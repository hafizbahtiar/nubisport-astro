# Copy to .env.development (gitignored) and fill in.

# Cloudflare Turnstile SITE key (public value, browser-safe).
# The widget must list localhost as an allowed domain in the Turnstile
# dashboard for local dev. Unset/empty does NOT disable it: src/data/site.ts
# falls back to the production key (`||`, so prod never ships without a captcha).
# To skip the real challenge locally use Cloudflare's test key (always passes,
# invisible) and leave the backend's TURNSTILE_SECRET unset (it then skips
# verification) or set it to the test secret 1x0000000000000000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
