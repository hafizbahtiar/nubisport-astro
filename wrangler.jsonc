// Nubi Sport Worker: static site from dist/ + /api/* forwarded to the hono-workers
// API through a service binding (same origin for the browser - no CORS, no public hop).
{
	"name": "nubisport-astro",
	"main": "worker.ts",
	"compatibility_date": "2026-01-14",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Only /api/*, /_astro/* and /u/* run the Worker (404s must not be cached, see worker.ts);
		// every other path is a plain static asset.
		"run_worker_first": [
			"/api/*",
			"/_astro/*",
			"/u",
			"/u/*"
		]
	},
	"services": [
		{
			"binding": "API",
			"service": "hono-workers"
		}
	],
	"routes": [
		{
			"pattern": "nubisport.hafizbahtiar.com",
			"custom_domain": true
		}
	]
}