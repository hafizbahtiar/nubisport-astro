---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Head from "../components/layout/Head.astro";
import ConfirmDialog from "../components/ui/ConfirmDialog.astro";
import ConnectionNotice from "../components/ui/ConnectionNotice.astro";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean; // page akaun
}
const {
  title = `${SITE.name} - ${SITE.tagline}`,
  description = SITE.description,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="ms">
  <head>
    <Head title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ConfirmDialog />
    <ConnectionNotice />
    <script>
      // Kiraan lawatan halaman awam (fire-and-forget, tanpa kuki). Halaman akaun tidak dikira.
      if (
        import.meta.env.PROD &&
        !location.pathname.startsWith("/account") &&
        navigator.sendBeacon
      )
        navigator.sendBeacon("/api/v1/public/visit", location.pathname);
      // PWA: pelan + pemasa boleh dibuka semula tanpa internet (public/sw.js).
      if (import.meta.env.PROD && "serviceWorker" in navigator)
        navigator.serviceWorker.register("/sw.js").catch(() => {});
    </script>
  </body>
</html>
