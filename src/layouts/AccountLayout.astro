---
// Layout selepas log masuk: sidebar (laci di bawah 64rem), navbar atas, kandungan lebar penuh.
// Satu-satunya pengawal sesi bagi /account/*: tiada sesi -> /login?next=<page ini>.
// Page di dalamnya ambil pengguna dengan currentUser() (src/lib/api.ts) - promise yang sama, satu /me.
import "../styles/global.css";
import "../styles/forms.css";
import "../styles/overlays.css";
import "../styles/panel.css";
import Head from "../components/layout/Head.astro";
import ConfirmDialog from "../components/ui/ConfirmDialog.astro";
import Icon from "../components/ui/Icon.astro";
import type { IconName } from "../lib/icon";
import UserMenu from "../components/ui/UserMenu.astro";
import ConnectionNotice from "../components/ui/ConnectionNotice.astro";
import { SITE } from "../data/site";

interface Props {
  title: string; // tajuk navbar + <title>
  description?: string;
}
const { title, description = `Akaun ${SITE.name}.` } = Astro.props;

// ikon: nama Lucide (src/lib/icon.ts). members: hanya ahli Nubi (lihat `ahli` di bawah) - dilukis
// tersembunyi, didedahkan bila pengguna diketahui. Profil + log keluar ada dalam UserMenu.
// owner: hanya owner (data-owner) - contoh Panduan UI untuk pembangun.
type NavItem = {
  href: string;
  label: string;
  ikon: IconName;
  members?: true;
  owner?: true;
};
const NAV: { tajuk: string; items: NavItem[] }[] = [
  {
    tajuk: "Utama",
    items: [{ href: "/account", label: "Dashboard", ikon: "rumah" }],
  },
  {
    tajuk: "Latihan",
    items: [
      { href: "/account/plans", label: "Pelan larian", ikon: "pemasa" },
      {
        href: "/account/activities",
        label: "Aktiviti",
        ikon: "aktiviti",
        members: true,
      },
      {
        href: "/account/ai",
        label: "NUNI",
        ikon: "buku",
        members: true,
      },
      {
        href: "/account/badges",
        label: "Lencana",
        ikon: "medal",
        members: true,
      },
    ],
  },
  {
    tajuk: "Alat",
    items: [
      { href: "/account/maf", label: "Kira MAF", ikon: "nadi" },
      {
        href: "/account/deficit",
        label: "Kalkulator defisit",
        ikon: "bendera",
      },
    ],
  },
  {
    tajuk: "Komuniti",
    items: [
      { href: "/account/events", label: "Larian kumpulan", ikon: "kalendar" },
    ],
  },
  {
    tajuk: "Akaun",
    items: [
      { href: "/account/usage", label: "Penggunaan", ikon: "laju" },
      { href: "/account/pricing", label: "Harga", ikon: "harga" },
      { href: "/account/ui", label: "Panduan UI", ikon: "buku", owner: true },
    ],
  },
];
const laluan = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="ms">
  <head>
    <Head title={`${title} - ${SITE.name}`} description={description} noindex />
  </head>
  <body class="app">
    <a class="langkau" href="#kandungan">Langkau ke kandungan</a>

    <script is:inline>
      // Sidebar dilipat (desktop) diingat - pasang kelas sebelum lukisan pertama.
      try {
        if (localStorage.getItem("akaun:sidebar") === "tutup")
          document.body.classList.add("sidebar-tutup");
      } catch {}
    </script>
    <aside class="app-sidebar" id="sidebar" aria-label="Navigasi akaun">
      <div class="app-sidebar-kepala">
        <a
          class="app-logo"
          href="/account"
          aria-label={`${SITE.name} - Dashboard`}
        >
          <img src="/brand/logo-on-dark.svg" alt="" width="142" height="40" />
        </a>
        <button
          class="app-tutup"
          type="button"
          aria-controls="sidebar"
          aria-label="Tutup menu"
          data-tutup-sidebar
        >
          <Icon name="tutup" />
        </button>
      </div>
      <nav class="app-nav">
        {
          NAV.map((g) => (
            <div class="app-nav-kumpulan">
              <p class="app-nav-tajuk">{g.tajuk}</p>
              {g.items.map((n) => (
                <a
                  href={n.href}
                  hidden={n.members || n.owner}
                  data-ahli={n.members ? "" : undefined}
                  data-owner={n.owner ? "" : undefined}
                  aria-current={
                    laluan === n.href ||
                    (n.href !== "/account" && laluan.startsWith(`${n.href}/`))
                      ? "page"
                      : undefined
                  }
                >
                  <Icon name={n.ikon} />
                  {n.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
      <div class="app-pengguna">
        <UserMenu up id="menu-sidebar" />
      </div>
    </aside>
    <div class="app-scrim" data-tutup hidden></div>

    <div class="app-utama">
      <header class="app-navbar">
        <button
          class="app-menu"
          type="button"
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="Buka menu"
          data-buka-sidebar
        >
          <Icon name="menu" />
        </button>
        <h1 class="display app-tajuk">{title}</h1>
        <span class="app-navbar-pengguna">
          <UserMenu id="menu-navbar" />
        </span>
      </header>
      <main class="app-kandungan" id="kandungan">
        <slot />
      </main>
      <script is:inline>
        // Lukis dari salinan /me (lib/api.ts ME_CACHE_KEY, sessionStorage) sebelum lukisan pertama:
        // nama/e-mel/awalan/peranan + bahagian ikut peranan, di sidebar DAN dalam page (sebab itu
        // skrip ini selepas <main>). Skrip modul di bawah lukis semula dari /me baharu - logik sama.
        //   [data-ahli]  ahli Nubi / admin Nubi / owner   [data-admin] admin Nubi / owner   [data-owner] owner
        try {
          const s = JSON.parse(
            sessionStorage.getItem("nubi:saya") || "null",
          )?.s;
          if (s && /(?:^|; )session_active=1/.test(document.cookie)) {
            const isi = (a, v) =>
              document.querySelectorAll(a).forEach((e) => (e.textContent = v));
            const n = s.apps && s.apps.nubi;
            const owner = s.role === "owner";
            isi("[data-saya-nama]", s.name);
            isi("[data-saya-emel]", s.email);
            isi(
              "[data-saya-awal]",
              s.name.trim().charAt(0).toUpperCase() || "?",
            );
            isi(
              "[data-saya-peranan]",
              owner
                ? "Pemilik"
                : n === "admin"
                  ? "Pentadbir"
                  : n === "ahli"
                    ? "Ahli"
                    : "Belum ahli",
            );
            // Link ahli/owner sengaja TIDAK dibuka dari cache: cache boleh stale selepas
            // role dibuang. Skrip modul di bawah buka ikut /me segar.
          }
        } catch {}
      </script>
    </div>
    <ConfirmDialog />
    <ConnectionNotice />
  </body>
</html>

<script>
  import { currentUser } from "../lib/api";

  // PWA: halaman akaun tidak dicache (data akaun), tetapi pendaftaran ini memastikan
  // pelan awam + pemasa yang dibuka dari sini turut berfungsi luar talian.
  if (import.meta.env.PROD && "serviceWorker" in navigator)
    navigator.serviceWorker.register("/sw.js").catch(() => {});

  const s = await currentUser();
  if (!s) {
    location.replace(
      `/login?next=${encodeURIComponent(location.pathname + location.search + location.hash)}`,
    );
  } else {
    document
      .querySelectorAll("[data-saya-nama]")
      .forEach((e) => (e.textContent = s.name));
    document
      .querySelectorAll("[data-saya-emel]")
      .forEach((e) => (e.textContent = s.email));
    const awal = s.name.trim().charAt(0).toUpperCase() || "?";
    document
      .querySelectorAll("[data-saya-awal]")
      .forEach((e) => (e.textContent = awal));
    // Sama dengan skrip inline (selepas <main>); backend tetap menyemak peranan pada setiap panggilan.
    const nubi = s.apps?.nubi;
    const owner = s.role === "owner";
    document
      .querySelectorAll("[data-saya-peranan]")
      .forEach(
        (e) =>
          (e.textContent = owner
            ? "Pemilik"
            : nubi === "admin"
              ? "Pentadbir"
              : nubi === "ahli"
                ? "Ahli"
                : "Belum ahli"),
      );
    const buka = (sel: string, ok: boolean) =>
      document
        .querySelectorAll<HTMLElement>(sel)
        .forEach((e) => (e.hidden = !ok));
    buka("[data-ahli]", owner || nubi === "ahli" || nubi === "admin");
    buka("[data-admin]", owner || nubi === "admin");
    buka("[data-owner]", owner);
  }

  // Bawah 64rem sidebar = laci (body.menu-buka); atas 64rem ia boleh dilipat (body.sidebar-tutup,
  // diingat dalam localStorage). Butang menu di navbar membuka, butang X di sidebar menutup.
  const desktop = matchMedia("(min-width: 64rem)");
  const menu = document.querySelector<HTMLButtonElement>(
    "[data-buka-sidebar]",
  )!;
  const tutup = document.querySelector<HTMLButtonElement>(
    "[data-tutup-sidebar]",
  )!;
  const scrim = document.querySelector<HTMLElement>("[data-tutup]")!;
  const body = document.body;
  const terbuka = () =>
    desktop.matches
      ? !body.classList.contains("sidebar-tutup")
      : body.classList.contains("menu-buka");
  const segerak = () => {
    const buka = terbuka();
    menu.setAttribute("aria-expanded", String(buka));
    menu.setAttribute("aria-label", buka ? "Tutup menu" : "Buka menu");
    scrim.hidden = desktop.matches || !buka;
  };
  const set = (buka: boolean) => {
    if (desktop.matches) {
      body.classList.toggle("sidebar-tutup", !buka);
      try {
        localStorage.setItem("akaun:sidebar", buka ? "buka" : "tutup");
      } catch {
        /* mod peribadi */
      }
    } else {
      body.classList.toggle("menu-buka", buka);
    }
    segerak();
    (buka ? document.querySelector<HTMLElement>(".app-nav a") : menu)?.focus();
  };
  menu.addEventListener("click", () => set(!terbuka()));
  tutup.addEventListener("click", () => set(false));
  scrim.addEventListener("click", () => set(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !desktop.matches && terbuka()) set(false);
  });
  desktop.addEventListener("change", () => {
    body.classList.remove("menu-buka"); // laci tidak terbawa ke desktop
    segerak();
  });
  segerak();
</script>

<style>
  .app {
    --sidebar-w: 16rem;
    --navbar-h: 4rem;
    min-height: 100vh;
    background: var(--paper-2);
  }

  .langkau {
    position: absolute;
    left: -999px;
  }
  .langkau:focus {
    left: 1rem;
    top: 1rem;
    z-index: 50;
    padding: 0.5rem 1rem;
    background: var(--paper);
  }

  /* ---------- Sidebar ---------- */
  .app-sidebar {
    view-transition-name: akaun-sidebar;
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    width: var(--sidebar-w);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.25rem 1rem;
    background: var(--navy);
    color: var(--on-dark);
    overflow-y: auto;
  }
  .app-sidebar-kepala {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .app-tutup {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--on-dark);
    cursor: pointer;
  }
  .app-tutup:hover {
    background: var(--navy-2);
    color: #fff;
  }
  .app-tutup:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  .app-logo img {
    height: 2.25rem;
    width: auto;
    display: block;
  }
  .app-nav {
    display: grid;
    gap: 1.25rem;
  }
  .app-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius);
    color: var(--on-dark);
    text-decoration: none;
    font-weight: 600;
  }
  .app-nav a:hover {
    background: var(--navy-2);
    color: #fff;
  }
  .app-nav a[aria-current="page"] {
    background: var(--orange);
    color: var(--navy);
  }
  .app-nav a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  :global(.lucide) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .app-nav-kumpulan {
    display: grid;
    gap: 0.25rem;
  }
  .app-nav-tajuk {
    margin: 0;
    padding: 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark);
    opacity: 0.7;
  }

  .app-pengguna {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--on-dark-line);
  }

  /* ---------- Navbar + kandungan ---------- */
  .app-utama {
    margin-left: var(--sidebar-w);
    min-width: 0;
    transition: margin-left 0.2s ease;
  }
  .app-sidebar {
    transition:
      transform 0.2s ease,
      visibility 0s;
  }
  /* Desktop: sidebar dilipat - kandungan ambil lebar penuh, butang menu muncul untuk buka semula. */
  @media (min-width: 64rem) {
    :global(body.sidebar-tutup) .app-sidebar {
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform 0.2s ease,
        visibility 0s 0.2s;
    }
    :global(body.sidebar-tutup) .app-utama {
      margin-left: 0;
    }
    :global(body.sidebar-tutup) .app-menu {
      display: grid;
    }
  }
  .app-navbar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--navbar-h);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.5rem;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .app-tajuk {
    margin: 0;
    font-size: 1.6rem;
    color: var(--navy);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .app-navbar-pengguna {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--ink);
  }
  .app-menu {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--navy);
    cursor: pointer;
  }
  .app-kandungan {
    padding: 1.5rem;
    display: grid;
    /* Satu perkataan panjang (nama fail .fit, URL) tak boleh lebarkan lajur melepasi skrin. */
    grid-template-columns: minmax(0, 1fr);
    overflow-wrap: anywhere;
    gap: 1.5rem;
    align-content: start;
  }
  /* Sasaran skrol (contoh #pelan) tidak terlindung di bawah navbar melekat. */
  .app-kandungan :global([id]) {
    scroll-margin-top: calc(var(--navbar-h) + 1rem);
  }
  /* Komponen laman awam (PageHero, Section) di dalam kandungan: lebar penuh, berbucu. */
  .app-kandungan :global(.container) {
    max-width: none;
    padding-inline: 0;
  }
  .app-kandungan :global(.page-hero) {
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }
  /* section awam ada padding besar (global.css) - di sini jarak datang dari gap .app-kandungan. */
  .app-kandungan :global(.band),
  .app-kandungan :global(.hasil) {
    background: none;
    border: 0;
    padding-block: 0;
  }

  /* ---------- Bawah 64rem: sidebar jadi laci ---------- */
  @media (max-width: 63.99rem) {
    .app-utama {
      margin-left: 0;
    }
    .app-menu {
      display: grid;
    }
    .app-sidebar {
      transform: translateX(-100%);
      visibility: hidden; /* tidak boleh difokus bila tertutup */
      transition:
        transform 0.2s ease,
        visibility 0s 0.2s;
      box-shadow: 0 0 2rem rgb(0 0 0 / 0.3);
    }
    :global(body.menu-buka) .app-sidebar {
      transform: none;
      visibility: visible;
      transition: transform 0.2s ease;
    }
    .app-scrim {
      position: fixed;
      inset: 0;
      z-index: 25;
      background: rgb(10 26 51 / 0.5);
    }
    :global(body.menu-buka) {
      overflow: hidden;
    }
  }
  @media (max-width: 40rem) {
    .app-kandungan {
      padding: 1rem;
    }
    .app-navbar {
      padding: 0 1rem;
    }
  }
</style>
