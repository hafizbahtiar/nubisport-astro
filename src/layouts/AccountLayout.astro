---
// Layout selepas log masuk: sidebar (laci di bawah 64rem), navbar atas, kandungan lebar penuh.
// Satu-satunya pengawal sesi bagi /account/*: tiada sesi -> /login?next=<page ini>.
// Page di dalamnya ambil pengguna dengan currentUser() (src/lib/api.ts) - promise yang sama, satu /me.
import "../styles/global.css";
import Head from "../components/layout/Head.astro";
import ConfirmDialog from "../components/ui/ConfirmDialog.astro";
import Icon from "../components/ui/Icon.astro";
import type { IconName } from "../lib/icon";
import ConnectionNotice from "../components/ui/ConnectionNotice.astro";
import { SITE } from "../data/site";

interface Props {
  title: string; // tajuk navbar + <title>
  description?: string;
}
const { title, description = `Akaun ${SITE.name}.` } = Astro.props;

// ikon: nama Lucide (src/lib/icon.ts)
const NAV: { href: string; label: string; ikon: IconName }[] = [
  {
    href: "/account",
    label: "Dashboard",
    ikon: "rumah",
  },
  {
    href: "/account/plan-5k",
    label: "Pelan 5K",
    ikon: "pemasa",
  },
  {
    href: "/account/distance-plan",
    label: "Pelan 10K / 21K",
    ikon: "bendera",
  },
  { href: "/account/maf", label: "Kira MAF", ikon: "nadi" },
  { href: "/account/activities", label: "Aktiviti", ikon: "aktiviti" },
  {
    href: "/account/profile",
    label: "Profil",
    ikon: "pengguna",
  },
];
const laluan = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="ms">
  <head>
    <Head title={`${title} - ${SITE.name}`} description={description} noindex />
  </head>
  <body class="app">
    <a class="langkau" href="#kandungan">Langkau ke kandungan</a>

    <script is:inline>
      // Sidebar dilipat (desktop) diingat - pasang kelas sebelum lukisan pertama.
      try {
        if (localStorage.getItem("akaun:sidebar") === "tutup")
          document.body.classList.add("sidebar-tutup");
      } catch {}
    </script>
    <aside class="app-sidebar" id="sidebar" aria-label="Navigasi akaun">
      <div class="app-sidebar-kepala">
        <a
          class="app-logo"
          href="/account"
          aria-label={`${SITE.name} - Dashboard`}
        >
          <img src="/brand/logo-on-dark.svg" alt="" width="142" height="40" />
        </a>
        <button
          class="app-tutup"
          type="button"
          aria-controls="sidebar"
          aria-label="Tutup menu"
          data-tutup-sidebar
        >
          <Icon name="tutup" />
        </button>
      </div>
      <nav class="app-nav">
        {
          NAV.map((n) => (
            <a
              href={n.href}
              aria-current={
                laluan === n.href ||
                (n.href !== "/account" && laluan.startsWith(`${n.href}/`))
                  ? "page"
                  : undefined
              }
            >
              <Icon name={n.ikon} />
              {n.label}
            </a>
          ))
        }
      </nav>
      <div class="app-pengguna">
        <span class="avatar" data-saya-awal aria-hidden="true"></span>
        <span class="app-pengguna-teks">
          <strong data-saya-nama>…</strong>
          <small data-saya-emel></small>
        </span>
        <button class="btn btn-outline btn-sm" type="button" data-keluar
          >Log keluar</button
        >
      </div>
    </aside>
    <div class="app-scrim" data-tutup hidden></div>

    <div class="app-utama">
      <header class="app-navbar">
        <button
          class="app-menu"
          type="button"
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="Buka menu"
          data-menu
        >
          <Icon name="menu" />
        </button>
        <h1 class="display app-tajuk">{title}</h1>
        <span class="app-navbar-pengguna">
          <span class="avatar" data-saya-awal aria-hidden="true"></span>
          <span data-saya-nama></span>
        </span>
      </header>
      <script is:inline>
        // Lukis nama/e-mel dari salinan /me (lib/api.ts ME_CACHE_KEY) sebelum lukisan pertama.
        try {
          const s = JSON.parse(
            sessionStorage.getItem("nubi:saya") || "null",
          )?.s;
          if (s && /(?:^|; )session_active=1/.test(document.cookie)) {
            const isi = (a, v) =>
              document.querySelectorAll(a).forEach((e) => (e.textContent = v));
            isi("[data-saya-nama]", s.name);
            isi("[data-saya-emel]", s.email);
            isi(
              "[data-saya-awal]",
              s.name.trim().charAt(0).toUpperCase() || "?",
            );
          }
        } catch {}
      </script>
      <main class="app-kandungan" id="kandungan">
        <slot />
      </main>
    </div>
    <ConfirmDialog />
    <ConnectionNotice />
  </body>
</html>

<script>
  import { api, cacheMe, currentUser } from "../lib/api";
  import { confirmDialog } from "../lib/confirm";

  const s = await currentUser();
  if (!s) {
    location.replace(
      `/login?next=${encodeURIComponent(location.pathname + location.search + location.hash)}`,
    );
  } else {
    document
      .querySelectorAll("[data-saya-nama]")
      .forEach((e) => (e.textContent = s.name));
    document
      .querySelectorAll("[data-saya-emel]")
      .forEach((e) => (e.textContent = s.email));
    const awal = s.name.trim().charAt(0).toUpperCase() || "?";
    document
      .querySelectorAll("[data-saya-awal]")
      .forEach((e) => (e.textContent = awal));
  }

  // Bawah 64rem sidebar = laci (body.menu-buka); atas 64rem ia boleh dilipat (body.sidebar-tutup,
  // diingat dalam localStorage). Butang menu di navbar membuka, butang X di sidebar menutup.
  const desktop = matchMedia("(min-width: 64rem)");
  const menu = document.querySelector<HTMLButtonElement>("[data-menu]")!;
  const tutup = document.querySelector<HTMLButtonElement>(
    "[data-tutup-sidebar]",
  )!;
  const scrim = document.querySelector<HTMLElement>("[data-tutup]")!;
  const body = document.body;
  const terbuka = () =>
    desktop.matches
      ? !body.classList.contains("sidebar-tutup")
      : body.classList.contains("menu-buka");
  const segerak = () => {
    const buka = terbuka();
    menu.setAttribute("aria-expanded", String(buka));
    menu.setAttribute("aria-label", buka ? "Tutup menu" : "Buka menu");
    scrim.hidden = desktop.matches || !buka;
  };
  const set = (buka: boolean) => {
    if (desktop.matches) {
      body.classList.toggle("sidebar-tutup", !buka);
      try {
        localStorage.setItem("akaun:sidebar", buka ? "buka" : "tutup");
      } catch {
        /* mod peribadi */
      }
    } else {
      body.classList.toggle("menu-buka", buka);
    }
    segerak();
    (buka ? document.querySelector<HTMLElement>(".app-nav a") : menu)?.focus();
  };
  menu.addEventListener("click", () => set(!terbuka()));
  tutup.addEventListener("click", () => set(false));
  scrim.addEventListener("click", () => set(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !desktop.matches && terbuka()) set(false);
  });
  desktop.addEventListener("change", () => {
    body.classList.remove("menu-buka"); // laci tidak terbawa ke desktop
    segerak();
  });
  segerak();

  document
    .querySelector("[data-keluar]")!
    .addEventListener("click", async () => {
      const ya = await confirmDialog({
        title: "Log keluar?",
        message:
          "Lepas ini, log masuk semula untuk buka Dashboard dan pelan versi penuh.",
        confirmLabel: "Log keluar",
      });
      if (!ya) return;
      await api("/auth/logout", { method: "POST" }).catch(() => {});
      cacheMe(null);
      // Cookie httpOnly dipadam oleh backend; session_active juga, tetapi pastikan UI ikut.
      document.cookie = "session_active=; Max-Age=0; path=/";
      location.replace("/");
    });
</script>

<style>
  .app {
    --sidebar-w: 16rem;
    --navbar-h: 4rem;
    min-height: 100vh;
    background: var(--paper-2);
  }

  .langkau {
    position: absolute;
    left: -999px;
  }
  .langkau:focus {
    left: 1rem;
    top: 1rem;
    z-index: 50;
    padding: 0.5rem 1rem;
    background: var(--paper);
  }

  /* ---------- Sidebar ---------- */
  .app-sidebar {
    view-transition-name: akaun-sidebar;
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    width: var(--sidebar-w);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.25rem 1rem;
    background: var(--navy);
    color: var(--on-dark);
    overflow-y: auto;
  }
  .app-sidebar-kepala {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .app-tutup {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--on-dark);
    cursor: pointer;
  }
  .app-tutup:hover {
    background: var(--navy-2);
    color: #fff;
  }
  .app-tutup:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  .app-logo img {
    height: 2.25rem;
    width: auto;
    display: block;
  }
  .app-nav {
    display: grid;
    gap: 0.25rem;
  }
  .app-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius);
    color: var(--on-dark);
    text-decoration: none;
    font-weight: 600;
  }
  .app-nav a:hover {
    background: var(--navy-2);
    color: #fff;
  }
  .app-nav a[aria-current="page"] {
    background: var(--orange);
    color: var(--navy);
  }
  .app-nav a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  .app-nav hr {
    border: 0;
    border-top: 1px solid var(--on-dark-line);
    margin: 0.75rem 0;
  }
  :global(.lucide) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .app-pengguna {
    margin-top: auto;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--on-dark-line);
  }
  .app-pengguna-teks {
    display: grid;
    min-width: 0;
  }
  .app-pengguna-teks strong {
    color: #fff;
  }
  .app-pengguna-teks small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .app-pengguna .btn {
    grid-column: 1 / -1;
    justify-self: stretch;
    color: #fff;
    border-color: var(--on-dark-line);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--orange);
    color: var(--navy);
    font-weight: 800;
  }

  /* ---------- Navbar + kandungan ---------- */
  .app-utama {
    margin-left: var(--sidebar-w);
    min-width: 0;
    transition: margin-left 0.2s ease;
  }
  .app-sidebar {
    transition:
      transform 0.2s ease,
      visibility 0s;
  }
  /* Desktop: sidebar dilipat - kandungan ambil lebar penuh, butang menu muncul untuk buka semula. */
  @media (min-width: 64rem) {
    :global(body.sidebar-tutup) .app-sidebar {
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform 0.2s ease,
        visibility 0s 0.2s;
    }
    :global(body.sidebar-tutup) .app-utama {
      margin-left: 0;
    }
    :global(body.sidebar-tutup) .app-menu {
      display: grid;
    }
  }
  .app-navbar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--navbar-h);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.5rem;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .app-tajuk {
    margin: 0;
    font-size: 1.6rem;
    color: var(--navy);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .app-navbar-pengguna {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--ink);
  }
  .app-menu {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--navy);
    cursor: pointer;
  }
  .app-kandungan {
    padding: 1.5rem;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  /* Sasaran skrol (contoh #pelan) tidak terlindung di bawah navbar melekat. */
  .app-kandungan :global([id]) {
    scroll-margin-top: calc(var(--navbar-h) + 1rem);
  }
  /* Komponen laman awam (PageHero, Section) di dalam kandungan: lebar penuh, berbucu. */
  .app-kandungan :global(.container) {
    max-width: none;
    padding-inline: 0;
  }
  .app-kandungan :global(.page-hero) {
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }
  /* section awam ada padding besar (global.css) - di sini jarak datang dari gap .app-kandungan. */
  .app-kandungan :global(.band),
  .app-kandungan :global(.hasil) {
    background: none;
    border: 0;
    padding-block: 0;
  }

  /* ---------- Bawah 64rem: sidebar jadi laci ---------- */
  @media (max-width: 63.99rem) {
    .app-utama {
      margin-left: 0;
    }
    .app-menu {
      display: grid;
    }
    .app-sidebar {
      transform: translateX(-100%);
      visibility: hidden; /* tidak boleh difokus bila tertutup */
      transition:
        transform 0.2s ease,
        visibility 0s 0.2s;
      box-shadow: 0 0 2rem rgb(0 0 0 / 0.3);
    }
    :global(body.menu-buka) .app-sidebar {
      transform: none;
      visibility: visible;
      transition: transform 0.2s ease;
    }
    .app-scrim {
      position: fixed;
      inset: 0;
      z-index: 25;
      background: rgb(10 26 51 / 0.5);
    }
    :global(body.menu-buka) {
      overflow: hidden;
    }
  }
  @media (max-width: 40rem) {
    .app-kandungan {
      padding: 1rem;
    }
    .app-navbar {
      padding: 0 1rem;
    }
    .app-navbar-pengguna [data-saya-nama] {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-utama,
    .app-sidebar {
      transition: none !important;
    }
  }
</style>
