---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Field from "../components/ui/Field.astro";
import Alert from "../components/ui/Alert.astro";
import { TURNSTILE_SITE_KEY } from "../data/site";
---

<Layout
  title="Lupa kata laluan - Nubi Sport"
  description="Minta pautan reset kata laluan akaun Nubi Sport."
>
  <PageHero
    eyebrow="Akaun"
    title="Lupa"
    accent="kata laluan."
    lead="Masukkan e-mel akaun anda. Kalau akaun itu wujud, kami hantar pautan reset ke e-mel itu."
  >
    <form class="form form-narrow" id="borang" novalidate>
      <Field label="E-mel">
        <input
          class="input"
          type="email"
          name="email"
          autocomplete="email"
          maxlength="255"
          required
        />
      </Field>
      <Alert variant="danger" id="mesej" hidden />
      <button class="btn btn-primary" type="submit">Hantar pautan reset</button>
      <p class="lead">
        Ingat kata laluan? <a class="link" href="/login">Log masuk</a>.
      </p>
    </form>

    <div class="form form-narrow" id="siap" hidden>
      <Alert variant="success">
        <p>
          Kalau e-mel ini ada akaun, pautan reset sedang dihantar. Semak peti
          masuk dan folder spam. Pautan sah 1 jam.
        </p>
      </Alert>
      <a class="btn btn-primary" href="/login">Log masuk</a>
    </div>

    <!-- Turnstile: tersembunyi kecuali Cloudflare minta interaksi. Backend wajibkan token (action reset). -->
    <div
      class="cf-turnstile"
      data-sitekey={TURNSTILE_SITE_KEY}
      data-action="reset"
      data-appearance="interaction-only"
    >
    </div>
  </PageHero>
</Layout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>

<script>
  import { api, captcha, json, commonError, resetCaptcha } from "../lib/api";

  const borang = document.getElementById("borang") as HTMLFormElement;
  const siap = document.getElementById("siap")!;
  const mesej = document.getElementById("mesej")!;
  const butang = borang.querySelector<HTMLButtonElement>(
    "button[type=submit]",
  )!;

  const papar = (teks: string | null) => {
    mesej.textContent = teks ?? "";
    mesej.hidden = !teks;
  };

  borang.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = borang.email.value.trim();
    if (!borang.email.checkValidity()) return papar("Masukkan e-mel yang sah.");
    papar(null);

    butang.disabled = true;
    try {
      const res = await api("/auth/forgot-password", {
        method: "POST",
        body: JSON.stringify({ email, app: "nubi", captchaToken: captcha() }),
      });
      if (!res.ok) {
        const body = await json(res);
        return papar(
          commonError(res.status, body) ??
            (res.status === 400
              ? "Masukkan e-mel yang sah."
              : "Tak dapat hantar sekarang. Cuba lagi sekejap."),
        );
      }
      borang.hidden = true;
      siap.hidden = false;
    } catch {
      papar("Tiada sambungan. Semak internet anda dan cuba lagi.");
    } finally {
      butang.disabled = false;
      resetCaptcha(); // token sekali guna
    }
  });
</script>
