---
// Page tidak wujud. Cloudflare Assets hidang dist/404.html untuk laluan yang tiada
// (wrangler.jsonc assets.not_found_handling = "404-page") - worker hanya untuk /api/*.
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
---

<Layout title="Tiada page - Nubi Sport" description="Page ini tidak wujud.">
  <PageHero
    eyebrow="404"
    title="Tersasar"
    accent="laluan."
    lead="Page ini tidak wujud atau sudah dipindahkan. Jom patah balik ke trek."
  >
    <div class="actions">
      <a class="btn btn-primary" href="/">Laman utama</a>
      <a class="btn btn-ghost" href="/pelan-5k">Pelan 5K</a>
    </div>
  </PageHero>
</Layout>

<style>
  .actions {
    margin-top: 2rem;
  }
</style>
