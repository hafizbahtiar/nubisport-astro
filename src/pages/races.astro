---
// Kalendar lumba Malaysia. Data dari API (src/lib/races.ts) - owner tambah dari laman rasmi penganjur di
// portfolio /admin/nubi/races. Page statik: senarai dimuat dalam pelayar.
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Alert from "../components/ui/Alert.astro";
---

<Layout
  title="Kalendar lumba Malaysia - Nubi Sport"
  description="Larian 3K hingga maraton di seluruh Malaysia, dari laman rasmi penganjur. Simpan ke kalendar dengan satu klik."
>
  <PageHero
    eyebrow="Kalendar"
    title="Lumba"
    accent="seterusnya."
    lead="Ada tarikh sasaran, latihan jadi lebih bermakna. Setiap acara disalin dari laman rasmi penganjur - semak di sana sebelum daftar."
  />

  <Section>
    <p class="lead" id="memuat" aria-live="polite">
      Memuatkan kalendar lumba...
    </p>
    <ul class="lumba card-grid" id="lumba"></ul>
    <template id="kad-lumba">
      <li class="card">
        <p class="eyebrow" data-k="bila"></p>
        <h2 class="lumba-nama" data-k="nama"></h2>
        <p class="lumba-tempat" data-k="tempat"></p>
        <p class="lumba-jarak" data-k="jarak"></p>
        <p class="lumba-kecil" data-k="yuran" hidden></p>
        <p class="lumba-kecil" data-k="tutup" hidden></p>
        <div class="actions">
          <a
            class="btn btn-primary btn-sm"
            data-k="pautan"
            target="_blank"
            rel="noopener">Laman rasmi</a
          >
          <button type="button" class="btn btn-outline btn-sm" data-k="ics"
            >Simpan ke kalendar</button
          >
        </div>
        <p class="lumba-kecil muted" data-k="disemak"></p>
      </li>
    </template>
    <p class="lead" id="kosong" hidden>
      Tiada lumba akan datang dalam senarai ini lagi - kami tengah semak acara
      baru.
    </p>
  </Section>

  <Section band narrow>
    <Alert variant="info" title="Tarikh boleh berubah">
      <p>
        Penganjur kadang-kadang tukar tarikh, laluan atau yuran. Laman rasmi
        penganjur sentiasa betul - senarai ini hanya rujukan. Pemula? Pilih 5K
        atau 10K dulu, dan beri diri anda sekurang-kurangnya 8-12 minggu dengan <a
          class="link"
          href="/plan-5k">Pelan 5K</a
        >.
      </p>
    </Alert>
  </Section>
</Layout>

<script>
  import { todayMY } from "../lib/date";
  import {
    downloadRaceIcs,
    fetchRaces,
    lowestFee,
    raceDistances,
  } from "../lib/races";

  const tarikh = (iso: string) =>
    new Date(`${iso}T00:00:00+08:00`).toLocaleDateString("ms-MY", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "Asia/Kuala_Lumpur",
    });
  const ddmm = (iso: string) => iso.split("-").reverse().join("/");

  const senarai = document.getElementById("lumba")!;
  const memuat = document.getElementById("memuat")!;
  const kad = document.getElementById("kad-lumba") as HTMLTemplateElement;

  void (async () => {
    const races = await fetchRaces();
    if (races === null) {
      memuat.textContent =
        "Kalendar lumba tak dapat dimuatkan sekarang. Cuba muat semula sebentar lagi.";
    } else {
      memuat.hidden = true;
      const hari = todayMY();
      for (const r of races) {
        const li = kad.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLElement;
        const k = (n: string) =>
          li.querySelector<HTMLElement>(`[data-k="${n}"]`)!;
        k("bila").textContent = r.endDate
          ? `${tarikh(r.raceDate)} - ${tarikh(r.endDate)} · ${r.startTime}`
          : `${tarikh(r.raceDate)} · ${r.startTime}`;
        k("nama").textContent = r.name;
        k("tempat").textContent = `${r.venue}, ${r.state}`;
        for (const j of raceDistances(r)) {
          const s = document.createElement("span");
          s.className = "lencana";
          s.textContent = j;
          k("jarak").append(s);
        }
        if (r.registrationOpens && r.registrationOpens > hari) {
          const s = document.createElement("span");
          s.className = "lencana";
          s.textContent = `Dibuka ${ddmm(r.registrationOpens)}`;
          k("jarak").append(s);
        }
        if (r.registrationCloses && r.registrationCloses < hari) {
          const s = document.createElement("span");
          s.className = "lencana lumba-tutup";
          s.textContent = "Pendaftaran ditutup";
          k("jarak").append(s);
        }
        const yuran = lowestFee(r);
        if (yuran != null)
          Object.assign(k("yuran"), {
            hidden: false,
            textContent: `Yuran dari RM${yuran % 1 ? yuran.toFixed(2) : yuran} (ikut kategori dan tarikh daftar)`,
          });
        if (r.registrationCloses)
          Object.assign(k("tutup"), {
            hidden: false,
            textContent: `Daftar sebelum ${ddmm(r.registrationCloses)}`,
          });
        (k("pautan") as HTMLAnchorElement).href = r.url;
        k("ics").addEventListener("click", () => downloadRaceIcs(r));
        k("disemak").textContent = `Disemak ${ddmm(r.checkedOn)}`;
        senarai.append(li);
      }
      document.getElementById("kosong")!.hidden = races.length > 0;
    }
  })();
</script>

<style>
  .lumba li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .lumba .eyebrow {
    margin: 0;
  }
  .lumba-nama {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .lumba-tempat,
  .lumba-kecil {
    margin: 0;
  }
  .lumba-kecil {
    font-size: 0.9rem;
  }
  .lumba-jarak {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }
  .lumba .actions {
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
