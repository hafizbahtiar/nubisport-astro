---
// Penggunaan vs had setiap ciri (hono-workers GET /me/apps/nubi/usage). Had + jadual tier datang dari
// backend (pemalar yang sama dengan laluan tulis), jadi page ini tiada nombor had sendiri - cuma
// nama ciri. Ciri baru = satu entri CIRI di sini + satu item dalam services/nubi-usage.ts.
import AccountLayout from "../../layouts/AccountLayout.astro";
import Alert from "../../components/ui/Alert.astro";
import Table from "../../components/ui/Table.astro";

const CIRI = [
  {
    key: "plan",
    nama: "Pelan di awan",
    sub: "Pelan yang ikut akaun anda ke peranti lain.",
  },
  {
    key: "activities",
    nama: "Aktiviti Strava",
    sub: "Larian dari fail .fit yang dimuat naik.",
  },
  {
    key: "rsvp",
    nama: "RSVP larian",
    sub: "Larian kumpulan akan datang yang anda sertai.",
  },
];
---

<AccountLayout
  title="Penggunaan"
  description="Penggunaan dan had setiap ciri akaun Nubi Sport anda."
>
  <ul class="stat" aria-label="Ringkasan penggunaan">
    <li><span>Tier</span><strong data-saya-peranan>…</strong></li>
    <li><span>Pelan di awan</span><strong id="stat-plan">…</strong></li>
    <li><span>Aktiviti</span><strong id="stat-activities">…</strong></li>
  </ul>

  <Alert variant="danger" id="ralat" hidden>
    <p>
      Tak dapat muat penggunaan sekarang. Semak internet dan muat semula page.
    </p>
  </Alert>

  <section class="panel" aria-labelledby="t-guna">
    <div class="panel-kepala">
      <h3 class="display" id="t-guna">Had ciri</h3>
      <a class="btn btn-outline btn-sm" href="/account/pricing">Lihat harga</a>
    </div>
    <p class="muted">Dikira dari akaun anda setiap kali page ini dibuka.</p>
    <ul class="had">
      {
        CIRI.map((c) => (
          <li data-k={c.key}>
            <div class="had-teks">
              <strong>{c.nama}</strong>
              <span class="muted">{c.sub}</span>
            </div>
            <span class="had-angka" data-angka>
              …
            </span>
            <div
              class="had-bar"
              role="progressbar"
              aria-label={c.nama}
              aria-valuemin="0"
              data-bar
              hidden
            >
              <i />
            </div>
            <p class="had-nota" data-nota hidden />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" aria-labelledby="t-tier">
    <div class="panel-kepala">
      <h3 class="display" id="t-tier">Had ikut tier</h3>
    </div>
    <p class="muted">
      Tier anda ditebalkan. Pemilik guna had Pentadbir. "-" = tiada pada tier
      itu.
    </p>
    <Table
      id="tier"
      variant="compact"
      columns={[
        { label: "Ciri" },
        { label: "Percuma", numeric: true },
        { label: "Ahli", numeric: true },
        { label: "Pentadbir", numeric: true },
      ]}
      empty="Tiada data had."
    />
  </section>
</AccountLayout>

<script>
  import { api, json } from "../../lib/api";
  import { createTable } from "../../lib/table";

  type Had = number | null; // null = tiada had; 0 = tiada pada tier itu
  type Tier = "free" | "ahli" | "admin";
  type Item = {
    key: string;
    used: number;
    limit: Had;
    tiers: Record<Tier, Had>;
  };

  const nombor = (n: number) => n.toLocaleString("ms-MY");
  const had = (h: Had) =>
    h === null ? "Tiada had" : h === 0 ? "-" : nombor(h);
  const nama = (k: string) =>
    document.querySelector(`[data-k="${k}"] .had-teks strong`)?.textContent ??
    k;

  const jadual = createTable<Item>("tier", {
    columns: [
      (i) => nama(i.key),
      (i) => sel(i, "free"),
      (i) => sel(i, "ahli"),
      (i) => sel(i, "admin"),
    ],
  });
  let semasa: Tier = "free";
  const sel = (i: Item, t: Tier) =>
    t === semasa
      ? Object.assign(document.createElement("strong"), {
          textContent: had(i.tiers[t]),
        })
      : had(i.tiers[t]);

  const res = await api("/me/apps/nubi/usage", { cache: "no-store" }).catch(
    () => null,
  );
  const data: { tier: string; items: Item[] } | null = res?.ok
    ? (await json(res)).data
    : null;

  if (!data) {
    document.getElementById("ralat")!.hidden = false;
    document
      .querySelectorAll("[data-angka], .stat strong[id]")
      .forEach((e) => (e.textContent = "-"));
    jadual.data([]);
  } else {
    semasa = data.tier === "owner" ? "admin" : (data.tier as Tier);
    for (const i of data.items) {
      const li = document.querySelector<HTMLElement>(`[data-k="${i.key}"]`);
      const stat = document.getElementById(`stat-${i.key}`);
      if (stat)
        stat.textContent =
          i.limit === 0
            ? "-"
            : i.limit === null
              ? nombor(i.used)
              : `${nombor(i.used)}/${nombor(i.limit)}`;
      if (!li) continue;
      const angka = li.querySelector<HTMLElement>("[data-angka]")!;
      const bar = li.querySelector<HTMLElement>("[data-bar]")!;
      const nota = li.querySelector<HTMLElement>("[data-nota]")!;
      if (i.limit === 0) {
        // Tiada pada tier ini: lencana + pautan, bukan bar kosong.
        angka.innerHTML = `<span class="lencana">Untuk ahli</span>`;
        nota.innerHTML = `<a class="link" href="/account/pricing">Lihat cara jadi ahli</a>`;
        nota.hidden = false;
        continue;
      }
      if (i.limit === null) {
        angka.textContent = `${nombor(i.used)} · tiada had`;
        continue;
      }
      const peratus = Math.min(100, Math.round((i.used / i.limit) * 100));
      angka.textContent = `${nombor(i.used)} / ${nombor(i.limit)}`;
      bar.setAttribute("aria-valuemax", String(i.limit));
      bar.setAttribute("aria-valuenow", String(Math.min(i.used, i.limit)));
      bar.querySelector("i")!.style.width = `${peratus}%`;
      bar.hidden = false;
      if (i.used >= i.limit) {
        li.classList.add("penuh");
        nota.textContent = "Had penuh. Buang satu untuk tambah yang baru.";
        nota.hidden = false;
      } else if (peratus >= 80) {
        li.classList.add("hampir");
      }
    }
    jadual.data(data.items);
  }
</script>

<style>
  .had {
    justify-self: stretch;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .had li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .had li:last-child {
    padding-bottom: 0;
  }
  .had-teks {
    display: grid;
    gap: 0.15rem;
  }
  .had-teks .muted {
    font-size: 0.88rem;
  }
  .had-angka {
    font-weight: 700;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .had-bar,
  .had-nota {
    grid-column: 1 / -1;
  }
  .had-bar {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }
  .had-bar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--info-ink);
    transition: width 0.4s ease;
  }
  .hampir .had-bar i {
    background: var(--orange);
  }
  .penuh .had-bar i {
    background: var(--danger-ink);
  }
  .had-nota {
    font-size: 0.88rem;
  }
  .penuh .had-nota {
    color: var(--danger-ink);
  }
</style>
