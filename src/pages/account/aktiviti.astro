---
// Aktiviti dari fail Strava (FIT wajib + GPX pilihan). Ahli ke atas sahaja - backend menyekat (403),
// page ini hanya menyembunyikan borang. Pelan: docs/plans/aktiviti-strava.md.
// Aliran: seret fail -> dulang (pratonton + status setiap aktiviti) -> Simpan. Persetujuan sebaris
// dengan butang Simpan (sekali sahaja), bukan langkah berasingan.
import AccountLayout from "../../layouts/AccountLayout.astro";
import Alert from "../../components/ui/Alert.astro";
import Checkbox from "../../components/ui/Checkbox.astro";
import Ikon from "../../components/ui/Ikon.astro";
---

<AccountLayout title="Aktiviti">
  <Alert variant="info" title="Ciri untuk ahli" id="bukan-ahli" hidden>
    <p>
      Import aktiviti Strava terbuka untuk ahli Nubi Sport. Keahlian diluluskan
      oleh admin - hubungi kami melalui kumpulan larian.
    </p>
  </Alert>

  <div id="ahli" hidden>
    <ul class="stat" aria-label="7 hari terakhir">
      <li><span>Aktiviti 7 hari</span><strong id="bil-minggu">0</strong></li>
      <li><span>Jarak</span><strong id="jarak-minggu">0 km</strong></li>
      <li><span>Masa</span><strong id="masa-minggu">0m</strong></li>
    </ul>

    <section class="panel" aria-labelledby="tajuk-tambah">
      <div class="panel-kepala">
        <h3 class="display" id="tajuk-tambah">Tambah aktiviti</h3>
      </div>

      <details class="cara" id="cara">
        <summary>Cara dapatkan fail dari Strava</summary>
        <ol>
          <li>
            Buka aktiviti di <strong>strava.com</strong> (laman web, bukan app), tekan
            <strong>⋯</strong>.
          </li>
          <li>
            <strong>Export Original</strong> memberi fail <code>.fit</code> - wajib,
            nilainya paling tepat.
          </li>
          <li>
            <strong>Export GPX</strong> memberi fail <code>.gpx</code> - pilihan.
          </li>
          <li>
            Seret kedua-duanya ke kotak di bawah. Boleh banyak aktiviti sekali
            gus, dalam apa-apa susunan.
          </li>
        </ol>
      </details>

      <Alert variant="warning">
        <p>
          Hanya fail dari <strong>Strava</strong> disokong. Fail dari app lain (Garmin,
          Coros dan lain-lain) mungkin tak dapat dipadankan atau nilainya tak tepat.
        </p>
      </Alert>

      <div class="zon-grid">
        <label class="zon" data-zon="fit">
          <input type="file" accept=".fit" multiple class="sr-only" />
          <span class="zon-ikon"><Ikon nama="muatNaik" /></span>
          <strong>Fail .fit <small class="wajib">wajib</small></strong>
          <span class="muted zon-arahan"
            >Seret ke sini, atau tekan untuk pilih</span
          >
          <ul class="zon-fail"></ul>
        </label>
        <label class="zon" data-zon="gpx">
          <input type="file" accept=".gpx" multiple class="sr-only" />
          <span class="zon-ikon"><Ikon nama="muatNaik" /></span>
          <strong>Fail .gpx <small class="muted">pilihan</small></strong>
          <span class="muted zon-arahan"
            >Seret ke sini, atau tekan untuk pilih</span
          >
          <ul class="zon-fail"></ul>
        </label>
      </div>

      <!-- Dulang: satu baris setiap aktiviti (dan setiap fail yang tak boleh dipakai), dengan statusnya. -->
      <ol class="dulang" id="dulang" aria-label="Aktiviti untuk disimpan"></ol>

      <div class="hantar" id="hantar" hidden>
        <div id="setuju" hidden>
          <Checkbox
            name="setuju"
            id="setuju-tanda"
            label="Saya setuju fail asal disimpan"
            hint="Termasuk laluan GPS, untuk analitik Nubi secara agregat. Anda boleh padam bila-bila masa. Ditanya sekali sahaja."
          />
        </div>
        <div class="actions">
          <button class="btn btn-primary btn-sm" type="button" id="simpan"
            >Simpan</button
          >
          <button class="btn btn-outline btn-sm" type="button" id="kosong"
            >Kosongkan</button
          >
        </div>
      </div>
      <div class="alert" id="status" role="status" aria-live="polite" hidden>
      </div>

      <p class="muted kecil">
        Kami simpan ringkasan dan fail asal. Tiada peta dipaparkan kepada
        sesiapa. Laluan GPS boleh mendedahkan alamat rumah, jadi tetapkan <em
          >privacy zones</em
        > di Strava sebelum eksport. Ini bukan sambungan terus ke Strava: muat naik
        setiap aktiviti baru. Had 5,000 aktiviti.
      </p>
    </section>

    <section class="panel" aria-labelledby="tajuk-saya">
      <div class="panel-kepala">
        <h3 class="display" id="tajuk-saya">Aktiviti saya</h3>
        <div class="chips" role="radiogroup" aria-label="Tempoh">
          <label class="chip"
            ><input type="radio" name="tempoh" value="30" /><span>30 hari</span
            ></label
          >
          <label class="chip"
            ><input type="radio" name="tempoh" value="90" checked /><span
              >90 hari</span
            ></label
          >
          <label class="chip"
            ><input type="radio" name="tempoh" value="semua" /><span>Semua</span
            ></label
          >
        </div>
      </div>
      <p class="muted" id="jumlah"></p>
      <ol class="senarai" id="senarai"></ol>
      <p class="muted" id="tiada" hidden>
        Belum ada aktiviti dalam tempoh ini. Seret fail <code>.fit</code> dari Strava
        ke kotak di atas untuk mula.
      </p>
      <button
        class="btn btn-outline btn-sm"
        type="button"
        id="padam-semua"
        hidden>Padam semua data aktiviti saya</button
      >
    </section>
  </div>
</AccountLayout>

<script>
  import { api, json, sesiSaya } from "../../lib/api";
  import { sahkan } from "../../lib/sahkan";
  import {
    LABEL_SUKAN,
    borang,
    km,
    pace,
    pasangkan,
    tempoh,
    type Aktiviti,
    type Sukan,
  } from "../../lib/aktiviti-fail";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const BASE = "/me/apps/nubi/activities";

  interface Baris {
    id: number;
    startedAt: string;
    sport: Sukan;
    name: string | null;
    distanceM: number;
    movingS: number;
    avgHr: number | null;
    hasGpx: boolean;
  }

  const tarikh = (iso: string) =>
    new Date(iso).toLocaleString("ms-MY", {
      timeZone: "Asia/Kuala_Lumpur",
      weekday: "short",
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  const el = (tag: string, cls = "", teks = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (teks) e.textContent = teks; // teks pengguna (nama aktiviti, nama fail) sentiasa textContent
    return e;
  };
  // Butang teks standard (sama seperti butang() di dashboard).
  const butang = (teks: string, label: string) => {
    const b = el("button", "btn btn-outline btn-sm", teks) as HTMLButtonElement;
    b.type = "button";
    b.setAttribute("aria-label", label);
    return b;
  };
  /** Mesej keputusan dalam kotak .alert global. Teks kosong = sembunyi. */
  const papar = (
    teks: string,
    jenis: "success" | "danger" | "info" = "info",
  ) => {
    const a = $("status");
    a.className = `alert alert-${jenis}`;
    a.textContent = teks;
    a.hidden = !teks;
  };

  /** Baris aktiviti: jarak besar di kiri, nama + tarikh, kemudian masa / pace / nadi berlabel. */
  function kad(r: {
    sport: Sukan;
    name: string | null;
    startedAt: string;
    distanceM: number;
    movingS: number;
    avgHr: number | null;
  }) {
    const badan = el("div", "akt");
    const jarak = el("p", "akt-jarak display");
    jarak.append(
      document.createTextNode(
        (r.distanceM / 1000).toLocaleString("ms-MY", {
          maximumFractionDigits: 2,
        }),
      ),
      el("small", "", " km"),
    );
    const tajuk = el("div", "akt-tajuk");
    tajuk.append(
      el("strong", "", r.name || LABEL_SUKAN[r.sport]),
      el("span", "muted", `${LABEL_SUKAN[r.sport]}, ${tarikh(r.startedAt)}`),
    );
    const nilai = el("dl", "akt-nilai");
    const tambahNilai = (k: string, v: string | null) => {
      if (!v) return;
      const d = el("div");
      d.append(el("dt", "", k), el("dd", "", v));
      nilai.append(d);
    };
    tambahNilai("Masa", tempoh(r.movingS));
    tambahNilai("Pace", pace(r.distanceM, r.movingS));
    tambahNilai("Nadi", r.avgHr ? `${Math.round(r.avgHr)} bpm` : null);
    badan.append(jarak, tajuk, nilai);
    return badan;
  }

  const s = await sesiSaya();
  const nubi = s?.apps?.nubi;
  const ahli = s?.role === "owner" || nubi === "ahli" || nubi === "admin";
  $("bukan-ahli").hidden = ahli;
  $("ahli").hidden = !ahli;

  let perluSetuju = true;

  async function mula() {
    pasangZon();
    document
      .querySelectorAll<HTMLInputElement>('input[name="tempoh"]')
      .forEach((r) => r.addEventListener("change", senarai));
    $("padam-semua").addEventListener("click", padamSemua);
    $("simpan").addEventListener("click", simpanSemua);
    $("kosong").addEventListener("click", () => {
      dipilih.length = 0;
      status.clear();
      papar("");
      void kemas();
    });
    $<HTMLInputElement>("setuju-tanda").addEventListener("change", segarButang);

    // Persetujuan sekali (backend: app_items nubi/consent/aktiviti).
    const [c, ada] = await Promise.all([
      api("/me/apps/nubi/consent"),
      senarai(),
      minggu(),
    ]);
    perluSetuju = !(c.ok && ((await json(c)).data?.items?.length ?? 0) > 0);
    // Arahan Strava terbuka untuk ahli yang belum ada aktiviti; selepas itu dilipat.
    $<HTMLDetailsElement>("cara").open = ada === 0;
  }

  const dari = (hari: number) =>
    new Date(Date.now() - hari * 86_400_000).toISOString().slice(0, 10);

  async function minggu() {
    const r = await api(`${BASE}?from=${dari(7)}`);
    if (!r.ok) return;
    const t = (await json(r)).data.totals;
    $("bil-minggu").textContent = String(t.count);
    $("jarak-minggu").textContent = km(t.distanceM);
    $("masa-minggu").textContent = tempoh(t.movingS);
  }

  /** Senarai aktiviti tersimpan. Pulang bilangan dalam tempoh, atau -1 bila gagal. */
  async function senarai(): Promise<number> {
    const pilihan =
      document.querySelector<HTMLInputElement>('input[name="tempoh"]:checked')
        ?.value ?? "90";
    const r = await api(
      `${BASE}?from=${pilihan === "semua" ? "2000-01-01" : dari(Number(pilihan))}`,
    );
    const ol = $("senarai");
    if (!r.ok) {
      $("jumlah").textContent =
        "Aktiviti tak dapat dimuatkan. Muat semula page.";
      return -1;
    }
    const { activities, totals } = (await json(r)).data as {
      activities: Baris[];
      totals: { count: number; distanceM: number; movingS: number };
    };
    $("jumlah").textContent = totals.count
      ? `${totals.count} aktiviti, ${km(totals.distanceM)}, ${tempoh(totals.movingS)} bergerak.`
      : "";
    ol.replaceChildren(
      ...activities.map((a) => {
        const li = el("li");
        const hujung = el("div", "akt-hujung");
        if (a.hasGpx) hujung.append(el("span", "lencana", "+ GPX"));
        const padam = butang(
          "Padam",
          `Padam ${a.name || LABEL_SUKAN[a.sport]}`,
        );
        padam.addEventListener("click", async () => {
          const ya = await sahkan({
            tajuk: "Padam aktiviti ini?",
            mesej: `${a.name || LABEL_SUKAN[a.sport]} (${tarikh(a.startedAt)}) dan fail asalnya akan dibuang. Tindakan ini tak boleh diundur.`,
            ya: "Padam",
            bahaya: true,
          });
          if (!ya) return;
          const d = await api(`${BASE}/${a.id}`, { method: "DELETE" });
          if (!d.ok && d.status !== 404) {
            $("jumlah").textContent =
              "Aktiviti tak dapat dipadam. Semak sambungan dan cuba lagi.";
            return;
          }
          await Promise.all([senarai(), minggu()]);
        });
        hujung.append(padam);
        li.append(kad(a), hujung);
        return li;
      }),
    );
    $("tiada").hidden = activities.length > 0;
    $("padam-semua").hidden = activities.length === 0;
    return activities.length;
  }

  async function padamSemua() {
    const ya = await sahkan({
      tajuk: "Padam semua data aktiviti?",
      mesej:
        "Semua aktiviti dan fail asal anda akan dibuang dari Nubi Sport. Tindakan ini tak boleh diundur.",
      ya: "Padam semua",
      bahaya: true,
    });
    if (!ya) return;
    const r = await api(BASE, { method: "DELETE" });
    if (!r.ok) {
      $("jumlah").textContent =
        "Data tak dapat dipadam. Semak sambungan dan cuba lagi.";
      return;
    }
    await Promise.all([senarai(), minggu()]);
  }

  // ---------- Dulang ----------
  // Semua fail yang dipilih/diseret dari kedua-dua zon. Fail diasingkan ikut sambungan, bukan
  // zon: .gpx yang diseret ke zon FIT tetap masuk sebagai GPX.
  const dipilih: File[] = [];
  const kunciFail = (f: File) => `${f.name}:${f.size}:${f.lastModified}`;
  let sedia: Aktiviti[] = [];
  let menyimpan = false;
  /** Status setiap aktiviti (kunci = masa mula) semasa/selepas Simpan. */
  const status = new Map<
    string,
    { jenis: "kerja" | "ok" | "gagal"; teks: string }
  >();

  function tambah(fail: Iterable<File>) {
    if (menyimpan) return;
    const ada = new Set(dipilih.map(kunciFail));
    for (const f of fail)
      if (!ada.has(kunciFail(f))) (dipilih.push(f), ada.add(kunciFail(f)));
    // Fail baru = pusingan baru: buang status "disimpan" lama, kekalkan yang gagal untuk dicuba semula.
    for (const [k, v] of status) if (v.jenis === "ok") status.delete(k);
    papar("");
    void kemas();
  }

  function buang(f: File) {
    const i = dipilih.indexOf(f);
    if (i >= 0) dipilih.splice(i, 1);
    void kemas();
  }

  function pasangZon() {
    document.querySelectorAll<HTMLElement>("[data-zon]").forEach((zon) => {
      const input = zon.querySelector("input")!;
      input.addEventListener("change", () => {
        tambah(input.files ?? []);
        input.value = ""; // fail yang sama boleh dipilih semula
      });
      zon.addEventListener("dragover", (e) => {
        e.preventDefault();
        zon.classList.add("aktif");
      });
      zon.addEventListener("dragleave", () => zon.classList.remove("aktif"));
      zon.addEventListener("drop", (e) => {
        e.preventDefault();
        zon.classList.remove("aktif");
        tambah(e.dataTransfer?.files ?? []);
      });
    });
    // Fail yang terlepas di luar zon jangan dibuka oleh pelayar (meninggalkan page) - terima sahaja.
    window.addEventListener("dragover", (e) => e.preventDefault());
    window.addEventListener("drop", (e) => {
      e.preventDefault();
      if (!(e.target as HTMLElement).closest?.("[data-zon]"))
        tambah(e.dataTransfer?.files ?? []);
    });
  }

  function segarButang() {
    const n = sedia.filter(
      (a) => status.get(a.ringkasan.startedAt)?.jenis !== "ok",
    ).length;
    $("hantar").hidden = dipilih.length === 0;
    $("setuju").hidden = !perluSetuju || n === 0;
    const b = $<HTMLButtonElement>("simpan");
    b.hidden = n === 0;
    b.textContent = menyimpan ? "Menyimpan…" : `Simpan ${n} aktiviti`;
    b.disabled =
      menyimpan ||
      (perluSetuju && !$<HTMLInputElement>("setuju-tanda").checked);
    $<HTMLButtonElement>("kosong").disabled = menyimpan;
  }

  // ponytail: setiap perubahan menghurai semula semua fail - beratus fail sekali gus perlukan cache.
  async function kemas() {
    for (const jenis of ["fit", "gpx"] as const) {
      const zon = document.querySelector<HTMLElement>(`[data-zon="${jenis}"]`)!;
      const fail = dipilih.filter((f) =>
        f.name.toLowerCase().endsWith(`.${jenis}`),
      );
      zon.classList.toggle("berisi", fail.length > 0);
      zon.querySelector(".zon-arahan")!.textContent = fail.length
        ? `${fail.length} fail dipilih. Seret lagi untuk tambah.`
        : "Seret ke sini, atau tekan untuk pilih";
      zon.querySelector(".zon-fail")!.replaceChildren(
        ...fail.map((f) => {
          const li = el("li");
          const x = butang("Buang", `Buang ${f.name}`);
          x.addEventListener("click", (e) => {
            e.preventDefault(); // dalam <label>: jangan buka pemilih fail
            buang(f);
          });
          li.append(el("span", "", f.name), x);
          return li;
        }),
      );
    }

    const { aktiviti, gagal } = await pasangkan(dipilih);
    sedia = aktiviti;
    const dulang = $("dulang");
    dulang.replaceChildren(
      ...aktiviti.map((a) => {
        const st = status.get(a.ringkasan.startedAt);
        const li = el("li", st ? `st-${st.jenis}` : "");
        const hujung = el("div", "akt-hujung");
        hujung.append(
          el("span", "lencana", a.gpx ? "FIT + GPX" : "FIT sahaja"),
        );
        hujung.append(el("span", "dulang-status", st?.teks ?? "Sedia"));
        li.append(kad(a.ringkasan), hujung);
        return li;
      }),
      ...gagal.map((g) => {
        const li = el("li", "st-gagal");
        const teks = el("div", "akt-tajuk");
        teks.append(el("strong", "", g.fail), el("span", "", g.sebab));
        li.append(teks);
        return li;
      }),
    );
    segarButang();
  }

  async function simpanSemua() {
    if (menyimpan) return;
    menyimpan = true;
    segarButang();

    if (perluSetuju) {
      const r = await api("/me/apps/nubi/consent/aktiviti", {
        method: "PUT",
        body: JSON.stringify({ engine: 1, data: { v: "1" }, progress: [] }),
      }).catch(() => null);
      if (!r?.ok) {
        menyimpan = false;
        segarButang();
        return papar(
          "Persetujuan tak dapat disimpan. Semak sambungan dan cuba lagi.",
          "danger",
        );
      }
      perluSetuju = false;
    }

    let baru = 0,
      dikemas = 0,
      gagal = 0;
    // Satu aktiviti setiap request (backend: multipart, fail ≤ 5 MB). Yang dah disimpan dilangkau.
    for (const a of sedia) {
      const k = a.ringkasan.startedAt;
      if (status.get(k)?.jenis === "ok") continue;
      status.set(k, { jenis: "kerja", teks: "Menyimpan…" });
      await kemas();
      try {
        const r = await api(BASE, { method: "POST", body: await borang(a) });
        const b = await json(r);
        if (r.ok) {
          b.data.created ? baru++ : dikemas++;
          status.set(k, {
            jenis: "ok",
            teks: b.data.created ? "Disimpan" : "Dikemas kini",
          });
        } else if (b.code === "quota_full") {
          status.set(k, {
            jenis: "gagal",
            teks: `Had ${b.limit} aktiviti penuh`,
          });
          gagal++;
          break;
        } else {
          status.set(k, {
            jenis: "gagal",
            teks:
              r.status === 400 ? "Fail ditolak" : "Ralat pelayan, cuba lagi",
          });
          gagal++;
        }
      } catch {
        status.set(k, { jenis: "gagal", teks: "Tiada sambungan, cuba lagi" });
        gagal++;
      }
    }

    // Fail aktiviti yang berjaya keluar dari zon; yang gagal kekal untuk dicuba semula.
    const siap = new Set(
      sedia
        .filter((a) => status.get(a.ringkasan.startedAt)?.jenis === "ok")
        .flatMap((a) => [a.fit, a.gpx]),
    );
    for (let i = dipilih.length - 1; i >= 0; i--)
      if (siap.has(dipilih[i])) dipilih.splice(i, 1);
    menyimpan = false;
    await kemas();
    papar(
      [
        baru && `${baru} aktiviti disimpan`,
        dikemas && `${dikemas} dikemas kini`,
        gagal && `${gagal} gagal - tekan Simpan untuk cuba lagi`,
      ]
        .filter(Boolean)
        .join(", ") + ".",
      gagal ? "danger" : "success",
    );
    await Promise.all([senarai(), minggu()]);
  }

  // Di hujung: mula() guna const di atas (dari, dipilih, status...) - dipanggil lebih awal = TDZ.
  if (ahli) await mula();
</script>

<style>
  /* .stat dan .panel = salinan tepat dashboard (src/pages/account/index.astro). */
  .stat {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .stat li,
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .stat li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
  }
  .stat span {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stat strong {
    font-family: var(--display);
    font-style: italic;
    font-size: 2rem;
    color: var(--navy);
  }
  /* Telefon: tiga kad kekal sebaris (bukan tiga skrin), teks lebih kecil. */
  @media (max-width: 36rem) {
    .stat {
      gap: 0.5rem;
    }
    .stat li {
      padding: 0.75rem;
    }
    .stat span {
      font-size: 0.68rem;
      letter-spacing: 0.06em;
    }
    .stat strong {
      font-size: 1.35rem;
      line-height: 1.1;
    }
  }

  .panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.25rem 1.5rem;
