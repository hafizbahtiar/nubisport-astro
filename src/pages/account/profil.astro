---
// Profil Nubi: nama + kata laluan. Backend sama dengan portfolio (PATCH /me, PUT /me/password) -
// akaun satu, jadi perubahan di sini juga nampak di hafizbahtiar.com. E-mel tak boleh diubah (backend).
import AccountLayout from "../../layouts/AccountLayout.astro";
import Field from "../../components/ui/Field.astro";
import Alert from "../../components/ui/Alert.astro";
---

<AccountLayout title="Profil">
  <div class="grid">
    <section class="panel" aria-labelledby="t-profil">
      <h2 class="display" id="t-profil">Maklumat anda</h2>
      <form class="form" id="profil" novalidate>
        <Field label="Nama">
          <input
            class="input"
            type="text"
            name="nama"
            autocomplete="name"
            maxlength="100"
            required
          />
        </Field>
        <Field label="E-mel" hint="E-mel log masuk tak boleh diubah.">
          <input class="input" type="email" name="emel" readonly />
        </Field>
        <Alert variant="danger" id="mesej-profil" hidden />
        <Alert variant="success" id="ok-profil" hidden />
        <button class="btn btn-primary" type="submit">Simpan</button>
      </form>
    </section>

    <section class="panel" aria-labelledby="t-kata">
      <h2 class="display" id="t-kata">Tukar kata laluan</h2>
      <form class="form" id="kata" novalidate>
        <Field label="Kata laluan semasa">
          <input
            class="input"
            type="password"
            name="semasa"
            autocomplete="current-password"
            required
          />
        </Field>
        <Field
          label="Kata laluan baru"
          hint="12 hingga 200 aksara, ada huruf besar, huruf kecil dan nombor."
        >
          <input
            class="input"
            type="password"
            name="baru"
            autocomplete="new-password"
            minlength="12"
            maxlength="200"
            required
          />
        </Field>
        <Field label="Sahkan kata laluan baru">
          <input
            class="input"
            type="password"
            name="baru2"
            autocomplete="new-password"
            required
          />
        </Field>
        <Alert variant="danger" id="mesej-kata" hidden />
        <p class="muted">
          Selepas ditukar, semua sesi (di Nubi Sport dan hafizbahtiar.com)
          ditamatkan - log masuk semula.
        </p>
        <button class="btn btn-primary" type="submit">Tukar kata laluan</button>
      </form>
    </section>
  </div>
</AccountLayout>

<script>
  import { api, json, ralatAm, sesiSaya } from "../../lib/api";

  const profil = document.getElementById("profil") as HTMLFormElement;
  const kata = document.getElementById("kata") as HTMLFormElement;
  const papar = (id: string, teks: string | null) => {
    const el = document.getElementById(id)!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };
  const SAMBUNGAN = "Tiada sambungan. Semak internet anda dan cuba lagi.";

  // Pengawal sesi = AccountLayout; s null bermaksud page sedang dilencong ke /login.
  const s = await sesiSaya();
  if (s) {
    profil.nama.value = s.name;
    profil.emel.value = s.email;
  }

  profil.addEventListener("submit", async (e) => {
    e.preventDefault();
    papar("ok-profil", null);
    const nama = String(profil.nama.value).trim();
    if (!nama || nama.length > 100)
      return papar("mesej-profil", "Masukkan nama (maksimum 100 aksara).");
    papar("mesej-profil", null);
    const butang = profil.querySelector("button")!;
    butang.disabled = true;
    try {
      const res = await api("/me", {
        method: "PATCH",
        body: JSON.stringify({ displayName: nama }),
      });
      if (!res.ok)
        return papar(
          "mesej-profil",
          ralatAm(res.status, await json(res)) ??
            "Tak dapat simpan sekarang. Cuba sebentar lagi.",
        );
      document
        .querySelectorAll("[data-saya-nama]")
        .forEach((el) => (el.textContent = nama));
      document
        .querySelectorAll("[data-saya-awal]")
        .forEach((el) => (el.textContent = nama.charAt(0).toUpperCase()));
      papar("ok-profil", "Nama disimpan.");
    } catch {
      papar("mesej-profil", SAMBUNGAN);
    } finally {
      butang.disabled = false;
    }
  });

  // Sama dengan PasswordUpdateSchema backend (8+, besar/kecil/nombor) dan had daftar Nubi (12-200).
  const semakBaru = (pw: string, pw2: string) => {
    if (pw.length < 12 || pw.length > 200)
      return "Kata laluan baru mesti 12 hingga 200 aksara.";
    if (!/[A-Z]/.test(pw) || !/[a-z]/.test(pw) || !/[0-9]/.test(pw))
      return "Kata laluan baru perlu ada huruf besar, huruf kecil dan nombor.";
    if (pw !== pw2) return "Kata laluan baru tidak sama.";
    return null;
  };

  kata.addEventListener("submit", async (e) => {
    e.preventDefault();
    const semasa = String(kata.semasa.value);
    const baru = String(kata.baru.value);
    const salah = !semasa
      ? "Masukkan kata laluan semasa."
      : semakBaru(baru, String(kata.baru2.value));
    papar("mesej-kata", salah);
    if (salah) return;
    const butang = kata.querySelector("button")!;
    butang.disabled = true;
    try {
      const res = await api("/me/password", {
        method: "PUT",
        body: JSON.stringify({ currentPassword: semasa, newPassword: baru }),
      });
      if (res.ok) {
        // Backend tamatkan semua sesi dan buang cookie.
        location.replace(
          `/login?next=${encodeURIComponent("/account/profil")}`,
        );
        return;
      }
      const body = await json(res);
      papar(
        "mesej-kata",
        ralatAm(res.status, body) ??
          (/current password/i.test(String(body.error ?? ""))
            ? "Kata laluan semasa salah."
            : res.status === 400
              ? "Kata laluan baru tak memenuhi syarat."
              : "Tak dapat tukar sekarang. Cuba sebentar lagi."),
      );
    } catch {
      papar("mesej-kata", SAMBUNGAN);
    } finally {
      butang.disabled = false;
    }
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    align-items: start;
  }
  .panel {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .panel h2 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--navy);
  }
  .panel p {
    margin: 0;
  }
  input[readonly] {
    background: var(--paper-2);
    color: var(--muted);
  }
</style>
