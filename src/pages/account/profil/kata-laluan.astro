---
// Profil Nubi - Kata laluan (PUT /me/password). Berjaya = backend tamatkan semua sesi
// (Nubi + hafizbahtiar.com), jadi terus ke /login.
import ProfilShell from "../../../components/ProfilShell.astro";
import Field from "../../../components/ui/Field.astro";
import Alert from "../../../components/ui/Alert.astro";
---

<ProfilShell title="Kata laluan">
  <section class="panel" aria-labelledby="t-kata">
    <h2 class="display" id="t-kata">Tukar kata laluan</h2>
    <form class="form" id="kata" novalidate>
      <Field label="Kata laluan semasa">
        <input
          class="input"
          type="password"
          name="semasa"
          autocomplete="current-password"
          required
        />
      </Field>
      <Field
        label="Kata laluan baru"
        hint="12 hingga 200 aksara, ada huruf besar, huruf kecil dan nombor."
      >
        <input
          class="input"
          type="password"
          name="baru"
          autocomplete="new-password"
          minlength="12"
          maxlength="200"
          required
        />
      </Field>
      <Field label="Sahkan kata laluan baru">
        <input
          class="input"
          type="password"
          name="baru2"
          autocomplete="new-password"
          required
        />
      </Field>
      <Alert variant="danger" id="mesej-kata" hidden />
      <p class="muted">
        Selepas ditukar, semua sesi (di Nubi Sport dan hafizbahtiar.com)
        ditamatkan - log masuk semula.
      </p>
      <button class="btn btn-primary" type="submit">Tukar kata laluan</button>
    </form>
  </section>
</ProfilShell>

<script>
  import { api, json, ralatAm } from "../../../lib/api";

  const kata = document.getElementById("kata") as HTMLFormElement;
  const papar = (teks: string | null) => {
    const el = document.getElementById("mesej-kata")!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };

  // Sama dengan PasswordUpdateSchema backend (8+, besar/kecil/nombor) dan had daftar Nubi (12-200).
  const semakBaru = (pw: string, pw2: string) => {
    if (pw.length < 12 || pw.length > 200)
      return "Kata laluan baru mesti 12 hingga 200 aksara.";
    if (!/[A-Z]/.test(pw) || !/[a-z]/.test(pw) || !/[0-9]/.test(pw))
      return "Kata laluan baru perlu ada huruf besar, huruf kecil dan nombor.";
    if (pw !== pw2) return "Kata laluan baru tidak sama.";
    return null;
  };

  kata.addEventListener("submit", async (e) => {
    e.preventDefault();
    const semasa = String(kata.semasa.value);
    const baru = String(kata.baru.value);
    const salah = !semasa
      ? "Masukkan kata laluan semasa."
      : semakBaru(baru, String(kata.baru2.value));
    papar(salah);
    if (salah) return;
    const butang = kata.querySelector("button")!;
    butang.disabled = true;
    try {
      const res = await api("/me/password", {
        method: "PUT",
        body: JSON.stringify({ currentPassword: semasa, newPassword: baru }),
      });
      if (res.ok) {
        // Backend tamatkan semua sesi dan buang cookie.
        location.replace(
          `/login?next=${encodeURIComponent("/account/profil")}`,
        );
        return;
      }
      const body = await json(res);
      papar(
        ralatAm(res.status, body) ??
          (/current password/i.test(String(body.error ?? ""))
            ? "Kata laluan semasa salah."
            : res.status === 400
              ? "Kata laluan baru tak memenuhi syarat."
              : "Tak dapat tukar sekarang. Cuba sebentar lagi."),
      );
    } catch {
      papar("Tiada sambungan. Semak internet anda dan cuba lagi.");
    } finally {
      butang.disabled = false;
    }
  });
</script>
