---
// Larian kumpulan + RSVP (hono-workers /me/apps/nubi/events, migration 036). Semua akaun nampak
// senarai dan kiraan datang; ahli tekan "Saya datang"; admin Nubi cipta/ubah/padam dan nampak nama.
// Masa disimpan UTC; borang dan paparan ikut waktu Malaysia (UTC+8).
import AccountLayout from "../../layouts/AccountLayout.astro";
import Field from "../../components/ui/Field.astro";
import Alert from "../../components/ui/Alert.astro";
import DatePicker from "../../components/ui/DatePicker.astro";

const hariIni = new Date().toISOString().slice(0, 10);
---

<AccountLayout title="Larian kumpulan">
  <section class="card" aria-labelledby="t-acara">
    <h2 class="display card-title" id="t-acara">Larian kumpulan</h2>
    <p>
      Lari bersama komuniti. Tiada pace minimum - ada kumpulan untuk pemula.
    </p>
    <p id="bukan-ahli" hidden>
      Untuk tekan "Saya datang", anda perlu jadi ahli -
      <a href="/account/pricing">lihat keahlian</a>.
    </p>
    <Alert variant="danger" id="ralat" hidden />
    <ul class="acara" id="senarai" aria-live="polite">
      <li class="muted">Memuatkan…</li>
    </ul>
  </section>

  <section class="card" id="urus" aria-labelledby="t-urus" hidden>
    <h2 class="display card-title" id="t-urus">Tambah larian</h2>
    <form class="form" id="borang" novalidate>
      <input type="hidden" name="id" />
      <Field label="Tajuk">
        <input
          class="input"
          name="title"
          maxlength="120"
          required
          placeholder="cth. Larian Sabtu"
        />
      </Field>
      <Field label="Tarikh" for="tarikh-text">
        <DatePicker id="tarikh" name="tarikh" min={hariIni} />
      </Field>
      <Field label="Masa mula (waktu Malaysia)">
        <input class="input" type="time" name="jam" value="07:00" required />
      </Field>
      <Field label="Lokasi" hint="Titik kumpul - dibuka dalam Google Maps.">
        <input
          class="input"
          name="location"
          maxlength="200"
          required
          placeholder="cth. Pintu utama Taman Tasik Titiwangsa"
        />
      </Field>
      <Field label="Jarak (km, pilihan)">
        <input
          class="input"
          type="number"
          name="distanceKm"
          min="0.5"
          max="100"
          step="0.1"
          inputmode="decimal"
        />
      </Field>
      <Field label="Pace kumpulan (pilihan)">
        <input
          class="input"
          name="pace"
          maxlength="40"
          placeholder="cth. 7:00-8:00 /km"
        />
      </Field>
      <Field
        label="Had peserta (pilihan)"
        hint="Kosong = tiada had. Selepas larian mula, walk-in masih boleh RSVP."
      >
        <input
          class="input"
          type="number"
          name="capacity"
          min="1"
          max="1000"
          step="1"
          inputmode="numeric"
        />
      </Field>
      <Field label="Nota (pilihan)" hint="Apa perlu dibawa, sweeper, parkir.">
        <textarea class="input" name="notes" maxlength="1000" rows="3"
        ></textarea>
      </Field>
      <Alert variant="danger" id="ralat-borang" hidden />
      <div class="actions">
        <button class="btn btn-primary" type="submit">Simpan</button>
        <button class="btn btn-outline" type="button" id="batal-ubah" hidden
          >Batal ubah</button
        >
      </div>
    </form>
  </section>
</AccountLayout>

<script>
  import { api, json, commonError, currentUser } from "../../lib/api";
  import { confirmDialog } from "../../lib/confirm";
  import { buildIcs } from "../../lib/ics";

  interface Acara {
    id: number;
    title: string;
    startsAt: string;
    location: string;
    distanceKm: number | null;
    pace: string | null;
    notes: string | null;
    capacity: number | null;
    going: number;
    attended: number;
    mine: boolean;
    mineAttended: boolean;
  }

  const BASE = "/me/apps/nubi/events";
  const MY = { timeZone: "Asia/Kuala_Lumpur" } as const;
  const senarai = document.getElementById("senarai")!;
  const borang = document.getElementById("borang") as HTMLFormElement;
  const batalUbah = document.getElementById("batal-ubah") as HTMLButtonElement;
  const medan = (n: string) => borang.elements.namedItem(n) as HTMLInputElement;
  const papar = (id: string, teks: string | null) => {
    const el = document.getElementById(id)!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };
  const ralatDari = async (res: Response, body?: Record<string, any>) =>
    commonError(res.status, (body ??= await json(res))) ??
    (body.code === "event_full"
      ? "Larian ini sudah penuh."
      : res.status === 404
        ? "Larian ini sudah tamat atau dipadam."
        : "Tak dapat simpan sekarang. Cuba lagi sekejap.");

  // Pengawal sesi = AccountLayout; s null bermaksud page sedang dilencong ke /login.
  const s = await currentUser();
  const admin = s?.role === "owner" || s?.apps?.nubi === "admin";
  const ahli = admin || s?.apps?.nubi === "ahli";
  document.getElementById("urus")!.hidden = !admin;
  document.getElementById("bukan-ahli")!.hidden = !s || ahli;

  const bila = (iso: string) =>
    new Date(iso).toLocaleString("ms-MY", {
      ...MY,
      weekday: "long",
      day: "numeric",
      month: "long",
      hour: "numeric",
      minute: "2-digit",
    });
  const el = <K extends keyof HTMLElementTagNameMap>(
    tag: K,
    teks = "",
    kelas = "",
  ) => {
    const e = document.createElement(tag);
    e.textContent = teks;
    if (kelas) e.className = kelas;
    return e;
  };
  const butang = (teks: string, kelas: string, fn: () => void) => {
    const b = el("button", teks, `btn btn-sm ${kelas}`);
    b.type = "button";
    b.addEventListener("click", fn);
    return b;
  };

  const muatIcs = (a: Acara) => {
    const ics = buildIcs(
      [
        {
          uid: `acara-${a.id}`,
          mula: new Date(a.startsAt),
          minit: 90,
          tajuk: `Nubi Sport: ${a.title}`,
          keterangan: [a.location, a.pace && `Pace ${a.pace}`, a.notes]
            .filter(Boolean)
            .join("\n"),
        },
      ],
      { nama: "Nubi Sport · Larian kumpulan" },
    );
    const l = document.createElement("a");
    l.href = URL.createObjectURL(new Blob([ics], { type: "text/calendar" }));
    l.download = `nubi-larian-${a.id}.ics`;
    l.click();
    setTimeout(() => URL.revokeObjectURL(l.href), 60e3);
  };

  async function rsvp(a: Acara) {
    papar("ralat", null);
    const res = await api(`${BASE}/${a.id}/rsvp`, {
      method: a.mine ? "DELETE" : "PUT",
    }).catch(() => null);
    if (!res)
      return papar(
        "ralat",
        "Tiada sambungan. Semak internet anda dan cuba lagi.",
      );
    if (!res.ok) return papar("ralat", await ralatDari(res));
    await muat();
  }

  // Selepas mula: kotak semak hadir setiap RSVP (RSVP = niat; hadir = yang lencana kira). Dikunci 7 hari
  // selepas larian (backend 409). Walk-in tekan "Saya datang" di lokasi dulu, kemudian ditanda.
  const bermula = (a: Acara) => Date.now() >= Date.parse(a.startsAt);
  async function nama(a: Acara, kotak: HTMLElement) {
    const res = await api(`${BASE}/${a.id}/attendees`).catch(() => null);
    const items: { userId: number; name: string; attended: boolean }[] = res?.ok
      ? ((await json(res)).data?.items ?? [])
      : [];
    if (!items.length || !bermula(a)) {
      kotak.replaceChildren(
        el(
          "p",
          items.length
            ? items.map((i) => i.name).join(", ")
            : res?.ok
              ? "Belum ada."
              : "Tak dapat muat senarai nama.",
          "muted",
        ),
      );
      return;
    }
    const ralat = el("p", "", "muted");
    kotak.replaceChildren(
      el("p", "Tanda yang hadir:", "muted"),
      ...items.map((i) => {
        const label = el("label", "", "check");
        const kotakSemak = el("input");
        kotakSemak.type = "checkbox";
        kotakSemak.checked = i.attended;
        kotakSemak.addEventListener("change", async () => {
          kotakSemak.disabled = true;
          const r = await api(`${BASE}/${a.id}/attendance/${i.userId}`, {
            method: kotakSemak.checked ? "PUT" : "DELETE",
          }).catch(() => null);
          kotakSemak.disabled = false;
          if (r?.ok) return (ralat.textContent = "");
          kotakSemak.checked = !kotakSemak.checked;
          ralat.textContent =
            r?.status === 409
              ? "Kehadiran dikunci 7 hari selepas larian."
              : "Tak dapat simpan. Cuba lagi sekejap.";
        });
        label.append(kotakSemak, el("span", i.name, "check-label"));
        return label;
      }),
      ralat,
    );
  }

  async function padam(a: Acara) {
    const ya = await confirmDialog({
      title: "Padam larian?",
      message: `"${a.title}" dan semua RSVP (${a.going} orang) akan dipadam.`,
      confirmLabel: "Padam",
      danger: true,
    });
    if (!ya) return;
    const res = await api(`${BASE}/${a.id}`, { method: "DELETE" }).catch(
      () => null,
    );
    if (!res?.ok)
      return papar("ralat", res ? await ralatDari(res) : "Tiada sambungan.");
    await muat();
  }

  function ubah(a: Acara) {
    const myt = new Date(
      new Date(a.startsAt).getTime() + 8 * 3600e3,
    ).toISOString();
    medan("id").value = String(a.id);
    medan("title").value = a.title;
    medan("tarikh").value = myt.slice(0, 10);
    medan("tarikh").dispatchEvent(new Event("change"));
    medan("jam").value = myt.slice(11, 16);
    medan("location").value = a.location;
    medan("distanceKm").value =
      a.distanceKm == null ? "" : String(a.distanceKm);
    medan("pace").value = a.pace ?? "";
    medan("capacity").value = a.capacity == null ? "" : String(a.capacity);
    (borang.elements.namedItem("notes") as HTMLTextAreaElement).value =
      a.notes ?? "";
    batalUbah.hidden = false;
    document.getElementById("t-urus")!.textContent = "Ubah larian";
    borang.scrollIntoView({ behavior: "smooth" });
  }

  function kad(a: Acara): HTMLLIElement {
    const li = el("li");
    li.append(el("h3", a.title), el("p", bila(a.startsAt), "bila"));
    const lokasi = el("a", a.location);
    lokasi.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(a.location)}`;
    lokasi.target = "_blank";
    lokasi.rel = "noopener noreferrer";
    const p = el("p");
    p.append("📍 ", lokasi);
    li.append(p);
    const butir = [
      a.distanceKm && `${a.distanceKm} km`,
      a.pace && `pace ${a.pace}`,
    ]
      .filter(Boolean)
      .join(" · ");
    if (butir) li.append(el("p", butir, "muted"));
    if (a.notes) li.append(el("p", a.notes, "nota"));
    const tutup = Date.now() > Date.parse(a.startsAt) + 3 * 3600e3; // admin /recent sahaja
    li.append(
      el(
        "p",
        `${a.going}${a.capacity ? `/${a.capacity}` : ""} orang RSVP` +
          (bermula(a) ? ` · ${a.attended} hadir` : "") +
          (a.mineAttended
            ? " · anda hadir ✓"
            : a.mine
              ? " (termasuk anda)"
              : "") +
          (tutup ? " · selesai" : ""),
        "kiraan",
      ),
    );
    const tindakan = el("div", "", "actions");
    // Penuh: sebelum mula sahaja (backend kuatkuasa yang sama); yang dah RSVP masih boleh batal.
    const penuh =
      !!a.capacity && a.going >= a.capacity && !a.mine && !bermula(a);
    if (penuh) tindakan.append(el("span", "Penuh", "muted"));
    else if (ahli && !tutup && !a.mineAttended)
      tindakan.append(
        butang(
          a.mine ? "Batal datang" : "Saya datang",
          a.mine ? "btn-outline" : "btn-primary",
          () => rsvp(a),
        ),
      );
    if (!tutup)
      tindakan.append(
        butang("Tambah ke kalendar", "btn-outline", () => muatIcs(a)),
      );
    if (admin) {
      const kotak = el("div");
      tindakan.append(
        butang(bermula(a) ? "Tanda hadir" : "Siapa datang", "btn-outline", () =>
          nama(a, kotak),
        ),
        butang("Ubah", "btn-outline", () => ubah(a)),
        butang("Padam", "btn-bahaya", () => padam(a)),
      );
      li.append(tindakan, kotak);
    } else li.append(tindakan);
    return li;
  }

  async function muat() {
    // Admin: termasuk 7 hari lepas, untuk tanda hadir.
    const res = await api(admin ? `${BASE}/recent` : BASE).catch(() => null);
    if (!res?.ok) {
      senarai.replaceChildren(
        el("li", "Tak dapat muat larian sekarang. Cuba lagi sekejap.", "muted"),
      );
      return;
    }
    const items: Acara[] = (await json(res)).data?.items ?? [];
    senarai.replaceChildren(
      ...(items.length
        ? items.map(kad)
        : [
            el(
              "li",
              "Belum ada larian dijadualkan. Semak semula nanti.",
              "muted",
            ),
          ]),
    );
  }

  const kosongkan = () => {
    borang.reset();
    medan("id").value = "";
    medan("tarikh").value = "";
    medan("tarikh").dispatchEvent(new Event("change"));
    batalUbah.hidden = true;
    document.getElementById("t-urus")!.textContent = "Tambah larian";
    papar("ralat-borang", null);
  };
  batalUbah.addEventListener("click", kosongkan);

  borang.addEventListener("submit", async (e) => {
    e.preventDefault();
    const tarikh = medan("tarikh").value;
    const jam = medan("jam").value;
    const title = medan("title").value.trim();
    const location = medan("location").value.trim();
    const km = medan("distanceKm").value;
    const salah = !title
      ? "Masukkan tajuk."
      : !/^\d{4}-\d{2}-\d{2}$/.test(tarikh) || !/^\d{2}:\d{2}$/.test(jam)
        ? "Pilih tarikh dan masa mula."
        : !location
          ? "Masukkan lokasi."
          : null;
    papar("ralat-borang", salah);
    if (salah) return;
    const body = {
      title,
      startsAt: new Date(`${tarikh}T${jam}:00+08:00`)
        .toISOString()
        .replace(/\.\d{3}Z$/, "Z"),
      location,
      distanceKm: km ? Number(km) : null,
      pace: medan("pace").value.trim() || null,
      capacity: medan("capacity").value
        ? Number(medan("capacity").value)
        : null,
      notes:
        (
          borang.elements.namedItem("notes") as HTMLTextAreaElement
        ).value.trim() || null,
    };
    const id = medan("id").value;
    const b = borang.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    b.disabled = true;
    try {
      const res = await api(id ? `${BASE}/${id}` : BASE, {
        method: id ? "PUT" : "POST",
        body: JSON.stringify(body),
      });
      if (!res.ok) return papar("ralat-borang", await ralatDari(res));
      kosongkan();
      await muat();
    } catch {
      papar(
        "ralat-borang",
        "Tiada sambungan. Semak internet anda dan cuba lagi.",
      );
    } finally {
      b.disabled = false;
    }
  });

  if (s) await muat();
</script>

<style>
  .acara {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .acara > li:not(.muted) {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 1.25rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .acara h3 {
    margin: 0;
    color: var(--navy);
  }
  .acara .bila {
    color: var(--ink);
    font-weight: 600;
  }
  .acara .nota {
    white-space: pre-line;
  }
  .acara .kiraan {
    color: var(--ink);
  }
  #urus {
    margin-top: 1.5rem;
  }
</style>
