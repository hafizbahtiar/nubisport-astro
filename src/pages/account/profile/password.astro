---
// Profil Nubi - Keselamatan: tukar kata laluan (PUT /me/password), sesi log masuk (GET/DELETE
// /me/sessions, kedua-dua app) + zon bahaya (DELETE /me, PDPA).
// Tukar berjaya = backend tamatkan semua sesi (Nubi + hafizbahtiar.com), jadi terus ke /login.
// URL kekal /password supaya pautan lama tak patah.
import ProfileShell from "../../../components/ProfileShell.astro";
import Field from "../../../components/ui/Field.astro";
import Alert from "../../../components/ui/Alert.astro";
---

<ProfileShell title="Keselamatan">
  <section class="panel" aria-labelledby="t-kata">
    <h2 class="display" id="t-kata">Tukar kata laluan</h2>
    <!-- Satu kolum sempit: semasa -> baru (+ meter kekuatan terus di bawahnya) -> ulang (+ padan). -->
    <form class="form form-sempit" id="kata" novalidate>
      <Field label="Kata laluan semasa">
        <input
          class="input"
          type="password"
          name="semasa"
          autocomplete="current-password"
          required
        />
      </Field>
      <Field label="Kata laluan baru">
        <input
          class="input"
          type="password"
          name="baru"
          autocomplete="new-password"
          minlength="12"
          maxlength="200"
          aria-describedby="kekuatan-teks kekuatan-syarat"
          required
        />
      </Field>
      <div class="kekuatan" id="kekuatan" data-tahap="0">
        <div class="kekuatan-bar" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </div>
        <p class="kekuatan-teks" id="kekuatan-teks" aria-live="polite">
          Kekuatan: <strong id="kekuatan-label">-</strong>
        </p>
        <ul class="kekuatan-syarat" id="kekuatan-syarat">
          <li data-syarat="panjang">Sekurang-kurangnya 12 aksara</li>
          <li data-syarat="besar">Satu huruf besar</li>
          <li data-syarat="kecil">Satu huruf kecil</li>
          <li data-syarat="nombor">Satu nombor</li>
        </ul>
      </div>
      <Field label="Ulang kata laluan baru">
        <input
          class="input"
          type="password"
          name="baru2"
          autocomplete="new-password"
          aria-describedby="padan"
          required
        />
        <small class="field-hint padan" id="padan" aria-live="polite"></small>
      </Field>
      <Alert variant="danger" id="mesej-kata" hidden />
      <p class="muted nota">
        Lepas ditukar, semua sesi (di Nubi Sport dan hafizbahtiar.com)
        ditamatkan - log masuk semula.
      </p>
      <button class="btn btn-primary" type="submit">Tukar kata laluan</button>
    </form>
  </section>

  <section class="panel" aria-labelledby="t-sessions">
    <h2 class="display" id="t-sessions">Sesi log masuk</h2>
    <p class="muted">
      Peranti yang sedang log masuk ke akaun anda, di Nubi Sport dan
      hafizbahtiar.com. Tak kenal satu? Tamatkan, kemudian tukar kata laluan.
    </p>
    <Alert variant="danger" id="sessions-error" hidden />
    <ul class="sessions" id="sessions" aria-live="polite">
      <li class="muted">Memuat…</li>
    </ul>
  </section>

  <section class="panel" aria-labelledby="t-bahaya">
    <h2 class="display" id="t-bahaya">Zon bahaya</h2>
    <p class="muted">
      Padam data aktiviti sahaja (fail, ringkasan dan persetujuan), atau padam
      akaun dan semua data. Tindakan di sini tak boleh dibatalkan.
    </p>
    <Alert variant="success" id="ok-aktiviti" hidden />
    <Alert variant="danger" id="mesej-aktiviti" hidden />
    <Alert variant="danger" id="mesej-padam" hidden />
    <div class="actions">
      <button class="btn btn-outline" type="button" id="padam-aktiviti">
        Padam data aktiviti
      </button>
      <button class="btn btn-bahaya" type="button" id="padam-akaun">
        Padam akaun
      </button>
    </div>
  </section>
</ProfileShell>

<script>
  import { api, json, commonError, currentUser } from "../../../lib/api";
  import { confirmDialog } from "../../../lib/confirm";
  import { ticksFrom, offerUntick } from "../../../lib/plan-sync";

  const kata = document.getElementById("kata") as HTMLFormElement;
  const papar = (id: string, teks: string | null) => {
    const el = document.getElementById(id)!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };

  // Syarat wajib = PasswordUpdateSchema backend + had daftar Nubi (12-200).
  const syarat = {
    panjang: (v: string) => v.length >= 12,
    besar: (v: string) => /[A-Z]/.test(v),
    kecil: (v: string) => /[a-z]/.test(v),
    nombor: (v: string) => /[0-9]/.test(v),
  };
  const TAHAP = [
    "-",
    "Sangat lemah",
    "Lemah",
    "Sederhana",
    "Kuat",
    "Sangat kuat",
  ];
  const kekuatan = document.getElementById("kekuatan")!;
  const kekuatanLabel = document.getElementById("kekuatan-label")!;
  const medanBaru = kata.elements.namedItem("baru") as HTMLInputElement;
  const medanUlang = kata.elements.namedItem("baru2") as HTMLInputElement;
  const padan = document.getElementById("padan")!;

  // Selagi syarat wajib belum cukup, paling tinggi "Lemah" - jangan tunjuk "Kuat" untuk
  // kata laluan yang backend akan tolak. Cukup syarat = Sederhana, +1 untuk 16+ aksara, +1 simbol.
  const ukur = () => {
    const v = medanBaru.value;
    let lulus = 0;
    for (const [nama, uji] of Object.entries(syarat)) {
      const ok = uji(v);
      if (ok) lulus++;
      kekuatan
        .querySelector(`[data-syarat="${nama}"]`)!
        .toggleAttribute("data-ok", ok);
    }
    const bonus = (v.length >= 16 ? 1 : 0) + (/[^A-Za-z0-9]/.test(v) ? 1 : 0);
    const tahap = !v ? 0 : lulus < 4 ? (lulus === 3 ? 2 : 1) : 3 + bonus;
    kekuatan.dataset.tahap = String(tahap);
    kekuatanLabel.textContent = TAHAP[tahap];
  };
  // Padanan ulang: senyap selagi medan ulang kosong.
  const semakPadan = () => {
    const ulang = medanUlang.value;
    const sama = !!ulang && ulang === medanBaru.value;
    padan.textContent = !ulang ? "" : sama ? "✓ Sama" : "✗ Belum sama";
    padan.dataset.ok = String(sama);
  };
  medanBaru.addEventListener("input", () => (ukur(), semakPadan()));
  medanUlang.addEventListener("input", semakPadan);
  ukur();

  const semakBaru = (pw: string, pw2: string) => {
    if (pw.length < 12 || pw.length > 200)
      return "Kata laluan baru mesti 12 hingga 200 aksara.";
    if (!syarat.besar(pw) || !syarat.kecil(pw) || !syarat.nombor(pw))
      return "Kata laluan baru mesti ada huruf besar, huruf kecil dan nombor.";
    if (pw !== pw2) return "Kata laluan baru tak sama.";
    return null;
  };

  kata.addEventListener("submit", async (e) => {
    e.preventDefault();
    const semasa = String(kata.semasa.value);
    const baru = String(kata.baru.value);
    const salah = !semasa
      ? "Masukkan kata laluan semasa."
      : semakBaru(baru, String(kata.baru2.value));
    papar("mesej-kata", salah);
    if (salah) return;
    const butang = kata.querySelector("button")!;
    butang.disabled = true;
    try {
      const res = await api("/me/password", {
        method: "PUT",
        body: JSON.stringify({ currentPassword: semasa, newPassword: baru }),
      });
      if (res.ok) {
        // Backend tamatkan semua sesi dan buang cookie.
        location.replace(
          `/login?next=${encodeURIComponent("/account/profile")}`,
        );
        return;
      }
      const body = await json(res);
      papar(
        "mesej-kata",
        commonError(res.status, body) ??
          (/current password/i.test(String(body.error ?? ""))
            ? "Kata laluan semasa salah."
            : res.status === 400
              ? "Kata laluan baru tak cukup syarat."
              : "Tak dapat tukar sekarang. Cuba lagi sekejap."),
      );
    } catch {
      papar(
        "mesej-kata",
        "Tiada sambungan. Semak internet anda dan cuba lagi.",
      );
    } finally {
      butang.disabled = false;
    }
  });

  const padamAktiviti = document.getElementById(
    "padam-aktiviti",
  ) as HTMLButtonElement;
  padamAktiviti.addEventListener("click", async () => {
    papar("ok-aktiviti", null);
    papar("mesej-aktiviti", null);
    const ya = await confirmDialog({
      title: "Padam semua data aktiviti?",
      message:
        "Semua aktiviti, fail asal dan rekod persetujuan anda akan dibuang daripada Nubi Sport. Muat naik seterusnya akan minta persetujuan semula. Tindakan ini tak boleh dibatalkan.",
      confirmLabel: "Padam semua",
      danger: true,
    });
    if (!ya) return padamAktiviti.focus();
    padamAktiviti.disabled = true;
    try {
      const tanda = await ticksFrom("semua").catch(() => null);
      const res = await api("/me/apps/nubi/activities", { method: "DELETE" });
      if (!res.ok) {
        papar(
          "mesej-aktiviti",
          "Data tak dapat dipadam. Semak sambungan dan cuba lagi.",
        );
        return;
      }
      await offerUntick(tanda);
      papar(
        "ok-aktiviti",
        "Data aktiviti dipadam. Persetujuan aktiviti juga ditarik balik.",
      );
    } catch {
      papar(
        "mesej-aktiviti",
        "Tiada sambungan. Semak internet anda dan cuba lagi.",
      );
    } finally {
      padamAktiviti.disabled = false;
    }
  });

  // Pengawal sesi = AccountLayout; s null bermaksud page sedang dilencong ke /login.
  const s = await currentUser();
  const padam = document.getElementById("padam-akaun") as HTMLButtonElement;
  padam.addEventListener("click", async () => {
    papar("mesej-padam", null);
    if (s?.role === "owner")
      return papar("mesej-padam", "Akaun pemilik tak boleh dipadam.");
    const dipadam = await confirmDialog({
      title: "Padam akaun?",
      message:
        "Akaun anda akan dipadam untuk selamanya: profil, maklumat latihan, pelan yang disimpan, aktiviti dan fail Strava. Log masuk dikongsi dengan hafizbahtiar.com, jadi akaun di sana juga dipadam. Masukkan kata laluan untuk sahkan.",
      confirmLabel: "Padam akaun",
      danger: true,
      passwordLabel: "Kata laluan",
      action: async (password) => {
        if (!password) return "Masukkan kata laluan anda.";
        const res = await api("/me", {
          method: "DELETE",
          body: JSON.stringify({ password }),
        });
        if (res.ok) return null;
        const body = await json(res);
        return (
          commonError(res.status, body) ??
          (body.code === "owner_account"
            ? "Akaun pemilik tak boleh dipadam."
            : res.status === 400
              ? "Kata laluan salah."
              : "Tak dapat padam sekarang. Cuba lagi sekejap.")
        );
      },
    });
    if (!dipadam) return padam.focus();
    // Semua storan laman ini milik Nubi (pelan, progres, MAF, lokasi) - buang semuanya.
    localStorage.clear();
    sessionStorage.clear();
    document.cookie = "session_active=; Max-Age=0; path=/";
    location.replace("/?akaun=dipadam");
  });
</script>

<script>
  import { api, json, commonError } from "../../../lib/api";
  import { confirmDialog } from "../../../lib/confirm";

  interface Session {
    id: string;
    app: "portfolio" | "nubi";
    userAgent: string | null;
    country: string | null;
    lastSeenAt: string | null;
    createdAt: string;
    current: boolean;
  }

  const list = document.getElementById("sessions")!;
  const errorBox = document.getElementById("sessions-error")!;
  const APP_NAMES = { nubi: "Nubi Sport", portfolio: "hafizbahtiar.com" };
  const formatTime = (iso: string) =>
    new Date(iso).toLocaleString("ms-MY", {
      timeZone: "Asia/Kuala_Lumpur",
      dateStyle: "medium",
      timeStyle: "short",
    });
  let regionNames: Intl.DisplayNames | null = null;
  try {
    regionNames = new Intl.DisplayNames(["ms"], { type: "region" });
  } catch {}

  // Rough guess from the user agent - enough to tell "my phone" from "the office PC".
  const deviceLabel = (ua: string | null) => {
    if (!ua) return "Peranti tidak diketahui";
    const browser = /Edg\//.test(ua) ? "Edge"
      : /Firefox\//.test(ua) ? "Firefox"
      : /Chrome\//.test(ua) ? "Chrome"
      : /Safari\//.test(ua) ? "Safari" : "Pelayar";
    const os = /iPhone/.test(ua) ? "iPhone"
      : /iPad/.test(ua) ? "iPad"
      : /Android/.test(ua) ? "Android"
      : /Windows/.test(ua) ? "Windows"
      : /Mac OS X/.test(ua) ? "Mac"
      : /Linux/.test(ua) ? "Linux" : "";
    return os ? `${browser} di ${os}` : browser;
  };

  const countryName = (code: string | null) => {
    if (!code) return "";
    try {
      return regionNames?.of(code) ?? code;
    } catch {
      return code;
    }
  };

  const render = (items: Session[]) => {
    list.replaceChildren(
      ...items.map((s) => {
        const row = document.createElement("li");
        const text = document.createElement("div");
        const name = document.createElement("strong");
        name.textContent = deviceLabel(s.userAgent);
        const details = document.createElement("span");
        details.className = "muted";
        details.textContent = [
          APP_NAMES[s.app] ?? s.app,
          countryName(s.country),
          `aktif ${formatTime(s.lastSeenAt ?? s.createdAt)}`,
        ].filter(Boolean).join(" · ");
        text.append(name, details);
        row.append(text);
        if (s.current) {
          const tag = document.createElement("span");
          tag.className = "session-current";
          tag.textContent = "Peranti ini";
          row.append(tag);
        } else {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "btn btn-outline btn-sm";
          button.textContent = "Tamatkan";
          button.addEventListener("click", () => endSession(s, button));
          row.append(button);
        }
        return row;
      }),
    );
  };

  const load = async () => {
    const res = await api("/me/sessions").catch(() => null);
    const body = res ? await json(res) : {};
    if (!res?.ok) {
      list.replaceChildren();
      errorBox.textContent = "Tak dapat muat sesi sekarang. Muat semula page.";
      errorBox.hidden = false;
      return;
    }
    render(body.data as Session[]);
  };

  const endSession = async (s: Session, button: HTMLButtonElement) => {
    const confirmed = await confirmDialog({
      title: "Tamatkan sesi?",
      message: `${deviceLabel(s.userAgent)} (${APP_NAMES[s.app] ?? s.app}) akan dilog keluar.`,
      confirmLabel: "Tamatkan",
      danger: true,
    });
    if (!confirmed) return;
    button.disabled = true;
    errorBox.hidden = true;
    const res = await api(`/me/sessions/${encodeURIComponent(s.id)}`, {
      method: "DELETE",
    }).catch(() => null);
    // 404 = that session already ended on its own - same result.
    if (res && (res.ok || res.status === 404)) return load();
    button.disabled = false;
    errorBox.textContent =
      (res && commonError(res.status, await json(res))) ??
      "Tak dapat tamatkan sesi sekarang. Cuba lagi.";
    errorBox.hidden = false;
  };

  load();
</script>

<style>
  .sessions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .sessions li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper-2);
    border-radius: var(--radius);
  }
  .sessions li > div {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .sessions li span.muted {
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .session-current {
    flex: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--success-ink);
  }
  .padan:empty {
    display: none;
  }
  .padan[data-ok="true"] {
    color: var(--success-ink);
  }
  .padan[data-ok="false"] {
    color: var(--danger-ink);
  }
  .nota {
    font-size: 0.88rem;
  }
  /* Meter melekat pada medan "baru" di atasnya (jarak lebih kecil daripada antara medan). */
  .kekuatan {
    display: grid;
    gap: 0.45rem;
    margin-top: -0.6rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper-2);
    border-radius: var(--radius);
  }
  .kekuatan-bar {
    display: flex;
    gap: 0.35rem;
  }
  .kekuatan-bar i {
    flex: 1;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--line);
  }
  .kekuatan-teks {
    margin: 0;
    font-size: 0.9rem;
  }
  .kekuatan-syarat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.15rem 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .kekuatan-syarat li::before {
    content: "• ";
  }
  .kekuatan-syarat li[data-ok] {
    color: var(--success-ink);
  }
  .kekuatan-syarat li[data-ok]::before {
    content: "✓ ";
  }
  .kekuatan[data-tahap="1"] .kekuatan-bar i:nth-child(-n + 1),
  .kekuatan[data-tahap="2"] .kekuatan-bar i:nth-child(-n + 2) {
    background: var(--danger-ink);
  }
  .kekuatan[data-tahap="3"] .kekuatan-bar i:nth-child(-n + 3) {
    background: #b45309;
  }
  .kekuatan[data-tahap="4"] .kekuatan-bar i:nth-child(-n + 4) {
    background: #15803d;
  }
  .kekuatan[data-tahap="5"] .kekuatan-bar i:nth-child(-n + 5) {
    background: var(--success-ink);
  }
  .kekuatan[data-tahap="1"] .kekuatan-teks strong,
  .kekuatan[data-tahap="2"] .kekuatan-teks strong {
    color: var(--danger-ink);
  }
  .kekuatan[data-tahap="3"] .kekuatan-teks strong {
    color: #b45309;
  }
  .kekuatan[data-tahap="4"] .kekuatan-teks strong {
    color: #15803d;
  }
  .kekuatan[data-tahap="5"] .kekuatan-teks strong {
    color: var(--success-ink);
  }
</style>
