---
// Profil Nubi - Keselamatan: tukar kata laluan (PUT /me/password) + zon bahaya (DELETE /me, PDPA).
// Tukar berjaya = backend tamatkan semua sesi (Nubi + hafizbahtiar.com), jadi terus ke /login.
// URL kekal /password supaya pautan lama tak patah.
import ProfileShell from "../../../components/ProfileShell.astro";
import Field from "../../../components/ui/Field.astro";
import Alert from "../../../components/ui/Alert.astro";
---

<ProfileShell title="Keselamatan">
  <section class="panel" aria-labelledby="t-kata">
    <h2 class="display" id="t-kata">Tukar kata laluan</h2>
    <form class="form" id="kata" novalidate>
      <!-- .form-group = satu baris penuh; baru + ulang berpasangan di bawahnya (skrin lebar). -->
      <div class="form-group">
        <Field label="Kata laluan semasa">
          <input
            class="input"
            type="password"
            name="semasa"
            autocomplete="current-password"
            required
          />
        </Field>
      </div>
      <Field label="Kata laluan baru">
        <input
          class="input"
          type="password"
          name="baru"
          autocomplete="new-password"
          minlength="12"
          maxlength="200"
          aria-describedby="kekuatan-teks kekuatan-syarat"
          required
        />
      </Field>
      <Field label="Ulang kata laluan baru">
        <input
          class="input"
          type="password"
          name="baru2"
          autocomplete="new-password"
          aria-describedby="padan"
          required
        />
        <small class="field-hint padan" id="padan" aria-live="polite"></small>
      </Field>
      <div class="form-group kekuatan" id="kekuatan" data-tahap="0">
        <div class="kekuatan-bar" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </div>
        <p class="kekuatan-teks" id="kekuatan-teks" aria-live="polite">
          Kekuatan: <strong id="kekuatan-label">-</strong>
        </p>
        <ul class="kekuatan-syarat" id="kekuatan-syarat">
          <li data-syarat="panjang">Sekurang-kurangnya 12 aksara</li>
          <li data-syarat="besar">Satu huruf besar</li>
          <li data-syarat="kecil">Satu huruf kecil</li>
          <li data-syarat="nombor">Satu nombor</li>
        </ul>
      </div>
      <Alert variant="danger" id="mesej-kata" hidden />
      <p class="muted">
        Lepas ditukar, semua sesi (di Nubi Sport dan hafizbahtiar.com)
        ditamatkan - log masuk semula.
      </p>
      <button class="btn btn-primary" type="submit">Tukar kata laluan</button>
    </form>
  </section>

  <section class="panel" aria-labelledby="t-bahaya">
    <h2 class="display" id="t-bahaya">Zon bahaya</h2>
    <p class="muted">
      Padam akaun anda dan semua data yang disimpan untuknya. Tak boleh
      dibatalkan.
    </p>
    <Alert variant="danger" id="mesej-padam" hidden />
    <div class="actions">
      <button class="btn btn-bahaya" type="button" id="padam-akaun">
        Padam akaun
      </button>
    </div>
  </section>
</ProfileShell>

<script>
  import { api, json, commonError, currentUser } from "../../../lib/api";
  import { confirmDialog } from "../../../lib/confirm";

  const kata = document.getElementById("kata") as HTMLFormElement;
  const papar = (id: string, teks: string | null) => {
    const el = document.getElementById(id)!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };

  // Syarat wajib = PasswordUpdateSchema backend + had daftar Nubi (12-200).
  const syarat = {
    panjang: (v: string) => v.length >= 12,
    besar: (v: string) => /[A-Z]/.test(v),
    kecil: (v: string) => /[a-z]/.test(v),
    nombor: (v: string) => /[0-9]/.test(v),
  };
  const TAHAP = [
    "-",
    "Sangat lemah",
    "Lemah",
    "Sederhana",
    "Kuat",
    "Sangat kuat",
  ];
  const kekuatan = document.getElementById("kekuatan")!;
  const kekuatanLabel = document.getElementById("kekuatan-label")!;
  const medanBaru = kata.elements.namedItem("baru") as HTMLInputElement;
  const medanUlang = kata.elements.namedItem("baru2") as HTMLInputElement;
  const padan = document.getElementById("padan")!;

  // Selagi syarat wajib belum cukup, paling tinggi "Lemah" - jangan tunjuk "Kuat" untuk
  // kata laluan yang backend akan tolak. Cukup syarat = Sederhana, +1 untuk 16+ aksara, +1 simbol.
  const ukur = () => {
    const v = medanBaru.value;
    let lulus = 0;
    for (const [nama, uji] of Object.entries(syarat)) {
      const ok = uji(v);
      if (ok) lulus++;
      kekuatan
        .querySelector(`[data-syarat="${nama}"]`)!
        .toggleAttribute("data-ok", ok);
    }
    const bonus = (v.length >= 16 ? 1 : 0) + (/[^A-Za-z0-9]/.test(v) ? 1 : 0);
    const tahap = !v ? 0 : lulus < 4 ? (lulus === 3 ? 2 : 1) : 3 + bonus;
    kekuatan.dataset.tahap = String(tahap);
    kekuatanLabel.textContent = TAHAP[tahap];
  };
  // Padanan ulang: senyap selagi medan ulang kosong.
  const semakPadan = () => {
    const ulang = medanUlang.value;
    const sama = !!ulang && ulang === medanBaru.value;
    padan.textContent = !ulang ? "" : sama ? "✓ Sama" : "✗ Belum sama";
    padan.dataset.ok = String(sama);
  };
  medanBaru.addEventListener("input", () => (ukur(), semakPadan()));
  medanUlang.addEventListener("input", semakPadan);
  ukur();

  const semakBaru = (pw: string, pw2: string) => {
    if (pw.length < 12 || pw.length > 200)
      return "Kata laluan baru mesti 12 hingga 200 aksara.";
    if (!syarat.besar(pw) || !syarat.kecil(pw) || !syarat.nombor(pw))
      return "Kata laluan baru mesti ada huruf besar, huruf kecil dan nombor.";
    if (pw !== pw2) return "Kata laluan baru tak sama.";
    return null;
  };

  kata.addEventListener("submit", async (e) => {
    e.preventDefault();
    const semasa = String(kata.semasa.value);
    const baru = String(kata.baru.value);
    const salah = !semasa
      ? "Masukkan kata laluan semasa."
      : semakBaru(baru, String(kata.baru2.value));
    papar("mesej-kata", salah);
    if (salah) return;
    const butang = kata.querySelector("button")!;
    butang.disabled = true;
    try {
      const res = await api("/me/password", {
        method: "PUT",
        body: JSON.stringify({ currentPassword: semasa, newPassword: baru }),
      });
      if (res.ok) {
        // Backend tamatkan semua sesi dan buang cookie.
        location.replace(
          `/login?next=${encodeURIComponent("/account/profile")}`,
        );
        return;
      }
      const body = await json(res);
      papar(
        "mesej-kata",
        commonError(res.status, body) ??
          (/current password/i.test(String(body.error ?? ""))
            ? "Kata laluan semasa salah."
            : res.status === 400
              ? "Kata laluan baru tak cukup syarat."
              : "Tak dapat tukar sekarang. Cuba lagi sekejap."),
      );
    } catch {
      papar(
        "mesej-kata",
        "Tiada sambungan. Semak internet anda dan cuba lagi.",
      );
    } finally {
      butang.disabled = false;
    }
  });

  // Pengawal sesi = AccountLayout; s null bermaksud page sedang dilencong ke /login.
  const s = await currentUser();
  const padam = document.getElementById("padam-akaun") as HTMLButtonElement;
  padam.addEventListener("click", async () => {
    papar("mesej-padam", null);
    if (s?.role === "owner")
      return papar("mesej-padam", "Akaun pemilik tak boleh dipadam.");
    const dipadam = await confirmDialog({
      title: "Padam akaun?",
      message:
        "Akaun anda akan dipadam untuk selamanya: profil, maklumat latihan, pelan yang disimpan, aktiviti dan fail Strava. Log masuk dikongsi dengan hafizbahtiar.com, jadi akaun di sana juga dipadam. Masukkan kata laluan untuk sahkan.",
      confirmLabel: "Padam akaun",
      danger: true,
      passwordLabel: "Kata laluan",
      action: async (password) => {
        if (!password) return "Masukkan kata laluan anda.";
        const res = await api("/me", {
          method: "DELETE",
          body: JSON.stringify({ password }),
        });
        if (res.ok) return null;
        const body = await json(res);
        return (
          commonError(res.status, body) ??
          (body.code === "owner_account"
            ? "Akaun pemilik tak boleh dipadam."
            : res.status === 400
              ? "Kata laluan salah."
              : "Tak dapat padam sekarang. Cuba lagi sekejap.")
        );
      },
    });
    if (!dipadam) return padam.focus();
    // Semua storan laman ini milik Nubi (pelan, progres, MAF, lokasi) - buang semuanya.
    localStorage.clear();
    sessionStorage.clear();
    document.cookie = "session_active=; Max-Age=0; path=/";
    location.replace("/?akaun=dipadam");
  });
</script>

<style>
  .padan:empty {
    display: none;
  }
  .padan[data-ok="true"] {
    color: var(--success-ink);
  }
  .padan[data-ok="false"] {
    color: var(--danger-ink);
  }
  .kekuatan {
    gap: 0.5rem;
  }
  .kekuatan-bar {
    display: flex;
    gap: 0.35rem;
  }
  .kekuatan-bar i {
    flex: 1;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--line);
  }
  .kekuatan-teks {
    margin: 0;
    font-size: 0.9rem;
  }
  .kekuatan-syarat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.15rem 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .kekuatan-syarat li::before {
    content: "• ";
  }
  .kekuatan-syarat li[data-ok] {
    color: var(--success-ink);
  }
  .kekuatan-syarat li[data-ok]::before {
    content: "✓ ";
  }
  .kekuatan[data-tahap="1"] .kekuatan-bar i:nth-child(-n + 1),
  .kekuatan[data-tahap="2"] .kekuatan-bar i:nth-child(-n + 2) {
    background: var(--danger-ink);
  }
  .kekuatan[data-tahap="3"] .kekuatan-bar i:nth-child(-n + 3) {
    background: #b45309;
  }
  .kekuatan[data-tahap="4"] .kekuatan-bar i:nth-child(-n + 4) {
    background: #15803d;
  }
  .kekuatan[data-tahap="5"] .kekuatan-bar i:nth-child(-n + 5) {
    background: var(--success-ink);
  }
  .kekuatan[data-tahap="1"] .kekuatan-teks strong,
  .kekuatan[data-tahap="2"] .kekuatan-teks strong {
    color: var(--danger-ink);
  }
  .kekuatan[data-tahap="3"] .kekuatan-teks strong {
    color: #b45309;
  }
  .kekuatan[data-tahap="4"] .kekuatan-teks strong {
    color: #15803d;
  }
  .kekuatan[data-tahap="5"] .kekuatan-teks strong {
    color: var(--success-ink);
  }
</style>
