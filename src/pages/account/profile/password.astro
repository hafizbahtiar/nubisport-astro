---
// Profil Nubi - Kata laluan (PUT /me/password). Berjaya = backend tamatkan semua sesi
// (Nubi + hafizbahtiar.com), jadi terus ke /login.
import ProfileShell from "../../../components/ProfileShell.astro";
import Field from "../../../components/ui/Field.astro";
import Alert from "../../../components/ui/Alert.astro";
---

<ProfileShell title="Kata laluan">
  <section class="panel" aria-labelledby="t-kata">
    <h2 class="display" id="t-kata">Tukar kata laluan</h2>
    <form class="form" id="kata" novalidate>
      <Field label="Kata laluan semasa">
        <input
          class="input"
          type="password"
          name="semasa"
          autocomplete="current-password"
          required
        />
      </Field>
      <Field
        label="Kata laluan baru"
        hint="12 hingga 200 aksara, ada huruf besar, huruf kecil dan nombor."
      >
        <input
          class="input"
          type="password"
          name="baru"
          autocomplete="new-password"
          minlength="12"
          maxlength="200"
          required
        />
      </Field>
      <div class="form-group kekuatan" id="kekuatan" data-tahap="0">
        <div class="kekuatan-bar" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </div>
        <p class="kekuatan-teks" aria-live="polite">
          Kekuatan: <strong id="kekuatan-label">Sangat lemah</strong>
        </p>
        <ul class="kekuatan-syarat">
          <li data-syarat="panjang">Sekurang-kurangnya 12 aksara</li>
          <li data-syarat="besar">Satu huruf besar</li>
          <li data-syarat="kecil">Satu huruf kecil</li>
          <li data-syarat="nombor">Satu nombor</li>
        </ul>
      </div>
      <Field label="Ulang kata laluan baru">
        <input
          class="input"
          type="password"
          name="baru2"
          autocomplete="new-password"
          required
        />
      </Field>
      <Alert variant="danger" id="mesej-kata" hidden />
      <p class="muted">
        Lepas ditukar, semua sesi (di Nubi Sport dan hafizbahtiar.com)
        ditamatkan - log masuk semula.
      </p>
      <button class="btn btn-primary" type="submit">Tukar kata laluan</button>
    </form>
  </section>
</ProfileShell>

<script>
  import { api, json, commonError } from "../../../lib/api";

  const kata = document.getElementById("kata") as HTMLFormElement;
  const papar = (teks: string | null) => {
    const el = document.getElementById("mesej-kata")!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };

  // Indikator kekuatan: syarat wajib backend/policy + bonus panjang atau simbol.
  const syarat = {
    panjang: (v: string) => v.length >= 12,
    besar: (v: string) => /[A-Z]/.test(v),
    kecil: (v: string) => /[a-z]/.test(v),
    nombor: (v: string) => /[0-9]/.test(v),
  };
  const TAHAP = [
    "Sangat lemah",
    "Sangat lemah",
    "Lemah",
    "Sederhana",
    "Kuat",
    "Sangat kuat",
  ];
  const kekuatan = document.getElementById("kekuatan")!;
  const kekuatanLabel = document.getElementById("kekuatan-label")!;
  const ukur = (v: string) => {
    let skor = 0;
    for (const [nama, uji] of Object.entries(syarat)) {
      const lulus = uji(v);
      if (lulus) skor++;
      kekuatan
        .querySelector(`[data-syarat="${nama}"]`)!
        .toggleAttribute("data-ok", lulus);
    }
    if (v.length >= 16) skor++;
    if (/[^A-Za-z0-9]/.test(v)) skor++;
    const tahap = Math.min(5, skor);
    kekuatan.dataset.tahap = String(tahap);
    kekuatanLabel.textContent = TAHAP[tahap];
  };
  const medanBaru = kata.elements.namedItem("baru") as HTMLInputElement;
  medanBaru.addEventListener("input", () => ukur(medanBaru.value));
  ukur(medanBaru.value);

  // Sama dengan PasswordUpdateSchema backend (8+, besar/kecil/nombor) dan had daftar Nubi (12-200).
  const semakBaru = (pw: string, pw2: string) => {
    if (pw.length < 12 || pw.length > 200)
      return "Kata laluan baru mesti 12 hingga 200 aksara.";
    if (!syarat.besar(pw) || !syarat.kecil(pw) || !syarat.nombor(pw))
      return "Kata laluan baru mesti ada huruf besar, huruf kecil dan nombor.";
    if (pw !== pw2) return "Kata laluan baru tak sama.";
    return null;
  };

  kata.addEventListener("submit", async (e) => {
    e.preventDefault();
    const semasa = String(kata.semasa.value);
    const baru = String(kata.baru.value);
    const salah = !semasa
      ? "Masukkan kata laluan semasa."
      : semakBaru(baru, String(kata.baru2.value));
    papar(salah);
    if (salah) return;
    const butang = kata.querySelector("button")!;
    butang.disabled = true;
    try {
      const res = await api("/me/password", {
        method: "PUT",
        body: JSON.stringify({ currentPassword: semasa, newPassword: baru }),
      });
      if (res.ok) {
        // Backend tamatkan semua sesi dan buang cookie.
        location.replace(
          `/login?next=${encodeURIComponent("/account/profile")}`,
        );
        return;
      }
      const body = await json(res);
      papar(
        commonError(res.status, body) ??
          (/current password/i.test(String(body.error ?? ""))
            ? "Kata laluan semasa salah."
            : res.status === 400
              ? "Kata laluan baru tak cukup syarat."
              : "Tak dapat tukar sekarang. Cuba lagi sekejap."),
      );
    } catch {
      papar("Tiada sambungan. Semak internet anda dan cuba lagi.");
    } finally {
      butang.disabled = false;
    }
  });
</script>

<style>
  .kekuatan {
    gap: 0.5rem;
  }
  .kekuatan-bar {
    display: flex;
    gap: 0.35rem;
  }
  .kekuatan-bar i {
    flex: 1;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--line);
  }
  .kekuatan-teks {
    margin: 0;
    font-size: 0.9rem;
  }
  .kekuatan-syarat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.15rem 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .kekuatan-syarat li::before {
    content: "• ";
  }
  .kekuatan-syarat li[data-ok] {
    color: var(--success-ink);
  }
  .kekuatan-syarat li[data-ok]::before {
    content: "✓ ";
  }
  .kekuatan[data-tahap="1"] .kekuatan-bar i:nth-child(-n + 1),
  .kekuatan[data-tahap="2"] .kekuatan-bar i:nth-child(-n + 2) {
    background: var(--danger-ink);
  }
  .kekuatan[data-tahap="3"] .kekuatan-bar i:nth-child(-n + 3) {
    background: #b45309;
  }
  .kekuatan[data-tahap="4"] .kekuatan-bar i:nth-child(-n + 4) {
    background: #15803d;
  }
  .kekuatan[data-tahap="5"] .kekuatan-bar i:nth-child(-n + 5) {
    background: var(--success-ink);
  }
  .kekuatan[data-tahap="1"] .kekuatan-teks strong,
  .kekuatan[data-tahap="2"] .kekuatan-teks strong {
    color: var(--danger-ink);
  }
  .kekuatan[data-tahap="3"] .kekuatan-teks strong {
    color: #b45309;
  }
  .kekuatan[data-tahap="4"] .kekuatan-teks strong {
    color: #15803d;
  }
  .kekuatan[data-tahap="5"] .kekuatan-teks strong {
    color: var(--success-ink);
  }
</style>
