---
// Profil Nubi - Maklumat: nama, username, bio, lokasi + profil awam (PATCH /me). Backend sama
// dengan portfolio - akaun satu, jadi perubahan di sini juga nampak di hafizbahtiar.com.
// E-mel tidak boleh diubah (backend). Telegram + NUNI di Tetapan; padam akaun di Zon bahaya.
// View mode first; "Edit profil" swaps in the form. "Apa orang lain nampak" previews the saved state:
// the members' feed (name, @username only when public) and /u/<username> (GET /public/profiles/:u/nubi).
import ProfileShell from "../../../components/ProfileShell.astro";
import Field from "../../../components/ui/Field.astro";
import Alert from "../../../components/ui/Alert.astro";
import Checkbox from "../../../components/ui/Checkbox.astro";
---

<ProfileShell title="Maklumat">
  <section class="panel" aria-labelledby="t-ringkas">
    <div class="ringkas">
      <span class="ringkas-avatar" id="ringkas-awal" aria-hidden="true">…</span>
      <div class="ringkas-teks">
        <h2 class="display" id="t-ringkas"><span id="ringkas-nama">…</span></h2>
        <p class="muted" id="ringkas-username">…</p>
      </div>
      <span class="lencana" id="ringkas-status">Peribadi</span>
    </div>
    <p class="muted" id="ringkas-nota">…</p>
    <a class="btn btn-outline btn-sm" id="ringkas-pautan" href="#" hidden
      >Lihat profil awam</a
    >
  </section>

  <section class="panel" aria-labelledby="t-profil">
    <div class="panel-kepala">
      <h2 class="display" id="t-profil">Maklumat anda</h2>
      <button class="btn btn-outline btn-sm" type="button" id="profile-edit"
        >Edit profil</button
      >
    </div>
    <Alert variant="success" id="ok-profil" hidden />
    <dl class="profile-view" id="profile-view">
      <div><dt>Nama</dt><dd data-view="name">…</dd></div>
      <div><dt>E-mel</dt><dd data-view="email">…</dd></div>
      <div><dt>Username</dt><dd data-view="username">…</dd></div>
      <div><dt>Lokasi</dt><dd data-view="location">…</dd></div>
      <div class="medan-penuh"><dt>Bio</dt><dd data-view="bio">…</dd></div>
      <div><dt>Profil awam</dt><dd data-view="public">…</dd></div>
    </dl>
    <form class="form form-grid form-grid--lg" id="profil" novalidate hidden>
      <p class="muted medan-penuh">
        Nama, username, bio dan lokasi. Profil awam hanya menunjukkan apa yang
        disenaraikan di bawah.
      </p>
      <Field label="Nama">
        <input
          class="input"
          type="text"
          name="nama"
          autocomplete="name"
          maxlength="100"
          required
        />
      </Field>
      <Field label="E-mel" hint="E-mel log masuk tak boleh diubah.">
        <input class="input" type="email" name="emel" readonly />
      </Field>
      <Field
        label="Username"
        hint="3-30 huruf kecil, nombor atau sengkang tunggal. Perlu untuk profil awam."
      >
        <input
          class="input"
          type="text"
          name="username"
          maxlength="30"
          autocomplete="username"
          pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?"
        />
      </Field>
      <Field label="Lokasi" hint="Contoh: Shah Alam, Selangor.">
        <input
          class="input"
          type="text"
          name="lokasi"
          maxlength="100"
          autocomplete="address-level2"
        />
      </Field>
      <div class="medan-penuh">
        <Field label="Bio" hint="Maksimum 1,000 aksara.">
          <textarea class="input" name="bio" rows="3" maxlength="1000"
          ></textarea>
        </Field>
      </div>
      <div class="medan-penuh">
        <Checkbox
          name="awam"
          label="Profil awam"
          hint="Nama, username, bio, lokasi, ahli sejak, lencana dan jumlah aktiviti/km akan kelihatan kepada sesiapa yang ada pautan. Laluan, pelan, umur/berat/MAF dan pace tidak dipaparkan. Lalai peribadi."
        />
      </div>
      <div class="medan-penuh">
        <Alert variant="danger" id="mesej-profil" hidden />
      </div>
      <div class="medan-penuh form-buttons">
        <button class="btn btn-primary" type="submit">Simpan</button>
        <button class="btn btn-outline" type="button" id="profile-cancel"
          >Batal</button
        >
      </div>
    </form>
  </section>

  <section class="panel" aria-labelledby="t-others">
    <h2 class="display" id="t-others">Apa orang lain nampak</h2>
    <p class="muted">Ikut maklumat yang sudah disimpan.</p>
    <div class="audience-grid">
      <article class="audience">
        <h3>Ahli Nubi (log masuk)</h3>
        <p class="muted">
          Pada aktiviti komuniti, sebelah larian yang anda kongsi.
        </p>
        <p class="audience-card" id="preview-members">…</p>
      </article>
      <article class="audience">
        <h3>Sesiapa dengan pautan</h3>
        <p class="muted" id="preview-public-note">…</p>
        <div class="audience-card" id="preview-public" hidden>
          <strong data-preview="name"></strong>
          <span class="muted" data-preview="username"></span>
          <p data-preview="bio"></p>
          <span class="muted" data-preview="meta"></span>
        </div>
      </article>
    </div>
  </section>
</ProfileShell>

<script>
  import {
    api,
    cacheMe,
    json,
    commonError,
    currentUser,
    type CurrentUser,
  } from "../../../lib/api";

  const profil = document.getElementById("profil") as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const medan = (name: string) =>
    profil.elements.namedItem(name) as HTMLInputElement;
  const papar = (id: string, teks: string | null) => {
    const el = document.getElementById(id)!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };

  const ringkas = (user: CurrentUser) => {
    const username = user.username ?? "";
    const awam = !!user.profilePublic && !!username;
    $("ringkas-awal").textContent = user.name.charAt(0).toUpperCase() || "?";
    $("ringkas-nama").textContent = user.name;
    $("ringkas-username").textContent = username
      ? `@${username}`
      : "Belum ada username";
    $("ringkas-status").textContent = awam ? "Profil awam" : "Peribadi";
    $("ringkas-nota").textContent = awam
      ? "Profil ini boleh dilihat sesiapa yang ada pautan. Laluan, pelan dan data kesihatan kekal peribadi."
      : "Profil ini peribadi. Tetapkan username dan tandakan Profil awam untuk kongsi.";
    const pautan = $("ringkas-pautan") as HTMLAnchorElement;
    pautan.hidden = !awam;
    if (awam) pautan.href = `/u/${encodeURIComponent(username)}`;
  };

  const formatMonth = (yyyyMm: string) =>
    new Date(`${yyyyMm}-01T00:00:00Z`).toLocaleDateString("ms-MY", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    });

  // What other people see - from the saved user, plus the real public endpoint when public.
  const renderPreview = async (user: CurrentUser) => {
    const username = user.username ?? "";
    const isPublic = !!user.profilePublic && !!username;
    $("preview-members").textContent = isPublic
      ? `${user.name} · @${username}`
      : `${user.name} (username disorok sebab profil peribadi)`;
    const card = $("preview-public");
    const note = $("preview-public-note");
    card.hidden = true;
    if (!isPublic) {
      note.textContent =
        'Tiada apa-apa: pautan /u/ memaparkan "tidak dijumpai" selagi profil peribadi.';
      return;
    }
    note.textContent = `Pautan /u/${username}:`;
    const res = await fetch(
      // noCache=1: skip the 60 s memo so the preview matches what was just saved.
      `/api/v1/public/profiles/${encodeURIComponent(username)}/nubi?noCache=1`,
      { cache: "no-store" },
    ).catch(() => null);
    const data = res?.ok ? (await json(res)).data : null;
    if (!data) {
      // e.g. email not verified yet, or a ban - the endpoint answers 404 for both.
      note.textContent =
        "Pautan /u/ belum aktif (contohnya e-mel belum disahkan). Cuba lagi sekejap.";
      return;
    }
    const field = (key: string) =>
      card.querySelector<HTMLElement>(`[data-preview="${key}"]`)!;
    field("name").textContent = data.displayName;
    field("username").textContent = `@${data.username}`;
    field("bio").textContent = data.bio ?? "";
    field("bio").hidden = !data.bio;
    const km = (data.activities.distanceM / 1000).toLocaleString("ms-MY", {
      maximumFractionDigits: 1,
    });
    field("meta").textContent = [
      data.location,
      data.memberSince && `Ahli sejak ${formatMonth(data.memberSince)}`,
      `${data.activities.count} aktiviti · ${km} km`,
      `${data.badges.length} lencana`,
    ]
      .filter(Boolean)
      .join(" · ");
    card.hidden = false;
  };

  const viewField = (key: string) =>
    document.querySelector<HTMLElement>(`[data-view="${key}"]`)!;
  const showView = (user: CurrentUser) => {
    viewField("name").textContent = user.name;
    viewField("email").textContent = user.email;
    viewField("username").textContent = user.username
      ? `@${user.username}`
      : "-";
    viewField("location").textContent = user.profile?.location || "-";
    viewField("bio").textContent = user.profile?.bio || "-";
    viewField("public").textContent =
      user.profilePublic && user.username ? "Ya" : "Tidak (peribadi)";
    $("profile-view").hidden = false;
    profil.hidden = true;
    $("profile-edit").hidden = false;
    void renderPreview(user);
  };

  $("profile-edit").addEventListener("click", () => {
    papar("ok-profil", null);
    $("profile-view").hidden = true;
    $("profile-edit").hidden = true;
    profil.hidden = false;
    medan("nama").focus();
  });

  // Pengawal sesi = AccountLayout; s null bermaksud page sedang dilencong ke /login.
  const s = await currentUser();
  // Last saved state: Batal resets the form to it, and the next save builds on it.
  let saved = s;
  const fillForm = (user: CurrentUser) => {
    medan("nama").value = user.name;
    medan("emel").value = user.email;
    medan("username").value = user.username ?? "";
    medan("bio").value = user.profile?.bio ?? "";
    medan("lokasi").value = user.profile?.location ?? "";
    medan("awam").checked = !!user.profilePublic;
  };
  if (s) {
    fillForm(s);
    ringkas(s);
    showView(s);
  }
  $("profile-cancel").addEventListener("click", () => {
    papar("mesej-profil", null);
    if (!saved) return;
    fillForm(saved);
    showView(saved);
    $("profile-edit").focus();
  });

  profil.addEventListener("submit", async (e) => {
    e.preventDefault();
    papar("ok-profil", null);
    const nama = String(medan("nama").value).trim();
    const username = String(medan("username").value).trim().toLowerCase();
    const bio = String(medan("bio").value).trim();
    const lokasi = String(medan("lokasi").value).trim();
    const awam = medan("awam").checked;
    if (!nama || nama.length > 100)
      return papar("mesej-profil", "Masukkan nama (maksimum 100 aksara).");
    if (awam && !username)
      return papar(
        "mesej-profil",
        "Set username dulu sebelum jadikan profil awam.",
      );
    papar("mesej-profil", null);
    const butang = profil.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    butang.disabled = true;
    try {
      const res = await api("/me", {
        method: "PATCH",
        body: JSON.stringify({
          displayName: nama,
          username: username || null,
          bio,
          location: lokasi,
          profilePublic: awam,
        }),
      });
      if (!res.ok) {
        const body = await json(res);
        const mesej =
          body.code === "username_taken"
            ? "Username ini dah diambil. Pilih yang lain."
            : body.code === "username_required"
              ? "Set username dulu sebelum jadikan profil awam."
              : body.field === "username"
                ? "Username mesti 3-30 huruf kecil, nombor atau sengkang tunggal."
                : (commonError(res.status, body) ??
                  "Tak dapat simpan sekarang. Cuba lagi sekejap.");
        return papar("mesej-profil", mesej);
      }
      document
        .querySelectorAll("[data-saya-nama]")
        .forEach((el) => (el.textContent = nama));
      document
        .querySelectorAll("[data-saya-awal]")
        .forEach((el) => (el.textContent = nama.charAt(0).toUpperCase()));
      if (!saved) return;
      const next: CurrentUser = {
        ...saved,
        name: nama,
        username: username || null,
        profilePublic: awam,
        profile: {
          displayName: nama,
          bio: bio || null,
          location: lokasi || null,
          website: saved.profile?.website ?? null,
          linkedinUrl: saved.profile?.linkedinUrl ?? null,
          githubUrl: saved.profile?.githubUrl ?? null,
          twitterUrl: saved.profile?.twitterUrl ?? null,
        },
      };
      saved = next;
      cacheMe(next);
      ringkas(next);
      showView(next);
      papar("ok-profil", "Profil disimpan.");
    } catch {
      papar(
        "mesej-profil",
        "Tiada sambungan. Semak internet anda dan cuba lagi.",
      );
    } finally {
      butang.disabled = false;
    }
  });
</script>

<style>
  input[readonly] {
    background: var(--paper-2);
    color: var(--muted);
  }
  .ringkas {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .ringkas-avatar {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--paper);
    font: 700 1.35rem / 1 var(--display, var(--body));
  }
  .ringkas-teks {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .ringkas-teks h2 {
    margin: 0;
    font-size: 1.5rem;
    overflow-wrap: anywhere;
  }
  .ringkas-teks p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .ringkas-nota {
    grid-column: 1 / -1;
    margin: 0;
  }
  #ringkas-pautan {
    grid-column: 1 / -1;
    justify-self: start;
  }
  .medan-penuh {
    grid-column: 1 / -1;
  }
  .profile-view {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 0;
  }
  .profile-view[hidden],
  #profil[hidden] {
    display: none;
  }
  .profile-view dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .profile-view dd {
    margin: 0.15rem 0 0;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }
  .form-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .audience {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .audience h3 {
    margin: 0;
    font-size: 1rem;
  }
  .audience p {
    margin: 0;
  }
  .audience-card {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0.85rem 1rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    overflow-wrap: anywhere;
  }
  .audience-card[hidden] {
    display: none;
  }
  @media (max-width: 40rem) {
    .ringkas {
      grid-template-columns: auto minmax(0, 1fr);
    }
    #ringkas-status {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
