---
// Nubi profile (view only). Order: who you are (header + Edit) -> your details -> who sees what
// (members' feed, and /u/<username> from GET /public/profiles/:u/nubi). Editing is
// /account/profile/edit; Telegram, AI, training, password, sessions and deletion live under
// /account/settings/*. Full width; the two-column body stacks below 64rem.
import AccountLayout from "../../../layouts/AccountLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
---

<AccountLayout
  title="Profil"
  description="Profil Nubi Sport anda dan apa yang orang lain nampak."
>
  <div class="profile-page">
    <Alert variant="success" id="profile-saved" hidden>
      <p>Profil disimpan.</p>
    </Alert>

    <section class="panel profile-head" aria-labelledby="t-name">
      <span class="avatar" id="avatar" aria-hidden="true">…</span>
      <div class="identity">
        <h2 class="display" id="t-name">…</h2>
        <p class="muted" id="handle">…</p>
        <p id="bio" hidden></p>
      </div>
      <div class="head-actions">
        <span class="lencana" id="visibility">Peribadi</span>
        <a class="btn btn-primary btn-sm" href="/account/profile/edit"
          >Edit profil</a
        >
        <a class="btn btn-outline btn-sm" id="public-link" href="#" hidden
          >Lihat profil awam</a
        >
      </div>
    </section>

    <div class="profile-body">
      <section class="panel" aria-labelledby="t-details">
        <h2 class="display" id="t-details">Maklumat</h2>
        <dl class="details">
          <div><dt>Nama</dt><dd data-view="name">…</dd></div>
          <div><dt>Username</dt><dd data-view="username">…</dd></div>
          <div><dt>E-mel</dt><dd data-view="email">…</dd></div>
          <div><dt>Lokasi</dt><dd data-view="location">…</dd></div>
          <div class="full-row"><dt>Bio</dt><dd data-view="bio">…</dd></div>
        </dl>
        <p class="muted small">
          E-mel hanya anda yang nampak. Telegram, kata laluan dan sesi ada di
          <a class="link" href="/account/settings">Tetapan</a>.
        </p>
      </section>

      <section class="panel" aria-labelledby="t-others">
        <h2 class="display" id="t-others">Apa orang lain nampak</h2>
        <article class="audience">
          <h3>Ahli Nubi (log masuk)</h3>
          <p class="muted small">
            Pada aktiviti komuniti, sebelah larian yang anda kongsi.
          </p>
          <p class="audience-card" id="preview-members">…</p>
        </article>
        <article class="audience">
          <h3>Sesiapa dengan pautan</h3>
          <p class="muted small" id="preview-public-note">…</p>
          <div class="audience-card" id="preview-public" hidden>
            <strong data-preview="name"></strong>
            <span class="muted" data-preview="username"></span>
            <p data-preview="bio"></p>
            <span class="muted" data-preview="meta"></span>
          </div>
        </article>
      </section>
    </div>
  </div>
</AccountLayout>

<script>
  import { json, currentUser, type CurrentUser } from "../../../lib/api";

  const $ = (id: string) => document.getElementById(id)!;
  const viewField = (key: string) =>
    document.querySelector<HTMLElement>(`[data-view="${key}"]`)!;
  const isPublic = (user: CurrentUser) =>
    !!user.profilePublic && !!user.username;

  // Back from /account/profile/edit after a save: show once, drop the param.
  if (new URLSearchParams(location.search).has("saved")) {
    $("profile-saved").hidden = false;
    history.replaceState(null, "", location.pathname);
  }

  const renderHead = (user: CurrentUser) => {
    $("avatar").textContent = user.name.charAt(0).toUpperCase() || "?";
    $("t-name").textContent = user.name;
    $("handle").textContent = user.username
      ? `@${user.username}`
      : "Belum ada username";
    const bio = $("bio");
    bio.textContent = user.profile?.bio ?? "";
    bio.hidden = !user.profile?.bio;
    $("visibility").textContent = isPublic(user) ? "Profil awam" : "Peribadi";
    const link = $("public-link") as HTMLAnchorElement;
    link.hidden = !isPublic(user);
    if (isPublic(user)) link.href = `/u/${encodeURIComponent(user.username!)}`;
  };

  const renderDetails = (user: CurrentUser) => {
    viewField("name").textContent = user.name;
    viewField("username").textContent = user.username
      ? `@${user.username}`
      : "-";
    viewField("email").textContent = user.email;
    viewField("location").textContent = user.profile?.location || "-";
    viewField("bio").textContent = user.profile?.bio || "-";
  };

  const formatMonth = (yyyyMm: string) =>
    new Date(`${yyyyMm}-01T00:00:00Z`).toLocaleDateString("ms-MY", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    });

  // What other people see - from the saved user, plus the real public endpoint when public.
  const renderPreview = async (user: CurrentUser) => {
    const username = user.username ?? "";
    $("preview-members").textContent = isPublic(user)
      ? `${user.name} · @${username}`
      : `${user.name} (username disorok sebab profil peribadi)`;
    const card = $("preview-public");
    const note = $("preview-public-note");
    if (!isPublic(user)) {
      note.textContent =
        'Tiada apa-apa: pautan /u/ memaparkan "tidak dijumpai" selagi profil peribadi.';
      return;
    }
    note.textContent = `Pautan /u/${username}:`;
    const res = await fetch(
      // noCache=1: skip the 60 s memo so the preview matches what was just saved.
      `/api/v1/public/profiles/${encodeURIComponent(username)}/nubi?noCache=1`,
      { cache: "no-store" },
    ).catch(() => null);
    const data = res?.ok ? (await json(res)).data : null;
    if (!data) {
      // e.g. email not verified yet, or a ban - the endpoint answers 404 for both.
      note.textContent =
        "Pautan /u/ belum aktif (contohnya e-mel belum disahkan). Cuba lagi sekejap.";
      return;
    }
    const field = (key: string) =>
      card.querySelector<HTMLElement>(`[data-preview="${key}"]`)!;
    field("name").textContent = data.displayName;
    field("username").textContent = `@${data.username}`;
    field("bio").textContent = data.bio ?? "";
    field("bio").hidden = !data.bio;
    const km = (data.activities.distanceM / 1000).toLocaleString("ms-MY", {
      maximumFractionDigits: 1,
    });
    field("meta").textContent = [
      data.location,
      data.memberSince && `Ahli sejak ${formatMonth(data.memberSince)}`,
      `${data.activities.count} aktiviti · ${km} km`,
      `${data.badges.length} lencana`,
    ]
      .filter(Boolean)
      .join(" · ");
    card.hidden = false;
  };

  // Session guard = AccountLayout; null means the page is redirecting to /login.
  const user = await currentUser();
  if (user) {
    renderHead(user);
    renderDetails(user);
    void renderPreview(user);
  }
</script>

<style>
  .profile-page {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }
  .profile-page :global(.panel) {
    justify-items: stretch;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
  }
  .profile-page :global(.panel h2) {
    margin: 0;
    font-size: 1.5rem;
    color: var(--navy);
  }

  /* Header: avatar | name, handle, bio | badge + actions. */
  .profile-head {
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.25rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--paper);
    font: 700 1.6rem / 1 var(--display, var(--body));
  }
  .identity {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .identity p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  #bio {
    margin-top: 0.35rem;
    white-space: pre-line;
  }
  .head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  /* Body: details | audience side by side on wide screens. */
  .profile-body {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 1.5rem;
    align-items: start;
  }
  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
  }
  .details dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .details dd {
    margin: 0.15rem 0 0;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }
  .full-row {
    grid-column: 1 / -1;
  }
  .small {
    margin: 0;
    font-size: 0.88rem;
  }
  .audience {
    display: grid;
    gap: 0.4rem;
  }
  .audience h3 {
    margin: 0;
    font-size: 1rem;
  }
  .audience-card {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0.85rem 1rem;
    background: var(--paper-2);
    border-radius: var(--radius);
    overflow-wrap: anywhere;
  }
  .audience-card p {
    margin: 0;
  }
  .audience-card[hidden] {
    display: none;
  }

  @media (max-width: 63.99rem) {
    .profile-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .profile-head {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .head-actions {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
    .head-actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
