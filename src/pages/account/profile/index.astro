---
// Profil Nubi - Maklumat: nama, username, bio, lokasi + profil awam (PATCH /me). Backend sama
// dengan portfolio - akaun satu, jadi perubahan di sini juga nampak di hafizbahtiar.com.
// E-mel tidak boleh diubah (backend). + Telegram (akaun dipautkan). Padam akaun di Keselamatan.
import ProfileShell from "../../../components/ProfileShell.astro";
import Field from "../../../components/ui/Field.astro";
import Alert from "../../../components/ui/Alert.astro";
import Checkbox from "../../../components/ui/Checkbox.astro";
---

<ProfileShell title="Maklumat">
  <section class="panel" aria-labelledby="t-ringkas">
    <div class="ringkas">
      <span class="ringkas-avatar" id="ringkas-awal" aria-hidden="true">…</span>
      <div class="ringkas-teks">
        <h2 class="display" id="t-ringkas"><span id="ringkas-nama">…</span></h2>
        <p class="muted" id="ringkas-username">…</p>
      </div>
      <span class="lencana" id="ringkas-status">Peribadi</span>
    </div>
    <p class="muted" id="ringkas-nota">…</p>
    <a class="btn btn-outline btn-sm" id="ringkas-pautan" href="#" hidden
      >Lihat profil awam</a
    >
  </section>

  <section class="panel" aria-labelledby="t-profil">
    <h2 class="display" id="t-profil">Maklumat anda</h2>
    <p class="muted">
      Nama, username, bio dan lokasi. Profil awam hanya menunjukkan apa yang
      disenaraikan di bawah.
    </p>
    <form class="form form-grid form-grid--lg" id="profil" novalidate>
      <Field label="Nama">
        <input
          class="input"
          type="text"
          name="nama"
          autocomplete="name"
          maxlength="100"
          required
        />
      </Field>
      <Field label="E-mel" hint="E-mel log masuk tak boleh diubah.">
        <input class="input" type="email" name="emel" readonly />
      </Field>
      <Field
        label="Username"
        hint="3-30 huruf kecil, nombor atau sengkang tunggal. Perlu untuk profil awam."
      >
        <input
          class="input"
          type="text"
          name="username"
          maxlength="30"
          autocomplete="username"
          pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?"
        />
      </Field>
      <Field label="Lokasi" hint="Contoh: Shah Alam, Selangor.">
        <input
          class="input"
          type="text"
          name="lokasi"
          maxlength="100"
          autocomplete="address-level2"
        />
      </Field>
      <div class="medan-penuh">
        <Field label="Bio" hint="Maksimum 1,000 aksara.">
          <textarea class="input" name="bio" rows="3" maxlength="1000"
          ></textarea>
        </Field>
      </div>
      <div class="medan-penuh">
        <Checkbox
          name="awam"
          label="Profil awam"
          hint="Nama, username, bio, lokasi, ahli sejak, lencana dan jumlah aktiviti/km akan kelihatan kepada sesiapa yang ada pautan. Laluan, pelan, umur/berat/MAF dan pace tidak dipaparkan. Lalai peribadi."
        />
      </div>
      <div class="medan-penuh">
        <Alert variant="danger" id="mesej-profil" hidden />
      </div>
      <div class="medan-penuh">
        <Alert variant="success" id="ok-profil" hidden />
      </div>
      <button class="btn btn-primary" type="submit">Simpan</button>
    </form>
  </section>

  <section class="panel" aria-labelledby="t-telegram">
    <h2 class="display" id="t-telegram">Telegram</h2>
    <p class="muted" id="telegram-status">Menyemak pautan…</p>
    <Alert variant="danger" id="mesej-telegram" hidden />
    <div class="actions">
      <a
        class="btn btn-outline"
        id="telegram-paut"
        href="/api/v1/public/telegram"
        target="_blank"
        rel="noopener">Pautkan Telegram</a
      >
      <button class="btn btn-bahaya" type="button" id="telegram-nyahpaut" hidden
        >Nyahpaut Telegram</button
      >
    </div>
  </section>

  <section class="panel" aria-labelledby="t-ai">
    <h2 class="display" id="t-ai">NUNI</h2>
    <p class="muted" id="ai-status">Menyemak persetujuan…</p>
    <Alert variant="danger" id="mesej-ai" hidden />
    <div class="actions">
      <button class="btn btn-outline" type="button" id="ai-tarik" hidden
        >Tarik balik persetujuan AI</button
      >
    </div>
  </section>
</ProfileShell>

<script>
  import {
    api,
    cacheMe,
    json,
    commonError,
    currentUser,
    type CurrentUser,
  } from "../../../lib/api";
  import { confirmDialog } from "../../../lib/confirm";

  const profil = document.getElementById("profil") as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const medan = (name: string) =>
    profil.elements.namedItem(name) as HTMLInputElement;
  const papar = (id: string, teks: string | null) => {
    const el = document.getElementById(id)!;
    el.textContent = teks ?? "";
    el.hidden = !teks;
  };

  const ringkas = (user: CurrentUser) => {
    const username = user.username ?? "";
    const awam = !!user.profilePublic && !!username;
    $("ringkas-awal").textContent = user.name.charAt(0).toUpperCase() || "?";
    $("ringkas-nama").textContent = user.name;
    $("ringkas-username").textContent = username
      ? `@${username}`
      : "Belum ada username";
    $("ringkas-status").textContent = awam ? "Profil awam" : "Peribadi";
    $("ringkas-nota").textContent = awam
      ? "Profil ini boleh dilihat sesiapa yang ada pautan. Laluan, pelan dan data kesihatan kekal peribadi."
      : "Profil ini peribadi. Tetapkan username dan tandakan Profil awam untuk kongsi.";
    const pautan = $("ringkas-pautan") as HTMLAnchorElement;
    pautan.hidden = !awam;
    if (awam) pautan.href = `/u/${encodeURIComponent(username)}`;
  };

  // Pengawal sesi = AccountLayout; s null bermaksud page sedang dilencong ke /login.
  const s = await currentUser();
  if (s) {
    medan("nama").value = s.name;
    medan("emel").value = s.email;
    medan("username").value = s.username ?? "";
    medan("bio").value = s.profile?.bio ?? "";
    medan("lokasi").value = s.profile?.location ?? "";
    medan("awam").checked = !!s.profilePublic;
    ringkas(s);
  }

  // Persetujuan AI boleh ditarik balik di sini - chat AI sendiri kekal bersih.
  const aiStatus = document.getElementById("ai-status")!;
  const aiTarik = document.getElementById("ai-tarik") as HTMLButtonElement;
  const aiMesej = document.getElementById("mesej-ai")!;
  const muatAi = async () => {
    const res = await api("/me/apps/nubi/aiconsent").catch(() => null);
    const aktif = res?.ok && ((await json(res)).data?.items?.length ?? 0) > 0;
    aiStatus.textContent = aktif
      ? "Persetujuan AI aktif. Chat dibuang bila page dimuat semula; Nubi tak simpan kandungan chat."
      : "Belum setuju. Pembantu AI akan minta persetujuan sebelum mula.";
    aiTarik.hidden = !aktif;
  };
  void muatAi();
  aiTarik.addEventListener("click", async () => {
    const ya = await confirmDialog({
      title: "Tarik balik persetujuan AI?",
      message:
        "Pembantu AI akan meminta persetujuan semula sebelum digunakan. Chat lama dibuang bila page dimuat semula.",
      confirmLabel: "Tarik balik",
      danger: true,
    });
    if (!ya) return aiTarik.focus();
    aiMesej.hidden = true;
    const res = await api("/me/apps/nubi/aiconsent/ya", {
      method: "DELETE",
    }).catch(() => null);
    if (!res?.ok) {
      aiMesej.textContent =
        "Tak dapat tarik balik sekarang. Cuba lagi sekejap.";
      aiMesej.hidden = false;
      return;
    }
    aiStatus.textContent =
      "Persetujuan AI ditarik balik. Pembantu AI akan minta persetujuan semula.";
    aiTarik.hidden = true;
  });

  // Telegram: status + nyahpaut dari profil. Amaran dihantar ke chat oleh backend
  // sebelum pautan dibuang (best effort - outage Telegram tak menghalang nyahpaut).
  const telegramStatus = document.getElementById("telegram-status")!;
  const telegramPaut = document.getElementById("telegram-paut")!;
  const telegramNyah = document.getElementById(
    "telegram-nyahpaut",
  ) as HTMLButtonElement;
  const telegramMesej = document.getElementById("mesej-telegram")!;
  const linkedAt = s?.telegram?.linkedAt ?? null;
  if (linkedAt) {
    telegramStatus.textContent = `Terikat sejak ${new Date(
      linkedAt,
    ).toLocaleDateString("ms-MY", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })}. Bot boleh tunjuk pelan anda.`;
    telegramPaut.hidden = true;
    telegramNyah.hidden = false;
  } else {
    telegramStatus.textContent =
      "Belum terikat. Pautkan untuk guna /nubiplan dalam bot.";
  }

  telegramNyah.addEventListener("click", async () => {
    telegramMesej.hidden = true;
    const ya = await confirmDialog({
      title: "Nyahpaut Telegram?",
      message:
        "Amaran akan dihantar ke chat Telegram, kemudian pautan dibuang. Bot tak lagi boleh tunjuk pelan anda sampai anda /bind semula.",
      confirmLabel: "Nyahpaut",
      danger: true,
    });
    if (!ya) return telegramNyah.focus();
    telegramNyah.disabled = true;
    try {
      const res = await api("/me/telegram/link", { method: "DELETE" });
      if (!res.ok) {
        telegramMesej.textContent =
          "Tak dapat nyahpaut sekarang. Cuba lagi sekejap.";
        telegramMesej.hidden = false;
        return;
      }
      const body = await json(res);
      if (s) cacheMe({ ...s, telegram: { linkedAt: null } });
      telegramStatus.textContent =
        body.data?.alerted === false
          ? "Telegram dinyahpaut. Amaran chat tak dapat dihantar, tetapi pautan sudah dibuang."
          : "Telegram dinyahpaut. Amaran dihantar ke chat.";
      telegramNyah.hidden = true;
      telegramPaut.hidden = false;
    } catch {
      telegramMesej.textContent =
        "Tiada sambungan. Semak internet anda dan cuba lagi.";
      telegramMesej.hidden = false;
    } finally {
      telegramNyah.disabled = false;
    }
  });

  profil.addEventListener("submit", async (e) => {
    e.preventDefault();
    papar("ok-profil", null);
    const nama = String(medan("nama").value).trim();
    const username = String(medan("username").value).trim().toLowerCase();
    const bio = String(medan("bio").value).trim();
    const lokasi = String(medan("lokasi").value).trim();
    const awam = medan("awam").checked;
    if (!nama || nama.length > 100)
      return papar("mesej-profil", "Masukkan nama (maksimum 100 aksara).");
    if (awam && !username)
      return papar(
        "mesej-profil",
        "Set username dulu sebelum jadikan profil awam.",
      );
    papar("mesej-profil", null);
    const butang = profil.querySelector("button")!;
    butang.disabled = true;
    try {
      const res = await api("/me", {
        method: "PATCH",
        body: JSON.stringify({
          displayName: nama,
          username: username || null,
          bio,
          location: lokasi,
          profilePublic: awam,
        }),
      });
      if (!res.ok) {
        const body = await json(res);
        const mesej =
          body.code === "username_taken"
            ? "Username ini dah diambil. Pilih yang lain."
            : body.code === "username_required"
              ? "Set username dulu sebelum jadikan profil awam."
              : body.field === "username"
                ? "Username mesti 3-30 huruf kecil, nombor atau sengkang tunggal."
                : (commonError(res.status, body) ??
                  "Tak dapat simpan sekarang. Cuba lagi sekejap.");
        return papar("mesej-profil", mesej);
      }
      document
        .querySelectorAll("[data-saya-nama]")
        .forEach((el) => (el.textContent = nama));
      document
        .querySelectorAll("[data-saya-awal]")
        .forEach((el) => (el.textContent = nama.charAt(0).toUpperCase()));
      if (!s) return;
      const next: CurrentUser = {
        ...s,
        name: nama,
        username: username || null,
        profilePublic: awam,
        profile: {
          displayName: nama,
          bio: bio || null,
          location: lokasi || null,
          website: s.profile?.website ?? null,
          linkedinUrl: s.profile?.linkedinUrl ?? null,
          githubUrl: s.profile?.githubUrl ?? null,
          twitterUrl: s.profile?.twitterUrl ?? null,
        },
      };
      cacheMe(next);
      ringkas(next);
      papar("ok-profil", "Profil disimpan.");
    } catch {
      papar(
        "mesej-profil",
        "Tiada sambungan. Semak internet anda dan cuba lagi.",
      );
    } finally {
      butang.disabled = false;
    }
  });
</script>

<style>
  input[readonly] {
    background: var(--paper-2);
    color: var(--muted);
  }
  .ringkas {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .ringkas-avatar {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--paper);
    font: 700 1.35rem / 1 var(--display, var(--body));
  }
  .ringkas-teks {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .ringkas-teks h2 {
    margin: 0;
    font-size: 1.5rem;
    overflow-wrap: anywhere;
  }
  .ringkas-teks p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .ringkas-nota {
    grid-column: 1 / -1;
    margin: 0;
  }
  #ringkas-pautan {
    grid-column: 1 / -1;
    justify-self: start;
  }
  .medan-penuh {
    grid-column: 1 / -1;
  }
  @media (max-width: 40rem) {
    .ringkas {
      grid-template-columns: auto minmax(0, 1fr);
    }
    #ringkas-status {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
