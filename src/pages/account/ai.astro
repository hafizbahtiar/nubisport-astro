---
// Pembantu AI Nubi (fasa 1c): chat baca + cadangan tulis dengan kad Sahkan. Backend: POST /me/ai/chat.
// Teks model dipapar dengan textContent - tiada innerHTML daripada model. Chat dalam memori page.
import AccountLayout from "../../layouts/AccountLayout.astro";
import Alert from "../../components/ui/Alert.astro";
import Icon from "../../components/ui/Icon.astro";
---

<AccountLayout
  title="NUNI"
  description="NUNI, pembantu AI Nubi Sport untuk profil, pelan, aktiviti dan larian kumpulan awak."
>
  <Alert variant="info" title="Ciri untuk ahli" id="bukan-ahli" hidden>
    <p>
      Pembantu AI terbuka untuk ahli Nubi Sport. Keahlian diluluskan pentadbir -
      <a class="link" href="/account/pricing">lihat keahlian</a>.
    </p>
  </Alert>

  <Alert variant="danger" id="ralat" hidden />

  <section
    class="ai-consent"
    id="persetujuan"
    aria-labelledby="t-setuju"
    hidden
  >
    <span class="ai-avatar ai-avatar-bot" aria-hidden="true">N</span>
    <h3 class="display" id="t-setuju">Sebelum mula</h3>
    <p>
      Pembantu AI boleh membaca profil, pelan, aktiviti dan larian kumpulan yang
      anda bincangkan. Soalan dan data itu dihantar ke Command Code dan pembekal
      model untuk diproses. Nubi tak menyimpan chat ini.
    </p>
    <p class="muted">
      Ini bukan nasihat perubatan atau penilaian jurulatih. Berhenti jika sakit,
      sesak dada atau pening. Anda boleh tarik balik persetujuan di Profil >
      Maklumat.
    </p>
    <button class="btn btn-primary" type="button" id="setuju">
      Setuju dan mula
    </button>
    <p class="muted">
      <a class="link" href="/privacy">Dasar Privasi</a>{" "}
      <span aria-hidden="true">·</span>{" "}
      <a class="link" href="/terms">Terma Penggunaan</a>
    </p>
  </section>

  <div id="chat" hidden>
    <section
      class="ai-chat"
      id="ai-chat"
      aria-label="NUNI, pembantu AI Nubi Sport"
    >
      <div class="ai-skrin" id="skrin">
        <ul
          class="ai-log"
          id="log"
          role="log"
          aria-live="polite"
          aria-label="Perbualan"
        >
        </ul>
        <button
          class="ai-turun"
          type="button"
          id="turun"
          aria-label="Ke mesej terkini"
          title="Ke mesej terkini"
          hidden
        >
          <Icon name="bawah" />
        </button>
      </div>

      <div class="ai-saran" id="saran">
        <ul aria-label="Cadangan soalan">
          <li>
            <button type="button" data-contoh="Minggu ini pelan saya apa?">
              Minggu ini pelan saya apa?
            </button>
          </li>
          <li>
            <button
              type="button"
              data-contoh="Aktiviti saya bulan ini macam mana?"
            >
              Aktiviti bulan ini macam mana?
            </button>
          </li>
          <li>
            <button
              type="button"
              data-contoh="Larian kumpulan akan datang apa?"
            >
              Larian akan datang apa?
            </button>
          </li>
        </ul>
      </div>

      <form class="ai-borangan" id="borang">
        <div class="ai-kotak">
          <label class="sr-only" for="teks">Soalan untuk pembantu AI</label>
          <textarea
            class="ai-teks"
            id="teks"
            rows="1"
            maxlength="2000"
            aria-describedby="kira"
            placeholder="Tanya pasal larian…"
            required></textarea>
          <button
            class="ai-hantar"
            type="submit"
            id="hantar"
            aria-label="Hantar"
            title="Hantar"
          >
            <Icon name="hantar" />
          </button>
        </div>
        <div class="ai-kaki">
          <span id="kira">0 / 2,000</span>
          <span id="kuota">…</span>
          <span class="ai-hint">Enter hantar · Shift+Enter baris baru</span>
        </div>
      </form>

      <p class="ai-legal" id="legal">
        <a class="link" href="/privacy">Dasar Privasi</a>{" "}
        <span aria-hidden="true">·</span>{" "}
        <a class="link" href="/terms">Terma Penggunaan</a>
      </p>
    </section>
  </div>
</AccountLayout>

<script>
  import { api, currentUser, json } from "../../lib/api";
  import { icon } from "../../lib/icon";
  import { renderMarkdown } from "../../lib/chat-markdown";
  import {
    runTool,
    toolContent,
    WRITE_TOOLS,
    type AiChatMessage,
    type AiToolCall,
    type ToolProposal,
    type ToolResult,
  } from "../../lib/ai-tools";

  document.body.classList.add("ai-page");

  const $ = (id: string) => document.getElementById(id)!;
  const showError = (m: string | null) => {
    $("ralat").textContent = m ?? "";
    $("ralat").hidden = !m;
    if (m) $("ralat").scrollIntoView({ block: "nearest" });
  };
  const log = $("log");
  const skrin = $("skrin") as HTMLElement;
  const saran = $("saran") as HTMLElement;
  const teks = $("teks") as HTMLTextAreaElement;
  const hantar = $("hantar") as HTMLButtonElement;
  const kira = $("kira");
  const messages: AiChatMessage[] = [];
  let sibuk = false;
  let namaSaya = "Awak";
  let assistant: { row: HTMLLIElement; bubble: HTMLElement } | null = null;
  let thinking: { row: HTMLLIElement; label: HTMLElement } | null = null;

  // Ikut mesej baru hanya bila pengguna sudah di bawah; kalau sedang baca mesej lama, tunjuk butang turun.
  const turun = $("turun") as HTMLButtonElement;
  let diBawah = true;
  const scrollBottom = (paksa = false) => {
    if (paksa || diBawah) skrin.scrollTop = skrin.scrollHeight;
  };
  skrin.addEventListener("scroll", () => {
    diBawah = skrin.scrollHeight - skrin.scrollTop - skrin.clientHeight < 48;
    turun.hidden = diBawah;
  });
  turun.addEventListener("click", () =>
    skrin.scrollTo({ top: skrin.scrollHeight, behavior: "smooth" }),
  );

  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement("textarea");
      area.value = text;
      area.setAttribute("readonly", "");
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.append(area);
      area.select();
      let ok = false;
      try {
        const exec = (
          document as unknown as { execCommand?: (id: string) => boolean }
        ).execCommand;
        ok = exec?.("copy") ?? false;
      } catch {
        /* clipboard tak tersedia */
      }
      area.remove();
      return ok;
    }
  };

  const copyMessage = async (
    bubble: HTMLElement,
    button: HTMLButtonElement,
  ) => {
    if (await copyText(bubble.dataset.text ?? bubble.textContent ?? "")) {
      button.innerHTML = icon("tanda");
      button.classList.add("disalin");
      button.setAttribute("aria-label", "Disalin");
      button.title = "Disalin";
      setTimeout(() => {
        button.innerHTML = icon("salin");
        button.classList.remove("disalin");
        button.setAttribute("aria-label", "Salin mesej");
        button.title = "Salin mesej";
      }, 1500);
    }
  };

  const createRow = (role: "user" | "assistant", copy = true) => {
    const row = document.createElement("li");
    row.className = `ai-row ai-row-${role}`;

    const avatar = document.createElement("span");
    avatar.className = `ai-avatar ai-avatar-${role}`;
    avatar.setAttribute("aria-hidden", "true");
    avatar.textContent =
      role === "assistant" ? "N" : namaSaya.charAt(0).toUpperCase();

    const wrap = document.createElement("div");
    wrap.className = "ai-msg-wrap";
    const nama = document.createElement("span");
    nama.className = "ai-nama";
    nama.textContent = role === "assistant" ? "NUNI" : namaSaya;
    const bubble = document.createElement("div");
    bubble.className = "ai-msg";
    wrap.append(nama, bubble);
    if (copy) {
      const actions = document.createElement("div");
      actions.className = "ai-msg-tindakan";
      const copyButton = document.createElement("button");
      copyButton.className = "ai-copy";
      copyButton.type = "button";
      copyButton.setAttribute("aria-label", "Salin mesej");
      copyButton.title = "Salin mesej";
      copyButton.innerHTML = icon("salin");
      copyButton.addEventListener(
        "click",
        () => void copyMessage(bubble, copyButton),
      );
      actions.append(copyButton);
      wrap.append(actions);
    }
    row.append(avatar, wrap);
    return { row, bubble };
  };

  const renderUser = (text: string) => {
    const { row, bubble } = createRow("user");
    bubble.textContent = text;
    bubble.dataset.text = text;
    log.append(row);
    scrollBottom(true);
  };

  const renderAssistant = (text: string) => {
    if (!assistant) {
      assistant = createRow("assistant");
      log.append(assistant.row);
    }
    assistant.bubble.classList.add("ai-msg-rich");
    assistant.bubble.dataset.text = text;
    renderMarkdown(assistant.bubble, text);
    scrollBottom();
  };

  const showThinking = (label: string) => {
    if (!thinking) {
      const { row, bubble } = createRow("assistant", false);
      row.classList.add("ai-row-thinking");
      bubble.classList.add("ai-thinking");
      const dots = document.createElement("span");
      dots.className = "ai-dots";
      dots.setAttribute("aria-hidden", "true");
      for (let i = 0; i < 3; i++) dots.append(document.createElement("i"));
      const text = document.createElement("span");
      text.className = "ai-thinking-teks";
      bubble.append(dots, text);
      log.append(row);
      thinking = { row, label: text };
    }
    thinking.label.textContent = label;
    scrollBottom();
  };

  const hideThinking = () => {
    thinking?.row.remove();
    thinking = null;
  };

  const renderConfirmCard = (proposal: ToolProposal) =>
    new Promise<boolean>((resolve) => {
      const { row, bubble } = createRow("assistant", false);
      row.classList.add("ai-row-proposal");
      bubble.classList.add("ai-kad");
      const id = `ai-kad-${Date.now()}`;
      bubble.setAttribute("role", "group");
      bubble.setAttribute("aria-labelledby", id);
      const tajuk = document.createElement("strong");
      tajuk.id = id;
      tajuk.className = "ai-kad-tajuk";
      tajuk.textContent = proposal.title;
      const butiran = document.createElement("p");
      butiran.className = "ai-kad-butiran";
      butiran.textContent = proposal.detail;
      const actions = document.createElement("div");
      actions.className = "ai-kad-tindakan";
      if (
        proposal.href &&
        proposal.href.startsWith("/") &&
        !proposal.href.startsWith("//")
      ) {
        const pautan = document.createElement("a");
        pautan.className = "btn btn-outline btn-sm";
        pautan.href = proposal.href;
        pautan.textContent = proposal.label ?? "Lihat";
        actions.append(pautan);
      }
      const batal = document.createElement("button");
      batal.type = "button";
      batal.className = "btn btn-outline btn-sm";
      batal.textContent = "Batal";
      const sahkan = document.createElement("button");
      sahkan.type = "button";
      sahkan.className = "btn btn-primary btn-sm";
      sahkan.textContent = "Sahkan";
      actions.append(batal, sahkan);
      bubble.append(tajuk, butiran, actions);
      log.append(row);
      scrollBottom();

      const tutup = (ok: boolean) => {
        document.removeEventListener("keydown", esc);
        row.remove();
        resolve(ok);
      };
      const esc = (e: KeyboardEvent) => {
        if (e.key === "Escape") {
          e.preventDefault();
          tutup(false);
        }
      };
      batal.addEventListener("click", () => tutup(false));
      sahkan.addEventListener("click", () => tutup(true));
      document.addEventListener("keydown", esc);
      sahkan.focus();
    });

  const renderResult = (result: ToolResult) => {
    const { row, bubble } = createRow("assistant", false);
    row.classList.add("ai-row-proposal");
    bubble.classList.add("ai-kad");
    const salah = typeof result.ralat === "string";
    const batal = result.dibatalkan === true;
    bubble.classList.add(
      salah ? "ai-kad-ralat" : batal ? "ai-kad-batal" : "ai-kad-selesai",
    );
    const tajuk = document.createElement("strong");
    tajuk.className = "ai-kad-tajuk";
    tajuk.textContent = salah
      ? "Tak dapat simpan"
      : batal
        ? "Dibatalkan"
        : "Selesai";
    const butiran = document.createElement("p");
    butiran.className = "ai-kad-butiran";
    const mesej = salah
      ? String(result.ralat)
      : batal
        ? "Tiada perubahan dibuat."
        : String(result.message ?? "Dah selesai.");
    butiran.textContent =
      result.awan === "penuh" && !salah && !batal
        ? `${mesej} Pelan disimpan pada peranti ini; slot awan penuh.`
        : mesej;
    bubble.append(tajuk, butiran);
    const pautan = typeof result.href === "string" ? result.href : "";
    if (
      !salah &&
      !batal &&
      pautan.startsWith("/") &&
      !pautan.startsWith("//")
    ) {
      const a = document.createElement("a");
      a.className = "btn btn-primary btn-sm";
      a.href = pautan;
      a.textContent = typeof result.label === "string" ? result.label : "Buka";
      bubble.append(a);
    }
    log.append(row);
    scrollBottom();
  };

  const setBusy = (v: boolean) => {
    sibuk = v;
    hantar.disabled = v;
    hantar.setAttribute("aria-busy", String(v));
  };

  const setEmptyState = (empty: boolean) => {
    $("ai-chat").classList.toggle("ai-chat--mula", empty);
    $("legal").hidden = !empty;
  };

  const setQuota = (q: { used: number; limit: number | null } | null) => {
    $("kuota").textContent = q
      ? q.limit === null
        ? `${q.used} · tiada had`
        : `${q.used} / ${q.limit} hari ini`
      : "…";
  };

  const loadQuota = async () => {
    const res = await api("/me/apps/nubi/usage").catch(() => null);
    if (!res?.ok) return setQuota(null);
    const data = (await json(res)).data;
    const ai = data?.items?.find((i: { key: string }) => i.key === "ai");
    if (ai)
      setQuota({
        used: Number(ai.used) || 0,
        limit: ai.limit === null ? null : Number(ai.limit) || 0,
      });
  };

  const showChat = async () => {
    $("persetujuan").hidden = true;
    $("chat").hidden = false;
    setEmptyState(messages.length === 0);
    await loadQuota();
    if (messages.length === 0 && matchMedia("(pointer: fine)").matches)
      teks.focus();
  };

  const showConsent = () => {
    $("chat").hidden = true;
    $("persetujuan").hidden = false;
  };

  const errorMessage = (status: number, body: Record<string, any>) => {
    if (body.code === "ai_consent_required") {
      showConsent();
      return "Persetujuan AI diperlukan semula.";
    }
    if (body.code === "ai_quota_full") return "Kuota AI hari ini dah habis.";
    if (status === 429) return "Tunggu sekejap dan cuba lagi.";
    if (status === 503 || status === 502)
      return "AI sibuk sekarang. Cuba lagi sekejap.";
    return "Tak dapat jawapan sekarang. Cuba lagi.";
  };

  const toolLabel = (name: string) => {
    if (name === "get_profile") return "Menyemak profil…";
    if (name === "list_plans" || name === "get_plan") return "Menyemak pelan…";
    if (name === "list_activities") return "Menyemak aktiviti…";
    if (name === "list_events") return "Menyemak larian…";
    if (WRITE_TOOLS.has(name)) return "Menyemak perubahan…";
    return "Menyemak data…";
  };

  const sendQuestion = async () => {
    const text = teks.value.trim();
    if (!text || sibuk) return;
    showError(null);
    saran.hidden = true;
    messages.push({ role: "user", content: text });
    setEmptyState(false);
    renderUser(text);
    teks.value = "";
    resizeTeks();
    kira.textContent = "0 / 2,000";
    assistant = null;
    setBusy(true);
    showThinking("Memikir…");

    try {
      let reply = "";
      let wrote = false;
      for (let round = 0; round < 6; round++) {
        if (round) showThinking("Menyusun jawapan…");
        const res = await api("/me/ai/chat", {
          method: "POST",
          body: JSON.stringify({ messages: messages.slice(-40) }),
        });
        const body = await json(res);
        if (!res.ok) {
          hideThinking();
          showError(errorMessage(res.status, body));
          return;
        }
        const data = body.data;
        setQuota(data.quota);
        const text = String(data.text ?? "").trim();
        if (text) {
          hideThinking();
          renderAssistant(text);
          reply = text;
        }
        const calls: AiToolCall[] = Array.isArray(data.toolCalls)
          ? data.toolCalls
          : [];
        if (!calls.length) {
          hideThinking();
          if (!reply) showError("AI tak beri jawapan. Cuba lagi.");
          else messages.push({ role: "assistant", content: reply });
          return;
        }
        // Satu bubble per turn: teks perantara tidak disimpan dalam history.
        messages.push({ role: "assistant", content: "", toolCalls: calls });
        for (const call of calls) {
          showThinking(toolLabel(call.name));
          const hasil = await runTool(call.name, call.arguments);
          let result: ToolResult;
          if ("proposal" in hasil) {
            wrote = true;
            hideThinking();
            const sah = await renderConfirmCard(hasil.proposal);
            if (!sah) result = { dibatalkan: true };
            else {
              showThinking("Menyimpan…");
              result = await hasil.proposal.jalankan();
              hideThinking();
            }
            renderResult(result);
          } else {
            result = hasil.result;
            if (
              typeof result.href === "string" &&
              typeof result.label === "string"
            )
              renderResult(result);
          }
          messages.push({
            role: "tool",
            toolCallId: call.id,
            content: toolContent(result),
          });
        }
        // Selepas tulis, UI jadi sumber kebenaran: jangan minta model mengesahkan lagi.
        if (wrote) {
          hideThinking();
          return;
        }
      }
      hideThinking();
      showError(
        "AI ambil terlalu banyak langkah. Cuba soalan yang lebih ringkas.",
      );
    } catch {
      hideThinking();
      showError("Tiada sambungan. Semak internet dan cuba lagi.");
    } finally {
      setBusy(false);
    }
  };

  const resizeTeks = () => {
    teks.style.height = "auto";
    teks.style.height = `${Math.min(teks.scrollHeight, 128)}px`;
  };

  const simpanPersetujuan = async () => {
    showError(null);
    const res = await api("/me/apps/nubi/aiconsent/ya", {
      method: "PUT",
      body: JSON.stringify({ engine: 1, data: {}, progress: [] }),
    }).catch(() => null);
    if (!res?.ok)
      return showError("Tak dapat simpan persetujuan sekarang. Cuba lagi.");
    await showChat();
  };

  const sentuh = matchMedia("(pointer: coarse)").matches;
  if (sentuh) teks.enterKeyHint = "enter";
  teks.addEventListener("input", () => {
    kira.textContent = `${teks.value.length.toLocaleString("ms-MY")} / 2,000`;
    resizeTeks();
  });
  teks.addEventListener("keydown", (e) => {
    // Telefon: Enter = baris baru, hantar guna butang (macam app chat lain).
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing && !sentuh) {
      e.preventDefault();
      void sendQuestion();
    }
  });
  $("borang").addEventListener("submit", (e) => {
    e.preventDefault();
    void sendQuestion();
  });
  $("setuju").addEventListener("click", () => void simpanPersetujuan());
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-contoh]"))
    b.addEventListener("click", () => {
      teks.value = b.dataset.contoh ?? "";
      teks.dispatchEvent(new Event("input"));
      void sendQuestion();
    });

  const saya = await currentUser();
  if (saya?.name) namaSaya = saya.name.split(/\s+/)[0];
  const ahli =
    saya &&
    (saya.role === "owner" ||
      saya.apps?.nubi === "ahli" ||
      saya.apps?.nubi === "admin");
  if (!ahli) {
    $("bukan-ahli").hidden = false;
  } else {
    const res = await api("/me/apps/nubi/aiconsent").catch(() => null);
    const ada = res?.ok && ((await json(res)).data?.items?.length ?? 0) > 0;
    if (ada) await showChat();
    else showConsent();
  }
</script>
