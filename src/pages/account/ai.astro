---
// Pembantu AI Nubi (fasa 1b): chat baca sahaja. Backend: POST /me/ai/chat (hono-workers).
// Teks model dipapar dengan textContent - tiada innerHTML daripada model. Chat dalam memori page.
import AccountLayout from "../../layouts/AccountLayout.astro";
import Alert from "../../components/ui/Alert.astro";
import Icon from "../../components/ui/Icon.astro";
---

<AccountLayout
  title="Pembantu AI"
  description="Pembantu AI Nubi untuk profil, pelan, aktiviti dan larian kumpulan anda."
>
  <Alert variant="info" title="Ciri untuk ahli" id="bukan-ahli" hidden>
    <p>
      Pembantu AI terbuka untuk ahli Nubi Sport. Keahlian diluluskan pentadbir -
      <a class="link" href="/account/pricing">lihat keahlian</a>.
    </p>
  </Alert>

  <Alert variant="danger" id="ralat" hidden />

  <section
    class="ai-consent"
    id="persetujuan"
    aria-labelledby="t-setuju"
    hidden
  >
    <span class="ai-avatar ai-avatar-bot" aria-hidden="true">N</span>
    <h3 class="display" id="t-setuju">Sebelum mula</h3>
    <p>
      Pembantu AI boleh membaca profil, pelan, aktiviti dan larian kumpulan yang
      anda bincangkan. Soalan dan data itu dihantar ke Command Code dan pembekal
      model untuk diproses. Nubi tak menyimpan chat ini.
    </p>
    <p class="muted">
      Ini bukan nasihat perubatan atau penilaian jurulatih. Berhenti jika sakit,
      sesak dada atau pening. Anda boleh tarik balik persetujuan di Profil >
      Maklumat.
    </p>
    <button class="btn btn-primary" type="button" id="setuju">
      Setuju dan mula
    </button>
  </section>

  <div id="chat" hidden>
    <section class="ai-chat" aria-labelledby="t-chat">
      <header class="ai-kepala">
        <div class="ai-identiti">
          <span class="ai-avatar ai-avatar-bot" aria-hidden="true">N</span>
          <div>
            <h2 class="display" id="t-chat">Pembantu AI</h2>
            <p class="muted">Larian · latihan · pemulihan · pemakanan pelari</p>
          </div>
        </div>
        <span class="ai-kuota" id="kuota">…</span>
      </header>

      <div class="ai-skrin" id="skrin">
        <ul
          class="ai-log"
          id="log"
          role="log"
          aria-live="polite"
          aria-label="Perbualan"
        >
        </ul>
      </div>

      <form class="ai-borangan" id="borang">
        <div class="ai-kotak">
          <label class="sr-only" for="teks">Soalan untuk pembantu AI</label>
          <textarea
            class="ai-teks"
            id="teks"
            rows="1"
            maxlength="2000"
            aria-describedby="kira"
            placeholder="Tanya pasal larian…"
            required></textarea>
          <button
            class="ai-hantar"
            type="submit"
            id="hantar"
            aria-label="Hantar"
            title="Hantar"
          >
            <Icon name="hantar" />
          </button>
        </div>
        <div class="ai-kaki">
          <span id="kira">0 / 2,000</span>
          <span>Enter hantar · Shift+Enter baris baru</span>
        </div>
      </form>

      <div class="ai-saran" id="saran">
        <ul aria-label="Cadangan soalan">
          <li>
            <button type="button" data-contoh="Minggu ini pelan saya apa?">
              Minggu ini pelan saya apa?
            </button>
          </li>
          <li>
            <button
              type="button"
              data-contoh="Aktiviti saya bulan ini macam mana?"
            >
              Aktiviti bulan ini macam mana?
            </button>
          </li>
          <li>
            <button
              type="button"
              data-contoh="Larian kumpulan akan datang apa?"
            >
              Larian akan datang apa?
            </button>
          </li>
        </ul>
      </div>
    </section>
  </div>
</AccountLayout>

<script>
  import { api, currentUser, json } from "../../lib/api";
  import {
    runTool,
    toolContent,
    type AiChatMessage,
    type AiToolCall,
  } from "../../lib/ai-tools";

  const $ = (id: string) => document.getElementById(id)!;
  const ralat = (m: string | null) => {
    $("ralat").textContent = m ?? "";
    $("ralat").hidden = !m;
    if (m) $("ralat").scrollIntoView({ block: "nearest" });
  };
  const log = $("log");
  const skrin = $("skrin") as HTMLElement;
  const saran = $("saran") as HTMLElement;
  const teks = $("teks") as HTMLTextAreaElement;
  const hantar = $("hantar") as HTMLButtonElement;
  const kira = $("kira");
  const messages: AiChatMessage[] = [];
  let sibuk = false;
  let namaSaya = "Awak";
  let assistant: { row: HTMLLIElement; bubble: HTMLElement } | null = null;
  let thinking: { row: HTMLLIElement; label: HTMLElement } | null = null;

  const scrollBottom = () => {
    skrin.scrollTop = skrin.scrollHeight;
  };

  const buatBaris = (role: "user" | "assistant") => {
    const row = document.createElement("li");
    row.className = `ai-row ai-row-${role}`;

    const avatar = document.createElement("span");
    avatar.className = `ai-avatar ai-avatar-${role}`;
    avatar.setAttribute("aria-hidden", "true");
    avatar.textContent =
      role === "assistant" ? "N" : namaSaya.charAt(0).toUpperCase();

    const wrap = document.createElement("div");
    wrap.className = "ai-msg-wrap";
    const nama = document.createElement("span");
    nama.className = "ai-nama";
    nama.textContent = role === "assistant" ? "Nubi" : namaSaya;
    const bubble = document.createElement("div");
    bubble.className = "ai-msg";
    wrap.append(nama, bubble);
    row.append(avatar, wrap);
    return { row, bubble };
  };

  const paparUser = (text: string) => {
    const { row, bubble } = buatBaris("user");
    bubble.textContent = text;
    log.append(row);
    scrollBottom();
  };

  const paparAssistant = (text: string) => {
    if (!assistant) {
      assistant = buatBaris("assistant");
      log.append(assistant.row);
    }
    assistant.bubble.textContent = text;
    scrollBottom();
  };

  const pikir = (label: string) => {
    if (!thinking) {
      const { row, bubble } = buatBaris("assistant");
      row.classList.add("ai-row-thinking");
      bubble.classList.add("ai-thinking");
      const dots = document.createElement("span");
      dots.className = "ai-dots";
      dots.setAttribute("aria-hidden", "true");
      for (let i = 0; i < 3; i++) dots.append(document.createElement("i"));
      const text = document.createElement("span");
      text.className = "ai-thinking-teks";
      bubble.append(dots, text);
      log.append(row);
      thinking = { row, label: text };
    }
    thinking.label.textContent = label;
    scrollBottom();
  };

  const selesaiPikir = () => {
    thinking?.row.remove();
    thinking = null;
  };

  const setBusy = (v: boolean) => {
    sibuk = v;
    hantar.disabled = v;
    hantar.setAttribute("aria-busy", String(v));
  };

  const setQuota = (q: { used: number; limit: number | null } | null) => {
    $("kuota").textContent = q
      ? q.limit === null
        ? `${q.used} · tiada had`
        : `${q.used} / ${q.limit} hari ini`
      : "…";
  };

  const muatKuota = async () => {
    const res = await api("/me/apps/nubi/usage").catch(() => null);
    if (!res?.ok) return setQuota(null);
    const data = (await json(res)).data;
    const ai = data?.items?.find((i: { key: string }) => i.key === "ai");
    if (ai)
      setQuota({
        used: Number(ai.used) || 0,
        limit: ai.limit === null ? null : Number(ai.limit) || 0,
      });
  };

  const tunjukChat = async () => {
    $("persetujuan").hidden = true;
    $("chat").hidden = false;
    await muatKuota();
    if (messages.length === 0 && matchMedia("(pointer: fine)").matches)
      teks.focus();
  };

  const tunjukPersetujuan = () => {
    $("chat").hidden = true;
    $("persetujuan").hidden = false;
  };

  const mesejRalat = (status: number, body: Record<string, any>) => {
    if (body.code === "ai_consent_required") {
      tunjukPersetujuan();
      return "Persetujuan AI diperlukan semula.";
    }
    if (body.code === "ai_quota_full") return "Kuota AI hari ini dah habis.";
    if (status === 429) return "Tunggu sekejap dan cuba lagi.";
    if (status === 503 || status === 502)
      return "AI sibuk sekarang. Cuba lagi sekejap.";
    return "Tak dapat jawapan sekarang. Cuba lagi.";
  };

  const labelTool = (name: string) => {
    if (name === "get_profile") return "Menyemak profil…";
    if (name === "list_plans" || name === "get_plan") return "Menyemak pelan…";
    if (name === "list_activities") return "Menyemak aktiviti…";
    if (name === "list_events") return "Menyemak larian…";
    return "Menyemak data…";
  };

  const hantarSoalan = async () => {
    const text = teks.value.trim();
    if (!text || sibuk) return;
    ralat(null);
    saran.hidden = true;
    messages.push({ role: "user", content: text });
    paparUser(text);
    teks.value = "";
    resizeTeks();
    kira.textContent = "0 / 2,000";
    assistant = null;
    setBusy(true);
    pikir("Memikir…");

    try {
      let reply = "";
      for (let round = 0; round < 6; round++) {
        if (round) pikir("Menyusun jawapan…");
        const res = await api("/me/ai/chat", {
          method: "POST",
          body: JSON.stringify({ messages: messages.slice(-40) }),
        });
        const body = await json(res);
        if (!res.ok) {
          selesaiPikir();
          ralat(mesejRalat(res.status, body));
          return;
        }
        const data = body.data;
        setQuota(data.quota);
        const text = String(data.text ?? "").trim();
        if (text) {
          selesaiPikir();
          paparAssistant(text);
          reply = text;
        }
        const calls: AiToolCall[] = Array.isArray(data.toolCalls)
          ? data.toolCalls
          : [];
        if (!calls.length) {
          selesaiPikir();
          if (!reply) ralat("AI tak beri jawapan. Cuba lagi.");
          else messages.push({ role: "assistant", content: reply });
          return;
        }
        // Satu bubble per turn: teks perantara tidak disimpan dalam history.
        messages.push({ role: "assistant", content: "", toolCalls: calls });
        for (const call of calls) {
          pikir(labelTool(call.name));
          const hasil = await runTool(call.name, call.arguments);
          messages.push({
            role: "tool",
            toolCallId: call.id,
            content: toolContent(hasil),
          });
        }
      }
      selesaiPikir();
      ralat("AI ambil terlalu banyak langkah. Cuba soalan yang lebih ringkas.");
    } catch {
      selesaiPikir();
      ralat("Tiada sambungan. Semak internet dan cuba lagi.");
    } finally {
      setBusy(false);
    }
  };

  const resizeTeks = () => {
    teks.style.height = "auto";
    teks.style.height = `${Math.min(teks.scrollHeight, 128)}px`;
  };

  const simpanPersetujuan = async () => {
    ralat(null);
    const res = await api("/me/apps/nubi/aiconsent/ya", {
      method: "PUT",
      body: JSON.stringify({ engine: 1, data: {}, progress: [] }),
    }).catch(() => null);
    if (!res?.ok)
      return ralat("Tak dapat simpan persetujuan sekarang. Cuba lagi.");
    await tunjukChat();
  };

  teks.addEventListener("input", () => {
    kira.textContent = `${teks.value.length.toLocaleString("ms-MY")} / 2,000`;
    resizeTeks();
  });
  teks.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      void hantarSoalan();
    }
  });
  $("borang").addEventListener("submit", (e) => {
    e.preventDefault();
    void hantarSoalan();
  });
  $("setuju").addEventListener("click", () => void simpanPersetujuan());
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-contoh]"))
    b.addEventListener("click", () => {
      teks.value = b.dataset.contoh ?? "";
      teks.dispatchEvent(new Event("input"));
      void hantarSoalan();
    });

  const saya = await currentUser();
  if (saya?.name) namaSaya = saya.name.split(/\s+/)[0];
  const ahli =
    saya &&
    (saya.role === "owner" ||
      saya.apps?.nubi === "ahli" ||
      saya.apps?.nubi === "admin");
  if (!ahli) {
    $("bukan-ahli").hidden = false;
  } else {
    const res = await api("/me/apps/nubi/aiconsent").catch(() => null);
    const ada = res?.ok && ((await json(res)).data?.items?.length ?? 0) > 0;
    if (ada) await tunjukChat();
    else tunjukPersetujuan();
  }
</script>
