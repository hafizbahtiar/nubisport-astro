---
// One list for all running plans (5K, 10K, 21K, 42K) -> /account/plans/<distance>/view. Index = reusable Table.
import AccountLayout from "../../../layouts/AccountLayout.astro";
import Table from "../../../components/ui/Table.astro";
import Dropdown from "../../../components/ui/Dropdown.astro";
---

<AccountLayout title="Pelan larian">
  <ul class="stat" aria-label="Ringkasan pelan">
    <li><span>Pelan</span><strong id="bil-pelan">0</strong></li>
    <li><span>Sesi siap</span><strong id="bil-siap">0</strong></li>
    <li><span>Awan</span><strong id="bil-awan">0</strong></li>
  </ul>

  <section class="panel" aria-labelledby="t-pelan">
    <div class="panel-kepala">
      <h3 class="display" id="t-pelan">Pelan larian</h3>
      <div class="actions plans-actions">
        <a class="btn btn-primary btn-sm" href="/account/plans/5k/new"
          >Buat pelan 5K</a
        >
        <a class="btn btn-outline btn-sm" href="/account/plans/10k/new"
          >Buat pelan 10K</a
        >
        <a class="btn btn-outline btn-sm" href="/account/plans/21k/new"
          >Buat pelan 21K</a
        >
        <a class="btn btn-outline btn-sm" href="/account/plans/42k/new"
          >Buat pelan 42K</a
        >
      </div>
    </div>
    <p class="muted">
      Semua pelan anda - 5K, 10K, 21K dan 42K. Lihat, edit atau padam.
    </p>

    <Table
      id="plans-table"
      variant="full"
      columns={[
        { label: "Pelan" },
        { label: "Kemajuan" },
        { label: "Storan" },
        { label: "Status" },
        { label: "Tindakan", srOnly: true },
      ]}
      searchPlaceholder="Cari pelan…"
      empty="Belum ada pelan larian."
      emptyHint="Mulakan dengan pelan 5K atau 10K pertama anda."
      emptyIcon="pemasa"
    >
      <div slot="filters">
        <label class="sr-only" for="jarak-butang">Jarak</label>
        <Dropdown
          id="jarak"
          value="semua"
          options={[
            { value: "semua", label: "Semua jarak" },
            { value: "5k", label: "5K" },
            { value: "10k", label: "10K" },
            { value: "21k", label: "21K" },
            { value: "42k", label: "42K" },
          ]}
        />
      </div>
    </Table>
  </section>
</AccountLayout>

<script>
  import { createTable } from "../../../lib/table";
  import { confirmDialog } from "../../../lib/confirm";
  import { activePlan } from "../../../lib/plan-sync";
  import { savedPlans, type SavedPlan } from "../../../lib/plan-list";
  import {
    pullCloud,
    listCloud,
    removeFromCloud,
  } from "../../../lib/cloud-sync";
  import { deletePlan } from "../../../lib/saved-plans";

  const byId = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const textSpan = (text: string, className?: string) => {
    const span = document.createElement("span");
    if (className) span.className = className;
    span.textContent = text;
    return span;
  };
  const planCell = (row: SavedPlan) => {
    const cell = document.createElement("div");
    cell.className = "plan-cell";
    const name = document.createElement("strong");
    name.textContent = row.name;
    cell.append(name, textSpan(row.detail, "muted"));
    return cell;
  };
  const progressCell = (row: SavedPlan) =>
    textSpan(
      `${row.done} / ${row.total} sesi`,
      row.done === row.total && row.total > 0 ? "" : "muted",
    );
  const storageCell = (row: SavedPlan) =>
    textSpan(
      cloudKeys.has(row.key) ? "Awan" : "Peranti",
      cloudKeys.has(row.key) ? "lencana lencana-awan" : "lencana",
    );
  const statusCell = (row: SavedPlan) =>
    row.key === activeKey
      ? textSpan("Aktif", "lencana")
      : textSpan("—", "muted");

  let cloudKeys = new Set<string>();
  let activeKey: string | null = null;

  const confirmDelete = async (row: SavedPlan) => {
    const yes = await confirmDialog({
      title: "Padam pelan ini?",
      message: `Pelan ${row.name} dan ${row.done} tanda siap akan dibuang dari pelayar ini${cloudKeys.has(row.key) ? " dan dari awan" : ""}. Tindakan ini tak boleh dibatalkan.`,
      confirmLabel: "Padam",
      danger: true,
    });
    if (!yes) return;
    deletePlan(row.key);
    if (cloudKeys.has(row.key)) await removeFromCloud(row.key);
    await load();
  };

  const actionsCell = (row: SavedPlan) => {
    const actions = document.createElement("div");
    actions.className = "actions";
    const open = document.createElement("a");
    open.className = "btn btn-outline btn-sm";
    open.href = row.href;
    open.textContent = "Lihat";
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "btn btn-outline btn-sm";
    remove.textContent = "Padam";
    remove.addEventListener("click", () => void confirmDelete(row));
    actions.append(open, remove);
    return actions;
  };

  const table = createTable<SavedPlan>("plans-table", {
    columns: [
      (row) => planCell(row),
      (row) => progressCell(row),
      (row) => storageCell(row),
      (row) => statusCell(row),
      (row) => actionsCell(row),
    ],
    search: (row) => `${row.name} ${row.detail} ${row.kind}`,
  });

  byId<HTMLSelectElement>("jarak").addEventListener("change", (event) => {
    const kind = (event.target as HTMLSelectElement).value;
    table.filter(kind === "semua" ? null : (row) => row.kind === kind);
  });

  async function load() {
    table.loading();
    await pullCloud(); // cloud plans join the local list
    const [cloud, current] = await Promise.all([listCloud(), activePlan()]);
    cloudKeys = new Set(cloud?.items.map((item) => item.key) ?? []);
    activeKey = current?.kunci ?? null;
    const plans = savedPlans();
    table.data(plans);
    byId("bil-pelan").textContent = String(plans.length);
    byId("bil-siap").textContent = String(
      plans.reduce((total, plan) => total + plan.done, 0),
    );
    byId("bil-awan").textContent = String(
      plans.filter((plan) => cloudKeys.has(plan.key)).length,
    );
  }

  await load();
</script>

<style>
  .stat.stat {
    margin-bottom: 1rem;
  }
  .panel.panel {
    justify-items: stretch;
  }
  /* Sel dijana skrip (tiada atribut skop Astro) - perlu :global. */
  :global(.plan-cell) {
    display: grid;
    gap: 0.1rem;
  }
  :global(.plan-cell strong) {
    color: var(--navy);
  }
  @media (max-width: 40rem) {
    .plans-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    .plans-actions .btn {
      padding-inline: 0.75rem; /* label muat sebaris */
    }
  }
</style>
