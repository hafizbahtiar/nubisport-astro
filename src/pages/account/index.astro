---
import AccountLayout from "../../layouts/AccountLayout.astro";
import Alert from "../../components/ui/Alert.astro";
import { NOTA_AWAN } from "../../data/site";
---

<AccountLayout title="Dashboard">
  <section class="salam">
    <p class="eyebrow">Akaun</p>
    <h2 class="display">Hai, <span data-saya-nama>…</span>.</h2>
  </section>

  <Alert variant="warning" title="Pelan disimpan dalam pelayar ini sahaja">
    <p>
      Pelan latihan, tanda siap dan had MAF anda tersimpan di peranti ini
      (localStorage), bukan dalam akaun. Ia hilang jika anda kosongkan data
      pelayar, guna mod peribadi, atau tukar ke telefon lain. {NOTA_AWAN}
    </p>
  </Alert>

  <ul class="stat" aria-label="Ringkasan">
    <li><span>Pelan</span><strong id="bil-pelan">0</strong></li>
    <li><span>Sesi siap</span><strong id="bil-siap">0</strong></li>
    <li><span>Keahlian</span><strong id="keahlian">…</strong></li>
  </ul>

  <div class="grid">
    <section class="panel">
      <div class="panel-kepala">
        <h3 class="display">Pelan saya</h3>
        <div class="actions">
          <a class="btn btn-primary btn-sm" href="/account/pelan-5k">Pelan 5K</a
          >
          <a class="btn btn-outline btn-sm" href="/account/pelan-jarak"
            >Pelan 10K / 21K</a
          >
        </div>
      </div>
      <ol class="senarai" id="pelan"></ol>
      <p class="muted" id="tiada-pelan" hidden>
        Belum ada pelan di pelayar ini. Buat satu - ia muncul di sini dengan
        kemajuannya.
      </p>
    </section>

    <div class="sisi">
      <section class="panel">
        <h3 class="display">Profil</h3>
        <p>
          <strong data-saya-nama></strong><br /><span
            class="muted"
            data-saya-emel></span>
        </p>
        <p class="muted" id="peranan"></p>
        <a class="btn btn-outline btn-sm" href="/account/profil">Urus profil</a>
      </section>
      <section class="panel">
        <h3 class="display">Lari ikut nadi</h3>
        <p class="muted" id="maf-terakhir">
          Kira had kadar nadi MAF, kemudian tanda "Ikut nadi" dalam pelan.
        </p>
        <a class="btn btn-outline btn-sm" href="/account/maf">Kira MAF</a>
      </section>
    </div>
  </div>
</AccountLayout>

<script>
  import { sesiSaya } from "../../lib/api";
  import { TAHAP, buatPelan, type Tahap } from "../../lib/pelan-5k";
  import {
    JARAK,
    buatPelanJarak,
    jam,
    type Jarak,
  } from "../../lib/pelan-jarak";
  import { KUNCI_DIBUAT, baca, padamPelan } from "../../lib/pelan-tersimpan";
  import { sahkan } from "../../lib/sahkan";

  const $ = (id: string) => document.getElementById(id)!;

  // Pengawal sesi + nama/e-mel = AccountLayout. Di sini hanya peranan.
  const s = await sesiSaya();
  if (s) {
    const nubi = s.apps?.nubi;
    $("keahlian").textContent =
      s.role === "owner"
        ? "Owner"
        : nubi === "admin"
          ? "Admin"
          : nubi === "ahli"
            ? "Ahli"
            : "Belum ahli";
    $("peranan").textContent =
      nubi === "ahli" || nubi === "admin" || s.role === "owner"
        ? "Ahli Nubi Sport."
        : "Pengguna berdaftar - keahlian Nubi Sport diluluskan oleh admin.";
  }

  // Pelan tersimpan (lib/pelan-tersimpan.ts): "pelan-5k:<bulan>-<tahap>-<masa>-<hari>" atau
  // "pelan-10k|21k:<minggu>-<masa>-<sasaran>-<hari>".
  function butiran(kunci: string) {
    const [jenis, isi] = kunci.split(":");
    const [a, b, c, hari] = isi.split("-");
    if (jenis === "pelan-5k") {
      const h = buatPelan({
        bulan: +a,
        tahap: b as Tahap,
        hari: +hari,
        masa5k: c ? +c : undefined,
      });
      return (
        h.ok && {
          h,
          nama: `5K · ${a} bulan · ${hari} hari seminggu`,
          sub: `${TAHAP[b as Tahap]}${c ? ` (${c} min)` : ""}`,
          href: `/account/pelan-5k?${new URLSearchParams({ bulan: a, tahap: b, hari, ...(c ? { masa: c } : {}) })}`,
        }
      );
    }
    const jarak = jenis.slice("pelan-".length) as Jarak;
    if (!(jarak in JARAK)) return false;
    const h = buatPelanJarak({
      jarak,
      minggu: +a,
      masa: +b,
      sasaran: c ? +c : undefined,
      hari: +hari,
    });
    const k = JARAK[jarak];
    return (
      h.ok && {
        h,
        nama: `${k.nama} · ${a} minggu · ${hari} hari seminggu`,
        sub: `${k.prasyarat.nama} ${b} min → ${c ? `bawah ${jam(+c)}` : "habis"}`,
        href: `/account/pelan-jarak?${new URLSearchParams({ jarak, minggu: a, masa: b, hari, ...(c ? { sasaran: c } : {}) })}`,
      }
    );
  }

  const senarai = $("pelan");
  function papar() {
    senarai.replaceChildren();
    let jumlahSiap = 0;
    for (const kunci of new Set(baca(KUNCI_DIBUAT))) {
      const p = butiran(kunci);
      if (!p) continue;
      const { h, nama } = p;
      const jumlah = h.minggu.reduce((a, w) => a + w.sesi.length, 0);
      const siap = new Set(baca(kunci)).size;
      jumlahSiap += siap;
      const li = document.createElement("li");
      li.innerHTML = `<a href="${p.href}">
          <strong>${nama}</strong>
          <span>${p.sub}</span>
          <progress max="${jumlah}" value="${siap}"></progress>
          <small>${siap} / ${jumlah} sesi siap · ${Math.round((siap / jumlah) * 100)}%</small>
        </a>
        <button class="btn btn-outline btn-sm padam" type="button" aria-label="Padam pelan ${nama}">Padam</button>`;
      li.querySelector("button")!.addEventListener("click", async () => {
        const ya = await sahkan({
          tajuk: "Padam pelan ini?",
          mesej: `Pelan ${nama} dan ${siap} tanda siap akan dibuang dari pelayar ini. Tindakan ini tak boleh diundur.`,
          ya: "Padam",
          bahaya: true,
        });
        if (!ya) return;
        padamPelan(kunci);
        papar();
      });
      senarai.append(li);
    }
    $("tiada-pelan").hidden = senarai.children.length > 0;
    $("bil-pelan").textContent = String(senarai.children.length);
    $("bil-siap").textContent = String(jumlahSiap);
  }
  papar();

  // Had MAF terakhir (Maf.astro versi akaun).
  try {
    const m = JSON.parse(localStorage.getItem("maf:terakhir") ?? "null");
    if (m && Number.isInteger(m.maf) && Number.isInteger(m.bawah))
      $("maf-terakhir").textContent =
        `Had MAF anda: ${m.maf} denyut/min (julat ${m.bawah}-${m.maf}).`;
  } catch {
    /* tiada / rosak */
  }
</script>

<style>
  .salam h2 {
    margin: 0.25rem 0;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--navy);
  }
  .salam p {
    margin: 0;
  }
  .salam {
    padding: 0; /* bukan section awam (global.css beri padding besar) */
  }

  .stat {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1rem;
  }
  .stat li,
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .stat li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
  }
  .stat span {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stat strong {
    font-family: var(--display);
    font-style: italic;
    font-size: 2rem;
    color: var(--navy);
  }

  /* Pelan lebar di kiri, profil/alat di kanan; satu lajur bila sempit. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: 1rem;
    align-items: start;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sisi {
    display: grid;
    gap: 1rem;
  }
  .panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.25rem 1.5rem;
  }
  .panel h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--navy);
  }
  .panel p {
    margin: 0;
  }
  .panel-kepala {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .senarai {
    justify-self: stretch;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  /* Item dijana skrip - tiada atribut skop Astro, jadi :global. */
  .senarai :global(li) {
    position: relative;
  }
  .senarai :global(a) {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 6.5rem 1rem 1rem; /* ruang untuk butang Padam */
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
  }
  .senarai :global(a:hover) {
    border-color: var(--orange);
  }
  .senarai :global(.padam) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }
  .senarai :global(span),
  .senarai :global(small) {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .senarai :global(progress) {
    width: 100%;
    height: 0.5rem;
    accent-color: var(--orange);
  }
</style>
