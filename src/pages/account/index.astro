---
import AccountLayout from "../../layouts/AccountLayout.astro";
---

<AccountLayout title="Dashboard">
  <section class="salam">
    <p class="eyebrow">Akaun</p>
    <h2 class="display">Hai, <span data-saya-nama>…</span>.</h2>
  </section>

  <ul class="stat" aria-label="Ringkasan">
    <li><span>Pelan</span><strong id="bil-pelan">0</strong></li>
    <li><span>Sesi siap</span><strong id="bil-siap">0</strong></li>
    <li><span>Keahlian</span><strong id="keahlian">…</strong></li>
  </ul>

  <div class="grid">
    <section class="panel">
      <div class="panel-kepala">
        <h3 class="display">Pelan saya</h3>
        <div class="actions">
          <a class="btn btn-primary btn-sm" href="/account/pelan-5k">Pelan 5K</a
          >
          <a class="btn btn-outline btn-sm" href="/account/pelan-jarak"
            >Pelan 10K / 21K</a
          >
        </div>
      </div>
      <div class="awan-meter" id="awan">
        <p id="awan-teks" class="muted">Menyemak awan…</p>
        <span class="awan-slot" id="awan-slot" aria-hidden="true"></span>
      </div>
      <p class="muted awan-nota">
        Pelan <strong>Awan</strong> ikut akaun anda ke peranti lain. Pelan{" "}
        <strong>Peranti ini</strong> hanya dalam pelayar ini - hilang jika data pelayar
        dikosongkan.
      </p>
      <div class="alert alert-info tukar" id="tukar" hidden>
        <p>
          Awan penuh. Pilih pelan awan untuk diganti dengan
          <strong id="tukar-nama"></strong> - pelan yang diganti kekal di peranti
          ini.
        </p>
        <button class="btn btn-outline btn-sm" type="button" id="tukar-batal"
          >Batal</button
        >
      </div>
      <ol class="senarai" id="pelan"></ol>
      <p class="muted" id="tiada-pelan" hidden>
        Belum ada pelan di pelayar ini. Buat satu - ia muncul di sini dengan
        kemajuannya.
      </p>
    </section>

    <div class="sisi">
      <section class="panel">
        <h3 class="display">Profil</h3>
        <p>
          <strong data-saya-nama></strong><br /><span
            class="muted"
            data-saya-emel></span>
        </p>
        <p class="muted" id="peranan"></p>
        <a class="btn btn-outline btn-sm" href="/account/profil">Urus profil</a>
      </section>
      <section class="panel">
        <h3 class="display">Lari ikut nadi</h3>
        <p class="muted" id="maf-terakhir">
          Kira had kadar nadi MAF, kemudian tanda "Ikut nadi" dalam pelan.
        </p>
        <a class="btn btn-outline btn-sm" href="/account/maf">Kira MAF</a>
      </section>
    </div>
  </div>
</AccountLayout>

<script>
  import { sesiSaya } from "../../lib/api";
  import { TAHAP, buatPelan, type Tahap } from "../../lib/pelan-5k";
  import {
    JARAK,
    buatPelanJarak,
    jam,
    type Jarak,
  } from "../../lib/pelan-jarak";
  import {
    KUNCI_DIBUAT,
    baca,
    bacaParam,
    padamPelan,
  } from "../../lib/pelan-tersimpan";
  import {
    VERSI_ENJIN,
    keluarAwan,
    lencana,
    senaraiAwan,
    simpanAwan,
    tarikAwan,
    type Awan,
  } from "../../lib/awan";
  import { sahkan } from "../../lib/sahkan";

  const $ = (id: string) => document.getElementById(id)!;

  // Pengawal sesi + nama/e-mel = AccountLayout. Di sini hanya peranan.
  const s = await sesiSaya();
  if (s) {
    const nubi = s.apps?.nubi;
    $("keahlian").textContent =
      s.role === "owner"
        ? "Owner"
        : nubi === "admin"
          ? "Admin"
          : nubi === "ahli"
            ? "Ahli"
            : "Belum ahli";
    $("peranan").textContent =
      nubi === "ahli" || nubi === "admin" || s.role === "owner"
        ? "Ahli Nubi Sport."
        : "Pengguna berdaftar - keahlian Nubi Sport diluluskan oleh admin.";
  }

  // Pelan tersimpan (lib/pelan-tersimpan.ts): "pelan-5k:<bulan>-<tahap>-<masa>-<hari>" atau
  // "pelan-10k|21k:<minggu>-<masa>-<sasaran>-<hari>".
  function butiran(kunci: string) {
    const [jenis, isi] = kunci.split(":");
    const [a, b, c, hari] = isi.split("-");
    if (jenis === "pelan-5k") {
      const h = buatPelan({
        bulan: +a,
        tahap: b as Tahap,
        hari: +hari,
        masa5k: c ? +c : undefined,
      });
      return (
        h.ok && {
          h,
          nama: `5K · ${a} bulan · ${hari} hari seminggu`,
          sub: `${TAHAP[b as Tahap]}${c ? ` (${c} min)` : ""}`,
          href: `/account/pelan-5k?${new URLSearchParams(bacaParam(kunci) ?? { bulan: a, tahap: b, hari, ...(c ? { masa: c } : {}) })}`,
        }
      );
    }
    const jarak = jenis.slice("pelan-".length) as Jarak;
    if (!(jarak in JARAK)) return false;
    const h = buatPelanJarak({
      jarak,
      minggu: +a,
      masa: +b,
      sasaran: c ? +c : undefined,
      hari: +hari,
    });
    const k = JARAK[jarak];
    return (
      h.ok && {
        h,
        nama: `${k.nama} · ${a} minggu · ${hari} hari seminggu`,
        sub: `${k.prasyarat.nama} ${b} min → ${c ? `bawah ${jam(+c)}` : "habis"}`,
        href: `/account/pelan-jarak?${new URLSearchParams(bacaParam(kunci) ?? { jarak, minggu: a, masa: b, hari, ...(c ? { sasaran: c } : {}) })}`,
      }
    );
  }

  const senarai = $("pelan");
  // awan: null = belum tahu / tak dapat dicapai. menukar = pelan peranti yang menunggu slot awan.
  let awan: Awan | null = null;
  let menukar: string | null = null;
  const segar = async () => {
    awan = await senaraiAwan();
    papar();
  };
  // Butang dalam item: [teks, tindakan, kelas]
  const butang = (
    teks: string,
    buat: () => Promise<unknown> | void,
    kelas = "btn-outline",
  ) => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = `btn ${kelas} btn-sm`;
    b.textContent = teks;
    b.addEventListener("click", async () => {
      b.disabled = true;
      await buat();
      b.disabled = false;
    });
    return b;
  };
  const gagal = () =>
    ($("awan-teks").textContent =
      "Tak dapat hubungi awan. Semak internet dan cuba lagi.");

  function papar() {
    senarai.replaceChildren();
    let jumlahSiap = 0;
    const diAwan = new Set(awan?.items.map((i) => i.key));
    const versiLama = new Set(
      awan?.items.filter((i) => i.engine < VERSI_ENJIN).map((i) => i.key),
    );
    // Awan dulu, kemudian peranti ini (susunan dibuat).
    const kunci = [...new Set(baca(KUNCI_DIBUAT))].sort(
      (x, y) => +diAwan.has(y) - +diAwan.has(x),
    );
    for (const k of kunci) {
      const p = butiran(k);
      if (!p) continue;
      const { h, nama } = p;
      const jumlah = h.minggu.reduce((n, w) => n + w.sesi.length, 0);
      const siap = new Set(baca(k)).size;
      jumlahSiap += siap;
      const awanIni = diAwan.has(k);
      const li = document.createElement("li");
      if (menukar === k) li.className = "menunggu";
      li.innerHTML = `<a href="${p.href}">
          <strong>${nama}</strong>
          <span>${p.sub}</span>
          <progress max="${jumlah}" value="${siap}"></progress>
          <small>${siap} / ${jumlah} sesi siap · ${Math.round((siap / jumlah) * 100)}%</small>
        </a>
        <div class="item-bawah">${awan ? lencana(awanIni) : ""}${
          versiLama.has(k)
            ? `<span class="muted kecil">Pelan dikemas kini sejak disimpan</span>`
            : ""
        }<span class="item-butang"></span></div>`;
      const kotak = li.querySelector(".item-butang")!;

      if (awan && menukar && awanIni)
        kotak.append(
          butang(
            "Ganti dengan pelan ini",
            async () => {
              const r = await simpanAwan(menukar!, k);
              if (r !== "ok") return gagal();
              menukar = null;
              await segar();
            },
            "btn-primary",
          ),
        );
      else if (awan && !menukar && awanIni)
        kotak.append(
          butang("Keluarkan dari awan", async () => {
            if (!(await keluarAwan(k))) return gagal();
            await segar();
          }),
        );
      else if (awan && !menukar && !awanIni)
        kotak.append(
          butang("Simpan ke awan", async () => {
            if (awan!.items.length >= awan!.limit) {
              menukar = k;
              return papar();
            }
            const r = await simpanAwan(k);
            if (r === "penuh") menukar = k;
            else if (r === "ralat") return gagal();
            await segar();
          }),
        );
      if (!menukar)
        kotak.append(
          butang("Padam", async () => {
            const ya = await sahkan({
              tajuk: "Padam pelan ini?",
              mesej: `Pelan ${nama} dan ${siap} tanda siap akan dibuang dari pelayar ini${awanIni ? " dan dari awan" : ""}. Tindakan ini tak boleh diundur.`,
              ya: "Padam",
              bahaya: true,
            });
            if (!ya) return;
            padamPelan(k);
            if (awanIni) await keluarAwan(k);
            await segar();
          }),
        );
      senarai.append(li);
    }
    $("tiada-pelan").hidden = senarai.children.length > 0;
    $("bil-pelan").textContent = String(senarai.children.length);
    $("bil-siap").textContent = String(jumlahSiap);

    // Meter slot awan + mod tukar.
    if (awan) {
      const guna = awan.items.length;
      $("awan-teks").textContent =
        `Awan: ${guna} / ${awan.limit} slot digunakan`;
      $("awan-slot").innerHTML = Array.from(
        { length: awan.limit },
        (_, i) => `<i${i < guna ? ' class="penuh"' : ""}></i>`,
      ).join("");
    }
    $("tukar").hidden = !menukar;
    if (menukar)
      $("tukar-nama").textContent = butiran(menukar)
        ? (butiran(menukar) as { nama: string }).nama
        : "";
  }
  $("tukar-batal").addEventListener("click", () => {
    menukar = null;
    papar();
  });

  papar();
  // Gabung awan (pelan dari peranti lain + tanda siap terkini), kemudian lukis dengan lencana.
  awan = await tarikAwan();
  if (!awan) gagal();
  papar();
  if (location.hash === "#awan") $("awan").scrollIntoView();

  // Had MAF terakhir (Maf.astro versi akaun).
  try {
    const m = JSON.parse(localStorage.getItem("maf:terakhir") ?? "null");
    if (m && Number.isInteger(m.maf) && Number.isInteger(m.bawah))
      $("maf-terakhir").textContent =
        `Had MAF anda: ${m.maf} denyut/min (julat ${m.bawah}-${m.maf}) - disimpan dalam pelayar ini.`;
  } catch {
    /* tiada / rosak */
  }
</script>

<style>
  .salam h2 {
    margin: 0.25rem 0;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--navy);
  }
  .salam p {
    margin: 0;
  }
  .salam {
    padding: 0; /* bukan section awam (global.css beri padding besar) */
  }

  .stat {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .stat li,
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .stat li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
  }
  .stat span {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stat strong {
    font-family: var(--display);
    font-style: italic;
    font-size: 2rem;
    color: var(--navy);
  }
  /* Telefon: tiga kad kekal sebaris (bukan tiga skrin), teks lebih kecil. */
  @media (max-width: 36rem) {
    .stat {
      gap: 0.5rem;
    }
    .stat li {
      padding: 0.75rem;
    }
    .stat span {
      font-size: 0.68rem;
      letter-spacing: 0.06em;
    }
    .stat strong {
      font-size: 1.35rem;
      line-height: 1.1;
    }
  }

  /* Pelan lebar di kiri, profil/alat di kanan; satu lajur bila sempit. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: 1rem;
    align-items: start;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sisi {
    display: grid;
    gap: 1rem;
  }
  .panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.25rem 1.5rem;
  }
  .panel h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--navy);
  }
  .panel p {
    margin: 0;
  }
  .panel-kepala {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .senarai {
    justify-self: stretch;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  /* Item dijana skrip - tiada atribut skop Astro, jadi :global. */
  .senarai :global(li) {
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .senarai :global(li:hover) {
    border-color: var(--orange);
  }
  .senarai :global(li.menunggu) {
    border-color: var(--info-line);
    background: var(--info-bg);
  }
  .senarai :global(a) {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1rem 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .senarai :global(.item-bawah) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1rem 0.85rem;
  }
  .senarai :global(.item-butang) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }
  .senarai :global(.kecil) {
    font-size: 0.8rem;
  }

  .awan-meter {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    scroll-margin-top: 5rem;
  }
  .awan-meter p {
    font-weight: 600;
  }
  .awan-slot {
    display: flex;
    gap: 0.35rem;
  }
  .awan-slot :global(i) {
    width: 2.25rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line);
  }
  .awan-slot :global(i.penuh) {
    background: var(--info-ink);
  }
  .awan-nota {
    font-size: 0.85rem;
  }
  .tukar {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .senarai :global(span),
  .senarai :global(small) {
    color: var(--muted);
    font-size: 0.9rem;
  }
  /* Trek kelabu + isian oren - lalai pelayar (Safari/Chrome) nampak penuh gelap pada 0%. */
  .senarai :global(progress) {
    width: 100%;
    height: 0.5rem;
    appearance: none;
    border: 0;
    border-radius: 999px;
    overflow: hidden;
    background: var(--line);
  }
  .senarai :global(progress::-webkit-progress-bar) {
    background: var(--line);
  }
  .senarai :global(progress::-webkit-progress-value) {
    background: var(--orange);
    border-radius: 999px;
  }
  .senarai :global(progress::-moz-progress-bar) {
    background: var(--orange);
    border-radius: 999px;
  }
</style>
