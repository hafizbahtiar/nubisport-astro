---
import AccountLayout from "../../layouts/AccountLayout.astro";
---

<AccountLayout title="Dashboard">
  <section class="salam">
    <p class="eyebrow">Akaun</p>
    <h2 class="display">Hai, <span data-saya-nama>…</span>.</h2>
  </section>

  <ul class="stat" aria-label="Ringkasan">
    <li><span>Pelan</span><strong id="bil-pelan">0</strong></li>
    <li><span>Sesi siap</span><strong id="bil-siap">0</strong></li>
    <li><span>Keahlian</span><strong id="keahlian">…</strong></li>
  </ul>

  <section class="panel" id="aktif" hidden>
    <div class="panel-kepala">
      <h3 class="display">Pelan aktif</h3>
      <a class="btn btn-outline btn-sm" id="aktif-buka" href="#" hidden
        >Buka pelan</a
      >
    </div>
    <p class="muted" id="aktif-nota">Menyemak pelan aktif…</p>
    <p id="aktif-seterusnya" hidden></p>
    <p id="aktif-minggu" hidden></p>
    <p id="aktif-minit" hidden></p>
    <div class="beban-senarai" id="aktif-beban" hidden></div>
    <div id="aktif-sambung" hidden></div>
  </section>

  <div class="grid">
    <section class="panel">
      <div class="panel-kepala">
        <h3 class="display">Pelan saya</h3>
        <div class="actions">
          <a class="btn btn-primary btn-sm" href="/account/plan-5k">Pelan 5K</a>
          <a class="btn btn-outline btn-sm" href="/account/distance-plan"
            >Pelan 10K / 21K</a
          >
        </div>
      </div>
      <div class="awan-meter" id="awan">
        <p id="awan-teks" class="muted">Menyemak awan…</p>
        <span class="awan-slot" id="awan-slot" aria-hidden="true"></span>
      </div>
      <p class="muted awan-nota">
        Pelan <strong>Awan</strong> ikut akaun anda ke peranti lain. Pelan{" "}
        <strong>Peranti ini</strong> hanya dalam pelayar ini - hilang kalau data pelayar
        dikosongkan.
      </p>
      <div class="alert alert-info tukar" id="tukar" hidden>
        <p>
          Awan penuh. Pilih pelan awan untuk diganti dengan
          <strong id="tukar-nama"></strong> - pelan yang diganti kekal di peranti
          ini.
        </p>
        <button class="btn btn-outline btn-sm" type="button" id="tukar-batal"
          >Batal</button
        >
      </div>
      <ol class="senarai" id="pelan"></ol>
      <p class="muted" id="tiada-pelan" hidden>
        Belum ada pelan di pelayar ini. Buat satu - nanti ia muncul di sini
        dengan kemajuannya.
      </p>
    </section>

    <div class="sisi">
      <section class="panel">
        <h3 class="display">Profil</h3>
        <p>
          <strong data-saya-nama></strong><br /><span
            class="muted"
            data-saya-emel></span>
        </p>
        <p class="muted" id="peranan"></p>
        <a class="btn btn-outline btn-sm" href="/account/profile">Urus profil</a
        >
      </section>
      <section class="panel">
        <h3 class="display">Lari ikut nadi</h3>
        <p class="muted" id="maf-terakhir">
          Kira had kadar nadi MAF, kemudian tanda "Ikut nadi" dalam pelan.
        </p>
        <a class="btn btn-outline btn-sm" href="/account/maf">Kira MAF</a>
      </section>
    </div>
  </div>
</AccountLayout>

<script>
  import { currentUser } from "../../lib/api";
  import {
    LEVELS,
    resumePoint,
    startMonday,
    isoDate,
    formatPace,
    type Level,
  } from "../../lib/plan-5k";
  import {
    DISTANCES,
    formatTime,
    type Distance,
  } from "../../lib/distance-plan";
  import { loadBarHtml } from "../../lib/plan-render";
  import {
    CREATED_KEY,
    readList,
    readParams,
    deletePlan,
  } from "../../lib/saved-plans";
  import {
    ENGINE_VERSION,
    removeFromCloud,
    storageBadge,
    listCloud,
    saveToCloud,
    pullCloud,
    type CloudList,
  } from "../../lib/cloud-sync";
  import { confirmDialog } from "../../lib/confirm";
  import { todayMY, addDays } from "../../lib/date";
  import {
    isMember,
    activitiesBetween,
    sessionLabel,
    activePlan,
    planFromParams,
    weeklyLoad,
  } from "../../lib/plan-sync";

  const $ = (id: string) => document.getElementById(id)!;

  // Pengawal sesi + nama/e-mel = AccountLayout. Di sini hanya peranan.
  const s = await currentUser();
  if (s) {
    const nubi = s.apps?.nubi;
    $("keahlian").textContent =
      s.role === "owner"
        ? "Pemilik"
        : nubi === "admin"
          ? "Pentadbir"
          : nubi === "ahli"
            ? "Ahli"
            : "Belum ahli";
    $("peranan").textContent =
      nubi === "ahli" || nubi === "admin" || s.role === "owner"
        ? "Ahli Nubi Sport."
        : "Pengguna berdaftar - keahlian Nubi Sport diluluskan pentadbir.";
  }

  // Pelan tersimpan (lib/saved-plans.ts): parameter "<kunci>#p" (v2: lumba, pace, minggu 5K), atau - pelan
  // lama tanpa parameter - dari kunci "pelan-5k:<bulan>-<tahap>-<masa>-<hari>" / "pelan-10k|21k:<minggu>-<masa>-<sasaran>-<hari>".
  function butiran(kunci: string) {
    const [jenis, isi] = kunci.split(":");
    const [a, b, c, hari] = isi.split("-");
    const p: Record<string, string> =
      readParams(kunci) ??
      (jenis === "pelan-5k"
        ? { bulan: a, tahap: b, hari, ...(c ? { masa: c } : {}) }
        : {
            jarak: jenis.slice("pelan-".length),
            minggu: a,
            masa: b,
            hari,
            ...(c ? { sasaran: c } : {}),
          });
    const h = planFromParams(kunci, p);
    if (!h) return false;
    const lumba = p.lumba
      ? `Lumba ${new Date(`${p.lumba}T00:00:00`).toLocaleDateString("ms-MY", { day: "numeric", month: "short", year: "numeric" })} · ${p.minggu} minggu`
      : null;
    if (h.jenis === "5k")
      return {
        h,
        p,
        nama: `5K · ${lumba ?? `${p.bulan} bulan`} · ${p.hari} hari seminggu`,
        sub: `${LEVELS[p.tahap as Level]}${p.masa ? ` (${p.masa} min)` : ""}${p.pace ? ` · pace ${formatPace(+p.pace)}/km` : ""}`,
        href: `/account/plan-5k?${new URLSearchParams(p)}`,
      };
    const k = DISTANCES[h.jenis as Distance];
    const sasaran = p.pace
      ? (+p.pace * k.km) / 60
      : p.sasaran
        ? +p.sasaran
        : null;
    return {
      h,
      p,
      nama: `${k.nama} · ${lumba ?? `${p.minggu} minggu`} · ${p.hari} hari seminggu`,
      sub: `${k.prasyarat.nama} ${p.masa} min → ${sasaran ? `bawah ${formatTime(sasaran)}` : "habis"}`,
      href: `/account/distance-plan?${new URLSearchParams(p)}`,
    };
  }

  const senarai = $("pelan");
  // awan: null = belum tahu / tidak dapat dicapai. menukar = pelan peranti yang menunggu slot awan.
  let awan: CloudList | null = null;
  let menukar: string | null = null;
  const segar = async () => {
    awan = await listCloud();
    papar();
  };
  // Butang dalam item: [teks, tindakan, kelas]
  const butang = (
    teks: string,
    buat: () => Promise<unknown> | void,
    kelas = "btn-outline",
  ) => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = `btn ${kelas} btn-sm`;
    b.textContent = teks;
    b.addEventListener("click", async () => {
      b.disabled = true;
      await buat();
      b.disabled = false;
    });
    return b;
  };
  const gagal = () =>
    ($("awan-teks").textContent =
      "Tak dapat hubungi awan. Semak internet dan cuba lagi.");

  function papar() {
    senarai.replaceChildren();
    let jumlahSiap = 0;
    const diAwan = new Set(awan?.items.map((i) => i.key));
    const versiLama = new Set(
      awan?.items.filter((i) => i.engine < ENGINE_VERSION).map((i) => i.key),
    );
    // Awan dahulu, kemudian peranti ini (susunan dibuat).
    const kunci = [...new Set(readList(CREATED_KEY))].sort(
      (x, y) => +diAwan.has(y) - +diAwan.has(x),
    );
    for (const k of kunci) {
      const p = butiran(k);
      if (!p) continue;
      const { h, nama } = p;
      const jumlah = h.minggu.reduce((n, w) => n + w.sesi.length, 0);
      const siap = new Set(readList(k)).size;
      jumlahSiap += siap;
      const awanIni = diAwan.has(k);
      const li = document.createElement("li");
      if (menukar === k) li.className = "menunggu";
      li.innerHTML = `<a href="${p.href}">
          <strong>${nama}</strong>
          <span>${p.sub}</span>
          <progress max="${jumlah}" value="${siap}"></progress>
          <small>${siap} / ${jumlah} sesi siap · ${Math.round((siap / jumlah) * 100)}%</small>
        </a>
        <div class="item-bawah">${awan ? storageBadge(awanIni) : ""}${
          versiLama.has(k)
            ? `<span class="muted kecil">Pelan dikemas kini sejak disimpan</span>`
            : ""
        }<span class="item-butang"></span></div>`;
      const kotak = li.querySelector(".item-butang")!;

      if (awan && menukar && awanIni)
        kotak.append(
          butang(
            "Ganti dengan pelan ini",
            async () => {
              const r = await saveToCloud(menukar!, k);
              if (r !== "ok") return gagal();
              menukar = null;
              await segar();
            },
            "btn-primary",
          ),
        );
      else if (awan && !menukar && awanIni)
        kotak.append(
          butang("Keluarkan dari awan", async () => {
            if (!(await removeFromCloud(k))) return gagal();
            await segar();
          }),
        );
      else if (awan && !menukar && !awanIni)
        kotak.append(
          butang("Simpan ke awan", async () => {
            // Lebih had (peranan ditarik / had turun): tukar pun tak muat - nota di meter, tiada mod tukar.
            if (awan!.items.length > awan!.limit) return papar();
            if (awan!.items.length >= awan!.limit) {
              menukar = k;
              return papar();
            }
            const r = await saveToCloud(k);
            if (r === "penuh") menukar = k;
            else if (r === "ralat") return gagal();
            await segar();
          }),
        );
      if (!menukar)
        kotak.append(
          butang("Padam", async () => {
            const ya = await confirmDialog({
              title: "Padam pelan ini?",
              message: `Pelan ${nama} dan ${siap} tanda siap akan dibuang dari pelayar ini${awanIni ? " dan dari awan" : ""}. Tindakan ini tak boleh dibatalkan.`,
              confirmLabel: "Padam",
              danger: true,
            });
            if (!ya) return;
            deletePlan(k);
            if (awanIni) await removeFromCloud(k);
            await segar();
          }),
        );
      senarai.append(li);
    }
    $("tiada-pelan").hidden = senarai.children.length > 0;
    $("bil-pelan").textContent = String(senarai.children.length);
    $("bil-siap").textContent = String(jumlahSiap);

    // Meter slot awan + mod tukar.
    if (awan) {
      const guna = awan.items.length;
      $("awan-teks").textContent =
        `Awan: ${guna} / ${awan.limit} slot digunakan` +
        (guna > awan.limit
          ? ` - lebih had. Pelan sedia ada selamat; keluarkan ${guna - awan.limit + 1} dari awan untuk simpan pelan baru.`
          : "");
      $("awan-slot").innerHTML = Array.from(
        { length: awan.limit },
        (_, i) => `<i${i < guna ? ' class="penuh"' : ""}></i>`,
      ).join("");
    }
    $("tukar").hidden = !menukar;
    if (menukar)
      $("tukar-nama").textContent = butiran(menukar)
        ? (butiran(menukar) as { nama: string }).nama
        : "";
  }
  $("tukar-batal").addEventListener("click", () => {
    menukar = null;
    papar();
  });

  papar();
  // Gabung awan (pelan dari peranti lain + tanda siap terkini), kemudian lukis dengan lencana.
  awan = await pullCloud();
  if (!awan) gagal();
  papar();
  if (location.hash === "#awan") $("awan").scrollIntoView();

  // Pelan aktif (ahli sahaja, lib/plan-sync.ts): sesi seterusnya + minggu ini (Isnin-Ahad, waktu Malaysia).
  if (isMember(s)) {
    $("aktif").hidden = false;
    const p = await activePlan();
    if (!p)
      $("aktif-nota").textContent =
        'Tiada pelan aktif. Buka pelan awan yang ada tarikh mula dan tekan "Jadikan pelan aktif" - aktiviti Strava yang dimuat naik akan tanda sesinya siap.';
    else {
      const baris = (id: string, teks: string) => {
        $(id).textContent = teks;
        $(id).hidden = false;
      };
      const hariIni = todayMY();
      const isnin = addDays(
        hariIni,
        -((new Date(`${hariIni}T00:00:00Z`).getUTCDay() + 6) % 7),
      );
      const ahad = addDays(isnin, 6);
      const siap = new Set(readList(p.kunci));
      const lagi = p.sesi.find((x) => x.tarikh >= hariIni && !siap.has(x.id));
      const minggu = p.sesi.filter(
        (x) => x.tarikh >= isnin && x.tarikh <= ahad,
      );
      // Satu permintaan dari mula pelan: minit minggu ini + bar beban mingguan.
      const semua = await activitiesBetween(
        p.sesi[0].tarikh < isnin ? p.sesi[0].tarikh : isnin,
      );
      const akt = semua ?? [];
      const sebenar = akt
        .filter(
          (a) =>
            (a.sport === "run" || a.sport === "walk") &&
            todayMY(new Date(a.startedAt)) >= isnin,
        )
        .reduce((n, a) => n + a.movingS / 60, 0);
      const href = butiran(p.kunci);
      if (href) {
        ($("aktif-buka") as HTMLAnchorElement).href = href.href;
        $("aktif-buka").hidden = false;
        $("aktif-nota").textContent = href.nama;
      }
      baris(
        "aktif-seterusnya",
        lagi
          ? `Sesi seterusnya: ${new Date(`${lagi.tarikh}T00:00:00`).toLocaleDateString("ms-MY", { weekday: "long", day: "numeric", month: "long" })} - ${sessionLabel(lagi)} (${lagi.minit} min)`
          : "Tiada lagi sesi akan datang.",
      );
      baris(
        "aktif-minggu",
        `Minggu ini: ${minggu.filter((x) => siap.has(x.id)).length} / ${minggu.length} sesi siap`,
      );
      baris(
        "aktif-minit",
        `Minit minggu ini: ${minggu.reduce((n, x) => n + x.minit, 0)} dirancang, ${Math.round(sebenar)} sebenar`,
      );
      // Beban mingguan (6 minggu terakhir sehingga minggu ini): dirancang vs sebenar.
      if (semua) {
        const lepas = weeklyLoad(p.sesi, semua)
          .filter(
            (w) => p.sesi.find((x) => x.minggu === w.no)!.tarikh <= hariIni,
          )
          .slice(-6);
        if (lepas.length) {
          $("aktif-beban").innerHTML =
            `<p class="muted">Beban mingguan (minit)</p>${lepas.map((w) => `<p class="beban">${loadBarHtml(w, `<span>Minggu ${w.no}</span>`)}</p>`).join("")}`;
          $("aktif-beban").hidden = false;
        }
      }
      // Ketinggalan > 1 minggu: "Sambung dari Minggu N" (aliran sama dengan page pelan). Pelan lumba tak dianjak.
      if (href && !href.p.lumba && href.p.mula) {
        const r = resumePoint(
          href.h.minggu,
          startMonday(new Date(`${href.p.mula}T00:00:00`)),
          siap,
        );
        if (r) {
          const q = new URLSearchParams({ ...href.p, mula: isoDate(r.mula) });
          $("aktif-sambung").innerHTML = `<div class="alert alert-info">
            <p class="alert-title">Terlepas sesi? Tak apa.</p>
            <p>Sambung dari <strong>Minggu ${r.no}</strong> mulai ${r.isninMinggu.toDateString() === new Date().toDateString() ? "hari ini" : "Isnin depan"}, ${r.isninMinggu.toLocaleDateString("ms-MY", { day: "numeric", month: "long" })}. Tarikh pelan dianjak ${r.anjak} minggu; tanda siap kekal.</p>
            <div class="actions"><a class="btn btn-primary btn-sm" href="${href.href.split("?")[0]}?${q}">Sambung dari Minggu ${r.no}</a></div>
          </div>`;
          $("aktif-sambung").hidden = false;
        }
      }
    }
  }

  // Had MAF terakhir (Maf.astro versi akaun).
  try {
    const m = JSON.parse(localStorage.getItem("maf:terakhir") ?? "null");
    if (m && Number.isInteger(m.maf) && Number.isInteger(m.bawah))
      $("maf-terakhir").textContent =
        `Had MAF anda: ${m.maf} denyut/min (julat ${m.bawah}-${m.maf}) - disimpan dalam pelayar ini.`;
  } catch {
    /* tiada / rosak */
  }
</script>

<style>
  .salam h2 {
    margin: 0.25rem 0;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--navy);
  }
  .salam p {
    margin: 0;
  }
  .salam {
    padding: 0; /* bukan section awam (global.css beri padding besar) */
  }

  .stat {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .stat li,
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .stat li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
  }
  .stat span {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stat strong {
    font-family: var(--display);
    font-style: italic;
    font-size: 2rem;
    color: var(--navy);
  }
  /* Telefon: tiga kad kekal sebaris (bukan tiga skrin), teks lebih kecil. */
  @media (max-width: 36rem) {
    .stat {
      gap: 0.5rem;
    }
    .stat li {
      padding: 0.75rem;
    }
    .stat span {
      font-size: 0.68rem;
      letter-spacing: 0.06em;
    }
    .stat strong {
      font-size: 1.35rem;
      line-height: 1.1;
    }
  }

  /* Pelan lebar di kiri, profil/alat di kanan; satu lajur bila sempit. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: 1rem;
    align-items: start;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sisi {
    display: grid;
    gap: 1rem;
  }
  .panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.25rem 1.5rem;
  }
  .panel h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--navy);
  }
  .panel p {
    margin: 0;
  }
  .panel-kepala {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .senarai {
    justify-self: stretch;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  /* Item dijana skrip - tiada atribut skop Astro, jadi :global. */
  .senarai :global(li) {
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .senarai :global(li:hover) {
    border-color: var(--orange);
  }
  .senarai :global(li.menunggu) {
    border-color: var(--info-line);
    background: var(--info-bg);
  }
  .senarai :global(a) {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1rem 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .senarai :global(.item-bawah) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1rem 0.85rem;
  }
  .senarai :global(.item-butang) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }
  .senarai :global(.kecil) {
    font-size: 0.8rem;
  }

  .awan-meter {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    scroll-margin-top: 5rem;
  }
  .awan-meter p {
    font-weight: 600;
  }
  .awan-slot {
    display: flex;
    gap: 0.35rem;
  }
  .awan-slot :global(i) {
    width: 2.25rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line);
  }
  .awan-slot :global(i.penuh) {
    background: var(--info-ink);
  }
  .awan-nota {
    font-size: 0.85rem;
  }
  .tukar {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .senarai :global(span),
  .senarai :global(small) {
    color: var(--muted);
    font-size: 0.9rem;
  }
  /* Trek kelabu + isian oren - lalai pelayar (Safari/Chrome) nampak penuh gelap pada 0%. */
  .senarai :global(progress) {
    width: 100%;
    height: 0.5rem;
    appearance: none;
    border: 0;
    border-radius: 999px;
    overflow: hidden;
    background: var(--line);
  }
  .senarai :global(progress::-webkit-progress-bar) {
    background: var(--line);
