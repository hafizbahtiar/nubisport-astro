---
import AccountLayout from "../../layouts/AccountLayout.astro";
---

<AccountLayout title="Dashboard">
  <section class="salam">
    <p class="eyebrow">Akaun</p>
    <h2 class="display">Hai, <span data-saya-nama>…</span>.</h2>
  </section>

  <ul class="stat" aria-label="Ringkasan">
    <li><span>Pelan</span><strong id="bil-pelan">0</strong></li>
    <li><span>Sesi siap</span><strong id="bil-siap">0</strong></li>
    <li><span>Keahlian</span><strong data-saya-peranan>…</strong></li>
  </ul>

  <!-- Admin Nubi + owner: larian kumpulan yang perlu diurus. -->
  <section class="panel" data-admin hidden aria-labelledby="t-urus">
    <div class="panel-kepala">
      <h3 class="display" id="t-urus">Urus larian</h3>
      <div class="actions">
        <a class="btn btn-primary btn-sm" href="/account/events/new"
          >Tambah larian</a
        >
        <a class="btn btn-outline btn-sm" href="/account/events">Semua larian</a
        >
      </div>
    </div>
    <p class="muted" id="urus-nota">Memuatkan larian…</p>
    <p id="urus-seterusnya" hidden></p>
    <div id="urus-hadir" hidden>
      <p><strong>Perlu tanda hadir</strong></p>
      <ul class="pautan-senarai" id="urus-hadir-senarai"></ul>
    </div>
  </section>

  <!-- Owner sahaja: komuniti Nubi (GET /owner/apps/nubi/members - owner sahaja di backend). -->
  <section class="panel" data-owner hidden aria-labelledby="t-komuniti">
    <div class="panel-kepala">
      <h3 class="display" id="t-komuniti">Komuniti Nubi</h3>
      <a
        class="btn btn-outline btn-sm"
        href="https://hafizbahtiar.com/admin/app-access"
        target="_blank"
        rel="noopener">Urus akses</a
      >
    </div>
    <p class="muted" id="komuniti-nota">Memuatkan ahli…</p>
    <ul class="pautan-senarai" id="komuniti-baru" hidden></ul>
  </section>

  <section class="panel" id="aktif" data-ahli hidden>
    <div class="panel-kepala">
      <h3 class="display">Pelan aktif</h3>
      <div class="actions">
        <button
          class="btn btn-outline btn-sm"
          type="button"
          id="aktif-sync"
          hidden>Sync aktiviti</button
        >
        <a class="btn btn-outline btn-sm" id="aktif-buka" href="#" hidden
          >Buka pelan</a
        >
      </div>
    </div>
    <p class="muted" id="aktif-nota">Menyemak pelan aktif…</p>
    <p id="aktif-seterusnya" hidden></p>
    <p id="aktif-minggu" hidden></p>
    <p id="aktif-minit" hidden></p>
    <p class="muted" id="aktif-sync-nota" hidden></p>
    <div class="beban-senarai" id="aktif-beban" hidden></div>
    <div id="aktif-sambung" hidden></div>
  </section>

  <section class="panel">
    <div class="panel-kepala">
      <h3 class="display">Pelan saya</h3>
      <div class="actions">
        <a class="btn btn-primary btn-sm" href="/account/plans">Pelan larian</a>
      </div>
    </div>
    <div class="awan-meter" id="awan">
      <p id="awan-teks" class="muted">Menyemak awan…</p>
      <span class="awan-slot" id="awan-slot" aria-hidden="true"></span>
    </div>
    <p class="muted awan-nota">
      Pelan <strong>Awan</strong> ikut akaun anda ke peranti lain. Pelan{" "}
      <strong>Peranti ini</strong> hanya dalam pelayar ini - hilang kalau data pelayar
      dikosongkan.
    </p>
    <div class="alert alert-info tukar" id="tukar" hidden>
      <p>
        Awan penuh. Pilih pelan awan untuk diganti dengan
        <strong id="tukar-nama"></strong> - pelan yang diganti kekal di peranti ini.
      </p>
      <button class="btn btn-outline btn-sm" type="button" id="tukar-batal"
        >Batal</button
      >
    </div>
    <ol class="senarai" id="pelan"></ol>
    <p class="muted" id="tiada-pelan" hidden>
      Belum ada pelan di pelayar ini. Buat satu - nanti ia muncul di sini dengan
      kemajuannya.
    </p>
  </section>
</AccountLayout>

<script>
  import { api, currentUser, json } from "../../lib/api";
  import {
    fetchEvents,
    isEventAdmin,
    rsvpText,
    shortWhen,
    started,
  } from "../../lib/events";
  import { resumePoint, startMonday, isoDate } from "../../lib/plan-5k";
  import { describePlan } from "../../lib/plan-list";
  import { loadBarHtml } from "../../lib/plan-render";
  import { CREATED_KEY, readList, deletePlan } from "../../lib/saved-plans";
  import {
    ENGINE_VERSION,
    removeFromCloud,
    storageBadge,
    listCloud,
    saveToCloud,
    pullCloud,
    type CloudList,
  } from "../../lib/cloud-sync";
  import { confirmDialog } from "../../lib/confirm";
  import { todayMY, addDays } from "../../lib/date";
  import {
    isMember,
    activitiesBetween,
    sessionLabel,
    activePlan,
    weeklyLoad,
    syncActivePlan,
  } from "../../lib/plan-sync";

  const $ = (id: string) => document.getElementById(id)!;
  const elText = <K extends keyof HTMLElementTagNameMap>(
    tag: K,
    teks: string,
  ) => Object.assign(document.createElement(tag), { textContent: teks });

  // Admin Nubi + owner: larian seterusnya + larian selesai (7 hari) yang belum ditanda hadir.
  async function urusLarian() {
    const items = await fetchEvents(true);
    if (!items)
      return void ($("urus-nota").textContent =
        "Tak dapat muat larian sekarang.");
    const akan = items.filter((a) => !started(a));
    const hadir = items.filter(
      (a) => started(a) && a.going > 0 && a.attended === 0,
    );
    $("urus-nota").textContent = akan.length
      ? `${akan.length} larian akan datang · ${akan.reduce((n, a) => n + a.going, 0)} RSVP`
      : "Tiada larian dijadualkan. Tambah satu supaya ahli boleh RSVP.";
    const lagi = akan[0];
    if (lagi) {
      const p = $("urus-seterusnya");
      const a = elText("a", lagi.title);
      a.className = "link";
      a.href = `/account/events/view?id=${lagi.id}`;
      p.replaceChildren(
        "Seterusnya: ",
        a,
        ` · ${shortWhen(lagi.startsAt)} · RSVP ${rsvpText(lagi)}`,
      );
      p.hidden = false;
    }
    if (hadir.length) {
      $("urus-hadir-senarai").replaceChildren(
        ...hadir.map((x) => {
          const li = document.createElement("li");
          const a = elText("a", x.title);
          a.className = "link";
          a.href = `/account/events/view?id=${x.id}#kehadiran`;
          li.append(a, ` · ${shortWhen(x.startsAt)} · ${x.going} RSVP`);
          return li;
        }),
      );
      $("urus-hadir").hidden = false;
    }
  }

  // Owner sahaja: bilangan ikut peranan + 5 terbaru (nama sahaja; e-mel kekal di portfolio).
  async function komuniti() {
    const res = await api("/owner/apps/nubi/members").catch(() => null);
    if (!res?.ok)
      return void ($("komuniti-nota").textContent =
        "Tak dapat muat ahli sekarang.");
    const ahli: { displayName: string; role: string; grantedAt: string }[] =
      (await json(res)).data ?? [];
    const bil = (r: string) => ahli.filter((m) => m.role === r).length;
    $("komuniti-nota").textContent =
      `${bil("ahli")} ahli · ${bil("admin")} pentadbir`;
    if (!ahli.length) return;
    $("komuniti-baru").replaceChildren(
      ...ahli
        .slice(0, 5)
        .map((m) =>
          elText(
            "li",
            `${m.displayName} · ${m.role === "admin" ? "pentadbir" : m.role} · sejak ${new Date(m.grantedAt).toLocaleDateString("ms-MY", { day: "numeric", month: "short", year: "numeric" })}`,
          ),
        ),
    );
    $("komuniti-baru").hidden = false;
  }

  // Pengawal sesi, nama, peranan dan bahagian ikut peranan = AccountLayout (dilukis dari cache sebelum
  // /me pulang). Jangan tunggu /me di sini: senarai pelan (localStorage) dilukis serta-merta.
  const sesi = currentUser();

  const senarai = $("pelan");
  // awan: null = belum tahu / tidak dapat dicapai. menukar = pelan peranti yang menunggu slot awan.
  let awan: CloudList | null = null;
  let menukar: string | null = null;
  const segar = async () => {
    awan = await listCloud();
    papar();
  };
  // Butang dalam item: [teks, tindakan, kelas]
  const butang = (
    teks: string,
    buat: () => Promise<unknown> | void,
    kelas = "btn-outline",
  ) => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = `btn ${kelas} btn-sm`;
    b.textContent = teks;
    b.addEventListener("click", async () => {
      b.disabled = true;
      await buat();
      b.disabled = false;
    });
    return b;
  };
  const gagal = () =>
    ($("awan-teks").textContent =
      "Tak dapat hubungi awan. Semak internet dan cuba lagi.");

  function papar() {
    senarai.replaceChildren();
    let jumlahSiap = 0;
    const diAwan = new Set(awan?.items.map((i) => i.key));
    const versiLama = new Set(
      awan?.items.filter((i) => i.engine < ENGINE_VERSION).map((i) => i.key),
    );
    // Awan dahulu, kemudian peranti ini (susunan dibuat).
    const kunci = [...new Set(readList(CREATED_KEY))].sort(
      (x, y) => +diAwan.has(y) - +diAwan.has(x),
    );
    for (const k of kunci) {
      const p = describePlan(k);
      if (!p) continue;
      const { done: siap, total: jumlah } = p;
      jumlahSiap += siap;
      const awanIni = diAwan.has(k);
      const li = document.createElement("li");
      if (menukar === k) li.className = "menunggu";
      li.innerHTML = `<a href="${p.href}">
          <strong>${p.name}</strong>
          <span>${p.detail}</span>
          <progress max="${jumlah}" value="${siap}"></progress>
          <small>${siap} / ${jumlah} sesi siap · ${Math.round((siap / jumlah) * 100)}%</small>
        </a>
        <div class="item-bawah">${awan ? storageBadge(awanIni) : ""}${
          versiLama.has(k)
            ? `<span class="muted kecil">Pelan dikemas kini sejak disimpan</span>`
            : ""
        }<span class="item-butang"></span></div>`;
      const kotak = li.querySelector(".item-butang")!;

      if (awan && menukar && awanIni)
        kotak.append(
          butang(
            "Ganti dengan pelan ini",
            async () => {
              const r = await saveToCloud(menukar!, k);
              if (r !== "ok") return gagal();
              menukar = null;
              await segar();
            },
            "btn-primary",
          ),
        );
      else if (awan && !menukar && awanIni)
        kotak.append(
          butang("Keluarkan dari awan", async () => {
            if (!(await removeFromCloud(k))) return gagal();
            await segar();
          }),
        );
      else if (awan && !menukar && !awanIni)
        kotak.append(
          butang("Simpan ke awan", async () => {
            // Lebih had (peranan ditarik / had turun): tukar pun tak muat - nota di meter, tiada mod tukar.
            if (awan!.items.length > awan!.limit) return papar();
            if (awan!.items.length >= awan!.limit) {
              menukar = k;
              return papar();
            }
            const r = await saveToCloud(k);
            if (r === "penuh") menukar = k;
            else if (r === "ralat") return gagal();
            await segar();
          }),
        );
      if (!menukar)
        kotak.append(
          butang("Padam", async () => {
            const ya = await confirmDialog({
              title: "Padam pelan ini?",
              message: `Pelan ${p.name} dan ${siap} tanda siap akan dibuang dari pelayar ini${awanIni ? " dan dari awan" : ""}. Tindakan ini tak boleh dibatalkan.`,
              confirmLabel: "Padam",
              danger: true,
            });
            if (!ya) return;
            deletePlan(k);
            if (awanIni) await removeFromCloud(k);
            await segar();
          }),
        );
      senarai.append(li);
    }
    $("tiada-pelan").hidden = senarai.children.length > 0;
    $("bil-pelan").textContent = String(senarai.children.length);
    $("bil-siap").textContent = String(jumlahSiap);

    // Meter slot awan + mod tukar.
    if (awan) {
      const guna = awan.items.length;
      $("awan-teks").textContent =
        `Awan: ${guna} / ${awan.limit} slot digunakan` +
        (guna > awan.limit
          ? ` - lebih had. Pelan sedia ada selamat; keluarkan ${guna - awan.limit + 1} dari awan untuk simpan pelan baru.`
          : "");
      $("awan-slot").innerHTML = Array.from(
        { length: awan.limit },
        (_, i) => `<i${i < guna ? ' class="penuh"' : ""}></i>`,
      ).join("");
    }
    $("tukar").hidden = !menukar;
    if (menukar)
      $("tukar-nama").textContent = describePlan(menukar)?.name ?? "";
  }
  $("tukar-batal").addEventListener("click", () => {
    menukar = null;
    papar();
  });

  papar();
  const s = await sesi;
  if (isEventAdmin(s)) void urusLarian();
  if (s?.role === "owner") void komuniti();
  // Gabung awan (pelan dari peranti lain + tanda siap terkini), kemudian lukis dengan lencana.
  awan = await pullCloud();
  if (!awan) gagal();
  papar();
  if (location.hash === "#awan") $("awan").scrollIntoView();

  // Pelan aktif (ahli sahaja, lib/plan-sync.ts): sesi seterusnya + minggu ini (Isnin-Ahad, waktu Malaysia).
  if (isMember(s)) {
    const p = await activePlan();
    if (!p)
      $("aktif-nota").textContent =
        'Tiada pelan aktif. Buka pelan awan yang ada tarikh mula dan tekan "Jadikan pelan aktif" - aktiviti Strava yang dimuat naik akan tanda sesinya siap.';
    else {
      const baris = (id: string, teks: string) => {
        $(id).textContent = teks;
        $(id).hidden = false;
      };
      const hariIni = todayMY();
      const isnin = addDays(
        hariIni,
        -((new Date(`${hariIni}T00:00:00Z`).getUTCDay() + 6) % 7),
      );
      const ahad = addDays(isnin, 6);
      const siap = new Set(readList(p.kunci));
      const lagi = p.sesi.find((x) => x.tarikh >= hariIni && !siap.has(x.id));
      const minggu = p.sesi.filter(
        (x) => x.tarikh >= isnin && x.tarikh <= ahad,
      );
      // Satu permintaan dari mula pelan: minit minggu ini + bar beban mingguan.
      const semua = await activitiesBetween(
        p.sesi[0].tarikh < isnin ? p.sesi[0].tarikh : isnin,
      );
      const akt = semua ?? [];
      const sebenar = akt
        .filter(
          (a) =>
            (a.sport === "run" || a.sport === "walk") &&
            todayMY(new Date(a.startedAt)) >= isnin,
        )
        .reduce((n, a) => n + a.movingS / 60, 0);
      const href = describePlan(p.kunci);
      if (href) {
        ($("aktif-buka") as HTMLAnchorElement).href = href.href;
        $("aktif-buka").hidden = false;
        $("aktif-nota").textContent = href.name;
      }
      baris(
        "aktif-seterusnya",
        lagi
          ? `Sesi seterusnya: ${new Date(`${lagi.tarikh}T00:00:00`).toLocaleDateString("ms-MY", { weekday: "long", day: "numeric", month: "long" })} - ${sessionLabel(lagi)} (${lagi.minit} min)`
          : "Tiada lagi sesi akan datang.",
      );
      baris(
        "aktif-minggu",
        `Minggu ini: ${minggu.filter((x) => siap.has(x.id)).length} / ${minggu.length} sesi siap`,
      );
      baris(
        "aktif-minit",
        `Minit minggu ini: ${minggu.reduce((n, x) => n + x.minit, 0)} dirancang, ${Math.round(sebenar)} sebenar`,
      );
      // Sync manual: aktiviti Strava yang sudah dimuat naik tetapi belum dipadankan (contoh
      // pelan dijadikan aktif selepas aktiviti itu dimuat naik).
      const syncButang = $("aktif-sync") as HTMLButtonElement;
      const syncNota = $("aktif-sync-nota");
      syncButang.hidden = false;
      syncButang.addEventListener("click", async () => {
        syncButang.disabled = true;
        const n = await syncActivePlan();
        syncButang.disabled = false;
        syncNota.hidden = false;
        if (n === null) {
          syncNota.textContent = "Tak dapat sync sekarang. Cuba lagi sekejap.";
          return;
        }
        siap.clear();
        readList(p.kunci).forEach((x) => siap.add(x));
        $("aktif-minggu").textContent =
          `Minggu ini: ${minggu.filter((x) => siap.has(x.id)).length} / ${minggu.length} sesi siap`;
        const lagiBaru = p.sesi.find(
          (x) => x.tarikh >= hariIni && !siap.has(x.id),
        );
        $("aktif-seterusnya").textContent = lagiBaru
          ? `Sesi seterusnya: ${new Date(`${lagiBaru.tarikh}T00:00:00`).toLocaleDateString("ms-MY", { weekday: "long", day: "numeric", month: "long" })} - ${sessionLabel(lagiBaru)} (${lagiBaru.minit} min)`
          : "Tiada lagi sesi akan datang.";
        syncNota.textContent = n
          ? `${n} sesi ditanda siap dari aktiviti Strava.`
          : "Tiada sesi baharu untuk ditanda.";
      });
      // Beban mingguan (6 minggu terakhir sehingga minggu ini): dirancang vs sebenar.
      if (semua) {
        const lepas = weeklyLoad(p.sesi, semua)
          .filter(
            (w) => p.sesi.find((x) => x.minggu === w.no)!.tarikh <= hariIni,
          )
          .slice(-6);
        if (lepas.length) {
          $("aktif-beban").innerHTML =
            `<p class="muted">Beban mingguan (minit)</p>${lepas.map((w) => `<p class="beban">${loadBarHtml(w, `<span>Minggu ${w.no}</span>`)}</p>`).join("")}`;
          $("aktif-beban").hidden = false;
        }
      }
      // Ketinggalan > 1 minggu: "Sambung dari Minggu N" (aliran sama dengan page pelan). Pelan lumba tak dianjak.
      if (href && !href.params.lumba && href.params.mula) {
        const r = resumePoint(
          href.weeks,
          startMonday(new Date(`${href.params.mula}T00:00:00`)),
          siap,
        );
        if (r) {
          $("aktif-sambung").innerHTML = `<div class="alert alert-info">
            <p class="alert-title">Terlepas sesi? Tak apa.</p>
            <p>Sambung dari <strong>Minggu ${r.no}</strong> mulai ${r.isninMinggu.toDateString() === new Date().toDateString() ? "hari ini" : "Isnin depan"}, ${r.isninMinggu.toLocaleDateString("ms-MY", { day: "numeric", month: "long" })}. Tarikh pelan dianjak ${r.anjak} minggu; tanda siap kekal.</p>
            <div class="actions"><a class="btn btn-primary btn-sm" href="${href.href}&mula=${isoDate(r.mula)}">Sambung dari Minggu ${r.no}</a></div>
          </div>`;
          $("aktif-sambung").hidden = false;
        }
      }
    }
  }
</script>

<style>
  .salam h2 {
    margin: 0.25rem 0;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--navy);
  }
  .salam p {
    margin: 0;
  }
  .salam {
    padding: 0; /* bukan section awam (global.css beri padding besar) */
  }

  .pautan-senarai {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }

  .senarai {
    justify-self: stretch;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  /* Item dijana skrip - tiada atribut skop Astro, jadi :global. */
  .senarai :global(li) {
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .senarai :global(li:hover) {
    border-color: var(--orange);
  }
  .senarai :global(li.menunggu) {
    border-color: var(--info-line);
    background: var(--info-bg);
  }
  .senarai :global(a) {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1rem 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .senarai :global(.item-bawah) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1rem 0.85rem;
  }
  .senarai :global(.item-butang) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }
  .senarai :global(.kecil) {
    font-size: 0.8rem;
  }

  .awan-meter {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    scroll-margin-top: 5rem;
  }
  .awan-meter p {
    font-weight: 600;
  }
  .awan-slot {
    display: flex;
    gap: 0.35rem;
  }
  .awan-slot :global(i) {
    width: 2.25rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line);
  }
  .awan-slot :global(i.penuh) {
    background: var(--info-ink);
  }
  .awan-nota {
    font-size: 0.85rem;
  }
  .tukar {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .senarai :global(span),
  .senarai :global(small) {
    color: var(--muted);
    font-size: 0.9rem;
  }
  /* Trek kelabu + isian oren - lalai pelayar (Safari/Chrome) nampak penuh gelap pada 0%. */
  .senarai :global(progress) {
    width: 100%;
    height: 0.5rem;
    appearance: none;
    border: 0;
    border-radius: 999px;
    overflow: hidden;
    background: var(--line);
  }
  .senarai :global(progress::-webkit-progress-bar) {
    background: var(--line);
  }
  .senarai :global(progress::-webkit-progress-value) {
    background: var(--orange);
    border-radius: 999px;
  }
