---
// Detail satu aktiviti: peta laluan (MapLibre GL + OpenFreeMap), ringkasan dan nadi. /account/activities/view?id=<id>.
// Laluan dan nadi dilukis di pelayar dari fail .fit asal (GET /me/apps/nubi/activities/:id/file - milik
// sendiri sahaja, diurai sekali); Worker tidak menghurai apa-apa. Peta hanya untuk ahli itu - tiada perkongsian.
// Peta: maplibre-gl dimuat malas (JS + CSS hanya di page ini), gaya vektor OpenFreeMap (PETA_GAYA di bawah).
// Atribusi datang dari gaya dan wajib kelihatan. Tiada WebGL = mesej gagal.
// Satu peta macam Strava (docs/plans/map-improvements.md): OpenFreeMap Liberty + bukit Mapterhorn, tiada
// pemilih gaya. Kawalan dalam kanvas: 3D (relief + bangunan), Pace, skrin penuh, pusat semula, zum.
import AccountLayout from "../../../layouts/AccountLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
import Icon from "../../../components/ui/Icon.astro";
---

<AccountLayout title="Aktiviti">
  <a class="back-link back-link--spaced" href="/account/activities" id="kembali"
    ><Icon name="kiri" /><span id="kembali-teks">Semua aktiviti</span></a
  >

  <Alert variant="info" title="Ciri untuk ahli" id="bukan-ahli" hidden>
    <p>Import aktiviti Strava terbuka untuk ahli Nubi Sport.</p>
  </Alert>
  <Alert variant="danger" id="tiada" hidden>
    <p id="tiada-teks">Aktiviti ini tiada, atau bukan milik anda.</p>
  </Alert>

  <div id="isi" hidden>
    <!-- Susunan ikut Strava: tajuk, angka utama, butiran + cuaca, peta + split, analisis. -->
    <div class="panel-kepala kepala-aktiviti">
      <div class="tajuk">
        <h3 class="display" id="nama"></h3>
        <p class="muted" id="bila"></p>
        <p id="sesi-pelan" hidden></p>
      </div>
      <button class="btn btn-outline btn-sm" type="button" id="padam"
        >Padam</button
      >
      <button
        class="btn btn-outline btn-sm"
        type="button"
        id="sokong"
        aria-pressed="false"
        hidden></button>
    </div>

    <ul class="stat" aria-label="Ringkasan">
      <li><span>Jarak</span><strong id="s-jarak"></strong></li>
      <li><span>Masa bergerak</span><strong id="s-masa"></strong></li>
      <li><span>Pace</span><strong id="s-pace"></strong></li>
    </ul>

    <section
      class="panel kongsi-panel"
      id="kongsi-panel"
      aria-labelledby="kongsi-tajuk"
    >
      <h3 class="display" id="kongsi-tajuk">Feed komuniti</h3>
      <label class="check">
        <input type="checkbox" id="kongsi-tanda" />
        <span>Kongsi ke feed ahli</span>
      </label>
      <label class="check">
        <input type="checkbox" id="kongsi-nadi" disabled />
        <span>Kongsi nadi</span>
      </label>
      <p class="muted kecil">
        Ahli Nubi boleh buka detail aktiviti ini: laluan penuh, split,
        ketinggian, pace dan cuaca. Nadi pilihan; fail asal kekal peribadi.
        Boleh tarik balik bila-bila masa.
      </p>
      <p class="muted" id="kongsi-status" hidden></p>
    </section>

    <section class="panel butiran" aria-label="Butiran aktiviti">
      <dl class="butiran-senarai">
        <div id="s-gap-baris" hidden>
          <dt title="Pace setara larian rata (GAP)">GAP</dt><dd id="s-gap"></dd>
        </div>
        <div><dt>Masa berlalu</dt><dd id="s-berlalu"></dd></div>
        <div id="s-henti-baris" hidden>
          <dt>Masa berhenti</dt><dd id="s-henti"></dd>
        </div>
        <div><dt>Ketinggian naik</dt><dd id="s-tinggi"></dd></div>
        <div><dt>Nadi purata</dt><dd id="s-nadi"></dd></div>
        <div><dt>Nadi maks</dt><dd id="s-nadi-maks"></dd></div>
        <div id="s-kadens-baris" hidden>
          <dt title="Langkah seminit (spm)">Kadens</dt><dd id="s-kadens"></dd>
        </div>
        <div id="s-lari-baris" hidden>
          <dt>Masa lari</dt><dd id="s-lari"></dd>
        </div>
        <div id="s-kalori-baris" hidden>
          <dt>Kalori</dt><dd id="s-kalori"></dd>
        </div>
      </dl>
      <div class="cuaca" id="cuaca" hidden>
        <h4 class="sub" id="cuaca-tajuk">Cuaca</h4>
        <dl class="butiran-senarai" aria-labelledby="cuaca-tajuk">
          <div id="cuaca-suhu" hidden><dt>Suhu</dt><dd id="s-suhu"></dd></div>
          <div id="cuaca-rasa" hidden>
            <dt>Rasa macam</dt><dd id="s-rasa"></dd>
          </div>
          <div id="cuaca-lembap" hidden>
            <dt>Kelembapan</dt><dd id="s-lembap"></dd>
          </div>
          <div id="cuaca-angin" hidden>
            <dt>Angin</dt><dd id="s-angin"></dd>
          </div>
          <div id="cuaca-arah" hidden>
            <dt>Arah angin</dt><dd id="s-arah"></dd>
          </div>
        </dl>
        <p class="muted kecil" id="cuaca-sumber"></p>
      </div>
    </section>

    <div class="peta-split" id="peta-split">
      <section class="panel peta-panel" aria-label="Peta laluan">
        <div class="peta" id="peta" aria-label="Peta laluan">
          <div class="main-semula" id="main-semula" hidden>
            <button
              class="main-main"
              id="main-main"
              type="button"
              aria-label="Main semula animasi laluan"
            >
              <span aria-hidden="true"><Icon name="main" /></span>
              <span>Main</span>
            </button>
          </div>
          <div class="pace-legenda" id="pace-legenda" hidden>
            <span>Laju <strong id="pace-laju"></strong></span>
            <span class="pace-bar" id="pace-bar" aria-hidden="true"></span>
            <span><strong id="pace-perlahan"></strong> Perlahan</span>
          </div>
        </div>
        <p class="muted" id="peta-status">Memuatkan laluan…</p>
        <p class="muted kecil" id="laluan-nota">
          Laluan penuh ini peribadi, kecuali aktiviti dikongsi ke feed ahli.
        </p>
      </section>

      <section
        class="panel split-panel"
        id="split"
        aria-labelledby="split-tajuk"
        hidden
      >
        <h3 class="display" id="split-tajuk">Split setiap km</h3>
        <ul class="split split-pace" id="split-senarai"></ul>
        <div id="best" hidden>
          <h4 class="sub">Best effort</h4>
          <ul class="split" id="best-senarai"></ul>
        </div>
        <p class="muted kecil">
          Masa bergerak dari rekod FIT. Bar lebih panjang = split lebih laju.
          Split terakhir mungkin separa km.
        </p>
      </section>
    </div>

    <section class="panel" id="tinggi" aria-labelledby="tinggi-tajuk" hidden>
      <h3 class="display" id="tinggi-tajuk">Ketinggian</h3>
      <figure class="carta tinggi">
        <div class="carta-badan">
          <span class="paksi-y" aria-hidden="true"
            ><span id="tinggi-hi"></span><span id="tinggi-lo"></span></span
          >
          <svg
            id="tinggi-carta"
            viewBox="0 0 600 160"
            preserveAspectRatio="none"
            role="img"
            tabindex="0"
          >
            <polygon id="tinggi-kawasan" class="kawasan"></polygon>
            <polyline
              id="tinggi-garis"
              class="garis"
              vector-effect="non-scaling-stroke"></polyline>
            <line
              id="tinggi-penunjuk"
              class="penunjuk"
              y1="0"
              y2="160"
              visibility="hidden"
              vector-effect="non-scaling-stroke"></line>
          </svg>
        </div>
        <figcaption class="paksi-x" aria-hidden="true">
          <span>0 km</span><span id="tinggi-jarak"></span>
        </figcaption>
      </figure>
      <p class="tinggi-baca" id="tinggi-baca" aria-live="polite"></p>
      <p class="muted kecil" id="tinggi-nota"></p>
    </section>

    <section class="panel" id="nadi" aria-labelledby="nadi-tajuk" hidden>
      <h3 class="display" id="nadi-tajuk">Nadi</h3>
      <figure class="carta">
        <div class="carta-badan">
          <span class="paksi-y" aria-hidden="true"
            ><span id="nadi-hi"></span><span id="nadi-lo"></span></span
          >
          <svg
            id="nadi-carta"
            viewBox="0 0 600 160"
            preserveAspectRatio="none"
            role="img"
          >
            <polygon id="nadi-kawasan" class="kawasan"></polygon>
            <polyline
              id="nadi-garis"
              class="garis"
              vector-effect="non-scaling-stroke"></polyline>
          </svg>
        </div>
        <figcaption class="paksi-x" aria-hidden="true">
          <span>0m</span><span id="nadi-tempoh"></span>
        </figcaption>
      </figure>
      <h4 class="sub">Masa dalam zon</h4>
      <ul class="zon" id="nadi-zon"></ul>
      <p class="muted kecil" id="nadi-asas"></p>
      <p class="muted kecil" id="nadi-drift" hidden></p>
    </section>

    <section class="panel" id="semakan" aria-labelledby="semakan-tajuk" hidden>
      <h3 class="display" id="semakan-tajuk">Semakan sesi</h3>
      <p id="semakan-ringkas"></p>
      <ul class="semakan" id="semakan-blok"></ul>
      <p class="muted kecil">
        Anggaran dari fail FIT: blok ikut masa pelan, bukan penilaian jurulatih.
      </p>
    </section>
  </div>
</AccountLayout>

<script>
  import { api, json, currentUser } from "../../../lib/api";
  import { confirmDialog } from "../../../lib/confirm";
  import { icon } from "../../../lib/icon";
  import {
    SPORT_LABELS,
    formatKm,
    fitData,
    routeOf,
    trackOf,
    trackAt,
    paceGradient,
    paceAt,
    nearestDistance,
    WARNA_PACE,
    type TrackPoint,
    type ActivityWeather,
    heartSeries,
    altitudeSeries,
    hrZones,
    paceFromDistance,
    formatDuration,
    routePreview,
    recordsFromShared,
    sharedRecords,
    previewTrack,
    type Sport,
  } from "../../../lib/activity-file";
  import {
    fetchFeedActivity,
    fetchFeedRecords,
    toggleKudos,
    uploadSharedRecords,
  } from "../../../lib/feed";
  import {
    sessionLabel,
    sessionFor,
    walkedNote,
    ticksFrom,
    offerUntick,
    type PlanSession,
  } from "../../../lib/plan-sync";
  import {
    activitySplits,
    bestEfforts,
    cadenceStats,
    checkSession,
    gradeAdjustedPace,
    heartRateDrift,
    type BestEffort,
    type Split,
  } from "../../../lib/activity-analysis";
  import { formatPace } from "../../../lib/plan-5k";
  import { formatTime } from "../../../lib/distance-plan";
  import type {
    ExpressionSpecification,
    GeoJSONSource,
    IControl,
    LngLatBoundsLike,
    Marker,
    RasterDEMSourceSpecification,
  } from "maplibre-gl";

  // Mula download besar serta-merta; jangan tunggu /me, row, fail atau padanan pelan.
  const PETA = Promise.all([
    import("maplibre-gl"),
    // Vite tidak nampak URL worker maplibre (dikira masa jalan) -> emit sendiri dan beritahu.
    import("maplibre-gl/dist/maplibre-gl-worker.mjs?url"),
    import("maplibre-gl/dist/maplibre-gl.css"),
  ]);
  void PETA.catch(() => {});
  void import("@garmin/fitsdk").catch(() => {});

  const $ = (id: string) => document.getElementById(id)!;
  const BASE = "/me/apps/nubi/activities";
  // DEM Terrarium percuma tanpa kunci (Copernicus GLO-30 dll., global sehingga z12, tiada SLA).
  // Gagal muat = kembali Standard. Ganti: AWS https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png (256, maxzoom 15).
  const DEM: RasterDEMSourceSpecification = {
    type: "raster-dem",
    tiles: ["https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"],
    tileSize: 512,
    maxzoom: 12,
    encoding: "terrarium",
    attribution:
      '<a href="https://mapterhorn.com/attribution">© Mapterhorn</a>',
  };
  // OpenFreeMap: percuma, tiada kunci/had paparan, komersial dibenarkan. Pilihan gaya/satelit dibuang
  // (2026-10-24) - alternatif satelit kekal didokumenkan dalam docs/plans/map-improvements.md.
  const PETA_GAYA = "https://tiles.openfreemap.org/styles/liberty";
  const SIMPAN_3D = "nubi/peta-3d";
  const SIMPAN_WARNA = "nubi/peta-warna";
  const simpan = (k: string, v: string) => {
    try {
      localStorage.setItem(k, v);
    } catch {}
  };

  interface Aktiviti {
    id: number;
    startedAt: string;
    sport: Sport;
    name: string | null;
    distanceM: number;
    movingS: number;
    elapsedS: number;
    elevationGainM: number | null;
    avgHr: number | null;
    maxHr: number | null;
    runRatio: number | null;
    weather: ActivityWeather | null; // MET Norway masa upload (migration 040 backend)
    visibility: "private" | "members";
    shareHr: boolean;
    hasPreview: boolean;
    updatedAt: string;
  }

  async function mula() {
    const params = new URLSearchParams(location.search);
    const id = Number(params.get("id"));
    const version = params.get("v");
    const sah = Number.isSafeInteger(id) && id > 0;
    // Dari feed (aktiviti ahli lain, macam Strava): baca saja, data dari salinan rekod pemilik.
    const fromFeed = params.get("source") === "feed";
    const fileUrl = (v: string) =>
      `${BASE}/${id}/file?v=${encodeURIComponent(v)}`;
    // Row + fail serentak dengan /me (backend tapis ikut pemilik). Link lama (tiada v) baca row
    // dulu supaya URL fail guna updatedAt semasa - immutable tak boleh dipakai pada URL tanpa versi.
    const fileP =
      sah && version && !fromFeed
        ? api(fileUrl(version)).catch(() => null)
        : null;
    const rowP =
      sah && !fromFeed ? api(`${BASE}/${id}`).catch(() => null) : null;
    const feedP = sah && fromFeed ? fetchFeedActivity(id) : null;
    const recordsP = sah && fromFeed ? fetchFeedRecords(id) : null;
    const s = await currentUser();
    const nubi = s?.apps?.nubi;
    if (!(s?.role === "owner" || nubi === "ahli" || nubi === "admin")) {
      $("bukan-ahli").hidden = false;
      return;
    }
    let a: Aktiviti;
    let author: string | null = null;
    let feedPreview: [number, number][] | null = null;
    if (fromFeed) {
      const item = await feedP;
      if (!item) {
        $("tiada-teks").textContent =
          "Aktiviti ini tak lagi dikongsi, atau tiada.";
        $("tiada").hidden = false;
        return;
      }
      // Macam Strava: cuaca + % lari ikut dipapar; kawalan pemilik tiada.
      a = {
        ...item,
        visibility: "members",
        hasPreview: !!item.preview,
        updatedAt: "",
      };
      author = item.author.name;
      feedPreview = item.preview;
      if (!item.own) {
        const sokong = $("sokong") as HTMLButtonElement;
        const label = () => {
          sokong.textContent = `${item.kudos.mine ? "Disokong" : "Sokong"} ${item.kudos.count}`;
          sokong.setAttribute("aria-pressed", String(item.kudos.mine));
        };
        label();
        sokong.hidden = false;
        sokong.addEventListener("click", async () => {
          sokong.disabled = true;
          const next = await toggleKudos(item.id, !item.kudos.mine);
          sokong.disabled = false;
          if (next) item.kudos = next;
          label();
        });
      }
      ($("kembali") as HTMLAnchorElement).href = "/account/feed";
      $("kembali-teks").textContent = "Feed komuniti";
      for (const ownerOnly of ["padam", "kongsi-panel", "laluan-nota"])
        $(ownerOnly).hidden = true;
    } else {
      const r = await rowP;
      if (!r?.ok) {
        $("tiada").hidden = false;
        return;
      }
      a = (await json(r)).data as Aktiviti;
    }
    $("isi").hidden = false;
    let rekodCache: any[] | null = null;

    const nama = a.name || SPORT_LABELS[a.sport];
    $("nama").textContent = nama; // teks pengguna - textContent sahaja
    document.title = `${nama} - ${document.title}`;
    $("bila").textContent =
      `${author ? `${author} · ` : ""}${SPORT_LABELS[a.sport]}, ${new Date(
        a.startedAt,
      ).toLocaleString("ms-MY", {
        timeZone: "Asia/Kuala_Lumpur",
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      })}`;
    const sesiPelan: ReturnType<typeof sessionFor> = fromFeed
      ? Promise.resolve(null)
      : sessionFor(a);
    void sesiPelan.then((m) => {
      if (!m) return;
      $("sesi-pelan").textContent = m.ditanda
        ? `Sesi pelan: ${sessionLabel(m.sesi)}`
        : walkedNote(a, m.sesi);
      $("sesi-pelan").hidden = false;
    });
    $("s-jarak").textContent = formatKm(a.distanceM);
    $("s-masa").textContent = formatDuration(a.movingS);
    $("s-pace").textContent = paceFromDistance(a.distanceM, a.movingS) ?? "-";
    $("s-tinggi").textContent =
      a.elevationGainM == null ? "-" : `${Math.round(a.elevationGainM)} m`;
    $("s-nadi").textContent = a.avgHr ? `${Math.round(a.avgHr)} bpm` : "-";
    $("s-nadi-maks").textContent = a.maxHr ? `${Math.round(a.maxHr)} bpm` : "-";
    $("s-berlalu").textContent = formatDuration(a.elapsedS);
    if (a.elapsedS - a.movingS >= 60) {
      $("s-henti").textContent = formatDuration(a.elapsedS - a.movingS);
      $("s-henti-baris").hidden = false;
    }
    cuaca(a.weather, MET_NOTA);
    if (a.runRatio != null) {
      $("s-lari").textContent =
        `${Math.round(a.runRatio * 100)}% masa bergerak`;
      $("s-lari-baris").hidden = false;
    }

    const shareEl = $("kongsi-tanda") as HTMLInputElement;
    const shareHrEl = $("kongsi-nadi") as HTMLInputElement;
    const shareStatus = $("kongsi-status");
    const setSharingUi = () => {
      shareHrEl.disabled = !shareEl.checked;
      if (!shareEl.checked) shareHrEl.checked = false;
    };
    const ownRecords = async (): Promise<any[] | null> => {
      if (rekodCache) return rekodCache;
      const f = await api(fileUrl(a.updatedAt)).catch(() => null);
      if (!f?.ok) return null;
      try {
        return (await fitData(await f.arrayBuffer())).records;
      } catch {
        return null;
      }
    };
    const previewForShare = async (): Promise<
      [number, number][] | undefined
    > => {
      if (a.hasPreview) return undefined;
      const records = await ownRecords();
      const route = records ? routePreview(records) : [];
      return route.length >= 2 ? route : undefined;
    };
    const saveSharing = async () => {
      const on = shareEl.checked;
      const wasShared = a.visibility === "members";
      shareStatus.hidden = false;
      shareStatus.textContent = on ? "Menyediakan peta…" : "Menyimpan…";
      shareEl.disabled = true;
      shareHrEl.disabled = true;
      const preview = on && !a.hasPreview ? await previewForShare() : undefined;
      const res = await api(`${BASE}/${a.id}/visibility`, {
        method: "PUT",
        body: JSON.stringify({
          visibility: on ? "members" : "private",
          shareHr: on && shareHrEl.checked,
          ...(preview ? { preview } : {}),
        }),
      }).catch(() => null);
      shareEl.disabled = false;
      if (!res?.ok) {
        shareEl.checked = wasShared;
        shareHrEl.checked = a.shareHr && wasShared;
        setSharingUi();
        shareStatus.textContent =
          "Tak dapat ubah tetapan kongsi. Cuba lagi sekejap.";
        return;
      }
      // Salinan rekod untuk detail ahli lain; gagal = ahli nampak ringkasan saja (cuba kongsi semula).
      if (on && !wasShared) {
        const records = await ownRecords();
        if (records) await uploadSharedRecords(a.id, sharedRecords(records));
      }
      a.visibility = on ? "members" : "private";
      a.shareHr = on && shareHrEl.checked;
      if (preview) a.hasPreview = true;
      setSharingUi();
      shareStatus.textContent = on
        ? "Aktiviti dikongsi ke feed ahli."
        : "Aktiviti kembali peribadi.";
    };
    shareEl.checked = a.visibility === "members";
    shareHrEl.checked = a.shareHr && shareEl.checked;
    setSharingUi();
    shareEl.addEventListener("change", () => void saveSharing());
    shareHrEl.addEventListener("change", () => void saveSharing());

    $("padam").addEventListener("click", async () => {
      const ya = await confirmDialog({
        title: "Padam aktiviti ini?",
        message: `${nama} dan fail asalnya akan dibuang. Tindakan ini tak boleh dibatalkan.`,
        confirmLabel: "Padam",
        danger: true,
      });
      if (!ya) return;
      const tanda = await ticksFrom([a]).catch(() => null);
      const d = await api(`${BASE}/${a.id}`, { method: "DELETE" });
      if (d.ok || d.status === 404) {
        await offerUntick(tanda);
        location.href = "/account/activities";
      } else
        $("peta-status").textContent =
          "Aktiviti tak dapat dipadam. Semak sambungan dan cuba lagi.";
    });

    let rekod: any[];
    try {
      if (fromFeed) {
        const shared = await recordsP;
        if (!shared) throw new Error("tiada-salinan");
        rekod = recordsFromShared(shared);
      } else {
        const currentVersion = a.updatedAt;
        const f = await (fileP && version === currentVersion
          ? fileP
          : api(fileUrl(currentVersion)).catch(() => null));
        if (!f?.ok) throw new Error();
        const data = await fitData(await f.arrayBuffer());
        rekod = data.records;
        rekodCache = rekod;
        if (data.weather) cuaca(data.weather, "Dari fail FIT (peranti).");
        if (data.calories) {
          $("s-kalori").textContent = `${Math.round(data.calories)} kcal`;
          $("s-kalori-baris").hidden = false;
        }
      }
    } catch {
      // Dikongsi sebelum salinan wujud: peta + animasi dari preview feed, tanpa split/carta (data anggaran).
      if (fromFeed && feedPreview && feedPreview.length >= 2) {
        $("laluan-nota").textContent =
          "Laluan ringkas - split, ketinggian dan pace tersedia bila pemilik kongsi semula aktiviti ini.";
        $("laluan-nota").hidden = false;
        await peta(
          feedPreview,
          previewTrack(feedPreview, a.distanceM, a.movingS),
          false,
        );
        return;
      }
      $("peta").hidden = true;
      $("peta-status").textContent = fromFeed
        ? "Laluan dan split tak tersedia untuk aktiviti ini."
        : "Laluan tak dapat dimuatkan. Muat semula halaman untuk cuba lagi.";
      return;
    }
    nadi(heartSeries(rekod), a.maxHr);
    const track = trackOf(rekod);
    tinggi(
      altitudeSeries(rekod),
      a.elevationGainM,
      track.length >= 2 ? track : null,
    );
    const splits = activitySplits(rekod);
    const gap = a.sport === "run" ? gradeAdjustedPace(splits) : null;
    if (gap !== null) {
      $("s-gap").textContent = `${formatPace(gap)}/km`;
      $("s-gap-baris").hidden = false;
    }
    const kadens = cadenceStats(rekod);
    if ((a.sport === "run" || a.sport === "walk") && kadens.avg !== null) {
      $("s-kadens").textContent = `${kadens.avg} spm${
        kadens.max !== null ? ` · maks ${kadens.max}` : ""
      }`;
      $("s-kadens-baris").hidden = false;
    }
    const drift = heartRateDrift(rekod);
    if (drift !== null) {
      $("nadi-drift").textContent =
        `Drift nadi separuh kedua: ${drift >= 0 ? "+" : ""}${drift.toFixed(1)}% berbanding separuh pertama. Pace berubah menjejaskan bacaan.`;
      $("nadi-drift").hidden = false;
    }
    pecahan(splits, a.sport === "run" ? bestEfforts(rekod) : []);
    // Padanan pelan tak perlu menyekat peta.
    void sesiPelan
      .then((m) => {
        if (m) semakan(m.sesi, rekod);
      })
      .catch(() => {});
    const laluan =
      track.length >= 2
        ? track.map((p): [number, number] => [p.lat, p.lon])
        : routeOf(rekod);
    await peta(laluan, track.length >= 2 ? track : null);
  }

  /** Interval/tempo: banding blok laju sebenar dengan pace sasaran dalam teks sesi. */
  function semakan(sesi: PlanSession, rekod: any[]) {
    if (sesi.jenis !== "interval" && sesi.jenis !== "tempo") return;
    const h = checkSession(rekod, sesi.segmen, sesi.usaha);
    if (!h) return;
    $("semakan-ringkas").textContent =
      h.target !== null
        ? `${h.lulus}/${h.jumlah} blok laju dalam sasaran${
            h.purata !== null ? ` · purata ${formatPace(h.purata)}` : ""
          } (sasaran ${h.targetFinal ? "akhir " : ""}${formatPace(h.target)})`
        : h.purata !== null
          ? `Purata blok laju: ${formatPace(h.purata)}/km`
          : "Tiada blok laju yang dapat diukur.";
    $("semakan-blok").replaceChildren(
      ...h.blok.map((b) => {
        const li = document.createElement("li");
        li.className =
          b.lulus === true ? "lulus" : b.lulus === false ? "gagal" : "";
        const kiri = document.createElement("span");
        kiri.textContent = `Blok ${b.no} · ${formatDuration(b.saat)}`;
        const kanan = document.createElement("strong");
        kanan.textContent = b.pace !== null ? `${formatPace(b.pace)}/km` : "—";
        li.append(kiri, kanan);
        return li;
      }),
    );
    $("semakan").hidden = false;
  }

  /** Split setiap km + best effort dari rekod FIT. */
  function pecahan(splits: Split[], best: BestEffort[]) {
    if (!splits.length) return;
    const paces = splits
      .map((s) => s.pace)
      .filter((p): p is number => p !== null);
    const lajuMin = paces.length ? Math.min(...paces) : 0;
    const lajuMax = paces.length ? Math.max(...paces) : 0;
    const julat = lajuMax - lajuMin;
    $("split-senarai").replaceChildren(
      ...splits.map((s) => {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.className = "split-km";
        label.textContent =
          s.distanceM >= 999 ? `KM ${s.km}` : formatKm(s.distanceM);
        const pace = document.createElement("strong");
        pace.textContent = s.pace !== null ? `${formatPace(s.pace)}/km` : "-";
        const bar = document.createElement("span");
        bar.className = "split-bar";
        bar.setAttribute("aria-hidden", "true");
        const isi = document.createElement("i");
        const pct =
          s.pace === null || !paces.length
            ? 0
            : julat === 0
              ? 100
              : Math.round(40 + (60 * (lajuMax - s.pace)) / julat);
        isi.style.width = `${pct}%`;
        bar.append(isi);
        const naik = document.createElement("span");
        naik.className = "muted split-naik";
        naik.textContent =
          s.elevationGainM >= 1 ? `+${Math.round(s.elevationGainM)} m` : "";
        li.append(label, pace, bar, naik);
        return li;
      }),
    );
    $("split").hidden = false;
    $("peta-split").classList.add("ada-split");
    if (!best.length) return;
    $("best-senarai").replaceChildren(
      ...best.map((b) => {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.className = "split-km";
        label.textContent = b.label;
        const masa = document.createElement("strong");
        masa.textContent = formatTime(b.seconds / 60);
        const pace = document.createElement("span");
        pace.className = "muted";
        pace.textContent = `${formatPace(b.seconds / (b.distanceM / 1000))}/km`;
        li.append(label, masa, pace);
        return li;
      }),
    );
    $("best").hidden = false;
  }

  const ARAH_ANGIN = ["U", "TL", "T", "TG", "S", "BD", "B", "BL"];

  /** Cuaca dari FIT: hanya field yang ada; panel tersembunyi jika tiada data. */
  // Teks tetap (tiada data pengguna) -> innerHTML selamat; pautan = atribusi CC BY 4.0.
  const MET_NOTA =
    'Anggaran jam larian di sekitar titik mula, dari <a href="https://api.met.no/">MET Norway</a> (CC BY 4.0), diambil semasa upload.';

  function cuaca(w: ActivityWeather | null, nota: string) {
    if (!w) return;
    $("cuaca-sumber").innerHTML = nota;
    const set = (row: string, id: string, teks: string | null) => {
      const el = $(row);
      if (teks === null) {
        el.hidden = true;
        return;
      }
      $(id).textContent = teks;
      el.hidden = false;
    };
    const deg =
      w.windDirectionDeg === null
        ? null
        : ((w.windDirectionDeg % 360) + 360) % 360;
    set(
      "cuaca-suhu",
      "s-suhu",
      w.temperatureC === null ? null : `${Math.round(w.temperatureC)}°C`,
    );
    set(
      "cuaca-rasa",
      "s-rasa",
      w.feelsLikeC === null ? null : `${Math.round(w.feelsLikeC)}°C`,
    );
    set(
      "cuaca-lembap",
      "s-lembap",
      w.humidityPct === null ? null : `${Math.round(w.humidityPct)}%`,
    );
    set(
      "cuaca-angin",
      "s-angin",
      w.windSpeedMs === null ? null : `${Math.round(w.windSpeedMs * 3.6)} km/j`,
    );
    set(
      "cuaca-arah",
      "s-arah",
      deg === null
        ? null
        : `${ARAH_ANGIN[Math.round(deg / 45) % 8]} (${Math.round(deg)}°)`,
    );
    $("cuaca").hidden = ![
      "cuaca-suhu",
      "cuaca-rasa",
      "cuaca-lembap",
      "cuaca-angin",
      "cuaca-arah",
    ].some((id) => !$(id).hidden);
  }

  const ZON = ["Ringan", "Aerobik asas", "Tempo", "Ambang laktat", "Maksimum"];

  /** Carta nadi (SVG sebaris) + masa dalam 5 zon. Tiada nadi = seksyen kekal tersembunyi. */
  function nadi(siri: [number, number][], maksSesi: number | null) {
    if (siri.length < 2) return;
    let lo = Infinity,
      hi = 0; // reduce, bukan Math.min(...) - larian panjang = puluhan ribu titik
    for (const [, b] of siri) ((lo = Math.min(lo, b)), (hi = Math.max(hi, b)));
    const maks = Math.round(Math.max(maksSesi ?? 0, hi));
    const T = siri.at(-1)![0] || 1,
      julat = hi - lo || 1,
      langkah = Math.ceil(siri.length / 600); // ~600 titik cukup untuk lebar carta
    const titik = siri
      .filter((_, i) => i % langkah === 0 || i === siri.length - 1)
      .map(
        ([t, b]) =>
          `${((t / T) * 600).toFixed(1)},${(155 - ((b - lo) / julat) * 150).toFixed(1)}`,
      )
      .join(" ");
    $("nadi-garis").setAttribute("points", titik);
    $("nadi-kawasan").setAttribute("points", `0,160 ${titik} 600,160`);
    $("nadi-hi").textContent = `${hi}`;
    $("nadi-lo").textContent = `${lo}`;
    $("nadi-tempoh").textContent = formatDuration(Math.round(T));
    $("nadi-carta").setAttribute(
      "aria-label",
      `Carta nadi: ${lo} hingga ${hi} bpm sepanjang ${formatDuration(Math.round(T))}`,
    );
    const had = [0.6, 0.7, 0.8, 0.9].map((p) => Math.round(maks * p));
    $("nadi-zon").innerHTML = hrZones(siri, maks) // nombor dan label tetap sahaja -> selamat untuk innerHTML
      .map((z, i) => {
        const bpm =
          i === 0
            ? `< ${had[0]}`
            : i === 4
              ? `≥ ${had[3]}`
              : `${had[i - 1]}-${had[i] - 1}`;
        const pct = Math.round(z * 100);
        return `<li style="--k:${25 + i * 18.75}%">
          <span class="zon-nama"><strong>Z${i + 1}</strong> ${ZON[i]}</span>
          <span class="zon-bpm">${bpm} bpm</span>
          <span class="zon-bar" aria-hidden="true"><i style="width:${pct}%"></i></span>
          <strong class="zon-pct">${pct}%</strong>
        </li>`;
      })
      .join("");
    $("nadi-asas").textContent =
      `Zon ikut % nadi maks aktiviti ini (${maks} bpm): Z1 bawah 60%, Z2 60-70%, Z3 70-80%, Z4 80-90%, Z5 90% ke atas. Z4 ambang laktat = rentak paling laju yang masih boleh ditahan lebih lama; Z5 maksimum = sekejap saja. Nadi maks sebenar anda mungkin lebih tinggi - anggap ini panduan kasar.`;
    $("nadi").hidden = false;
  }

  // Diisi oleh peta() bila laluan ada track: jarak (m) dari profil -> titik di peta; null = sembunyi.
  let penunjukPeta: ((jarakM: number | null) => void) | null = null;
  // Diisi oleh tinggi(): hover laluan di peta -> penunjuk + bacaan di profil (gaya Analysis Strava).
  let tunjukProfil: ((jarakM: number | null) => void) | null = null;

  /** Profil ketinggian (SVG sebaris). Tiada altitude = seksyen kekal tersembunyi.
   *  Tetikus / seret / anak panah pada profil = penunjuk jarak + titik sama di peta. */
  function tinggi(
    siri: [number, number][],
    naik: number | null,
    track: TrackPoint[] | null,
  ) {
    if (siri.length < 2) return;
    let lo = Infinity,
      hi = -Infinity;
    for (const [, alt] of siri)
      ((lo = Math.min(lo, alt)), (hi = Math.max(hi, alt)));
    const T = siri.at(-1)![0] || 1;
    const julat = hi - lo || 1;
    const langkah = Math.ceil(siri.length / 600); // ~600 titik cukup untuk lebar carta
    const titik = siri
      .filter((_, i) => i % langkah === 0 || i === siri.length - 1)
      .map(
        ([d, alt]) =>
          `${((d / T) * 600).toFixed(1)},${(155 - ((alt - lo) / julat) * 150).toFixed(1)}`,
      )
      .join(" ");
    $("tinggi-garis").setAttribute("points", titik);
    $("tinggi-kawasan").setAttribute("points", `0,160 ${titik} 600,160`);
    $("tinggi-hi").textContent = `${Math.round(hi)} m`;
    $("tinggi-lo").textContent = `${Math.round(lo)} m`;
    $("tinggi-jarak").textContent = formatKm(T);
    $("tinggi-carta").setAttribute(
      "aria-label",
      `Profil ketinggian: ${Math.round(lo)} hingga ${Math.round(hi)} m sepanjang ${formatKm(T)}`,
    );
    $("tinggi-nota").textContent =
      naik == null
        ? "Ketinggian dari fail FIT."
        : `Naik ${Math.round(naik)} m sepanjang laluan. Turun tidak dikira.`;

    const svg = $("tinggi-carta");
    const penunjuk = $("tinggi-penunjuk");
    const baca = $("tinggi-baca");
    let kini: number | null = null;
    const tunjuk = (d: number | null) => {
      kini = d === null ? null : Math.min(T, Math.max(0, d));
      if (kini === null) {
        penunjuk.setAttribute("visibility", "hidden");
        baca.textContent = "";
      } else {
        const [x, alt] = siri.find(([m]) => m >= kini!) ?? siri.at(-1)!;
        const px = ((x / T) * 600).toFixed(1);
        penunjuk.setAttribute("x1", px);
        penunjuk.setAttribute("x2", px);
        penunjuk.setAttribute("visibility", "visible");
        const pace = track && paceAt(track, x);
        const bpm = track?.find((p) => p.distanceM >= x)?.heartRate;
        baca.textContent = [
          formatKm(x),
          `${Math.round(alt)} m`,
          pace && `${formatPace(pace)}/km`,
          bpm && `${bpm} bpm`,
        ]
          .filter(Boolean)
          .join(" · ");
      }
      penunjukPeta?.(kini);
    };
    tunjukProfil = tunjuk;
    const dariTetikus = (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      tunjuk(((e.clientX - r.left) / r.width) * T);
    };
    svg.addEventListener("pointerdown", dariTetikus);
    svg.addEventListener("pointermove", dariTetikus);
    svg.addEventListener("pointerleave", () => tunjuk(null));
    svg.addEventListener("blur", () => tunjuk(null));
    svg.addEventListener("keydown", (e) => {
      const arah = ({ ArrowRight: 1, ArrowLeft: -1 } as Record<string, number>)[
        e.key
      ];
      if (arah) {
        e.preventDefault();
        tunjuk((kini ?? 0) + (arah * T) / 50);
      } else if (e.key === "Escape") tunjuk(null);
    });
    $("tinggi").hidden = false;
  }

  // paceColours false = track anggaran (preview feed): warna pace akan rata dan mengelirukan.
  async function peta(
    titik: [number, number][],
    track: TrackPoint[] | null,
    paceColours = true,
  ) {
    const status = $("peta-status");
    if (titik.length < 2) {
      $("peta").hidden = true;
      status.textContent =
        "Tiada laluan GPS dalam fail ini (contoh larian treadmill).";
      return;
    }
    try {
      const [ml, pekerja] = await PETA;
      ml.setWorkerUrl(pekerja.default);
      const warna = getComputedStyle(document.documentElement);
      const oren = warna.getPropertyValue("--orange").trim() || "#ff5a1f";
      const lonLat = titik.map(([lat, lon]) => [lon, lat] as [number, number]);
      const lon = lonLat.map((t) => t[0]),
        lat = lonLat.map((t) => t[1]);
      const sempadan: LngLatBoundsLike = [
        Math.min(...lon),
        Math.min(...lat),
        Math.max(...lon),
        Math.max(...lat),
      ];

      let tigaD = false;
      try {
        tigaD = localStorage.getItem(SIMPAN_3D) === "1";
      } catch {}
      const sudut = () => (tigaD ? 60 : 0);
      // Warna ikut pace perlukan masa + jarak (track); tanpa itu butang Pace tiada.
      const gradien = track && paceColours ? paceGradient(track) : null;
      const garisPace: ExpressionSpecification | undefined = gradien
        ? ([
            "interpolate",
            ["linear"],
            ["line-progress"],
            ...gradien.stops.flat(),
          ] as unknown as ExpressionSpecification)
        : undefined;
      let warnaPace = false;
      try {
        warnaPace = !!gradien && localStorage.getItem(SIMPAN_WARNA) === "pace";
      } catch {}

      // Tiada WebGL = konstruktor melontar -> catch di bawah.
      const map = new ml.Map({
        container: "peta",
        style: PETA_GAYA,
        bounds: sempadan,
        fitBoundsOptions: { padding: 24 },
        pitch: sudut(),
        // Page tetap boleh skrol: zum dalam peta = Ctrl/⌘ + skrol (desktop), dua jari (telefon).
        cooperativeGestures: true,
        attributionControl: { compact: true }, // butang "i"; ditutup selepas load (di bawah)
        locale: {
          "CooperativeGesturesHandler.WindowsHelpText":
            "Tekan Ctrl + skrol untuk zum peta",
          "CooperativeGesturesHandler.MacHelpText":
            "Tekan ⌘ + skrol untuk zum peta",
          "CooperativeGesturesHandler.MobileHelpText":
            "Guna dua jari untuk gerakkan peta",
          "FullscreenControl.Enter": "Skrin penuh",
          "FullscreenControl.Exit": "Keluar skrin penuh",
          "NavigationControl.ZoomIn": "Zum masuk",
          "NavigationControl.ZoomOut": "Zum keluar",
        },
      });

      // Animasi laluan: track hanya ada bila FIT mempunyai GPS + timestamp. Tanpa track,
      // route biasa masih dipaparkan dan butang Main kekal tersembunyi.
      const mainBox = $("main-semula");
      const mainButton = $("main-main") as HTMLButtonElement;
      const duration = track?.at(-1)?.t ?? 0;
      let animTime = 0;
      let playMarker: Marker | null = null;
      let playDir: HTMLElement | null = null;

      function drawTrack(seconds: number) {
        if (!track || !duration || !map.getSource("main-kemajuan")) return;
        const pos = trackAt(track, seconds);
        if (!pos) return;
        const coordinates: [number, number][] =
          seconds >= duration
            ? [
                [pos.lon, pos.lat],
                [pos.lon, pos.lat],
              ]
            : track
                .slice(0, pos.index + 1)
                .map((p): [number, number] => [p.lon, p.lat]);
        if (seconds < duration) coordinates.push([pos.lon, pos.lat]);
        const sumber = map.getSource("main-kemajuan") as GeoJSONSource;
        sumber.setData({
          type: "Feature",
          properties: {},
          geometry: { type: "LineString", coordinates },
        });
        playMarker?.setLngLat([pos.lon, pos.lat]);
        const a = track[Math.max(0, pos.index - 1)];
        const b = track[Math.min(track.length - 1, pos.index + 1)];
        if (playDir && a && b && (a.lat !== b.lat || a.lon !== b.lon)) {
          const rad = Math.PI / 180;
          const y = Math.sin((b.lon - a.lon) * rad) * Math.cos(b.lat * rad);
          const x =
            Math.cos(a.lat * rad) * Math.sin(b.lat * rad) -
            Math.sin(a.lat * rad) *
              Math.cos(b.lat * rad) *
              Math.cos((b.lon - a.lon) * rad);
          const deg = (Math.atan2(y, x) * 180) / Math.PI - map.getBearing();
          playDir.style.transform = `rotate(${deg}deg)`;
        }
      }

      // Intro: sapuan dari mula ke akhir ~3 s, bukan masa sebenar. Butang Main
      // mengulang animasi ini. Reduced motion = terus tunjuk laluan penuh.
      const setRoute = (visible: boolean, color: string) => {
        if (map.getLayer("laluan"))
          map.setLayoutProperty(
            "laluan",
            "visibility",
            visible ? "visible" : "none",
          );
        if (map.getLayer("laluan-tepi"))
          map.setLayoutProperty(
            "laluan-tepi",
            "visibility",
            visible ? "visible" : "none",
          );
        if (map.getLayer("main-kemajuan"))
          map.setPaintProperty("main-kemajuan", "line-color", color);
      };
      let introRaf = 0;
      let introTimer = 0;
      let introOn = false;
      let introDone = false;
      const showFull = () => {
        setRoute(true, "#fff");
        animTime = duration;
        drawTrack(duration);
        introDone = true;
      };
      const cancelIntro = () => {
        introOn = false;
        cancelAnimationFrame(introRaf);
        if (introTimer) clearTimeout(introTimer);
        introRaf = 0;
        introTimer = 0;
      };
      const stopIntro = () => {
        if (!introOn && !introTimer) return;
        cancelIntro();
        showFull();
      };
      const intro = () => {
        if (!track || !duration) return;
        cancelIntro();
        introDone = false;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
          showFull();
          return;
        }
        setRoute(false, oren);
        animTime = 0;
        drawTrack(0);
        const mula = performance.now();
        introOn = true;
        const langkah = (now: number) => {
          if (!introOn) return;
          const f = Math.min(1, (now - mula) / 3000);
          animTime = f * duration;
          drawTrack(animTime);
          if (f < 1) introRaf = requestAnimationFrame(langkah);
          else {
            introOn = false;
            showFull();
          }
        };
        introRaf = requestAnimationFrame(langkah);
      };

      mainButton.addEventListener("click", intro);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopIntro();
      });
      map.on("rotate", () => drawTrack(animTime));

      // Kawalan sendiri = butang biasa dalam kumpulan kawalan MapLibre -> gaya sama dengan zum/skrin penuh.
      const butang = (label: string, isi: string, klik: () => void) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "kawal";
        b.title = label;
        b.setAttribute("aria-label", label);
        b.innerHTML = isi; // ikon / teks tetap sahaja
        b.addEventListener("click", klik);
        return b;
      };
      const kumpulan = (...b: HTMLElement[]): IControl => ({
        onAdd: () => {
          const d = document.createElement("div");
          d.className = "maplibregl-ctrl maplibregl-ctrl-group";
          d.append(...b);
          return d;
        },
        onRemove: () => {},
      });

      const RELIEF = { source: "dem", exaggeration: 1.5 };
      const set3d = (on: boolean) => {
        tigaD = on;
        if (map.getSource("dem")) map.setTerrain(on ? RELIEF : null);
        b3d.setAttribute("aria-pressed", String(on));
        map.easeTo({ pitch: sudut(), ...(on ? {} : { bearing: 0 }) });
      };
      const b3d = butang("Paparan 3D", "3D", () => {
        set3d(!tigaD);
        simpan(SIMPAN_3D, tigaD ? "1" : "0");
      });
      b3d.classList.add("kawal-teks");
      b3d.setAttribute("aria-pressed", String(tigaD));

      const legenda = $("pace-legenda");
      const setPace = (on: boolean) => {
        warnaPace = on;
        bPace?.setAttribute("aria-pressed", String(on));
        legenda.hidden = !on;
        if (map.getLayer("laluan"))
          map.setPaintProperty(
            "laluan",
            "line-gradient",
            on ? garisPace : undefined,
          );
      };
      const bPace =
        gradien &&
        butang("Warna laluan ikut pace", "Pace", () => {
          setPace(!warnaPace);
          simpan(SIMPAN_WARNA, warnaPace ? "pace" : "biasa");
        });
      if (gradien && bPace) {
        bPace.classList.add("kawal-teks");
        $("pace-laju").textContent = `${formatPace(gradien.laju)}/km`;
        $("pace-perlahan").textContent = `${formatPace(gradien.perlahan)}/km`;
        $("pace-bar").style.background =
          `linear-gradient(90deg, ${[...WARNA_PACE].reverse().join(", ")})`;
        setPace(warnaPace);
      }

      const bPusat = butang("Pusat semula", icon("pusat"), () =>
        map.fitBounds(sempadan, { padding: 24, pitch: sudut(), bearing: 0 }),
      );

      map.addControl(kumpulan(b3d, ...(bPace ? [bPace] : [])), "top-right");
      map.addControl(new ml.FullscreenControl(), "top-right");
      // Bawah-kanan: kawalan baru masuk di atas -> susunan (atas ke bawah) pusat semula, zum, atribusi.
      map.addControl(
        new ml.NavigationControl({ showCompass: false }),
        "bottom-right",
      );
      map.addControl(kumpulan(bPusat), "bottom-right");

      // Laluan + bukit dilukis bila gaya siap.
      const garis = { "line-join": "round", "line-cap": "round" } as const;
      map.on("style.load", () => {
        {
          map.addSource("dem", DEM);
          map.addSource("dem-bukit", DEM); // MapLibre: hillshade + terrain lebih cantik dengan sumber berasingan
          const label = map
            .getStyle()
            .layers.find((l) => l.type === "symbol")?.id;
          map.addLayer(
            {
              id: "bukit",
              type: "hillshade",
              source: "dem-bukit",
              // Lembut supaya laluan kekal paling menonjol; cahaya barat laut (lazim peta).
              paint: {
                "hillshade-exaggeration": 0.35,
                "hillshade-illumination-direction": 315,
                "hillshade-shadow-color": "rgba(10, 26, 51, 0.35)",
                "hillshade-highlight-color": "rgba(255, 255, 255, 0.3)",
              },
            },
            label,
          );
          if (tigaD) map.setTerrain(RELIEF); // 2D = hillshade sahaja (ringan untuk telefon)
        }
        map.addSource("laluan", {
          type: "geojson",
          lineMetrics: true, // line-progress untuk warna pace
          data: {
            type: "Feature",
            properties: {},
            geometry: { type: "LineString", coordinates: lonLat },
          },
        });
        map.addLayer({
          id: "laluan-tepi",
          type: "line",
          source: "laluan",
          layout: garis,
          paint: { "line-color": "#fff", "line-width": 9 },
        });
        map.addLayer({
          id: "laluan",
          type: "line",
          source: "laluan",
          layout: garis,
          paint: { "line-color": oren, "line-width": 5 },
        });
        if (warnaPace)
          map.setPaintProperty("laluan", "line-gradient", garisPace);
        if (track && track.length >= 2) {
          map.addSource("main-kemajuan", {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: { type: "LineString", coordinates: [lonLat[0]] },
            },
          });
          map.addLayer({
            id: "main-kemajuan",
            type: "line",
            source: "main-kemajuan",
            layout: garis,
            paint: { "line-color": "#fff", "line-width": 8 },
          });
          if (!playMarker) {
            const el = document.createElement("div");
            el.className = "main-titik";
            el.title = "Kedudukan semasa";
            el.setAttribute("role", "img");
            el.setAttribute("aria-label", "Kedudukan semasa");
            const arah = document.createElement("span");
            arah.className = "main-arah";
            arah.setAttribute("aria-hidden", "true");
            const kepala = document.createElement("span");
            kepala.className = "main-anak-panah";
            arah.append(kepala);
            el.append(arah);
            playDir = arah;
            playMarker = new ml.Marker({ element: el, anchor: "center" })
              .setLngLat(lonLat[0])
              .addTo(map);
          }
          mainBox.hidden = false;
          drawTrack(animTime);
          if (!introDone && duration) setRoute(false, oren);
        }
      });
      await new Promise((ok, gagal) => {
        map.once("load", ok);
        map.on("error", (e) => {
          const sid = (e as { sourceId?: string }).sourceId;
          // DEM gagal = Terperinci kekal, cuma tanpa bukit/relief (bukit ialah tambahan, bukan peta).
          if (sid?.startsWith("dem")) {
            map.setTerrain(null);
            if (map.getLayer("bukit")) map.removeLayer("bukit");
            return;
          }
          // Ralat jubin biasa (ada sourceId) diabaikan; gaya gagal sebelum load = mesej gagal di bawah.
          if (!map.loaded() && !sid) gagal(e.error);
        });
      });
      // Kredit mula tertutup: MapLibre buka compact sekali sahaja, jadi tutup sekali selepas load memadai.
      const kredit = map
        .getContainer()
        .querySelector(".maplibregl-ctrl-attrib");
      kredit?.classList.remove("maplibregl-compact-show");
      kredit?.removeAttribute("open");
      for (const [label, isi, titikNya] of [
        // Gaya Strava: mula hijau, tamat bendera petak.
        ["Mula", "#16a34a", lonLat[0]],
        [
          "Tamat",
          "repeating-conic-gradient(#111 0 25%, #fff 0 50%) 50% / 6px 6px",
          lonLat.at(-1)!,
        ],
      ] as const) {
        const el = document.createElement("div");
        el.className = "penanda";
        el.style.background = isi;
        el.title = label;
        el.setAttribute("role", "img");
        el.setAttribute("aria-label", label);
        new ml.Marker({ element: el }).setLngLat(titikNya).addTo(map);
      }
      if (track) {
        const el = document.createElement("div");
        el.className = "penanda penanda-profil";
        el.setAttribute("aria-hidden", "true"); // jarak + ketinggian dibaca di bawah profil
        const titikProfil = new ml.Marker({ element: el });
        penunjukPeta = (d) => {
          if (d === null) return void titikProfil.remove();
          const p = track.find((t) => t.distanceM >= d) ?? track.at(-1)!;
          titikProfil.setLngLat([p.lon, p.lat]);
          if (!el.isConnected) titikProfil.addTo(map);
        };
        // Hover / ketik laluan = titik terdekat; bacaan muncul di profil bila profil ada.
        const dariPeta = (d: number | null) =>
          tunjukProfil ? tunjukProfil(d) : penunjukPeta?.(d);
        const hover = (e: { lngLat: { lng: number; lat: number } }) => {
          map.getCanvas().style.cursor = "crosshair";
          dariPeta(nearestDistance(track, e.lngLat.lng, e.lngLat.lat));
        };
        map.on("mousemove", "laluan-tepi", hover);
        map.on("click", "laluan-tepi", hover);
        map.on("mouseleave", "laluan-tepi", () => {
          map.getCanvas().style.cursor = "";
          dariPeta(null);
        });
      }
      if (track && duration && !introDone && !introOn && !introTimer) {
        // Buffer supaya peta sempat muncul; reduced motion terus tunjuk laluan penuh.
        const delay = matchMedia("(prefers-reduced-motion: reduce)").matches
          ? 0
          : 600;
        introTimer = window.setTimeout(intro, delay);
      }
      status.hidden = true;
    } catch {
      $("peta").hidden = true;
      status.textContent =
        "Laluan tak dapat dimuatkan. Muat semula halaman untuk cuba lagi.";
    }
  }

  await mula();
</script>

