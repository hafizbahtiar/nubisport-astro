    overflow-wrap: anywhere;
  }
  .panel .panel-kepala {
    align-items: flex-start;
  }

  .tajuk {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .kecil {
    font-size: 0.8rem;
  }

  .peta-split {
    display: grid;
    gap: 1rem;
  }
  .peta-split .panel {
    margin-bottom: 0;
  }
  @media (min-width: 60rem) {
    .peta-split.ada-split {
      grid-template-columns: minmax(0, 1.7fr) minmax(19rem, 1fr);
      align-items: start;
    }
    .peta-split.ada-split .split-panel {
      max-height: 32rem;
      overflow-y: auto;
    }
  }

  .peta {
    height: clamp(16rem, 45vh, 28rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    z-index: 0; /* kawalan peta (z-index 2) jangan atasi laci sidebar */
    isolation: isolate;
  }
  /* Penanda dan kawalan dicipta dalam skrip/MapLibre -> perlu :global */
  .peta :global(.penanda) {
    width: 14px;
    height: 14px;
    border: 2px solid #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
  }
  .peta :global(.main-titik) {
    position: relative;
    width: 22px;
    height: 22px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 2px rgb(10 26 51 / 0.35);
    animation: main-titik-nadi 1.4s ease-out infinite;
  }
  .peta :global(.main-arah) {
    position: absolute;
    inset: -3px;
    transform-origin: 50% 50%;
  }
  .peta :global(.main-anak-panah) {
    position: absolute;
    top: -7px;
    left: 50%;
    width: 0;
    height: 0;
    border-right: 5px solid transparent;
    border-bottom: 9px solid var(--orange);
    border-left: 5px solid transparent;
    transform: translateX(-50%);
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff);
  }
  @keyframes main-titik-nadi {
    0%,
    100% {
      box-shadow:
        0 0 0 2px rgb(10 26 51 / 0.35),
        0 0 0 0 rgb(255 90 31 / 0.35);
    }
    50% {
      box-shadow:
        0 0 0 2px rgb(10 26 51 / 0.35),
        0 0 0 8px rgb(255 90 31 / 0);
