---
// Detail satu aktiviti: peta laluan (MapLibre GL + OpenFreeMap), ringkasan dan nadi. /account/activities/view?id=<id>.
// Laluan dan nadi dilukis di pelayar dari fail .fit asal (GET /me/apps/nubi/activities/:id/file - milik
// sendiri sahaja, diurai sekali); Worker tidak menghurai apa-apa. Peta hanya untuk ahli itu - tiada perkongsian.
// Peta: maplibre-gl dimuat malas (JS + CSS hanya di page ini), gaya vektor OpenFreeMap (GAYA di bawah).
// Atribusi datang dari gaya dan wajib kelihatan. Tiada WebGL = mesej gagal.
// Kawalan dalam kanvas (docs/plans/map-3d.md): 3D, gaya peta (popover / bottom sheet bawah 40rem),
// skrin penuh, pusat semula, zum. Gaya + 3D diingat dalam localStorage, lalai Standard 2D.
import AccountLayout from "../../../layouts/AccountLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
import Icon from "../../../components/ui/Icon.astro";
import type { IconName } from "../../../lib/icon";

// Semua URL disemak 200 (2026-10-22). OpenFreeMap: percuma, tiada kunci/had paparan, komersial dibenarkan.
// Satelit sengaja tiada: tiada sumber percuma tanpa kunci yang jelas boleh guna komersial (EOX s2cloudless
// 2018+ = CC BY-NC-SA; Esri perlu akaun).
const OFM = "https://tiles.openfreemap.org/styles/";
const GAYA: {
  id: string;
  label: string;
  nota: string;
  url: string;
  ikon: IconName;
}[] = [
  {
    id: "standard",
    label: "Standard",
    nota: "Kelabu lembut, laluan paling jelas",
    url: `${OFM}positron`,
    ikon: "peta",
  },
  {
    id: "liberty",
    label: "Terperinci",
    nota: "Jalan, taman dan bangunan 3D",
    url: `${OFM}liberty`,
    ikon: "bangunan",
  },
  {
    id: "bright",
    label: "Cerah",
    nota: "Warna penuh, macam peta biasa",
    url: `${OFM}bright`,
    ikon: "matahari",
  },
  {
    id: "dark",
    label: "Gelap",
    nota: "Selesa untuk mata waktu malam",
    url: `${OFM}dark`,
    ikon: "bulan",
  },
  {
    id: "fiord",
    label: "Fiord",
    nota: "Biru gelap, laluan menonjol",
    url: `${OFM}fiord`,
    ikon: "ombak",
  },
  {
    id: "terrain",
    label: "Terrain",
    nota: "Bukit dan lembah - tekan 3D untuk relief",
    url: `${OFM}positron`,
    ikon: "gunung",
  },
];
---

<AccountLayout title="Aktiviti">
  <a class="back-link back-link--spaced" href="/account/activities"
    ><Icon name="kiri" />Semua aktiviti</a
  >

  <Alert variant="info" title="Ciri untuk ahli" id="bukan-ahli" hidden>
    <p>Import aktiviti Strava terbuka untuk ahli Nubi Sport.</p>
  </Alert>
  <Alert variant="danger" id="tiada" hidden>
    <p>Aktiviti ini tiada, atau bukan milik anda.</p>
  </Alert>

  <div id="isi" hidden>
    <section class="panel">
      <div class="panel-kepala">
        <div class="tajuk">
          <h3 class="display" id="nama"></h3>
          <p class="muted" id="bila"></p>
          <p id="sesi-pelan" hidden></p>
        </div>
        <button class="btn btn-outline btn-sm" type="button" id="padam"
          >Padam</button
        >
      </div>

      <div class="peta" id="peta" aria-label="Peta laluan">
        <!-- Dalam bekas peta supaya kekal kelihatan dalam skrin penuh. Desktop: show() = popover; telefon: showModal() = sheet. -->
        <dialog class="gaya" id="pilih-gaya" aria-labelledby="gaya-tajuk">
          <div class="gaya-isi">
            <span class="pemegang" aria-hidden="true"></span>
            <div class="gaya-kepala">
              <h4 id="gaya-tajuk">Gaya peta</h4>
              <button
                class="gaya-tutup"
                type="button"
                aria-label="Tutup"
                data-tutup><Icon name="tutup" /></button
              >
            </div>
            <fieldset>
              <legend class="sr-only">Pilih gaya peta</legend>
              {
                GAYA.map((g) => (
                  <label class="gaya-pilihan">
                    <input
                      class="sr-only"
                      type="radio"
                      name="gaya"
                      value={g.id}
                      data-url={g.url}
                    />
                    <span class={`contoh contoh-${g.id}`} aria-hidden="true">
                      <Icon name={g.ikon} />
                    </span>
                    <span class="gaya-teks">
                      <strong>{g.label}</strong>
                      <small>{g.nota}</small>
                    </span>
                    <span class="gaya-tanda" aria-hidden="true">
                      <Icon name="tanda" />
                    </span>
                  </label>
                ))
              }
            </fieldset>
          </div>
        </dialog>
        <div
          class="main-semula"
          id="main-semula"
          role="group"
          aria-label="Main semula laluan"
          hidden
        >
          <button
            class="main-main"
            id="main-main"
            type="button"
            aria-label="Main laluan"
            aria-pressed="false"
          >
            <span id="main-main-ikon" aria-hidden="true"
              ><Icon name="main" /></span
            >
            <span id="main-main-teks">Main</span>
          </button>
          <button
            class="main-reset"
            id="main-reset"
            type="button"
            aria-label="Mula semula"
            title="Mula semula"
          >
            <Icon name="kiri" />
          </button>
          <span class="main-masa" id="main-masa" aria-live="polite"
            >0:00 / 0:00</span
          >
          <label class="sr-only" for="main-slider">Kedudukan masa</label>
          <input
            class="main-slider"
            id="main-slider"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            aria-label="Kedudukan masa"
          />
          <label class="sr-only" for="main-laju">Kelajuan main semula</label>
          <select
            class="main-laju"
            id="main-laju"
            aria-label="Kelajuan main semula"
          >
            <option value="1">1×</option>
            <option value="2">2×</option>
            <option value="4">4×</option>
            <option value="8">8×</option>
          </select>
        </div>
      </div>
      <p class="muted" id="peta-status">Memuatkan laluan…</p>
      <p class="muted kecil">Laluan ini hanya kelihatan kepada anda.</p>
    </section>

    <ul class="stat" aria-label="Ringkasan">
      <li><span>Jarak</span><strong id="s-jarak"></strong></li>
      <li><span>Masa</span><strong id="s-masa"></strong></li>
      <li><span>Pace</span><strong id="s-pace"></strong></li>
      <li><span>Ketinggian naik</span><strong id="s-tinggi"></strong></li>
      <li><span>Nadi purata</span><strong id="s-nadi"></strong></li>
      <li><span>Nadi maks</span><strong id="s-nadi-maks"></strong></li>
      <li id="s-lari-baris" hidden>
        <span>Kadens lari</span><strong id="s-lari"></strong>
      </li>
    </ul>

    <section class="panel" id="split" aria-labelledby="split-tajuk" hidden>
      <h3 class="display" id="split-tajuk">Split setiap km</h3>
      <ul class="split" id="split-senarai"></ul>
      <div id="best" hidden>
        <h4 class="sub">Best effort</h4>
        <ul class="split" id="best-senarai"></ul>
      </div>
      <p class="muted kecil">
        Masa bergerak dari rekod FIT. Split terakhir mungkin separa km.
      </p>
    </section>

    <section class="panel" id="nadi" aria-labelledby="nadi-tajuk" hidden>
      <h3 class="display" id="nadi-tajuk">Nadi</h3>
      <figure class="carta">
        <div class="carta-badan">
          <span class="paksi-y" aria-hidden="true"
            ><span id="nadi-hi"></span><span id="nadi-lo"></span></span
          >
          <svg
            id="nadi-carta"
            viewBox="0 0 600 160"
            preserveAspectRatio="none"
            role="img"
          >
            <polygon id="nadi-kawasan" class="kawasan"></polygon>
            <polyline
              id="nadi-garis"
              class="garis"
              vector-effect="non-scaling-stroke"></polyline>
          </svg>
        </div>
        <figcaption class="paksi-x" aria-hidden="true">
          <span>0m</span><span id="nadi-tempoh"></span>
        </figcaption>
      </figure>
      <h4 class="sub">Masa dalam zon</h4>
      <ul class="zon" id="nadi-zon"></ul>
      <p class="muted kecil" id="nadi-asas"></p>
    </section>

    <section class="panel" id="tinggi" aria-labelledby="tinggi-tajuk" hidden>
      <h3 class="display" id="tinggi-tajuk">Ketinggian</h3>
      <figure class="carta tinggi">
        <div class="carta-badan">
          <span class="paksi-y" aria-hidden="true"
            ><span id="tinggi-hi"></span><span id="tinggi-lo"></span></span
          >
          <svg
            id="tinggi-carta"
            viewBox="0 0 600 160"
            preserveAspectRatio="none"
            role="img"
          >
            <polygon id="tinggi-kawasan" class="kawasan"></polygon>
            <polyline
              id="tinggi-garis"
              class="garis"
              vector-effect="non-scaling-stroke"></polyline>
          </svg>
        </div>
        <figcaption class="paksi-x" aria-hidden="true">
          <span>0 km</span><span id="tinggi-jarak"></span>
        </figcaption>
      </figure>
      <p class="muted kecil" id="tinggi-nota"></p>
    </section>

    <section class="panel" id="semakan" aria-labelledby="semakan-tajuk" hidden>
      <h3 class="display" id="semakan-tajuk">Semakan sesi</h3>
      <p id="semakan-ringkas"></p>
      <ul class="semakan" id="semakan-blok"></ul>
      <p class="muted kecil">
        Anggaran dari fail FIT: blok ikut masa pelan, bukan penilaian jurulatih.
      </p>
    </section>
  </div>
</AccountLayout>

<script>
  import { api, json, currentUser } from "../../../lib/api";
  import { confirmDialog } from "../../../lib/confirm";
  import { icon } from "../../../lib/icon";
  import {
    SPORT_LABELS,
    formatKm,
    fitRecords,
    routeOf,
    trackOf,
    trackAt,
    type TrackPoint,
    heartSeries,
    altitudeSeries,
    hrZones,
    paceFromDistance,
    formatDuration,
    type Sport,
  } from "../../../lib/activity-file";
  import {
    sessionLabel,
    sessionFor,
    walkedNote,
    ticksFrom,
    offerUntick,
    type PlanSession,
  } from "../../../lib/plan-sync";
  import {
    activitySplits,
    bestEfforts,
    checkSession,
    type BestEffort,
    type Split,
  } from "../../../lib/activity-analysis";
  import { formatPace } from "../../../lib/plan-5k";
  import { formatTime } from "../../../lib/distance-plan";
  import type {
    GeoJSONSource,
    IControl,
    LngLatBoundsLike,
    Marker,
    RasterDEMSourceSpecification,
  } from "maplibre-gl";

  // Mula download besar serta-merta; jangan tunggu /me, row, fail atau padanan pelan.
  const PETA = Promise.all([
    import("maplibre-gl"),
    // Vite tidak nampak URL worker maplibre (dikira masa jalan) -> emit sendiri dan beritahu.
    import("maplibre-gl/dist/maplibre-gl-worker.mjs?url"),
    import("maplibre-gl/dist/maplibre-gl.css"),
  ]);
  void PETA.catch(() => {});
  void import("@garmin/fitsdk").catch(() => {});

  const $ = (id: string) => document.getElementById(id)!;
  const BASE = "/me/apps/nubi/activities";
  // DEM Terrarium percuma tanpa kunci (Copernicus GLO-30 dll., global sehingga z12, tiada SLA).
  // Gagal muat = kembali Standard. Ganti: AWS https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png (256, maxzoom 15).
  const DEM: RasterDEMSourceSpecification = {
    type: "raster-dem",
    tiles: ["https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"],
    tileSize: 512,
    maxzoom: 12,
    encoding: "terrarium",
    attribution:
      '<a href="https://mapterhorn.com/attribution">© Mapterhorn</a>',
  };
  const SIMPAN_GAYA = "nubi/peta-gaya";
  const SIMPAN_3D = "nubi/peta-3d";
  const simpan = (k: string, v: string) => {
    try {
      localStorage.setItem(k, v);
    } catch {}
  };

  interface Aktiviti {
    id: number;
    startedAt: string;
    sport: Sport;
    name: string | null;
    distanceM: number;
    movingS: number;
    elapsedS: number;
    elevationGainM: number | null;
    avgHr: number | null;
    maxHr: number | null;
    runRatio: number | null;
    updatedAt: string;
  }

  async function mula() {
    const params = new URLSearchParams(location.search);
    const id = Number(params.get("id"));
    const version = params.get("v");
    const sah = Number.isSafeInteger(id) && id > 0;
    const fileUrl = (v: string) =>
      `${BASE}/${id}/file?v=${encodeURIComponent(v)}`;
    // Row + fail serentak dengan /me (backend tapis ikut pemilik). Link lama (tiada v) baca row
    // dulu supaya URL fail guna updatedAt semasa - immutable tak boleh dipakai pada URL tanpa versi.
    const fileP =
      sah && version ? api(fileUrl(version)).catch(() => null) : null;
    const rowP = sah ? api(`${BASE}/${id}`).catch(() => null) : null;
    const s = await currentUser();
    const nubi = s?.apps?.nubi;
    if (!(s?.role === "owner" || nubi === "ahli" || nubi === "admin")) {
      $("bukan-ahli").hidden = false;
      return;
    }
    const r = await rowP;
    if (!r?.ok) {
      $("tiada").hidden = false;
      return;
    }
    const a = (await json(r)).data as Aktiviti;
    $("isi").hidden = false;

    const nama = a.name || SPORT_LABELS[a.sport];
    $("nama").textContent = nama; // teks pengguna - textContent sahaja
    document.title = `${nama} - ${document.title}`;
    $("bila").textContent = `${SPORT_LABELS[a.sport]}, ${new Date(
      a.startedAt,
    ).toLocaleString("ms-MY", {
      timeZone: "Asia/Kuala_Lumpur",
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    })}`;
    const sesiPelan = sessionFor(a);
    void sesiPelan.then((m) => {
      if (!m) return;
      $("sesi-pelan").textContent = m.ditanda
        ? `Sesi pelan: ${sessionLabel(m.sesi)}`
        : walkedNote(a, m.sesi);
      $("sesi-pelan").hidden = false;
    });
    $("s-jarak").textContent = formatKm(a.distanceM);
    $("s-masa").textContent = formatDuration(a.movingS);
    $("s-pace").textContent = paceFromDistance(a.distanceM, a.movingS) ?? "-";
    $("s-tinggi").textContent =
      a.elevationGainM == null ? "-" : `${Math.round(a.elevationGainM)} m`;
    $("s-nadi").textContent = a.avgHr ? `${Math.round(a.avgHr)} bpm` : "-";
    $("s-nadi-maks").textContent = a.maxHr ? `${Math.round(a.maxHr)} bpm` : "-";
    if (a.runRatio != null) {
      $("s-lari").textContent =
        `Lari ${Math.round(a.runRatio * 100)}% masa bergerak`;
      $("s-lari-baris").hidden = false;
    }

    $("padam").addEventListener("click", async () => {
      const ya = await confirmDialog({
        title: "Padam aktiviti ini?",
        message: `${nama} dan fail asalnya akan dibuang. Tindakan ini tak boleh dibatalkan.`,
        confirmLabel: "Padam",
        danger: true,
      });
      if (!ya) return;
      const tanda = await ticksFrom([a]).catch(() => null);
      const d = await api(`${BASE}/${a.id}`, { method: "DELETE" });
      if (d.ok || d.status === 404) {
        await offerUntick(tanda);
        location.href = "/account/activities";
      } else
        $("peta-status").textContent =
          "Aktiviti tak dapat dipadam. Semak sambungan dan cuba lagi.";
    });

    let rekod: any[];
    try {
      const currentVersion = a.updatedAt;
      const f = await (fileP && version === currentVersion
        ? fileP
        : api(fileUrl(currentVersion)).catch(() => null));
      if (!f?.ok) throw new Error();
      rekod = await fitRecords(await f.arrayBuffer());
    } catch {
      $("peta").hidden = true;
      $("peta-status").textContent =
        "Laluan tak dapat dimuatkan. Muat semula halaman untuk cuba lagi.";
      return;
    }
    nadi(heartSeries(rekod), a.maxHr);
    tinggi(altitudeSeries(rekod), a.elevationGainM);
    pecahan(activitySplits(rekod), a.sport === "run" ? bestEfforts(rekod) : []);
    // Padanan pelan tak perlu menyekat peta.
    void sesiPelan
      .then((m) => {
        if (m) semakan(m.sesi, rekod);
      })
      .catch(() => {});
    const track = trackOf(rekod);
    const laluan =
      track.length >= 2
        ? track.map((p): [number, number] => [p.lat, p.lon])
        : routeOf(rekod);
    await peta(laluan, track.length >= 2 ? track : null);
  }

  /** Interval/tempo: banding blok laju sebenar dengan pace sasaran dalam teks sesi. */
  function semakan(sesi: PlanSession, rekod: any[]) {
    if (sesi.jenis !== "interval" && sesi.jenis !== "tempo") return;
    const h = checkSession(rekod, sesi.segmen, sesi.usaha);
    if (!h) return;
    $("semakan-ringkas").textContent =
      h.target !== null
        ? `${h.lulus}/${h.jumlah} blok laju dalam sasaran${
            h.purata !== null ? ` · purata ${formatPace(h.purata)}` : ""
          } (sasaran ${h.targetFinal ? "akhir " : ""}${formatPace(h.target)})`
        : h.purata !== null
          ? `Purata blok laju: ${formatPace(h.purata)}/km`
          : "Tiada blok laju yang dapat diukur.";
    $("semakan-blok").replaceChildren(
      ...h.blok.map((b) => {
        const li = document.createElement("li");
        li.className =
          b.lulus === true ? "lulus" : b.lulus === false ? "gagal" : "";
        const kiri = document.createElement("span");
        kiri.textContent = `Blok ${b.no} · ${formatDuration(b.saat)}`;
        const kanan = document.createElement("strong");
        kanan.textContent = b.pace !== null ? `${formatPace(b.pace)}/km` : "—";
        li.append(kiri, kanan);
        return li;
      }),
    );
    $("semakan").hidden = false;
  }

  /** Split setiap km + best effort dari rekod FIT. */
  function pecahan(splits: Split[], best: BestEffort[]) {
    if (!splits.length) return;
    $("split-senarai").replaceChildren(
      ...splits.map((s) => {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.className = "split-km";
        label.textContent =
          s.distanceM >= 999 ? `KM ${s.km}` : formatKm(s.distanceM);
        const pace = document.createElement("strong");
        pace.textContent = s.pace !== null ? `${formatPace(s.pace)}/km` : "-";
        const naik = document.createElement("span");
        naik.className = "muted";
        naik.textContent =
          s.elevationGainM >= 1 ? `+${Math.round(s.elevationGainM)} m` : "";
        li.append(label, pace, naik);
        return li;
      }),
    );
    $("split").hidden = false;
    if (!best.length) return;
    $("best-senarai").replaceChildren(
      ...best.map((b) => {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.className = "split-km";
        label.textContent = b.label;
        const masa = document.createElement("strong");
        masa.textContent = formatTime(b.seconds / 60);
        const pace = document.createElement("span");
        pace.className = "muted";
        pace.textContent = `${formatPace(b.seconds / (b.distanceM / 1000))}/km`;
        li.append(label, masa, pace);
        return li;
      }),
    );
    $("best").hidden = false;
  }

  const ZON = ["Ringan", "Aerobik asas", "Tempo", "Ambang", "Maksimum"];

  /** Carta nadi (SVG sebaris) + masa dalam 5 zon. Tiada nadi = seksyen kekal tersembunyi. */
  function nadi(siri: [number, number][], maksSesi: number | null) {
    if (siri.length < 2) return;
    let lo = Infinity,
      hi = 0; // reduce, bukan Math.min(...) - larian panjang = puluhan ribu titik
    for (const [, b] of siri) ((lo = Math.min(lo, b)), (hi = Math.max(hi, b)));
    const maks = Math.round(Math.max(maksSesi ?? 0, hi));
    const T = siri.at(-1)![0] || 1,
      julat = hi - lo || 1,
      langkah = Math.ceil(siri.length / 600); // ~600 titik cukup untuk lebar carta
    const titik = siri
      .filter((_, i) => i % langkah === 0 || i === siri.length - 1)
      .map(
        ([t, b]) =>
          `${((t / T) * 600).toFixed(1)},${(155 - ((b - lo) / julat) * 150).toFixed(1)}`,
      )
      .join(" ");
    $("nadi-garis").setAttribute("points", titik);
    $("nadi-kawasan").setAttribute("points", `0,160 ${titik} 600,160`);
    $("nadi-hi").textContent = `${hi}`;
    $("nadi-lo").textContent = `${lo}`;
    $("nadi-tempoh").textContent = formatDuration(Math.round(T));
    $("nadi-carta").setAttribute(
      "aria-label",
      `Carta nadi: ${lo} hingga ${hi} bpm sepanjang ${formatDuration(Math.round(T))}`,
    );
    const had = [0.6, 0.7, 0.8, 0.9].map((p) => Math.round(maks * p));
    $("nadi-zon").innerHTML = hrZones(siri, maks) // nombor dan label tetap sahaja -> selamat untuk innerHTML
      .map((z, i) => {
        const bpm =
          i === 0
            ? `< ${had[0]}`
            : i === 4
              ? `≥ ${had[3]}`
              : `${had[i - 1]}-${had[i] - 1}`;
        const pct = Math.round(z * 100);
        return `<li style="--k:${25 + i * 18.75}%">
          <span class="zon-nama"><strong>Z${i + 1}</strong> ${ZON[i]}</span>
          <span class="zon-bpm">${bpm} bpm</span>
          <span class="zon-bar" aria-hidden="true"><i style="width:${pct}%"></i></span>
          <strong class="zon-pct">${pct}%</strong>
        </li>`;
      })
      .join("");
    $("nadi-asas").textContent =
      `Zon ikut % nadi maks aktiviti ini (${maks} bpm): Z1 bawah 60%, Z2 60-70%, Z3 70-80%, Z4 80-90%, Z5 90% ke atas. Nadi maks sebenar anda mungkin lebih tinggi - anggap ini panduan kasar.`;
    $("nadi").hidden = false;
  }

  /** Profil ketinggian (SVG sebaris). Tiada altitude = seksyen kekal tersembunyi. */
  function tinggi(siri: [number, number][], naik: number | null) {
    if (siri.length < 2) return;
    let lo = Infinity,
      hi = -Infinity;
    for (const [, alt] of siri)
      ((lo = Math.min(lo, alt)), (hi = Math.max(hi, alt)));
    const T = siri.at(-1)![0] || 1;
    const julat = hi - lo || 1;
    const langkah = Math.ceil(siri.length / 600); // ~600 titik cukup untuk lebar carta
    const titik = siri
      .filter((_, i) => i % langkah === 0 || i === siri.length - 1)
      .map(
        ([d, alt]) =>
          `${((d / T) * 600).toFixed(1)},${(155 - ((alt - lo) / julat) * 150).toFixed(1)}`,
      )
      .join(" ");
    $("tinggi-garis").setAttribute("points", titik);
    $("tinggi-kawasan").setAttribute("points", `0,160 ${titik} 600,160`);
    $("tinggi-hi").textContent = `${Math.round(hi)} m`;
    $("tinggi-lo").textContent = `${Math.round(lo)} m`;
    $("tinggi-jarak").textContent = formatKm(T);
    $("tinggi-carta").setAttribute(
      "aria-label",
      `Profil ketinggian: ${Math.round(lo)} hingga ${Math.round(hi)} m sepanjang ${formatKm(T)}`,
    );
    $("tinggi-nota").textContent =
      naik == null
        ? "Ketinggian dari fail FIT."
        : `Naik ${Math.round(naik)} m sepanjang laluan. Turun tidak dikira.`;
    $("tinggi").hidden = false;
  }

  async function peta(titik: [number, number][], track: TrackPoint[] | null) {
    const status = $("peta-status");
    if (titik.length < 2) {
      $("peta").hidden = true;
      status.textContent =
        "Tiada laluan GPS dalam fail ini (contoh larian treadmill).";
      return;
    }
    try {
      const [ml, pekerja] = await PETA;
      ml.setWorkerUrl(pekerja.default);
      const warna = getComputedStyle(document.documentElement);
      const oren = warna.getPropertyValue("--orange").trim() || "#ff5a1f";
      const navy = warna.getPropertyValue("--navy").trim() || "#0a1a33";
      const lonLat = titik.map(([lat, lon]) => [lon, lat] as [number, number]);
      const lon = lonLat.map((t) => t[0]),
        lat = lonLat.map((t) => t[1]);
      const sempadan: LngLatBoundsLike = [
        Math.min(...lon),
        Math.min(...lat),
        Math.max(...lon),
        Math.max(...lat),
      ];

      const pilihan = [
        ...document.querySelectorAll<HTMLInputElement>('input[name="gaya"]'),
      ];
      const urlGaya = (g: string) =>
        pilihan.find((p) => p.value === g)?.dataset.url;
      let gaya = "standard",
        tigaD = false;
      try {
        const g = localStorage.getItem(SIMPAN_GAYA);
        if (g && urlGaya(g)) gaya = g;
        tigaD = localStorage.getItem(SIMPAN_3D) === "1";
      } catch {}
      const sudut = () => (tigaD ? 60 : 0);

      // Tiada WebGL = konstruktor melontar -> catch di bawah.
      const map = new ml.Map({
        container: "peta",
        style: urlGaya(gaya)!,
        bounds: sempadan,
        fitBoundsOptions: { padding: 24 },
        pitch: sudut(),
        // Page tetap boleh skrol: zum dalam peta = Ctrl/⌘ + skrol (desktop), dua jari (telefon).
        cooperativeGestures: true,
        locale: {
          "CooperativeGesturesHandler.WindowsHelpText":
            "Tekan Ctrl + skrol untuk zum peta",
          "CooperativeGesturesHandler.MacHelpText":
            "Tekan ⌘ + skrol untuk zum peta",
          "CooperativeGesturesHandler.MobileHelpText":
            "Guna dua jari untuk gerakkan peta",
          "FullscreenControl.Enter": "Skrin penuh",
          "FullscreenControl.Exit": "Keluar skrin penuh",
          "NavigationControl.ZoomIn": "Zum masuk",
          "NavigationControl.ZoomOut": "Zum keluar",
        },
      });

      // Replay peta: track hanya ada bila FIT mempunyai GPS + timestamp. Tanpa track, route biasa
      // masih dipaparkan dan kawalan replay kekal tersembunyi.
      const mainBox = $("main-semula");
      const mainButton = $("main-main") as HTMLButtonElement;
      const mainIcon = $("main-main-ikon");
      const mainText = $("main-main-teks");
      const mainReset = $("main-reset") as HTMLButtonElement;
      const mainTime = $("main-masa");
      const mainSlider = $("main-slider") as HTMLInputElement;
      const mainSpeed = $("main-laju") as HTMLSelectElement;
      const duration = track?.at(-1)?.t ?? 0;
      let replayTime = 0;
      let replayPlaying = false;
      let replaySpeed = 1;
      let replayRaf = 0;
      let replayLast = 0;
      let playMarker: Marker | null = null;

      const clock = (seconds: number) => {
        const total = Math.max(0, Math.round(seconds));
        const h = Math.floor(total / 3600);
        const m = Math.floor((total % 3600) / 60);
        const s = total % 60;
        return h
          ? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`
          : `${m}:${String(s).padStart(2, "0")}`;
      };
      const updateMain = () => {
        mainButton.setAttribute("aria-pressed", String(replayPlaying));
        mainButton.setAttribute(
          "aria-label",
          replayPlaying ? "Jeda" : "Main laluan",
        );
        mainIcon.innerHTML = icon(replayPlaying ? "jeda" : "main");
        mainText.textContent = replayPlaying ? "Jeda" : "Main";
      };
      function drawTrack(seconds: number) {
        if (!track || !duration || !map.getSource("main-kemajuan")) return;
        const pos = trackAt(track, seconds);
        if (!pos) return;
        const coordinates = track
          .slice(0, pos.index + 1)
          .map((p) => [p.lon, p.lat] as [number, number]);
        coordinates.push([pos.lon, pos.lat]);
        const sumber = map.getSource("main-kemajuan") as GeoJSONSource;
        sumber.setData({
          type: "Feature",
          properties: {},
          geometry: { type: "LineString", coordinates },
        });
        playMarker?.setLngLat([pos.lon, pos.lat]);
        mainSlider.value = String(Math.round((seconds / duration) * 1000));
        mainTime.textContent = `${clock(seconds)} / ${clock(duration)}`;
        mainSlider.setAttribute(
          "aria-valuetext",
          `${clock(seconds)} / ${clock(duration)}`,
        );
      }
      const stopReplay = () => {
        replayPlaying = false;
        cancelAnimationFrame(replayRaf);
        replayLast = 0;
        updateMain();
      };
      const tick = (now: number) => {
        if (!replayPlaying) return;
        if (!replayLast) replayLast = now;
        const delta = Math.min(0.25, (now - replayLast) / 1000);
        replayLast = now;
        replayTime = Math.min(duration, replayTime + delta * replaySpeed);
        drawTrack(replayTime);
        if (replayTime >= duration) {
          replayPlaying = false;
          updateMain();
          return;
        }
        replayRaf = requestAnimationFrame(tick);
      };
      const startReplay = () => {
        if (!track || !duration) return;
        if (replayTime >= duration) replayTime = 0;
        replayPlaying = true;
        replayLast = 0;
        updateMain();
        replayRaf = requestAnimationFrame(tick);
      };

      mainButton.addEventListener("click", () =>
        replayPlaying ? stopReplay() : startReplay(),
      );
      mainReset.addEventListener("click", () => {
        stopReplay();
        replayTime = 0;
        drawTrack(0);
      });
      mainSlider.addEventListener("input", () => {
        stopReplay();
        replayTime = (Number(mainSlider.value) / 1000) * duration;
        drawTrack(replayTime);
      });
      mainSpeed.addEventListener("change", () => {
        replaySpeed = Number(mainSpeed.value) || 1;
        replayLast = 0;
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden && replayPlaying) stopReplay();
      });

      // Kawalan sendiri = butang biasa dalam kumpulan kawalan MapLibre -> gaya sama dengan zum/skrin penuh.
      const butang = (label: string, isi: string, klik: () => void) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "kawal";
        b.title = label;
        b.setAttribute("aria-label", label);
        b.innerHTML = isi; // ikon / teks tetap sahaja
        b.addEventListener("click", klik);
        return b;
      };
      const kumpulan = (...b: HTMLElement[]): IControl => ({
        onAdd: () => {
          const d = document.createElement("div");
          d.className = "maplibregl-ctrl maplibregl-ctrl-group";
          d.append(...b);
          return d;
        },
        onRemove: () => {},
      });

      const set3d = (on: boolean) => {
        tigaD = on;
        b3d.setAttribute("aria-pressed", String(on));
        map.easeTo({ pitch: sudut(), ...(on ? {} : { bearing: 0 }) });
      };
      const b3d = butang("Paparan 3D", "3D", () => {
        set3d(!tigaD);
        simpan(SIMPAN_3D, tigaD ? "1" : "0");
      });
      b3d.classList.add("kawal-teks");
      b3d.setAttribute("aria-pressed", String(tigaD));

      const dlg = $("pilih-gaya") as HTMLDialogElement;
      const telefon = matchMedia("(max-width: 40rem)");
      const bGaya = butang("Gaya peta", icon("lapisan"), () => {
        if (dlg.open) return dlg.close();
        for (const p of pilihan) p.checked = p.value === gaya;
        if (telefon.matches)
          dlg.showModal(); // sheet: fokus terperangkap, Esc, latar (native)
        else dlg.show(); // popover dalam kanvas
        bGaya.setAttribute("aria-expanded", "true");
        pilihan.find((p) => p.checked)?.focus();
      });
      bGaya.setAttribute("aria-haspopup", "dialog");
      bGaya.setAttribute("aria-controls", dlg.id);
      bGaya.setAttribute("aria-expanded", "false");
      const bPusat = butang("Pusat semula", icon("pusat"), () =>
        map.fitBounds(sempadan, { padding: 24, pitch: sudut(), bearing: 0 }),
      );

      map.addControl(kumpulan(b3d, bGaya), "top-right");
      map.addControl(new ml.FullscreenControl(), "top-right");
      // Bawah-kanan: kawalan baru masuk di atas -> susunan (atas ke bawah) pusat semula, zum, atribusi.
      map.addControl(
        new ml.NavigationControl({ showCompass: false }),
        "bottom-right",
      );
      map.addControl(kumpulan(bPusat), "bottom-right");

      dlg.addEventListener("close", () => {
        bGaya.setAttribute("aria-expanded", "false");
        if (
          !document.activeElement ||
          document.activeElement === document.body ||
          dlg.contains(document.activeElement)
        )
          bGaya.focus();
      });
      // Popover bukan modal: Esc dan klik di luar tutup sendiri. Modal: klik pada latar = target dialog.
      dlg.addEventListener("keydown", (e) => e.key === "Escape" && dlg.close());
      dlg.addEventListener("click", (e) => {
        const t = e.target as Element;
        if (t === dlg || t.closest("[data-tutup]")) dlg.close();
        // Klik tetikus/sentuh pada pilihan = pilih dan tutup; anak panah papan kekunci = pratonton, kekal buka.
        else if ((e as MouseEvent).detail && t.closest(".gaya-pilihan"))
          dlg.close();
      });
      document.addEventListener("pointerdown", (e) => {
        const t = e.target as Node;
        if (dlg.open && !dlg.contains(t) && !bGaya.contains(t)) dlg.close();
      });

      // setStyle buang semua lapisan sendiri -> lukis semula laluan (dan DEM) setiap kali gaya siap.
      const garis = { "line-join": "round", "line-cap": "round" } as const;
      map.on("style.load", () => {
        if (gaya === "terrain") {
          map.addSource("dem", DEM);
          map.addSource("dem-bukit", DEM); // MapLibre: hillshade + terrain lebih cantik dengan sumber berasingan
          const label = map
            .getStyle()
            .layers.find((l) => l.type === "symbol")?.id;
          map.addLayer(
            {
              id: "bukit",
              type: "hillshade",
              source: "dem-bukit",
              paint: { "hillshade-exaggeration": 0.4 },
            },
            label,
          );
          map.setTerrain({ source: "dem", exaggeration: 1.5 });
        }
        map.addSource("laluan", {
          type: "geojson",
          data: {
            type: "Feature",
            properties: {},
            geometry: { type: "LineString", coordinates: lonLat },
          },
        });
        map.addLayer({
          id: "laluan-tepi",
          type: "line",
          source: "laluan",
          layout: garis,
          paint: { "line-color": "#fff", "line-width": 7 },
        });
        map.addLayer({
          id: "laluan",
          type: "line",
          source: "laluan",
          layout: garis,
          paint: { "line-color": oren, "line-width": 4 },
        });
        if (track && track.length >= 2) {
          map.addSource("main-kemajuan", {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: { type: "LineString", coordinates: [lonLat[0]] },
            },
          });
          map.addLayer({
            id: "main-kemajuan",
            type: "line",
            source: "main-kemajuan",
            layout: garis,
            paint: { "line-color": "#fff", "line-width": 6 },
          });
          if (!playMarker) {
            const el = document.createElement("div");
            el.className = "main-titik";
            el.title = "Kedudukan semasa";
            el.setAttribute("role", "img");
            el.setAttribute("aria-label", "Kedudukan semasa");
            playMarker = new ml.Marker({ element: el, anchor: "center" })
              .setLngLat(lonLat[0])
              .addTo(map);
          }
          mainBox.hidden = false;
          drawTrack(replayTime);
        }
      });
      let jatuh = false; // dah kembali ke Standard sebab gaya/DEM gagal -> mesej kekal kelihatan
      const tukarGaya = (g: string) => {
        gaya = g;
        for (const p of pilihan) p.checked = p.value === g;
        map.setStyle(urlGaya(g)!, { diff: false }); // diff:false = gaya baru penuh -> style.load pasti berbunyi
      };
      dlg.addEventListener("change", (e) => {
        const g = (e.target as HTMLInputElement).value;
        status.hidden = true;
        jatuh = false;
        tukarGaya(g);
        simpan(SIMPAN_GAYA, g);
      });
      await new Promise((ok, gagal) => {
        map.once("load", ok);
        map.on("error", (e) => {
          const sid = (e as { sourceId?: string }).sourceId;
          // Gaya lain atau DEM gagal = kembali Standard; ralat jubin biasa (ada sourceId lain) diabaikan.
          if (gaya !== "standard" && (!sid || sid.startsWith("dem"))) {
            tukarGaya("standard");
            jatuh = true;
            status.textContent =
              "Gaya peta ini tak dapat dimuatkan sekarang. Kami tunjuk Standard dulu.";
            status.hidden = false;
          } else if (!map.loaded() && !sid) gagal(e.error);
        });
      });
      for (const [label, isi, titikNya] of [
        ["Mula", navy, lonLat[0]],
        ["Tamat", oren, lonLat.at(-1)!],
      ] as const) {
        const el = document.createElement("div");
        el.className = "penanda";
        el.style.background = isi;
        el.title = label;
        el.setAttribute("role", "img");
        el.setAttribute("aria-label", label);
        new ml.Marker({ element: el }).setLngLat(titikNya).addTo(map);
      }
      status.hidden = !jatuh;
    } catch {
      $("peta").hidden = true;
      status.textContent =
        "Laluan tak dapat dimuatkan. Muat semula halaman untuk cuba lagi.";
    }
  }

  await mula();
</script>

