---
// Senarai aktiviti Strava (ahli+). Borang upload di /account/activities/new; detail di view.
// Backend tetap pengawal (403) - page hanya menyembunyikan akses.
import AccountLayout from "../../../layouts/AccountLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
import Dropdown from "../../../components/ui/Dropdown.astro";
import Table from "../../../components/ui/Table.astro";
---

<AccountLayout title="Aktiviti">
  <Alert variant="info" title="Ciri untuk ahli" id="bukan-ahli" hidden>
    <p>
      Import aktiviti Strava terbuka untuk ahli Nubi Sport. Keahlian diluluskan
      pentadbir - <a class="link" href="/account/pricing">lihat keahlian</a>.
    </p>
    <p id="data-lama" hidden>
      <span id="data-lama-teks"></span>
      <button class="btn btn-bahaya btn-sm" type="button" id="padam-lama">
        Padam data aktiviti
      </button>
    </p>
  </Alert>

  <Alert variant="danger" id="status" hidden />

  <div id="ahli" class="stack-panels" hidden>
    <ul class="stat" aria-label="7 hari terakhir">
      <li><span>Aktiviti 7 hari</span><strong id="bil-minggu">0</strong></li>
      <li><span>Jarak</span><strong id="jarak-minggu">0 km</strong></li>
      <li><span>Masa</span><strong id="masa-minggu">0m</strong></li>
    </ul>

    <section class="panel" aria-labelledby="tajuk-saya">
      <div class="panel-kepala">
        <h3 class="display" id="tajuk-saya">Aktiviti saya</h3>
        <a class="btn btn-primary btn-sm" href="/account/activities/new"
          >Tambah aktiviti</a
        >
      </div>
      <p class="muted" id="jumlah"></p>
      <Table
        id="senarai"
        variant="full"
        searchPlaceholder="Cari nama aktiviti…"
        empty="Tiada aktiviti dalam tempoh ini."
        emptyHint="Tekan Tambah aktiviti untuk muat naik fail Strava, atau tukar tempoh / penapis."
        emptyIcon="aktiviti"
        columns={[
          { label: "Tarikh" },
          { label: "Aktiviti" },
          { label: "Jarak", numeric: true },
          { label: "Masa", numeric: true },
          { label: "Pace", numeric: true },
          { label: "Nadi", numeric: true },
          { label: "Tindakan", srOnly: true },
        ]}
      >
        <div class="penapis-sukan" slot="filters">
          <label class="sr-only" for="tempoh-butang">Tempoh</label>
          <Dropdown
            id="tempoh"
            value="90"
            options={[
              { value: "30", label: "30 hari" },
              { value: "90", label: "90 hari" },
              { value: "semua", label: "Semua" },
            ]}
          />
          <label class="sr-only" for="sukan-butang">Sukan</label>
          <Dropdown
            id="sukan"
            value="semua"
            options={[
              { value: "semua", label: "Semua sukan" },
              { value: "run", label: "Larian" },
              { value: "walk", label: "Jalan" },
              { value: "hike", label: "Mendaki" },
              { value: "ride", label: "Berbasikal" },
              { value: "other", label: "Lain-lain" },
            ]}
          />
        </div>
      </Table>
      <button
        class="btn btn-bahaya btn-sm"
        type="button"
        id="padam-semua"
        hidden>Padam semua data aktiviti saya</button
      >
    </section>
  </div>
</AccountLayout>

<script>
  import { api, json, currentUser } from "../../../lib/api";
  import { confirmDialog } from "../../../lib/confirm";
  import { createTable } from "../../../lib/table";
  import {
    SPORT_LABELS,
    formatDuration,
    formatKm,
    paceFromDistance,
    type Sport,
  } from "../../../lib/activity-file";
  import { ticksFrom, offerUntick } from "../../../lib/plan-sync";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const BASE = "/me/apps/nubi/activities";

  interface Baris {
    id: number;
    startedAt: string;
    sport: Sport;
    name: string | null;
    distanceM: number;
    movingS: number;
    avgHr: number | null;
    hasGpx: boolean;
    updatedAt: string;
  }

  const tarikh = (iso: string) =>
    new Date(iso).toLocaleString("ms-MY", {
      timeZone: "Asia/Kuala_Lumpur",
      weekday: "short",
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  const el = (tag: string, cls = "", teks = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (teks) e.textContent = teks;
    return e;
  };
  const butang = (teks: string, label: string) => {
    const b = el("button", "btn btn-outline btn-sm", teks) as HTMLButtonElement;
    b.type = "button";
    b.setAttribute("aria-label", label);
    return b;
  };
  const papar = (teks: string, jenis: "success" | "danger" = "danger") => {
    const a = $("status");
    a.className = `alert alert-${jenis}`;
    a.textContent = teks;
    a.hidden = !teks;
  };

  const dari = (hari: number) =>
    new Date(Date.now() - hari * 86_400_000).toISOString().slice(0, 10);

  let senaraiAwal: Promise<Response | null> | null = api(
    `${BASE}?from=${dari(90)}`,
  ).catch(() => null);
  let mingguAwal: Promise<Response | null> | null = api(
    `${BASE}?from=${dari(7)}`,
  ).catch(() => null);
  const sekali = (
    p: Promise<Response | null> | null,
    baru: () => Promise<Response | null>,
  ) => p ?? baru();

  const s = await currentUser();
  const nubi = s?.apps?.nubi;
  const ahli = s?.role === "owner" || nubi === "ahli" || nubi === "admin";
  $("bukan-ahli").hidden = ahli;
  $("ahli").hidden = !ahli;
  if (s && !ahli) void dataLama();

  async function dataLama() {
    const r = await api(`${BASE}?from=2000-01-01`).catch(() => null);
    const n: number = r?.ok ? ((await json(r)).data?.totals?.count ?? 0) : 0;
    if (!n) return;
    $("data-lama-teks").textContent =
      `Anda masih ada ${n} aktiviti tersimpan dari masa keahlian. `;
    $("data-lama").hidden = false;
    $("padam-lama").addEventListener("click", async () => {
      const ya = await confirmDialog({
        title: "Padam semua data aktiviti?",
        message:
          "Semua aktiviti, fail asal dan rekod persetujuan anda akan dibuang daripada Nubi Sport. Tindakan ini tak boleh dibatalkan.",
        confirmLabel: "Padam semua",
        danger: true,
      });
      if (!ya) return;
      const d = await api(BASE, { method: "DELETE" }).catch(() => null);
      $("data-lama-teks").textContent = d?.ok
        ? "Data aktiviti dipadam. "
        : "Data tak dapat dipadam. Semak sambungan dan cuba lagi. ";
      if (d?.ok) $("padam-lama").hidden = true;
    });
  }

  async function minggu() {
    const r = await sekali(mingguAwal, () =>
      api(`${BASE}?from=${dari(7)}`).catch(() => null),
    );
    mingguAwal = null;
    if (!r?.ok) return;
    const t = (await json(r)).data.totals;
    $("bil-minggu").textContent = String(t.count);
    $("jarak-minggu").textContent = formatKm(t.distanceM);
    $("masa-minggu").textContent = formatDuration(t.movingS);
  }

  async function senarai(): Promise<number> {
    jadualAkt.loading();
    const tempoh = $<HTMLSelectElement>("tempoh").value;
    const r = await sekali(tempoh === "90" ? senaraiAwal : null, () =>
      api(
        `${BASE}?from=${tempoh === "semua" ? "2000-01-01" : dari(Number(tempoh))}`,
      ).catch(() => null),
    );
    senaraiAwal = null;
    if (!r?.ok) {
      jadualAkt.data([]);
      papar("Aktiviti tak dapat dimuatkan. Muat semula halaman.");
      return -1;
    }
    papar("");
    const { activities, totals } = (await json(r)).data as {
      activities: Baris[];
      totals: { count: number; distanceM: number; movingS: number };
    };
    $("jumlah").textContent = totals.count
      ? `${totals.count} aktiviti, ${formatKm(totals.distanceM)}, ${formatDuration(totals.movingS)} bergerak.`
      : "";
    jadualAkt.data(activities);
    $("padam-semua").hidden = activities.length === 0;
    return activities.length;
  }

  const jadualAkt = createTable<Baris>("senarai", {
    search: (a) => `${a.name ?? ""} ${SPORT_LABELS[a.sport]}`,
    columns: [
      (a) => tarikh(a.startedAt),
      (a) => {
        const n = el(
          "a",
          "akt-nama",
          a.name || SPORT_LABELS[a.sport],
        ) as HTMLAnchorElement;
        n.href = `/account/activities/view?id=${a.id}&v=${encodeURIComponent(a.updatedAt)}`;
        const d = el("span", "akt-sel");
        d.append(n, el("span", "muted", SPORT_LABELS[a.sport]));
        if (a.hasGpx) d.append(el("span", "lencana", "+ GPX"));
        return d;
      },
      (a) => formatKm(a.distanceM),
      (a) => formatDuration(a.movingS),
      (a) => paceFromDistance(a.distanceM, a.movingS) ?? "-",
      (a) => (a.avgHr ? `${Math.round(a.avgHr)} bpm` : "-"),
      (a) => {
        const b = butang("Padam", `Padam ${a.name || SPORT_LABELS[a.sport]}`);
        b.addEventListener("click", () => padam(a));
        return b;
      },
    ],
  });

  async function padam(a: Baris) {
    const ya = await confirmDialog({
      title: "Padam aktiviti ini?",
      message: `${a.name || SPORT_LABELS[a.sport]} (${tarikh(a.startedAt)}) dan fail asalnya akan dibuang. Tindakan ini tak boleh dibatalkan.`,
      confirmLabel: "Padam",
      danger: true,
    });
    if (!ya) return;
    const tanda = await ticksFrom([a]).catch(() => null);
    const d = await api(`${BASE}/${a.id}`, { method: "DELETE" });
    if (!d.ok && d.status !== 404) {
      papar("Aktiviti tak dapat dipadam. Semak sambungan dan cuba lagi.");
      return;
    }
    await Promise.all([senarai(), minggu()]);
    await offerUntick(tanda);
  }

  async function padamSemua() {
    const ya = await confirmDialog({
      title: "Padam semua data aktiviti?",
      message:
        "Semua aktiviti, fail asal dan rekod persetujuan anda akan dibuang daripada Nubi Sport. Muat naik seterusnya akan minta persetujuan semula. Tindakan ini tak boleh dibatalkan.",
      confirmLabel: "Padam semua",
      danger: true,
    });
    if (!ya) return;
    const tanda = await ticksFrom("semua").catch(() => null);
    const r = await api(BASE, { method: "DELETE" });
    if (!r.ok) {
      papar("Data tak dapat dipadam. Semak sambungan dan cuba lagi.");
      return;
    }
    await Promise.all([senarai(), minggu()]);
    papar(
      "Data aktiviti dipadam dan persetujuan ditarik. Muat naik seterusnya akan minta persetujuan semula.",
      "success",
    );
    await offerUntick(tanda);
  }

  $<HTMLSelectElement>("tempoh").addEventListener(
    "change",
    () => void senarai(),
  );
  $<HTMLSelectElement>("sukan").addEventListener("change", (e) => {
    const v = (e.target as HTMLSelectElement).value;
    jadualAkt.filter(v === "semua" ? null : (r) => r.sport === v);
  });
  $("padam-semua").addEventListener("click", padamSemua);

  if (ahli) await Promise.all([senarai(), minggu()]);
</script>

<style>
  .penapis-sukan {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .penapis-sukan :global(.dd) {
    width: auto;
    min-width: 10rem;
  }
  .penapis-sukan :global(.dd-butang) {
    width: 100%;
  }
  .panel {
    justify-items: stretch;
  }
  .panel :global(.akt-sel) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
  }
  .panel :global(a.akt-nama) {
    color: var(--navy);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
</style>
