---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Field from "../components/ui/Field.astro";
import Alert from "../components/ui/Alert.astro";
---

<Layout
  title="Tukar kata laluan - Nubi Sport"
  description="Tetapkan kata laluan baru akaun Nubi Sport."
>
  <PageHero eyebrow="Akaun" title="Tukar" accent="kata laluan.">
    <p class="lead" id="memuat">Menyemak pautan...</p>

    <form class="form reset" id="borang" novalidate hidden>
      <Field label="Kata laluan baru" hint="12 hingga 200 aksara.">
        <input
          class="input"
          type="password"
          name="password"
          autocomplete="new-password"
          minlength="12"
          maxlength="200"
          required
        />
      </Field>
      <Field label="Ulang kata laluan">
        <input
          class="input"
          type="password"
          name="password2"
          autocomplete="new-password"
          minlength="12"
          maxlength="200"
          required
        />
      </Field>
      <Alert variant="danger" id="mesej" hidden />
      <button class="btn btn-primary" type="submit">Tukar kata laluan</button>
    </form>

    <div class="form reset" id="berjaya" hidden>
      <Alert variant="success">
        <p>Kata laluan dah ditukar. Log masuk dengan kata laluan baru.</p>
      </Alert>
      <a class="btn btn-primary" href="/login">Log masuk</a>
    </div>

    <div class="form reset" id="gagal" hidden>
      <Alert variant="warning" title="Pautan tak sah atau dah tamat">
        <p>Pautan reset hanya sah 1 jam dan sekali guna.</p>
      </Alert>
      <a class="btn btn-ghost" href="/forgot-password">Minta pautan baru</a>
    </div>
  </PageHero>
</Layout>

<script>
  import { api, json, commonError } from "../lib/api";

  const memuat = document.getElementById("memuat")!;
  const borang = document.getElementById("borang") as HTMLFormElement;
  const berjaya = document.getElementById("berjaya")!;
  const gagal = document.getElementById("gagal")!;
  const mesej = document.getElementById("mesej")!;
  const butang = borang.querySelector<HTMLButtonElement>(
    "button[type=submit]",
  )!;

  const papar = (teks: string | null) => {
    mesej.textContent = teks ?? "";
    mesej.hidden = !teks;
  };

  const token = new URLSearchParams(location.search).get("token") ?? "";
  memuat.hidden = true;
  if (token) borang.hidden = false;
  else gagal.hidden = false;

  borang.addEventListener("submit", async (e) => {
    e.preventDefault();
    const password = borang.password.value;
    const salah =
      password.length < 12 || password.length > 200
        ? "Kata laluan mesti 12 hingga 200 aksara."
        : password !== borang.password2.value
          ? "Kata laluan tak sama."
          : null;
    papar(salah);
    if (salah) return;

    butang.disabled = true;
    try {
      const res = await api("/auth/reset-password", {
        method: "POST",
        body: JSON.stringify({ token, password }),
      });
      if (res.ok) {
        // Token sekali guna - buang dari bar alamat (sejarah / kongsi skrin).
        history.replaceState(null, "", location.pathname);
        borang.hidden = true;
        berjaya.hidden = false;
        return;
      }
      const body = await json(res);
      const mesejRalat = commonError(res.status, body);
      if (mesejRalat) return papar(mesejRalat);
      // 400 = pautan tak sah / dah tamat: tutup borang, jangan cuba berulang.
      if (res.status === 400) {
        borang.hidden = true;
        gagal.hidden = false;
        return;
      }
      papar("Tak dapat tukar sekarang. Cuba lagi sekejap.");
    } catch {
      papar("Tiada sambungan. Semak internet anda dan cuba lagi.");
    } finally {
      butang.disabled = false;
    }
  });
</script>

<style>
  .reset {
    max-width: 26rem;
  }
</style>
