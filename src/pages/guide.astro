---
// Panduan pemula + senarai semak hari lumba. Statik. Setiap nasihat kesihatan mesti dari sumber
// rasmi yang disenaraikan di bawah (NHS, KKM, ACSM) - semakan 2026-10-18. Angka yang tidak dapat disahkan
// dari sumber rasmi (contoh "tukar kasut setiap X km") sengaja tidak ditulis.
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Checkbox from "../components/ui/Checkbox.astro";
import Alert from "../components/ui/Alert.astro";
import Field from "../components/ui/Field.astro";

const SENARAI = [
  {
    tajuk: "Seminggu sebelum",
    item: [
      [
        "Ambil bib / kit lumba",
        "Semak tarikh, tempat dan dokumen yang perlu dibawa.",
      ],
      [
        "Kurangkan larian",
        "Ikut minggu tirus dalam pelan - kaki segar lebih penting daripada latihan tambahan.",
      ],
      [
        "Rancang perjalanan",
        "Masa tiba, parkir atau pengangkutan awam, dan jalan ditutup.",
      ],
      [
        "Semak ramalan cuaca",
        "Hujan, ribut petir atau jerebu - sedia pakaian ikut cuaca.",
      ],
    ],
  },
  {
    tajuk: "Malam sebelum",
    item: [
      [
        "Sediakan pakaian",
        "Pakaian dan stoking yang dah biasa dipakai semasa latihan.",
      ],
      ["Pin bib pada baju", "Di hadapan, kelihatan jelas."],
      ["Kasut yang dah biasa", "Jangan pakai kasut baru pada hari lumba."],
      [
        "Makan malam biasa",
        "Makanan yang anda kenal - bukan masa untuk cuba menu baru.",
      ],
      ["Isi botol air, cas jam / telefon", ""],
      ["Tidur awal", "Pasang jam loceng dengan masa yang cukup untuk bersiap."],
    ],
  },
  {
    tajuk: "Pagi lumba",
    item: [
      [
        "Sarapan ringan yang dah biasa",
        "Sekurang-kurangnya beberapa jam sebelum mula.",
      ],
      ["Minum air kosong", ""],
      ["Ke tandas sebelum beratur", ""],
      ["Panas badan", "Jalan laju atau joging perlahan 5-10 minit."],
      [
        "Mula perlahan",
        "Km pertama lebih perlahan daripada pace sasaran - ramai yang terlalu laju pada awalnya.",
      ],
    ],
  },
  {
    tajuk: "Lepas tamat",
    item: [
      ["Teruskan berjalan", "Sejuk badan 5-10 minit, jangan terus duduk."],
      ["Minum dan makan", ""],
      ["Regangan ringan", ""],
      ["Rehat beberapa hari", "Lari mudah saja minggu itu."],
    ],
  },
];
---

<Layout
  title="Panduan pemula - Nubi Sport"
  description="Panduan lari untuk pemula: kasut, panas dan sejuk badan, cuaca panas Malaysia, kalkulator peluh, keselamatan, masa untuk berhenti, dan senarai semak hari lumba yang boleh dicetak."
>
  <PageHero
    eyebrow="Panduan"
    title="Mula lari"
    accent="dengan selamat."
    lead="Perkara asas yang pemula selalu tanya - dari sumber rasmi (NHS, Kementerian Kesihatan Malaysia), ditambah senarai semak hari lumba yang boleh dicetak."
  />

  <Section
    id="asas"
    eyebrow="Setiap larian"
    title="Panas badan, sejuk badan, naik perlahan"
    narrow
  >
    <div class="prose">
      <ul>
        <li>
          <strong>Panas badan 5-10 minit</strong> - jalan laju atau joging perlahan
          sebelum mula.
        </li>
        <li>
          <strong>Sejuk badan 5-10 minit</strong> - teruskan dengan rentak lebih perlahan
          atau berjalan. Regangan ringan lepas itu bantu otot tak terlalu tegang esoknya.
        </li>
        <li>
          <strong>Jangan naikkan jarak atau kelajuan terlalu cepat.</strong> Ulang
          larian yang sama beberapa kali sebelum tambah. Pelan Nubi dah hadkan untuk
          anda.
        </li>
        <li>
          <strong>Hari rehat antara larian.</strong> Badan jadi kuat masa berehat,
          bukan masa berlari.
        </li>
        <li>
          <strong>Rentak yang terasa sesuai</strong> - boleh bercakap ayat penuh untuk
          kebanyakan larian.
        </li>
      </ul>
    </div>
  </Section>

  <Section id="kasut" band eyebrow="Peralatan" title="Kasut dan pakaian" narrow>
    <div class="prose">
      <ul>
        <li>
          <strong>Kasut lari yang menyokong kaki.</strong> Paling baik dipasang di
          kedai sukan lari. Model asas dari jenama utama dah cukup untuk pemula -
          tak perlu yang paling mahal.
        </li>
        <li>
          <strong>Tukar kasut</strong> bila tapak dah haus, terasa leper, atau kaki/lutut
          mula sakit lepas lari yang biasanya selesa.
        </li>
        <li>
          <strong>Pakaian ringan, longgar, warna cerah</strong> dalam cuaca panas,
          dengan topi.
        </li>
      </ul>
    </div>
  </Section>

  <Section
    id="panas"
    eyebrow="Malaysia"
    title="Cuaca panas dan minum air"
    narrow
  >
    <div class="prose">
      <p>
        KKM mendapati hampir separuh kes penyakit berkaitan cuaca panas akibat
        aktiviti fizikal melibatkan sukan seperti merentas desa dan maraton.
        Pelari pemula tak terkecuali.
      </p>
      <ul>
        <li>
          <strong>Minum air kosong walaupun tak dahaga</strong>, bukan hanya
          semasa lari. Kurangkan minuman manis dan berkafein.
        </li>
        <li>
          <strong>Lari awal pagi atau lewat petang.</strong> KKM nasihatkan elak waktu
          puncak panas, 11 pagi hingga 4 petang. Hari yang sangat panas: kurangkan
          atau tangguhkan larian. Semak ramalan cuaca negeri anda sebelum keluar.
        </li>
        <li>
          <strong>Berehat di tempat teduh</strong> bila terasa terlalu panas.
        </li>
        <li>
          <strong>Jerebu:</strong> semak bacaan IPU dan kurangkan aktiviti luar bila
          kualiti udara tak sihat.
        </li>
      </ul>
    </div>
  </Section>

  <Section
    id="peluh"
    band
    eyebrow="Kalkulator"
    title="Berapa banyak peluh anda?"
    narrow
  >
    <div class="prose">
      <p>
        Kadar peluh berbeza setiap orang. Cara paling mudah nak tahu: timbang
        sebelum dan lepas lari kira-kira sejam. Timbang tanpa kasut dengan
        pakaian yang sama (lap peluh dulu), dan ke tandas sebelum timbangan
        pertama.
      </p>
    </div>
    <form class="form" id="borang-peluh">
      <div class="dua">
        <Field label="Berat sebelum (kg)">
          <input
            class="input"
            type="number"
            name="sebelum"
            min="30"
            max="200"
            step="0.1"
            inputmode="decimal"
            required
          />
        </Field>
        <Field label="Berat lepas (kg)">
          <input
            class="input"
            type="number"
            name="lepas"
            min="30"
            max="200"
            step="0.1"
            inputmode="decimal"
            required
          />
        </Field>
        <Field label="Minum semasa lari (ml)" hint="0 kalau tak minum">
          <input
            class="input"
            type="number"
            name="minum"
            min="0"
            max="5000"
            step="50"
            inputmode="numeric"
            value="0"
            required
          />
        </Field>
        <Field label="Tempoh lari (minit)">
          <input
            class="input"
            type="number"
            name="minit"
            min="15"
            max="300"
            step="1"
            inputmode="numeric"
            value="60"
            required
          />
        </Field>
      </div>
      <button class="btn btn-primary" type="submit">Kira</button>
    </form>
    <div id="hasil-peluh" aria-live="polite"></div>
  </Section>

  <Section
    id="selamat"
    band
    eyebrow="Keselamatan"
    title="Lari malam dan awal pagi"
    narrow
  >
    <div class="prose">
      <ul>
        <li>
          <strong>Laluan yang terang</strong> dan pakaian atau jalur yang memantulkan
          cahaya.
        </li>
        <li>
          <strong>Peka dengan persekitaran</strong>, terutama bila pakai fon
          telinga - perlahankan bunyi atau sebelah saja.
        </li>
        <li>
          <strong>Lari berkawan</strong> lebih selamat dan lebih seronok. Kalau lari
          seorang, beritahu kawan atau keluarga laluan dan masa anda.
        </li>
        <li>
          <strong>Bawa telefon</strong> dan kenal pasti nombor kecemasan: 999.
        </li>
      </ul>
    </div>
  </Section>

  <section id="berhenti">
    <div class="container narrow">
      <Alert variant="danger" title="Masa untuk berhenti">
        <p>
          <strong>Berhenti serta-merta</strong> kalau sakit dada, pening, sesak nafas
          luar biasa, keliru, atau rasa nak pitam - kemudian dapatkan rawatan (999
          kalau teruk). <strong>Jangan berlari ketika sakit.</strong> Sakit lutut
          yang teruk atau bengkak, atau sakit tajam tiba-tiba di belakang buku lali:
          jumpa doktor segera.
        </p>
      </Alert>
    </div>
  </section>

  <Section id="senarai" band eyebrow="Hari lumba" title="Senarai semak" narrow>
    <p class="lead">
      Tanda sambil bersiap, atau cetak dan tampal di dinding. Tanda tak
      disimpan.
    </p>
    <div class="senarai">
      {
        SENARAI.map((k) => (
          <fieldset>
            <legend class="display">{k.tajuk}</legend>
            {k.item.map(([label, hint]) => (
              <Checkbox name="semak" label={label} hint={hint || undefined} />
            ))}
          </fieldset>
        ))
      }
    </div>
    <div class="actions no-print">
      <button class="btn btn-primary" type="button" data-cetak
        >Cetak senarai semak</button
      >
    </div>
  </Section>

  <Section id="sumber" eyebrow="Rujukan" title="Sumber" narrow>
    <div class="prose">
      <ul>
        <li>
          NHS - <a
            class="link"
            href="https://www.nhs.uk/better-health/get-active/get-running-with-couch-to-5k/"
            rel="noopener"
            target="_blank">Get running with Couch to 5K</a
          > (kasut, hari rehat, keselamatan).
        </li>
        <li>
          NHS - <a
            class="link"
            href="https://www.nhs.uk/live-well/exercise/knee-pain-and-other-running-injuries/"
            rel="noopener"
            target="_blank">Knee pain and other running injuries</a
          > (panas/sejuk badan, naik perlahan, bila perlu jumpa doktor).
        </li>
        <li>
          NHS - <a
            class="link"
            href="https://www.nhs.uk/live-well/exercise/how-to-stretch-after-exercising/"
            rel="noopener"
            target="_blank">How to stretch after exercising</a
          >.
        </li>
        <li>
          KKM melalui Berita RTM - <a
            class="link"
            href="https://berita.rtm.gov.my/nasional/senarai-berita-nasional/senarai-artikel/gelombang-haba-orang-ramai-perlu-had-masa-di-luar-bangunan-banyak-minum-air-kosong-kkm/"
            rel="noopener"
            target="_blank">Gelombang haba</a
          > (28 Mac 2026) dan <a
            class="link"
            href="https://berita.rtm.gov.my/nasional/senarai-berita-nasional/senarai-artikel/dua-kematian-akibat-strok-haba-56-kes-penyakit-berkaitan-cuaca-panas/"
            rel="noopener"
            target="_blank">penyakit berkaitan cuaca panas</a
          > (3 Mei 2026). KKM - <a
            class="link"
            href="https://www.moh.gov.my/images/kenyataan-media/2026/MAC%202026/KENYATAAN%20MEDIA%20CUACA%20PANAS%20_25%20Mac%202026-1.pdf"
            rel="noopener"
            target="_blank">Kenyataan Media Cuaca Panas</a
          > (25 Mac 2026; elak 11 pagi hingga 4 petang).
        </li>
        <li>
          American College of Sports Medicine - <a
            class="link"
            href="https://pubmed.ncbi.nlm.nih.gov/17277604/"
            rel="noopener"
            target="_blank">Exercise and Fluid Replacement</a
          > (2007; kadar peluh dari timbang sebelum/lepas, had 2% berat badan).
        </li>
      </ul>
      <p class="muted">
        Panduan umum, bukan nasihat perubatan. Ada penyakit jantung, tekanan
        darah tinggi, asma, mengandung atau baru sembuh daripada sakit? Rujuk
        doktor sebelum mula.
      </p>
    </div>
  </Section>
</Layout>

<script>
  // Cetak senarai semak sahaja (kelas pada <body> semasa cetak - lihat gaya di bawah).
  document.querySelector("[data-cetak]")?.addEventListener("click", () => {
    document.body.classList.add("cetak-senarai");
    print();
  });
  addEventListener("afterprint", () =>
    document.body.classList.remove("cetak-senarai"),
  );

  import { sweatRate } from "../lib/sweat";
  const borang = document.getElementById("borang-peluh") as HTMLFormElement;
  const hasil = document.getElementById("hasil-peluh")!;
  borang.addEventListener("submit", (e) => {
    e.preventDefault();
    const n = (k: string) =>
      Number((borang.elements.namedItem(k) as HTMLInputElement).value);
    const h = sweatRate(n("sebelum"), n("lepas"), n("minum"), n("minit"));
    const ml = (l: number) =>
      `${Math.round(l * 1000).toLocaleString("ms-MY")} ml`;
    // Teks dari lib + nombor sahaja - selamat untuk innerHTML.
    hasil.innerHTML = !h.ok
      ? `<div class="alert alert-warning"><p>${h.sebab}</p></div>`
      : h.naik
        ? `<div class="alert alert-warning"><p>Berat naik lepas lari - anda minum lebih daripada peluh yang hilang. Minum sedikit kurang semasa sesi sepanjang ini.</p></div>`
        : `<div class="alert ${h.peratus > 2 ? "alert-warning" : "alert-success"}">
            <p class="alert-title">Kadar peluh ~${ml(h.sejamL)} sejam</p>
            <p>Peluh hilang ${ml(h.peluhL)}, iaitu ${h.peratus.toFixed(1)}% berat badan. ${
              h.peratus > 2
                ? "Lebih 2% - ACSM nasihatkan minum semasa lari supaya kekurangan air tak lebih 2% berat badan. Minum lebih kerap pada sesi sepanjang ini."
                : "Bawah 2% berat badan (had ACSM) - cara minum anda sekarang dah cukup untuk sesi macam ini."
            }</p>
            <p class="field-hint">Kadar peluh berubah ikut cuaca dan laju - timbang semula bila cuaca jauh berbeza. Panduan umum, bukan nasihat perubatan.</p>
          </div>`;
  });
</script>

<style>
  .senarai {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem 2rem;
    margin: 1.5rem 0;
  }
  fieldset {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  /* 2x2 tetap (auto-fit dahulu beri 3 + 1 tergantung). Medan bermula di atas: petunjuk "0 jika tidak minum"
     tidak menolak input jiran ke bawah. */
  .dua {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1.25rem 1rem;
    max-width: 36rem;
  }
  @media (max-width: 30rem) {
    .dua {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  #hasil-peluh:not(:empty) {
    margin-top: 1.5rem;
  }
  legend {
    margin-bottom: 0.5rem;
    font-size: 1.4rem;
    color: var(--navy);
  }
  @media print {
    :global(body.cetak-senarai main > :not(#senarai)) {
      display: none !important;
    }
    .senarai {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
