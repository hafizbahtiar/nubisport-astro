---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Alert from "../components/ui/Alert.astro";
import { CONTACT, SITE } from "../data/site";

const values = [
  {
    title: "Mula dari sifar",
    body: "Tak pernah berlari? Tak apa. Jalan-lari atau lari perlahan - setiap langkah dikira.",
  },
  {
    title: "Gerak bersama",
    body: "Kita mula bersama dan habis bersama. Tiada siapa ditinggalkan di belakang.",
  },
  {
    title: "Seronok dulu",
    body: "Laju datang kemudian. Yang penting konsisten, selamat dan seronok.",
  },
];

const steps = [
  {
    title: "Hubungi kami",
    body: "Hantar mesej dan perkenalkan diri - pengalaman tak diperlukan.",
  },
  {
    title: "Hadir ke larian",
    body: "Sertai sesi larian kumpulan. Datang dengan kasut yang selesa.",
  },
  {
    title: "Ikut kemampuan",
    body: "Lari ikut rentak sendiri. Kami bantu anda naik setapak demi setapak.",
  },
];

const faqs = [
  {
    q: "Saya tak pernah berlari langsung. Boleh sertai?",
    a: "Boleh - Nubi Sport memang untuk pemula. Ramai bermula dengan jalan-lari.",
  },
  {
    q: "Perlu laju untuk ikut kumpulan?",
    a: "Tak. Tiada pace minimum. Anda lari ikut kemampuan sendiri.",
  },
  {
    q: "Apa perlu dibawa?",
    a: "Kasut larian yang selesa, pakaian yang sesuai dan air minuman.",
  },
];

const contacts = [
  { label: "WhatsApp", href: CONTACT.whatsapp },
  { label: "Instagram", href: CONTACT.instagram },
  { label: "E-mel", href: CONTACT.email && `mailto:${CONTACT.email}` },
].filter((c) => c.href);
---

<Layout>
  <div class="container dipadam" id="akaun-dipadam" hidden>
    <Alert variant="success">
      Akaun anda dah dipadam. Terima kasih kerana berlari bersama Nubi Sport.
    </Alert>
  </div>
  <section class="surface-dark hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">
          {SITE.tagline} · Sejak {SITE.established}
        </p>
        <h1 class="display hero-title">
          Lari pertama anda <span>bermula di sini.</span>
        </h1>
        <p class="hero-lead">
          Nubi Sport ialah komuniti larian untuk pemula. Tiada pace minimum,
          tiada siapa ditinggalkan - hanya langkah demi langkah, bersama.
        </p>
        <div class="actions hero-cta">
          <a class="btn btn-primary" href="#sertai">Sertai komuniti</a>
          <a class="btn btn-ghost" href="/plan-5k">Pelan 5K bawah 30 min</a>
          <a class="btn btn-ghost" href="/maf">Lari ikut nadi (MAF)</a>
        </div>
      </div>
      <img
        src="/brand/nubi-crest-roundel-reversed.svg"
        alt="Jata Nubi Sport - Running Community"
        width="320"
        height="320"
        class="hero-crest"
      />
    </div>
  </section>

  <Section
    id="tentang"
    eyebrow="Tentang kami"
    title="Nubi = newbie. Dan itu tak apa."
    lead="Kami kumpulan pelari baru yang nak mula dengan cara yang betul - tanpa tekanan, tanpa ego. Setiap orang bermula di tempat yang berbeza."
  >
    <ul class="grid-cards">
      {
        values.map((v, i) => (
          <li class="card">
            <span class="card-num display">0{i + 1}</span>
            <h3 class="display card-title">{v.title}</h3>
            <p>{v.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="cara" band eyebrow="Cara sertai" title="Tiga langkah, itu saja.">
    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <h3 class="display card-title">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="soalan" narrow eyebrow="Soalan lazim" title="Ada soalan?">
    {
      faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </Section>

  <section id="sertai" class="join">
    <div class="container join-inner">
      <h2 class="display join-title">
        Langkah pertama paling sukar. <span>Kami temankan.</span>
      </h2>
      {
        contacts.length ? (
          <div class="actions hero-cta">
            {contacts.map((c) => (
              <a
                class="btn btn-primary"
                href={c.href}
                rel="noopener"
                target={c.href.startsWith("mailto:") ? undefined : "_blank"}
              >
                {c.label}
              </a>
            ))}
          </div>
        ) : (
          <p class="hero-lead">
            Maklumat untuk sertai akan dikongsi tak lama lagi.
          </p>
        )
      }
    </div>
  </section>
</Layout>

<script>
  // Lepas padam akaun (/account/profile) - tunjuk sekali, buang param dari URL.
  if (new URLSearchParams(location.search).get("akaun") === "dipadam") {
    document.getElementById("akaun-dipadam")!.hidden = false;
    history.replaceState(null, "", "/");
  }
</script>

<style>
  .dipadam {
    padding-block: 1rem;
  }
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 3rem;
  }
  .hero-title {
    font-size: clamp(3.2rem, 9vw, 6.25rem);
    margin: 0 0 1.25rem;
  }
  .hero-title span {
    color: var(--orange);
    display: block;
  }
  .hero-lead {
    color: #cbd5e1;
    font-size: 1.2rem;
    max-width: 34rem;
    margin: 0;
  }
  .hero-cta {
    margin-top: 2rem;
  }
  .hero-crest {
    width: min(100%, 20rem);
    height: auto;
    justify-self: center;
  }
  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-crest {
      order: -1;
      width: 9rem;
      justify-self: start;
    }
  }

  .card-num {
    color: var(--orange);
    font-size: 1.6rem;
  }
  .steps p {
    margin: 0;
    color: var(--muted);
  }

  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem;
  }
  .steps li {
    counter-increment: step;
    border-top: 4px solid var(--orange);
    padding-top: 1.25rem;
  }
  .steps li::before {
    content: "Langkah " counter(step);
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--orange-ink);
    font-size: 0.9rem;
  }

  .faq {
    border-bottom: 1px solid var(--line);
    padding-block: 1.1rem;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--navy);
    font-size: 1.1rem;
  }
  .faq p {
    margin: 0.6rem 0 0;
    color: var(--muted);
  }

  .join {
    background: var(--orange);
    color: var(--navy);
  }
  .join-inner {
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .join-title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin: 0;
    max-width: 18ch;
  }
  .join-title span {
    color: #fff;
  }
  .join .hero-lead {
    color: var(--navy);
    margin-top: 1.25rem;
  }
  .join .btn-primary {
    background: var(--navy);
    color: #fff;
  }
</style>
