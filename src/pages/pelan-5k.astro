---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import ChipGroup from "../components/ui/ChipGroup.astro";
import Field from "../components/ui/Field.astro";
import {
  BULAN,
  HARI,
  MASA_MAX,
  MASA_MIN,
  MINGGU_MIN,
  MINGGU_SETIAP_MINIT,
  TAHAP,
} from "../lib/pelan-5k";
---

<Layout
  title="Pelan 5K bawah 30 minit - Nubi Sport"
  description="Pilih berapa bulan dan tahap anda sekarang - dapat pelan latihan mingguan untuk lari 5K bawah 30 minit. Percuma, tanpa daftar."
>
  <PageHero
    eyebrow="Pelan latihan"
    title="5K bawah"
    accent="30 minit."
    lead="Pilih tempoh dan tahap anda sekarang. Pelan dikira dalam pelayar anda - tiada daftar, tiada data dihantar ke mana-mana."
  >
    <form class="form" method="get" id="borang">
      <ChipGroup
        legend="Tempoh"
        name="bulan"
        checked={3}
        options={BULAN.map((b) => ({ value: b, label: `${b} bulan` }))}
      />
      <ChipGroup
        legend="Tahap sekarang"
        name="tahap"
        checked="jalan"
        options={Object.entries(TAHAP).map(([value, label]) => ({
          value,
          label,
        }))}
      />
      <Field label="Masa 5K sekarang (minit)" id="masa-medan" hidden>
        <input
          class="input"
          type="number"
          name="masa"
          min={MASA_MIN}
          max={MASA_MAX}
          step="1"
          inputmode="numeric"
          placeholder="cth. 36"
        />
      </Field>
      <ChipGroup
        legend="Hari seminggu"
        name="hari"
        checked={3}
        options={HARI.map((h) => ({ value: h, label: `${h} hari` }))}
      />
      <Field
        label="Tarikh mula (pilihan)"
        hint="Pelan bermula pada hari Isnin pada atau selepas tarikh ini."
      >
        <input class="input" type="date" name="mula" />
      </Field>
      <button class="btn btn-primary" type="submit">Buat pelan</button>
    </form>
  </PageHero>

  <section class="hasil" id="hasil" hidden aria-live="polite">
    <div class="container" id="pelan"></div>
  </section>

  <Section band narrow title="Sebelum mula" class="nota">
    <ul>
      <li>
        Pelan ini panduan umum, <strong>bukan nasihat perubatan</strong>. Jika
        ada masalah jantung, tekanan darah, sendi atau baru sembuh dari
        kecederaan, rujuk doktor dulu. Berhenti jika sakit (bukan sekadar
        penat).
      </li>
      <li>
        Ambang "munasabah" adalah <strong>anggaran kasar</strong>: dari sifar ~{
          MINGGU_MIN.sifar
        } minggu, dari jalan-lari ~{MINGGU_MIN.jalan} minggu, dan dari 5K sekarang
        ~{MINGGU_SETIAP_MINIT} minggu bagi setiap minit yang hendak dipotong. Setiap
        orang berbeza.
      </li>
      <li>
        Beban naik paling banyak 10% seminggu dan setiap minggu ke-4 lebih
        ringan - badan menjadi kuat ketika berehat. Terlepas sesi? Teruskan
        dengan minggu itu, jangan ganti dua kali ganda.
      </li>
      <li>
        Cuaca Malaysia panas dan lembap: lari awal pagi atau lewat petang, bawa
        air, perlahankan pace bila panas - ikut rasa usaha, bukan jam. Mahu
        ukuran yang lebih tepat? Cuba <a class="link" href="/maf"
          >lari ikut nadi (MAF)</a
        > untuk sesi mudah.
      </li>
    </ul>
  </Section>
</Layout>

<script>
  import { buatIcs, waktuMalaysia } from "../lib/ics";
  import {
    HAD_TANPA_AKAUN,
    HARI_SESI,
    NAMA_HARI,
    TAHAP,
    bolehBuatPelan,
    buatPelan,
    isninMula,
    tarikhSesi,
    type Minggu,
    type Tahap,
  } from "../lib/pelan-5k";

  const borang = document.getElementById("borang") as HTMLFormElement;
  const masaMedan = document.getElementById("masa-medan")!;
  const masaInput = borang.elements.namedItem("masa") as HTMLInputElement;
  const hasil = document.getElementById("hasil")!;
  const pelanEl = document.getElementById("pelan")!;

  const q = new URLSearchParams(location.search);
  for (const [k, v] of q) {
    const el = borang.elements.namedItem(k);
    if (el instanceof RadioNodeList) el.value = v;
    else if (el instanceof HTMLInputElement) el.value = v;
  }

  const ikutTahap = () => {
    const is5k =
      (borang.elements.namedItem("tahap") as RadioNodeList).value === "5k";
    masaMedan.hidden = !is5k;
    masaInput.required = is5k;
    masaInput.disabled = !is5k; // tak dihantar dalam URL bila bukan 5k
  };
  borang.addEventListener("change", ikutTahap);
  ikutTahap();

  if (q.has("bulan")) papar();

  function papar() {
    const tahap = q.get("tahap") as Tahap;
    const bulan = Number(q.get("bulan"));
    const hari = Number(q.get("hari"));
    const masa5k = q.get("masa") ? Number(q.get("masa")) : undefined;
    const h = buatPelan({ bulan, tahap, hari, masa5k });
    hasil.hidden = false;

    if (!h.ok) {
      pelanEl.innerHTML = `<div class="alert alert-warning"><p>${h.sebab}</p>${
        h.cadanganBulan
          ? `<a class="btn btn-primary" href="?${new URLSearchParams({ ...Object.fromEntries(q), bulan: String(h.cadanganBulan) })}">Cuba ${h.cadanganBulan} bulan</a>`
          : ""
      }</div>`;
      hasil.scrollIntoView({ behavior: "smooth" });
      return;
    }

    const kunci = `pelan-5k:${bulan}-${tahap}-${masa5k ?? ""}-${hari}`;
    const dibuat = baca("pelan-5k:dibuat");
    const logMasuk = /(?:^|; )session_active=1/.test(document.cookie);
    if (!bolehBuatPelan(kunci, dibuat, logMasuk)) {
      pelanEl.innerHTML = `<div class="alert alert-info">
        <p class="alert-title">${HAD_TANPA_AKAUN} pelan percuma tanpa akaun</p>
        <p>Anda sudah buat ${HAD_TANPA_AKAUN} pelan berbeza di pelayar ini. Daftar akaun percuma untuk buat lebih banyak pelan.
          Pelan yang sudah dibuat masih boleh dibuka seperti biasa.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/register">Daftar percuma</a>
          <a class="btn btn-outline" href="/login">Log masuk</a>
        </div>
      </div>`;
      hasil.scrollIntoView({ behavior: "smooth" });
      return;
    }
    if (!dibuat.includes(kunci)) simpan("pelan-5k:dibuat", [...dibuat, kunci]);
    const siap = new Set<string>(baca(kunci));
    const isnin = /^\d{4}-\d{2}-\d{2}$/.test(q.get("mula") ?? "")
      ? isninMula(new Date(`${q.get("mula")}T00:00:00`))
      : null;
    const hariIni = new Date().toDateString();
    const jumlah = h.minggu.reduce((a, w) => a + w.sesi.length, 0);

    pelanEl.innerHTML = `
      <div class="ringkas">
        <div>
          <p class="eyebrow">Pelan anda</p>
          <h2 class="display section-title">${bulan} bulan · ${hari} hari seminggu</h2>
          <p class="lead">${TAHAP[tahap]}${masa5k ? ` (${masa5k} minit)` : ""} → 5K bawah 30 minit.
            ${isnin ? `Bermula Isnin, ${isnin.toLocaleDateString("ms-MY", { day: "numeric", month: "long", year: "numeric" })}.` : ""}
            <span id="kemajuan"></span></p>
        </div>
        <div class="actions no-print">
          <button class="btn btn-outline" type="button" data-kongsi>Kongsi</button>
          <button class="btn btn-outline" type="button" onclick="print()">Cetak</button>
        </div>
      </div>
      ${h.amaran.map((a) => `<div class="alert alert-warning amaran"><p>${a}</p></div>`).join("")}
      <div class="kalendar no-print">
        <h3 class="display">Simpan ke kalendar</h3>
        ${
          isnin
            ? `<div class="actions">
                <label class="field"><span class="field-label">Masa lari</span>
                  <input class="input" type="time" id="masa-lari" value="06:30" /></label>
                <button class="btn btn-primary" type="button" data-ics>Muat turun fail kalendar (.ics)</button>
              </div>`
            : `<p class="muted">Isi "Tarikh mula" di atas dan tekan "Buat pelan" - kalendar perlukan tarikh sebenar.</p>`
        }
        <ul class="muted">
          <li><strong>iPhone / iPad:</strong> buka page ini dalam Safari, tekan butang dan pilih "Tambah Semua".</li>
          <li><strong>Android (Samsung Calendar):</strong> buka fail yang dimuat turun dan pilih Kalendar.</li>
          <li><strong>Google Calendar:</strong> app Android tidak boleh import fail. Guna calendar.google.com dalam pelayar komputer → Tetapan → Import &amp; eksport.</li>
          <li><strong>Outlook / Mac:</strong> buka fail yang dimuat turun.</li>
        </ul>
      </div>
      <ol class="minggu">${h.minggu.map((w) => minggu(w, isnin, hariIni)).join("")}</ol>`;

    const kemajuan = document.getElementById("kemajuan")!;
    const kira = () =>
      (kemajuan.textContent = `${siap.size} / ${jumlah} sesi siap.`);
    kira();
    pelanEl
      .querySelectorAll<HTMLInputElement>("input[data-sesi]")
      .forEach((c) => {
        c.checked = siap.has(c.dataset.sesi!);
        c.addEventListener("change", () => {
          c.checked ? siap.add(c.dataset.sesi!) : siap.delete(c.dataset.sesi!);
          simpan(kunci, [...siap]);
          kira();
        });
      });
    pelanEl
      .querySelector<HTMLButtonElement>("[data-kongsi]")!
      .addEventListener("click", async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        try {
          if (navigator.share)
            return await navigator.share({
              title: document.title,
              url: location.href,
            });
          await navigator.clipboard.writeText(location.href);
          btn.textContent = "Pautan disalin";
        } catch {
          /* dibatalkan */
        }
      });
    pelanEl
      .querySelector<HTMLButtonElement>("[data-ics]")
      ?.addEventListener("click", () => {
        const jam =
          (document.getElementById("masa-lari") as HTMLInputElement).value ||
          "06:30";
        const ics = buatIcs(
          h.minggu.flatMap((w) =>
            w.sesi.map((s, i) => ({
              uid: `${kunci.replace(":", "-")}-m${w.no}s${i}`,
              mula: waktuMalaysia(tarikhSesi(isnin!, w.no, hari, i), jam),
              minit: s.minit,
              tajuk: `Nubi 5K · Minggu ${w.no}: ${s.tajuk} (${s.minit} min)`,
              keterangan: `${s.arahan}\n${s.usaha}`,
            })),
          ),
          { nama: `Nubi 5K · ${bulan} bulan` },
        );
        const a = document.createElement("a");
        a.href = URL.createObjectURL(
          new Blob([ics], { type: "text/calendar" }),
        );
        a.download = `pelan-5k-${bulan}bln-${tahap}-${hari}hari.ics`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 60e3);
      });
    // Minggu semasa (bila tarikh mula diisi) lebih berguna dari atas pelan.
    (pelanEl.querySelector(".kad.kini") ?? hasil).scrollIntoView({
      behavior: "smooth",
    });
  }

  function minggu(w: Minggu, isnin: Date | null, hariIni: string) {
    const hari = w.sesi.length;
    const tarikh = (i: number) => isnin && tarikhSesi(isnin, w.no, hari, i);
    const isninIni = tarikh(0)?.getTime(); // sesi pertama = Isnin minggu itu
    const kini =
      isninIni !== undefined &&
      Date.now() >= isninIni &&
      Date.now() < isninIni + 7 * 864e5;
    return `<li class="kad${w.ringan ? " ringan" : ""}${kini ? " kini" : ""}">
      <header>
        <h3 class="display">Minggu ${w.no}</h3>
        <span class="tag">${kini ? "Minggu ini · " : ""}${w.fasa}${w.ringan && w.fasa !== "Ujian" ? " · ringan" : ""}</span>
        <span class="minit">${w.minit} min</span>
      </header>
      <ol>${w.sesi
        .map((s, i) => {
          const d = tarikh(i);
          const label =
            NAMA_HARI[HARI_SESI[hari][i]] +
            (d
              ? ` ${d.toLocaleDateString("ms-MY", { day: "numeric", month: "short" })}`
              : "");
          const today = d?.toDateString() === hariIni;
          return `<li class="sesi ${s.jenis}${today ? " hari-ini" : ""}">
            <label>
              <input type="checkbox" data-sesi="${w.no}.${i}" aria-label="Minggu ${w.no}, ${label}, siap" />
              <span>
                <strong>${today ? "Hari ini · " : ""}${label}: ${s.tajuk}</strong> <em>${s.minit} min</em>
                <span class="arahan">${s.arahan}</span>
                <span class="usaha">${s.usaha}</span>
              </span>
            </label>
          </li>`;
        })
        .join("")}</ol>
    </li>`;
  }

  function baca(k: string): string[] {
    try {
      return JSON.parse(localStorage.getItem(k) ?? "[]");
    } catch {
      return [];
    }
  }
  function simpan(k: string, v: string[]) {
    try {
      localStorage.setItem(k, JSON.stringify(v));
    } catch {
      /* mod peribadi: tanda siap tak disimpan */
    }
  }
</script>

<!-- Global: pelan dirender melalui innerHTML, jadi gaya scoped Astro tak sampai. CSS ini hanya dimuat di page ini. -->
<style is:global>
  .hasil {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .ringkas {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .amaran {
    margin-top: 1.5rem;
  }

  .minggu {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1rem;
  }
  .kad {
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.25rem;
    background: var(--paper);
    break-inside: avoid;
  }
  .kad.ringan {
    background: var(--paper-2);
  }
  .kad.kini {
    border: 2px solid var(--orange);
    scroll-margin-top: 5.5rem; /* bawah header sticky */
  }
  .sesi.hari-ini {
    background: rgb(255 90 31 / 0.08);
    border-radius: 0.5rem;
    margin: -0.4rem;
    padding: 0.4rem;
  }
  .kad header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }
  .kad h3 {
    font-size: 1.6rem;
    margin: 0;
    color: var(--navy);
  }
  .tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--orange-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .minit {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .kad ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .sesi label {
    display: flex;
    gap: 0.75rem;
    align-items: start;
    cursor: pointer;
  }
  .sesi input {
    margin-top: 0.3rem;
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--orange);
    flex: none;
  }
  .sesi strong {
    color: var(--navy);
  }
  .sesi em {
    font-style: normal;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .arahan,
  .usaha {
    display: block;
    font-size: 0.95rem;
  }
  .usaha {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .sesi.interval strong,
  .sesi.tempo strong,
  .sesi.ujian strong {
    color: var(--orange-ink);
  }
  .sesi:has(input:checked) .arahan {
    text-decoration: line-through;
    color: var(--muted);
  }

  .kalendar {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .kalendar h3 {
    font-size: 1.6rem;
    margin: 0;
    color: var(--navy);
  }
  .kalendar .actions {
    align-items: end;
  }
  .kalendar ul {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    display: grid;
    gap: 0.25rem;
  }

  .nota ul {
    padding-left: 1.2rem;
    color: var(--muted);
    display: grid;
    gap: 0.75rem;
  }

  @media print {
    .minggu {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
