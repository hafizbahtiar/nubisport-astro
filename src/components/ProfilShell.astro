---
// Halaman profil akaun: navigasi kecil (Maklumat / Kata laluan) di sebelah kandungan.
// Lebar: menu menegak di kiri. Sempit: jadi tab mendatar di atas.
import AccountLayout from "../layouts/AccountLayout.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
const SUB = [
  { href: "/account/profil", label: "Maklumat" },
  { href: "/account/profil/kata-laluan", label: "Kata laluan" },
];
const laluan = Astro.url.pathname.replace(/\/$/, "");
---

<AccountLayout title={`Profil · ${title}`}>
  <div class="profil">
    <nav class="profil-nav" aria-label="Tetapan profil">
      {
        SUB.map((s) => (
          <a
            href={s.href}
            aria-current={laluan === s.href ? "page" : undefined}
          >
            {s.label}
          </a>
        ))
      }
    </nav>
    <div class="profil-isi">
      <slot />
    </div>
  </div>
</AccountLayout>

<style>
  .profil {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .profil-nav {
    position: sticky;
    top: calc(var(--navbar-h, 4rem) + 1.5rem);
    display: grid;
    gap: 0.25rem;
  }
  .profil-nav a {
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .profil-nav a:hover {
    background: var(--paper);
  }
  .profil-nav a[aria-current="page"] {
    background: var(--paper);
    color: var(--navy);
    box-shadow: inset 3px 0 0 var(--orange);
  }
  .profil-nav a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  .profil-isi {
    max-width: 40rem;
  }
  .profil-isi :global(.panel) {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .profil-isi :global(.panel h2) {
    margin: 0;
    font-size: 1.5rem;
    color: var(--navy);
  }
  .profil-isi :global(.panel p) {
    margin: 0;
  }
  @media (max-width: 48rem) {
    .profil {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .profil-nav {
      position: static;
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
    }
    .profil-nav a {
      white-space: nowrap;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.45rem 1rem;
      background: var(--paper);
    }
    .profil-nav a[aria-current="page"] {
      box-shadow: none;
      background: var(--navy);
      border-color: var(--navy);
      color: #fff;
    }
  }
</style>
