---
import PageHero from "./ui/PageHero.astro";
import Section from "./ui/Section.astro";
import ChipGroup from "./ui/ChipGroup.astro";
import Field from "./ui/Field.astro";
import DatePicker from "./ui/DatePicker.astro";
import Checkbox from "./ui/Checkbox.astro";
import { KATEGORI, UMUR_MAX, UMUR_MIN } from "../lib/maf";
import {
  BULAN,
  HARI,
  MASA_MAX,
  MASA_MIN,
  MINGGU_MIN,
  MINGGU_SETIAP_MINIT,
  TAHAP,
} from "../lib/pelan-5k";
import "../styles/pelan.css";

// Kandungan sahaja - page memilih layout. Satu borang, dua page: /pelan-5k (awam - pelan ringkas) dan /account/pelan-5k (log masuk -
// `penuh`: pecahan "Realistik ke?", ikut nadi MAF, simpan ke kalendar).
// ponytail: had dibuat di pelayar (laman statik) - kod versi penuh tetap boleh dibaca. Ini dorongan
// untuk daftar, bukan kawalan. Kandungan berbayar sebenar = jana di server.
interface Props {
  penuh?: boolean;
}
const { penuh = false } = Astro.props;
const maf = penuh ? "/account/maf" : "/maf";
// Julat tarikh mula: dikira semasa build (laman statik - setiap deploy menyegarkannya).
const tahun = new Date().getFullYear();
---

<PageHero
  eyebrow="Pelan latihan"
  title="5K bawah"
  accent="30 minit."
  lead={penuh
    ? "Versi penuh: pecahan kenapa sasaran anda realistik atau tidak, latihan ikut nadi, simpan ke kalendar, dan simpan sehingga 3 pelan ke awan."
    : "Pilih tempoh dan tahap anda sekarang. Pelan dikira dalam pelayar anda - tiada daftar, tiada data dihantar ke mana-mana."}
>
  <form
    class="form"
    method="get"
    id="borang"
    data-penuh={penuh ? "1" : undefined}
  >
    <ChipGroup
      legend="Tempoh"
      name="bulan"
      checked={3}
      options={BULAN.map((b) => ({ value: b, label: `${b} bulan` }))}
    />
    <ChipGroup
      legend="Tahap sekarang"
      name="tahap"
      checked="jalan"
      options={Object.entries(TAHAP).map(([value, label]) => ({
        value,
        label,
      }))}
    />
    <Field label="Masa 5K sekarang (minit)" id="masa-medan" hidden>
      <input
        class="input"
        type="number"
        name="masa"
        min={MASA_MIN}
        max={MASA_MAX}
        step="1"
        inputmode="numeric"
        placeholder="cth. 36"
      />
    </Field>
    <ChipGroup
      legend="Hari seminggu"
      name="hari"
      checked={3}
      options={HARI.map((h) => ({ value: h, label: `${h} hari` }))}
    />
    {
      penuh && (
        <Fragment>
          <Checkbox
            name="maf"
            id="maf"
            label="Ikut nadi (MAF)"
            hint="Sesi mudah dan larian panjang dikawal had kadar nadi anda. Perlu jam atau tali dada pengukur nadi."
          />
          <fieldset class="form-group" id="maf-medan" hidden disabled>
            <Field label="Umur (tahun)">
              <input
                class="input"
                type="number"
                name="umur"
                min={UMUR_MIN}
                max={UMUR_MAX}
                step="1"
                inputmode="numeric"
                required
                placeholder="cth. 32"
              />
            </Field>
            <ChipGroup
              legend="Keadaan anda sekarang"
              name="keadaan"
              checked="terganggu"
              stacked
              options={Object.entries(KATEGORI).map(([value, k]) => ({
                value,
                label: k.label,
              }))}
            />
            <p class="field-hint">
              Apa itu MAF?{" "}
              <a class="link" href={maf}>
                Baca panduan lari ikut nadi
              </a>
              .
            </p>
          </fieldset>
        </Fragment>
      )
    }
    <Field
      label="Tarikh mula (pilihan)"
      for="mula-text"
      hint="Pelan bermula pada hari Isnin pada atau selepas tarikh ini."
    >
      <DatePicker
        id="mula"
        name="mula"
        min={`${tahun - 1}-01-01`}
        max={`${tahun + 2}-12-31`}
      />
    </Field>
    <button class="btn btn-primary" type="submit">Buat pelan</button>
  </form>
</PageHero>

<section class="hasil" id="hasil" hidden aria-live="polite">
  <div class="container" id="pelan"></div>
</section>

<Section band narrow title="Sebelum mula" class="nota">
  <ul>
    <li>
      Pelan ini panduan umum, <strong>bukan nasihat perubatan</strong>. Jika ada
      masalah jantung, tekanan darah, sendi atau baru sembuh dari kecederaan,
      rujuk doktor dulu. Berhenti jika sakit (bukan sekadar penat). Pelan dijana
      mengikut prinsip latihan umum (contoh NHS Couch to 5K) dan <strong
        >belum disemak jurulatih bertauliah</strong
      >.
    </li>
    <li>
      Ambang "munasabah" adalah <strong>anggaran kasar</strong>: dari sifar ~{
        MINGGU_MIN.sifar
      } minggu, dari jalan-lari ~{MINGGU_MIN.jalan} minggu, dan dari 5K sekarang ~{
        MINGGU_SETIAP_MINIT
      } minggu bagi setiap minit yang hendak dipotong. Setiap orang berbeza.
    </li>
    <li>
      Beban naik paling banyak 10% seminggu dan setiap minggu ke-4 lebih ringan
      - badan menjadi kuat ketika berehat. Terlepas sesi? Teruskan dengan minggu
      itu, jangan ganti dua kali ganda.
    </li>
    <li>
      Cuaca Malaysia panas dan lembap: lari awal pagi atau lewat petang, bawa
      air, perlahankan pace bila panas - ikut rasa usaha, bukan jam. Mahu ukuran
      yang lebih tepat? Cuba <a class="link" href={maf}>lari ikut nadi (MAF)</a> untuk
      sesi mudah.
    </li>
  </ul>
</Section>

<script>
  import { buatIcs, waktuMalaysia } from "../lib/ics";
  import { kiraMaf, type Kategori } from "../lib/maf";
  import {
    KUNCI_DIBUAT,
    baca,
    kunciPelan,
    padamPelan,
    paramPelan,
    simpan,
    simpanParam,
  } from "../lib/pelan-tersimpan";
  import { keluarAwan, kotakAwan } from "../lib/awan";
  import { sahkan } from "../lib/sahkan";
  import { htmlMinggu, papakAnalisis } from "../lib/pelan-papar";
  import { NOTA_AWAN } from "../data/site";
  import {
    HAD_TANPA_AKAUN,
    HARI_SESI,
    NAMA_HARI,
    analisis,
    TAHAP,
    type Analisis,
    bolehBuatPelan,
    buatPelan,
    isninMula,
    tarikhSesi,
    type Minggu,
    type Tahap,
  } from "../lib/pelan-5k";

  const borang = document.getElementById("borang") as HTMLFormElement;
  const penuh = borang.dataset.penuh === "1";
  const logMasuk = /(?:^|; )session_active=1/.test(document.cookie);
  const ke = (path: string) => `${path}${location.search}${location.hash}`;
  const LOGIN = () =>
    `/login?next=${encodeURIComponent(ke("/account/pelan-5k"))}`;
  // Log masuk -> versi penuh (pengawal sesi versi penuh = AccountLayout).
  if (!penuh && logMasuk) location.replace(ke("/account/pelan-5k"));
  const masaMedan = document.getElementById("masa-medan")!;
  const masaInput = borang.elements.namedItem("masa") as HTMLInputElement;
  const mafBox = document.getElementById("maf") as HTMLInputElement | null;
  const mafMedan = document.getElementById(
    "maf-medan",
  ) as HTMLFieldSetElement | null;
  const hasil = document.getElementById("hasil")!;
  const pelanEl = document.getElementById("pelan")!;

  const q = new URLSearchParams(location.search);
  for (const [k, v] of q) {
    const el = borang.elements.namedItem(k);
    if (el instanceof RadioNodeList) el.value = v;
    else if (el instanceof HTMLInputElement && el.type === "checkbox")
      el.checked = v === el.value;
    else if (el instanceof HTMLInputElement) {
      el.value = v;
      el.dispatchEvent(new Event("change")); // DatePicker: kotak dd/mm/yyyy ikut
    }
  }

  const masaLabel = masaMedan.querySelector(".field-label")!;
  const ikutTahap = () => {
    const tahap = (borang.elements.namedItem("tahap") as RadioNodeList).value;
    const is5k = tahap === "5k";
    const ada = is5k || tahap === "jalan"; // jalan: pilihan, untuk analisis lebih tepat
    masaMedan.hidden = !ada;
    masaInput.required = is5k;
    masaInput.disabled = !ada; // tak dihantar dalam URL bila "sifar"
    masaLabel.textContent = is5k
      ? "Masa 5K sekarang (minit)"
      : "Masa jalan-lari 5K (minit, pilihan)";
    // fieldset disabled = umur/keadaan tak dihantar dan tak wajib bila MAF tak ditanda
    if (mafMedan) mafMedan.hidden = mafMedan.disabled = !mafBox!.checked;
  };
  borang.addEventListener("change", ikutTahap);
  ikutTahap();

  if (q.has("bulan")) papar();

  // Awam: kotak promosi versi penuh (selepas analisis ringkas).
  function htmlPromosi() {
    return `<section class="promosi no-print">
      <h3 class="display">Dapatkan versi penuh - percuma</h3>
      <p>Daftar atau log masuk untuk:</p>
      <ul>
        <li><strong>Pecahan "Realistik ke?"</strong> - jurang pace, kadar yang diperlukan seminggu, minggu yang cukup atau tidak, dan sesi laju dalam pelan.</li>
        <li><strong>Ikut nadi (MAF)</strong> - sesi mudah dengan julat kadar nadi anda.</li>
        <li><strong>Simpan ke kalendar</strong> - setiap sesi masuk kalendar telefon (iPhone, Android, Google, Outlook).</li>
        <li><strong>Pelan 10K dan 21K</strong> - langkah seterusnya selepas 5K, dengan masa sasaran pilihan.</li>
        <li><strong>Simpan ke awan</strong> - sehingga 3 pelan ikut akaun anda ke telefon atau komputer lain.</li>
        <li><strong>Dashboard</strong> - semua pelan anda dan kemajuan dalam satu tempat.</li>
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href="/register">Daftar percuma</a>
        <a class="btn btn-outline" href="${LOGIN()}">Log masuk</a>
      </div>
    </section>`;
  }

  // Fungsi (bukan const): papar() dipanggil lebih awal dalam skrip.
  function htmlAnalisis(a: Analisis) {
    return papakAnalisis(
      a,
      penuh
        ? undefined
        : `<p class="muted">Pecahan penuh (jurang pace, kadar seminggu, cukup minggu atau tidak) untuk akaun percuma - <a class="link" href="${LOGIN()}">log masuk</a>.</p>`,
    );
  }

  function papar() {
    const tahap = q.get("tahap") as Tahap;
    const bulan = Number(q.get("bulan"));
    const hari = Number(q.get("hari"));
    const masa5k = q.get("masa") ? Number(q.get("masa")) : undefined;
    hasil.hidden = false;
    let nadi: { maf: number; bawah: number } | undefined;
    if (penuh && q.get("maf") === "1") {
      const m = kiraMaf(Number(q.get("umur")), q.get("keadaan") as Kategori);
      if (!m.ok) {
        pelanEl.innerHTML = `<div class="alert alert-warning"><p>Ikut nadi: ${m.sebab}</p></div>`;
        hasil.scrollIntoView({ behavior: "smooth" });
        return;
      }
      nadi = { maf: m.maf, bawah: m.bawah };
    }
    const h = buatPelan({ bulan, tahap, hari, masa5k, nadi });
    const a = analisis({ bulan, tahap, hari, masa5k, nadi });

    if (!h.ok) {
      pelanEl.innerHTML = `${a ? htmlAnalisis(a) : ""}<div class="alert alert-warning"><p>${h.sebab}</p>${
        h.cadanganBulan
          ? `<a class="btn btn-primary" href="?${new URLSearchParams({ ...Object.fromEntries(q), bulan: String(h.cadanganBulan) })}">Cuba ${h.cadanganBulan} bulan</a>`
          : ""
      }</div>`;
      hasil.scrollIntoView({ behavior: "smooth" });
      return;
    }

    const kunci = kunciPelan(bulan, tahap, masa5k, hari);
    const dibuat = baca(KUNCI_DIBUAT);
    // Had tanpa akaun kira pelan 5K sahaja (10K/21K = akaun).
    if (
      !bolehBuatPelan(
        kunci,
        dibuat.filter((k) => k.startsWith("pelan-5k:")),
        penuh || logMasuk,
      )
    ) {
      pelanEl.innerHTML = `<div class="alert alert-info">
        <p class="alert-title">${HAD_TANPA_AKAUN} pelan percuma tanpa akaun</p>
        <p>Anda sudah buat ${HAD_TANPA_AKAUN} pelan berbeza di pelayar ini. Daftar akaun percuma untuk buat lebih banyak pelan.
          Pelan yang sudah dibuat masih boleh dibuka seperti biasa.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/register">Daftar percuma</a>
          <a class="btn btn-outline" href="${LOGIN()}">Log masuk</a>
        </div>
      </div>`;
      hasil.scrollIntoView({ behavior: "smooth" });
      return;
    }
    if (!dibuat.includes(kunci)) simpan(KUNCI_DIBUAT, [...dibuat, kunci]);
    if (penuh) simpanParam(kunci, paramPelan(q));
    const siap = new Set<string>(baca(kunci));
    const isnin = /^\d{4}-\d{2}-\d{2}$/.test(q.get("mula") ?? "")
      ? isninMula(new Date(`${q.get("mula")}T00:00:00`))
      : null;
    const hariIni = new Date().toDateString();
    const jumlah = h.minggu.reduce((a, w) => a + w.sesi.length, 0);

    pelanEl.innerHTML = `
      <div class="ringkas">
        <div>
          <p class="eyebrow">Pelan anda</p>
          <h2 class="display section-title">${bulan} bulan · ${hari} hari seminggu</h2>
          <p class="lead">${TAHAP[tahap]}${masa5k ? ` (${masa5k} minit)` : ""} → 5K bawah 30 minit.
            ${nadi ? `Ikut nadi: had MAF <strong>${nadi.maf}</strong>, julat ${nadi.bawah}-${nadi.maf} denyut/min.` : ""}
            ${isnin ? `Bermula Isnin, ${isnin.toLocaleDateString("ms-MY", { day: "numeric", month: "long", year: "numeric" })}.` : ""}
            <span id="kemajuan"></span></p>
        </div>
        <div class="actions no-print">
          <button class="btn btn-outline" type="button" data-kongsi>Kongsi</button>
          <button class="btn btn-outline" type="button" onclick="print()">Cetak</button>
          ${penuh ? `<button class="btn btn-outline" type="button" data-padam>Padam pelan</button>` : ""}
        </div>
      </div>
      ${
        penuh
          ? `<p class="awan-baris no-print" data-awan></p>`
          : `<div class="alert alert-warning no-print"><p>Pelan dan tanda siap disimpan dalam pelayar ini sahaja (localStorage) - hilang jika data pelayar dikosongkan atau anda tukar peranti. ${NOTA_AWAN}</p></div>`
      }
      ${a ? htmlAnalisis(a) : ""}
      ${penuh ? "" : htmlPromosi()}
      ${
        penuh
          ? `<div class="kalendar no-print">
        <h3 class="display">Simpan ke kalendar</h3>
        ${
          isnin
            ? `<div class="actions">
                <label class="field"><span class="field-label">Masa lari</span>
                  <input class="input" type="time" id="masa-lari" value="06:30" /></label>
                <button class="btn btn-primary" type="button" data-ics>Muat turun fail kalendar (.ics)</button>
              </div>`
            : `<p class="muted">Isi "Tarikh mula" di atas dan tekan "Buat pelan" - kalendar perlukan tarikh sebenar.</p>`
        }
        <ul class="muted">
          <li><strong>iPhone / iPad:</strong> buka page ini dalam Safari, tekan butang dan pilih "Tambah Semua".</li>
          <li><strong>Android (Samsung Calendar):</strong> buka fail yang dimuat turun dan pilih Kalendar.</li>
          <li><strong>Google Calendar:</strong> app Android tidak boleh import fail. Guna calendar.google.com dalam pelayar komputer → Tetapan → Import &amp; eksport.</li>
          <li><strong>Outlook / Mac:</strong> buka fail yang dimuat turun.</li>
        </ul>
      </div>`
          : ""
      }
      <ol class="minggu">${h.minggu.map((w) => htmlMinggu(w, isnin, hariIni)).join("")}</ol>`;

    const kemajuan = document.getElementById("kemajuan")!;
    const kira = () =>
      (kemajuan.textContent = `${siap.size} / ${jumlah} sesi siap.`);
    kira();
    const kotak =
      pelanEl.querySelectorAll<HTMLInputElement>("input[data-sesi]");
    const kemas = () => {
      kotak.forEach((c) => (c.checked = siap.has(c.dataset.sesi!)));
      kira();
    };
    // Versi akaun: lencana awan + segerak tanda siap (lib/awan.ts).
    const slotAwan = pelanEl.querySelector<HTMLElement>("[data-awan]");
    const keAwan = slotAwan
      ? kotakAwan(slotAwan, kunci, siap, kemas)
      : () => {};
    kemas();
    kotak.forEach((c) =>
      c.addEventListener("change", () => {
        c.checked ? siap.add(c.dataset.sesi!) : siap.delete(c.dataset.sesi!);
        simpan(kunci, [...siap]);
        kira();
        keAwan();
      }),
    );
    // Versi penuh sahaja: di versi awam, padam akan membuka semula slot had 3 pelan.
    pelanEl
      .querySelector("[data-padam]")
      ?.addEventListener("click", async () => {
        const ya = await sahkan({
          tajuk: "Padam pelan ini?",
          mesej: `Pelan ${bulan} bulan · ${hari} hari seminggu dan ${siap.size} tanda siap akan dibuang dari pelayar ini dan dari awan. Tindakan ini tak boleh diundur.`,
          ya: "Padam",
          bahaya: true,
        });
        if (!ya) return;
        padamPelan(kunci);
        await keluarAwan(kunci);
        location.href = "/account";
      });
    pelanEl
      .querySelector<HTMLButtonElement>("[data-kongsi]")!
      .addEventListener("click", async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        try {
          if (navigator.share)
            return await navigator.share({
              title: document.title,
              url: location.href,
            });
          await navigator.clipboard.writeText(location.href);
          btn.textContent = "Pautan disalin";
        } catch {
          /* dibatalkan */
        }
      });
    pelanEl
      .querySelector<HTMLButtonElement>("[data-ics]")
      ?.addEventListener("click", () => {
        const jam =
          (document.getElementById("masa-lari") as HTMLInputElement).value ||
          "06:30";
        const ics = buatIcs(
          h.minggu.flatMap((w) =>
            w.sesi.map((s, i) => ({
              uid: `${kunci.replace(":", "-")}-m${w.no}s${i}`,
              mula: waktuMalaysia(tarikhSesi(isnin!, w.no, hari, i), jam),
              minit: s.minit,
              tajuk: `Nubi 5K · Minggu ${w.no}: ${s.tajuk} (${s.minit} min)`,
              keterangan: `${s.arahan}\n${s.usaha}`,
            })),
          ),
          { nama: `Nubi 5K · ${bulan} bulan` },
        );
        const a = document.createElement("a");
        a.href = URL.createObjectURL(
          new Blob([ics], { type: "text/calendar" }),
        );
        a.download = `pelan-5k-${bulan}bln-${tahap}-${hari}hari.ics`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 60e3);
      });
    // Minggu semasa (bila tarikh mula diisi) lebih berguna dari atas pelan.
    (pelanEl.querySelector(".kad.kini") ?? hasil).scrollIntoView({
      behavior: "smooth",
    });
  }
</script>
