---
// Tarikh lumba (input utama pelan v2) + pilihan cepat dari kalendar /races (API, src/lib/races.ts).
// Pilih lumba = isi tarikh (+ jarak bila borang ada radio `jarak`). Pilihan dimuat dalam pelayar; tiada lumba = medan tersembunyi.
import Field from "./ui/Field.astro";
import DatePicker from "./ui/DatePicker.astro";
import Dropdown from "./ui/Dropdown.astro";
import Icon from "./ui/Icon.astro";

interface Props {
  /** Label jarak (raceDistances), contoh ["5K"] atau ["10K", "21K"]. */
  jarak: string[];
}
const { jarak } = Astro.props;
const tahun = new Date().getFullYear();
---

<Field
  label="Tarikh lumba (pilihan)"
  for="lumba-text"
  hint="Pelan dikira dari tarikh mula hingga hari lumba - minggu tirus betul-betul sebelum lumba. Kosongkan untuk pilih tempoh sendiri."
>
  <DatePicker
    id="lumba"
    name="lumba"
    min={`${tahun - 1}-01-01`}
    max={`${tahun + 2}-12-31`}
  />
</Field>
<div hidden data-pilih-lumba data-jarak={jarak.join(",")}>
  <Field label="Atau pilih dari kalendar lumba" for="pilih-lumba-butang">
    {/* Nilai "tarikh|jarak"; tiada `name`, jadi tak dihantar dengan borang. */}
    <Dropdown id="pilih-lumba" placeholder="Pilih lumba…" options={[]} />
  </Field>
  <template id="pilih-lumba-item"
    ><li role="option" aria-selected="false">
      <span></span><Icon name="tanda" />
    </li></template
  >
</div>

<script>
  import { fetchRaces, raceDistances } from "../lib/races";

  const kotak = document.querySelector<HTMLElement>("[data-pilih-lumba]");
  const pilih = document.getElementById(
    "pilih-lumba",
  ) as HTMLSelectElement | null;
  const lumba = document.getElementById("lumba") as HTMLInputElement | null;
  const tarikh = (iso: string) =>
    new Date(`${iso}T00:00:00`).toLocaleDateString("ms-MY", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });

  if (kotak && pilih && lumba) {
    void fetchRaces().then((races) => {
      const jarak = kotak.dataset.jarak!.split(",");
      const pilihan = (races ?? []).flatMap((r) =>
        jarak
          .filter((j) => raceDistances(r).includes(j))
          .map((j) => ({
            value: `${r.raceDate}|${j.toLowerCase()}`,
            label: `${r.name} · ${j} · ${tarikh(r.raceDate)}`,
          })),
      );
      if (!pilihan.length) return;
      const menu = document.getElementById("pilih-lumba-menu")!;
      const item = document.getElementById(
        "pilih-lumba-item",
      ) as HTMLTemplateElement;
      pilihan.forEach((p, i) => {
        pilih.add(new Option(p.label, p.value));
        const li = item.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLElement;
        li.id = `pilih-lumba-p${i}`;
        li.dataset.value = p.value;
        li.querySelector("span")!.textContent = p.label;
        menu.append(li);
      });
      pilih.closest("[data-dropdown]")!.dispatchEvent(new Event("dd:semula"));
      kotak.hidden = false;
    });
    pilih.addEventListener("change", () => {
      const [tarikh, j] = pilih.value.split("|");
      if (!tarikh) return;
      const jarak = pilih.form?.elements.namedItem("jarak");
      if (jarak instanceof RadioNodeList) {
        jarak.value = j;
        (jarak[0] as HTMLInputElement).dispatchEvent(
          new Event("change", { bubbles: true }),
        );
      }
      lumba.value = tarikh;
      lumba.dispatchEvent(new Event("change", { bubbles: true }));
    });
  }
</script>
