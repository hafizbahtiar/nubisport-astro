---
// Seksyen kandungan: eyebrow + h2 + lead pilihan, kemudian slot.
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  band?: boolean; // latar kelabu dengan garis atas/bawah
  narrow?: boolean;
  /** Akaun: jangan hadkan kepada .container 72rem. */
  fullWidth?: boolean;
  class?: string;
}
const {
  id,
  eyebrow,
  title,
  lead,
  band,
  narrow,
  fullWidth,
  class: cls,
} = Astro.props;
---

<section id={id} class:list={[band && "band", cls]}>
  <div
    class:list={[
      "container",
      narrow && "narrow",
      fullWidth && "container-wide",
    ]}
  >
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {title && <h2 class="display section-title">{title}</h2>}
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .container-wide {
    width: 100%;
    max-width: none;
    padding-inline: 0;
  }
</style>
