---
/**
 * Medan masa standard (adik DatePicker): teks hh:mm bermask + panel Jam / Minit, 24 jam. Markup dan
 * logik dalam src/lib/time-picker.ts (dikongsi dengan HTML yang dijana skrip - panggil
 * mountTimePickers selepas innerHTML). Contoh: /account/ui.
 *   <Field label="Masa mula" for="jam-text"><TimePicker id="jam" name="jam" value="07:00" /></Field>
 */
import { timePickerHtml } from "../../lib/time-picker";

interface Props {
  id: string;
  name?: string;
  /** "HH:MM". */
  value?: string;
  /** Langkah minit dalam panel (pembahagi 60). */
  step?: number;
  required?: boolean;
}
---

<Fragment set:html={timePickerHtml(Astro.props)} />

<script>
  import { mountTimePickers } from "../../lib/time-picker";
  mountTimePickers();
</script>
