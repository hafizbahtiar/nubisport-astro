---
import { SITE } from "../../data/site";
---

<header class="site-header">
  <div class="container bar">
    <a href="/" aria-label={`${SITE.name} - laman utama`}>
      <img
        src="/brand/logo-on-dark.svg"
        alt=""
        width="142"
        height="40"
        class="logo"
      />
    </a>
    <nav aria-label="Utama">
      <a class="desktop" href="/#tentang">Tentang</a>
      <a class="desktop" href="/#cara">Cara sertai</a>
      <a href="/pelan-5k">Pelan 5K</a>
      <a class="desktop" href="/maf">MAF</a>
      <a class="desktop" href="/pace">Pace</a>
      <a class="desktop" href="/panduan">Panduan</a>
      <a class="btn btn-ghost btn-sm" href="/login" data-akaun>Log masuk</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(10 26 51 / 0.92);
    backdrop-filter: blur(8px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .logo {
    height: 2.25rem;
    width: auto;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  nav a {
    color: #cbd5e1;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  nav a:not(.btn):hover {
    color: var(--orange);
  }
  nav .btn {
    color: #fff;
  }
  /* Phone: Pelan 5K + log masuk sahaja (yang lain dipaut dari laman utama). */
  @media (max-width: 40rem) {
    nav {
      gap: 1rem;
    }
    .desktop {
      display: none;
    }
  }
</style>

<script>
  // session_active = cookie UX (bukan httpOnly) dari backend: tanda sudah log masuk.
  if (/(?:^|; )session_active=1/.test(document.cookie)) {
    const a = document.querySelector<HTMLAnchorElement>("[data-akaun]");
    if (a) {
      a.textContent = "Akaun";
      a.href = "/account";
    }
  }
</script>
