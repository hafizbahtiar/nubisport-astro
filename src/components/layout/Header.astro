---
import { SITE } from "../../data/site";
import Icon from "../ui/Icon.astro";
import type { IconName } from "../../lib/icon";

// Panel "Alat": desktop = butang "Alat" + panel 4 kad; telefon = logo + log masuk + butang menu, dan
// panel yang sama ditambah Pelan 5K + Tentang / Cara sertai supaya semua page boleh dicapai.
const ALAT: { href: string; tajuk: string; nota: string; ikon: IconName }[] = [
  {
    href: "/maf",
    tajuk: "Kira MAF",
    nota: "Had kadar nadi untuk lari mudah",
    ikon: "nadi",
  },
  {
    href: "/pace",
    tajuk: "Kalkulator pace",
    nota: "Pace, masa dan anggaran 5K-maraton",
    ikon: "laju",
  },
  {
    href: "/races",
    tajuk: "Kalendar lumba",
    nota: "Larian di Malaysia + simpan ke kalendar",
    ikon: "kalendar",
  },
  {
    href: "/guide",
    tajuk: "Panduan pemula",
    nota: "Kasut, cuaca panas, hidrasi, hari lumba",
    ikon: "buku",
  },
];
const kini = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container bar">
    <a href="/" aria-label={`${SITE.name} - laman utama`}>
      <img
        src="/brand/logo-on-dark.svg"
        alt=""
        width="142"
        height="40"
        class="logo"
      />
    </a>
    <nav aria-label="Utama">
      <a class="desktop" href="/#tentang">Tentang</a>
      <a class="desktop" href="/#cara">Cara sertai</a>
      <a
        class="desktop"
        href="/plan-5k"
        aria-current={kini === "/plan-5k" ? "page" : undefined}>Pelan 5K</a
      >
      <button
        class="alat-butang"
        type="button"
        aria-expanded="false"
        aria-controls="panel-alat"
        id="butang-alat"
      >
        <span class="desktop">Alat</span><span class="desktop"
          ><Icon name="bawah" /></span
        >
        <span class="telefon" aria-hidden="true"><Icon name="menu" /></span>
        <span class="sr-telefon">Menu</span>
      </button>
      <a class="btn btn-ghost btn-sm" href="/login" data-akaun>Log masuk</a>
    </nav>
  </div>

  <div class="panel-alat" id="panel-alat" hidden>
    <div class="container">
      <ul class="alat">
        <li class="telefon">
          <a
            href="/plan-5k"
            aria-current={kini === "/plan-5k" ? "page" : undefined}
          >
            <span class="alat-ikon"><Icon name="pemasa" /></span>
            <span>
              <strong>Pelan 5K</strong>
              <small>5K bawah 30 minit, ikut tahap anda</small>
            </span>
          </a>
        </li>
        {
          ALAT.map((a) => (
            <li>
              <a
                href={a.href}
                aria-current={kini === a.href ? "page" : undefined}
              >
                <span class="alat-ikon">
                  <Icon name={a.ikon} />
                </span>
                <span>
                  <strong>{a.tajuk}</strong>
                  <small>{a.nota}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="alat-utama telefon">
        <a href="/#tentang">Tentang</a>
        <a href="/#cara">Cara sertai</a>
      </p>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(10 26 51 / 0.92);
    backdrop-filter: blur(8px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .logo {
    height: 2.25rem;
    width: auto;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  nav a,
  .alat-butang,
  .alat-utama a {
    color: #cbd5e1;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  nav a:not(.btn):hover,
  nav a[aria-current="page"],
  .alat-butang:hover,
  .alat-butang[aria-expanded="true"] {
    color: var(--orange);
  }
  nav .btn {
    color: #fff;
  }
  .alat-butang {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .alat-butang :global(.lucide) {
    transition: transform 0.15s;
  }
  .alat-butang[aria-expanded="true"] .desktop :global(.lucide) {
    transform: rotate(180deg);
  }
  .telefon,
  .sr-telefon {
    display: none;
  }

  /* Panel di bawah bar, lebar penuh; kad 4 lajur (desktop) -> 2 -> 1. */
  .panel-alat {
    position: absolute;
    inset: 100% 0 auto;
    background: var(--navy);
    border-top: 1px solid var(--on-dark-line);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.35);
    padding-block: 1.25rem;
  }
  .alat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .alat a {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    height: 100%;
    box-sizing: border-box;
    padding: 1rem;
    border-radius: var(--radius-lg);
    color: #fff;
    text-decoration: none;
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px var(--on-dark-line);
  }
  .alat a:hover,
  .alat a:focus-visible,
  .alat a[aria-current="page"] {
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px var(--orange);
  }
  .alat-ikon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: rgb(255 90 31 / 0.15);
    color: var(--orange);
  }
  .alat strong {
    display: block;
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .alat small {
    display: block;
    color: #cbd5e1;
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .alat-utama {
    gap: 1.5rem;
    margin: 1rem 0 0;
  }

  @media (max-width: 60rem) {
    .alat {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Telefon: Pelan 5K + menu + log masuk; selebihnya dalam panel. */
  @media (max-width: 40rem) {
    nav {
      gap: 1rem;
    }
    .desktop {
      display: none;
    }
    .telefon {
      display: flex;
    }
    .alat .telefon {
      display: block;
    }
    .sr-telefon {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .alat-butang {
      order: 3;
      width: 2.75rem;
      height: 2.75rem;
      justify-content: center;
      border-radius: 999px;
      box-shadow: inset 0 0 0 2px var(--on-dark-line);
      color: #fff;
    }
    .alat {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
    .alat a {
      padding: 0.75rem;
    }
    .panel-alat {
      max-height: calc(100dvh - 4.25rem);
      overflow-y: auto;
    }
  }
</style>

<script>
  // session_active = cookie UX (bukan httpOnly) dari backend: tanda sudah log masuk.
  if (/(?:^|; )session_active=1/.test(document.cookie)) {
    const a = document.querySelector<HTMLAnchorElement>("[data-akaun]");
    if (a) {
      a.textContent = "Akaun";
      a.href = "/account";
    }
  }

  // Panel Alat: klik butang buka/tutup; Esc, klik di luar atau klik pautan menutupnya.
  const butang = document.getElementById("butang-alat")!;
  const panel = document.getElementById("panel-alat")!;
  const set = (buka: boolean) => {
    panel.hidden = !buka;
    butang.setAttribute("aria-expanded", String(buka));
  };
  butang.addEventListener("click", () => set(panel.hidden !== false));
  panel.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) set(false);
  });
  document.addEventListener("click", (e) => {
    if (!panel.hidden && !(e.target as Element).closest(".site-header"))
      set(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !panel.hidden) {
      set(false);
      butang.focus();
    }
  });
</script>
