---
// "Sesuai lari hari ini?" - IPU (JAS) + ramalan cuaca (MET Malaysia) + waktu lari terbaik
// (waktu solat JAKIM, elak 11 pagi - 4 petang ikut KKM) untuk negeri pilihan.
// Tambahan sahaja: kalau sambungan atau sumber tiada, kad ini cuma beri mesej - pelan tetap berfungsi.
// Sumber rasmi (eqms.doe.gov.my, api.data.gov.my, e-solat.gov.my); panduan umum, bukan nasihat perubatan.
import Section from "./ui/Section.astro";
import Field from "./ui/Field.astro";
import Dropdown from "./ui/Dropdown.astro";
import { STATES } from "../lib/run-check";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
---

<Section
  narrow={!full}
  fullWidth={full}
  title="Sesuai lari hari ini?"
  class="no-print"
>
  <div class="card sesuai">
    <Field label="Negeri anda" for="sesuai-negeri-butang">
      <Dropdown
        id="sesuai-negeri"
        placeholder="Pilih negeri…"
        options={STATES.map((n) => ({ value: n.nama, label: n.nama }))}
      />
    </Field>
    <p class="muted" id="sesuai-mesej">
      Pilih negeri untuk nasihat IPU, cuaca dan waktu lari terbaik hari ini.
    </p>
    <div class="sesuai-hasil" id="sesuai-hasil" aria-live="polite" hidden></div>
    <p class="field-hint">
      Sumber: Jabatan Alam Sekitar (IPU), MET Malaysia (ramalan cuaca), JAKIM
      (waktu solat ibu negeri) dan KKM (elak 11 pagi - 4 petang). Panduan umum,
      bukan nasihat perubatan.
    </p>
  </div>
</Section>

<script>
  import {
    STATES,
    fetchForecast,
    fetchAqi,
    readLocation,
    fetchPrayerTimes,
    highestAqi,
    nowTimeMY,
    weatherAdvice,
    saveLocation,
    aqiLevel,
    runWindows,
  } from "../lib/run-check";
  import { todayMY } from "../lib/date";

  const negeriEl = document.getElementById(
    "sesuai-negeri",
  ) as HTMLSelectElement;
  const mesejEl = document.getElementById("sesuai-mesej")!;
  const hasilEl = document.getElementById("sesuai-hasil")!;

  // Teks dari sumber luar (nama stesen, ayat ramalan) - escape sebelum masuk innerHTML.
  const esc = (t: string) =>
    t.replace(
      /[&<>"]/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!,
    );
  // APIMS menyimpan waktu Malaysia seolah-olah UTC - format dengan timeZone UTC supaya jam betul.
  const jam = (ms: number) =>
    new Date(ms).toLocaleTimeString("ms-MY", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: "UTC",
    });
  const NADA: Record<string, string> = {
    baik: "alert-success",
    sederhana: "alert-warning",
  };

  async function papar(nama: string) {
    const negeri = STATES.find((n) => n.nama === nama);
    if (!negeri) return;
    mesejEl.hidden = false;
    mesejEl.textContent = "Memuatkan IPU dan cuaca…";
    hasilEl.hidden = true;
    const [stesen, cuaca, waktu] = await Promise.all([
      fetchAqi(negeri.nama),
      fetchForecast(negeri.met),
      fetchPrayerTimes(negeri.zon),
    ]);
    if (!stesen && !cuaca && !waktu) {
      mesejEl.textContent =
        "Data IPU dan cuaca tak dapat diambil sekarang. Cuba sekejap lagi.";
      return;
    }
    mesejEl.hidden = true;

    const bahagian: string[] = [];
    const tertinggi = stesen ? highestAqi(stesen) : null;
    if (tertinggi) {
      const t = aqiLevel(tertinggi.api!);
      bahagian.push(`<div class="sesuai-blok"><h3 class="sesuai-tajuk">Kualiti udara</h3><div class="alert ${NADA[t.nada] ?? "alert-danger"}">
        <p class="alert-title">IPU ${tertinggi.api} · ${esc(t.label)}</p>
        <p>${esc(t.nasihat)}</p>
        <p class="field-hint">Bacaan tertinggi di ${esc(negeri.nama)}: ${esc(tertinggi.station)} (JAS, ${jam(tertinggi.time)})</p>
      </div></div>`);
    } else if (!stesen) {
      bahagian.push(`<p class="muted">Bacaan IPU tak tersedia sekarang.</p>`);
    }

    const hari = cuaca?.find((d) => d.date === todayMY()) ?? cuaca?.[0] ?? null;
    if (hari) {
      const butir = [
        hari.morning ? `Pagi: ${esc(hari.morning)}.` : "",
        hari.afternoon ? `Petang: ${esc(hari.afternoon)}.` : "",
        hari.night ? `Malam: ${esc(hari.night)}.` : "",
      ]
        .filter(Boolean)
        .join(" ");
      const nasihat = weatherAdvice(hari);
      bahagian.push(`<div class="sesuai-blok"><h3 class="sesuai-tajuk">Cuaca hari ini <span>MET · ${hari.min}-${hari.max} °C</span></h3>
        <p><strong>${esc(hari.summary)}.</strong> ${butir}</p>
        ${nasihat.length ? `<ul>${nasihat.map((n) => `<li>${esc(n)}</li>`).join("")}</ul>` : ""}</div>`);
    } else {
      bahagian.push(
        `<p class="muted">Ramalan cuaca tak tersedia sekarang.</p>`,
      );
    }

    if (waktu) {
      const tingkap = runWindows(waktu, nowTimeMY(), hari);
      bahagian.push(
        tingkap.length
          ? `<div class="sesuai-blok"><h3 class="sesuai-tajuk">Waktu lari terbaik</h3><div class="sesuai-waktu">${tingkap
              .map(
                (t) =>
                  `<div class="sesuai-slot"><p><strong>${t.nama}</strong> <span class="sesuai-jam">${t.dari} - ${t.hingga}</span>${t.ribut ? ' <span class="tag">Ribut petir</span>' : ""}</p><p class="field-hint">${t.nota}</p></div>`,
              )
              .join("")}</div></div>`
          : `<div class="sesuai-blok"><h3 class="sesuai-tajuk">Waktu lari terbaik</h3><p>Waktu terbaik hari ini dah berlalu. Esok: lepas Subuh hingga 11 pagi, atau lepas 4 petang hingga Maghrib.</p></div>`,
      );
    }

    hasilEl.innerHTML = bahagian.join("");
    hasilEl.hidden = false;
  }

  negeriEl.addEventListener("change", () => {
    saveLocation(negeriEl.value);
    if (negeriEl.value) void papar(negeriEl.value);
  });
  negeriEl.value = readLocation() ?? "";
  if (negeriEl.value) negeriEl.dispatchEvent(new Event("change")); // Dropdown ikut + papar
</script>

<style is:global>
  /* Global: hasil dirender dengan innerHTML. */
  .sesuai {
    display: grid;
    gap: 1.5rem;
  }
  .sesuai > p {
    margin: 0;
  }
  .sesuai-hasil {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .sesuai-blok {
    display: grid;
    gap: 0.6rem;
  }
  .sesuai-hasil p,
  .sesuai-hasil ul {
    margin: 0;
  }
  /* .card p = muted; hasil (alert, ramalan) kekal warna teks/alert. */
  .sesuai .sesuai-hasil p:not(.field-hint) {
    color: inherit;
  }
  .sesuai-hasil ul {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.3rem;
  }
  .sesuai-tajuk {
    margin: 0;
    font-family: var(--display);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .sesuai-tajuk span {
    margin-left: 0.4rem;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .sesuai-waktu {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .sesuai-slot {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .sesuai-jam {
    font-variant-numeric: tabular-nums;
    color: var(--orange-ink);
    font-weight: 700;
  }
</style>
