---
// Kalkulator MAF + panduan. Kandungan sahaja - page pilih layout (seperti Plan5k.astro).
// `full` (/account/maf): had disimpan untuk dashboard + butang terus ke Pelan 5K ikut nadi.
import PageHero from "./ui/PageHero.astro";
import Section from "./ui/Section.astro";
import ChipGroup from "./ui/ChipGroup.astro";
import Field from "./ui/Field.astro";
import Alert from "./ui/Alert.astro";
import { CONDITIONS, AGE_MAX, AGE_MIN } from "../lib/maf";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const pelan = full ? "/account/plan-5k" : "/plan-5k";
---

<PageHero
  eyebrow="Latihan ikut nadi"
  title="Lari perlahan,"
  accent="untuk jadi laju."
  lead="MAF (Maximum Aerobic Function) ialah kaedah Dr. Phil Maffetone: berlatih di bawah satu had kadar nadi supaya badan membina asas aerobik - tahan lebih lama, kurang penat, kurang cedera."
>
  <form
    class="form"
    method="get"
    id="borang"
    data-full={full ? "1" : undefined}
  >
    <Field label="Umur (tahun)">
      <input
        class="input"
        type="number"
        name="umur"
        min={AGE_MIN}
        max={AGE_MAX}
        step="1"
        inputmode="numeric"
        required
        placeholder="cth. 32"
      />
    </Field>
    <ChipGroup
      legend="Keadaan anda sekarang - pilih yang paling tepat"
      name="keadaan"
      checked="terganggu"
      stacked
      options={Object.entries(CONDITIONS).map(([value, k]) => ({
        value,
        label: k.label,
      }))}
    />
    <button class="btn btn-primary" type="submit">Kira had MAF</button>
  </form>
</PageHero>

<section id="hasil" hidden aria-live="polite">
  <div class="container" id="keputusan"></div>
</section>

<Section id="apa" eyebrow="Asas" title="Apa itu MAF?" narrow>
  <div class="prose">
    <p>
      Formula 180: <strong>180 tolak umur</strong>, kemudian laras ikut keadaan
      anda (-10, -5, 0 atau +5). Hasilnya ialah <strong>had atas</strong> kadar nadi
      untuk latihan aerobik. Ramai pelari berlatih dalam julat 10 denyut di bawah
      had itu.
    </p>
    <p>
      Bawah had ini, badan belajar membakar lemak sebagai tenaga dan jantung
      menjadi lebih cekap. Lama-kelamaan,{" "}
      <strong>pace anda pada nadi yang sama makin laju</strong> - itulah
      tanda kemajuan.
    </p>
    <p>
      Mula-mula memang rasa terlalu perlahan. Ramai pemula terpaksa jalan-lari
      untuk kekal di bawah had - itu normal, bukan gagal.
    </p>
  </div>
</Section>

<Section
  id="cara"
  band
  eyebrow="Praktikal"
  title="Cara kekalkan nadi dalam zon"
  narrow
>
  <div class="prose">
    <ul>
      <li>
        <strong>Panas badan 10-15 minit</strong> - jalan, kemudian joging perlahan,
        biar nadi naik sedikit demi sedikit ke zon.
      </li>
      <li>
        <strong>Nadi melebihi had? Perlahankan.</strong> Masih tinggi? Jalan sehingga
        turun, kemudian sambung. Tinggalkan ego di rumah.
      </li>
      <li>
        <strong>Bukit:</strong> jalan laju semasa mendaki. Nadi naik cepat walaupun
        pace perlahan.
      </li>
      <li>
        <strong>Tetapkan amaran pada jam</strong> di had atas - jam berbunyi bila nadi terlebih, jadi tak perlu asyik tengok jam.
      </li>
      <li>
        <strong>Tali dada lebih tepat</strong> daripada sensor jam di pergelangan,
        terutama ketika berpeluh dan berlari laju-perlahan.
      </li>
      <li>
        <strong>Panas dan lembap Malaysia menaikkan nadi.</strong> Pace pada had yang
        sama akan lebih perlahan pada tengah hari berbanding awal pagi - lari awal
        pagi atau lewat petang.
      </li>
      <li>
        <strong>Kurang tidur, tekanan, kafein dan baru sembuh demam</strong> juga
        menaikkan nadi. Hari itu, ikut nadi - bukan pace semalam.
      </li>
      <li>
        <strong>Sabar.</strong> Kemajuan aerobik dikira dalam bulan, bukan minggu.
      </li>
    </ul>
  </div>
</Section>

<Section
  id="ujian"
  eyebrow="Ukur kemajuan"
  title="Ujian MAF sebulan sekali"
  narrow
>
  <div class="prose">
    <ol>
      <li>
        Pilih laluan rata yang sama setiap kali - trek atau laluan taman yang
        anda tahu jaraknya.
      </li>
      <li>Panas badan 10-15 minit.</li>
      <li>
        Lari 3-5 km pada <strong>had MAF anda</strong> (bukan bawah julat - tepat
        di had atas).
      </li>
      <li>
        Catat masa setiap kilometer. Kilometer pertama biasanya paling laju;
        setiap km seterusnya sedikit perlahan.
      </li>
      <li>
        Ulang bulan depan pada keadaan yang serupa (waktu, cuaca). Masa setiap
        km sepatutnya turun dari bulan ke bulan.
      </li>
    </ol>
    <p class="muted">
      Masa tak turun beberapa bulan berturut-turut? Itu tanda latihan, rehat atau tidur perlu dinilai semula - bagi Maffetone, itu isyarat, bukan kegagalan. Jangan uji terlalu kerap.
    </p>
  </div>
</Section>

<Section id="pelan" band eyebrow="Gabung" title="MAF dan pelan 5K" narrow>
  <div class="prose">
    <p>
      Dalam <a class="link" href={pelan}>pelan 5K bawah 30 minit</a>, sesi <strong
        >lari mudah</strong
      > dan{" "}
      <strong>larian panjang</strong> boleh dibuat ikut had MAF. Sesi interval dan
      tempo memang melebihi had itu - itu tujuannya.
    </p>
    <p>
      Maffetone sendiri cadangkan beberapa bulan asas aerobik tanpa latihan
      laju. Kalau anda baru bermula, MAF dulu, kemudian pelan 5K - memang perlahan, tapi selamat.
    </p>
  </div>
</Section>

<section>
  <div class="container narrow">
    <Alert variant="warning" title="Bukan nasihat perubatan">
      <p>
        Ini panduan umum berdasarkan formula 180 Dr. Phil Maffetone (<a
          class="link"
          href="https://philmaffetone.com/180-formula/"
          rel="noopener"
          target="_blank">philmaffetone.com</a
        >). Ada penyakit jantung, tekanan darah, makan ubat yang menjejaskan
        nadi, atau mengandung? Rujuk doktor dulu. Berhenti serta-merta kalau
        sakit dada, pening atau sesak nafas luar biasa.
      </p>
    </Alert>
  </div>
</section>

<script>
  import { CONDITIONS, calcMaf, type Condition } from "../lib/maf";
  import { prefillForm } from "../lib/profile";

  const full = document.getElementById("borang")!.dataset.full === "1";
  // Log masuk -> versi akaun (pengawal sesi = AccountLayout).
  if (!full && /(?:^|; )session_active=1/.test(document.cookie))
    location.replace(`/account/maf${location.search}${location.hash}`);

  const borang = document.getElementById("borang") as HTMLFormElement;
  const hasil = document.getElementById("hasil")!;
  const keputusan = document.getElementById("keputusan")!;
  const q = new URLSearchParams(location.search);

  for (const [k, v] of q) {
    const el = borang.elements.namedItem(k);
    if (el instanceof RadioNodeList || el instanceof HTMLInputElement)
      el.value = v;
  }
  if (full) void prefillForm(borang, q, () => undefined);

  if (q.has("umur")) {
    const kategori = q.get("keadaan") as Condition;
    const h = calcMaf(Number(q.get("umur")), kategori);
    hasil.hidden = false;
    if (full && h.ok)
      try {
        // Dashboard papar had terakhir. Pelayar ini sahaja, seperti pelan.
        localStorage.setItem(
          "maf:terakhir",
          JSON.stringify({
            maf: h.maf,
            bawah: h.bawah,
            umur: Number(q.get("umur")),
            keadaan: kategori,
          }),
        );
      } catch {
        /* mod peribadi */
      }
    // Teks di bawah datang dari lib (bukan dari URL), jadi selamat untuk innerHTML.
    keputusan.innerHTML = h.ok
      ? `<p class="eyebrow">Had MAF anda</p>
        <p class="display maf-angka">${h.maf} <small>denyut/min</small></p>
        <p class="lead">Jangan lebih <strong>${h.maf}</strong>. Julat latihan biasa: <strong>${h.bawah}-${h.maf}</strong> denyut/min.</p>
        <p class="muted">Keadaan: ${CONDITIONS[kategori].label.toLowerCase()} (${CONDITIONS[kategori].ubah >= 0 ? "+" : ""}${CONDITIONS[kategori].ubah}).</p>
        ${h.nota.map((n) => `<div class="alert alert-info maf-nota"><p>${n}</p></div>`).join("")}
        ${full ? `<a class="btn btn-primary maf-nota" href="/account/plan-5k?${new URLSearchParams({ maf: "1", umur: String(Number(q.get("umur"))), keadaan: kategori })}#borang">Buat Pelan 5K ikut nadi ini</a>` : ""}`
      : `<div class="alert alert-warning"><p>${h.sebab}</p></div>`;
    hasil.scrollIntoView({ behavior: "smooth" });
  }
</script>

<style is:global>
  /* Global: keputusan dirender dengan innerHTML. */
  .maf-angka {
    font-size: clamp(4rem, 14vw, 7rem);
    color: var(--orange-ink);
    margin: 0 0 1rem;
  }
  .maf-angka small {
    font-size: 0.3em;
    color: var(--navy);
  }
  .maf-nota {
    margin-top: 1rem;
  }
</style>
