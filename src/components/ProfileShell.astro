---
// Halaman profil akaun: card navigasi (Maklumat / Latihan / Keselamatan) di sebelah kandungan.
// Lebar: card menegak di kiri (melekat semasa skrol). Sempit (<= 48rem): card jadi tab segmen di atas.
import AccountLayout from "../layouts/AccountLayout.astro";
import Icon from "./ui/Icon.astro";
import type { IconName } from "../lib/icon";

interface Props {
  title: string;
}
const { title } = Astro.props;
// ikon: nama Lucide (src/lib/icon.ts), sama dengan NAV dalam AccountLayout.
const SUB: { href: string; label: string; nota: string; ikon: IconName }[] = [
  {
    href: "/account/profile",
    label: "Maklumat",
    nota: "Nama, e-mel, Telegram",
    ikon: "pengguna",
  },
  {
    href: "/account/profile/training",
    label: "Latihan",
    nota: "Umur, keadaan, masa terkini",
    ikon: "nadi",
  },
  {
    href: "/account/profile/password",
    label: "Keselamatan",
    nota: "Kata laluan, padam akaun",
    ikon: "mangga",
  },
];
const laluan = Astro.url.pathname.replace(/\/$/, "");
---

<AccountLayout title={`Profil · ${title}`}>
  <div class="profil">
    <nav class="profil-nav" aria-label="Tetapan profil">
      <p class="profil-nav-tajuk">Tetapan akaun</p>
      <ul>
        {
          SUB.map((s) => (
            <li>
              <a
                href={s.href}
                aria-current={laluan === s.href ? "page" : undefined}
              >
                <span class="ikon" aria-hidden="true">
                  <Icon name={s.ikon} />
                </span>
                <span class="teks">
                  <strong>{s.label}</strong>
                  <small>{s.nota}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="profil-isi">
      <slot />
    </div>
  </div>
</AccountLayout>

<style>
  .profil {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* Card navigasi */
  .profil-nav {
    position: sticky;
    top: calc(var(--navbar-h, 4rem) + 1.5rem);
    padding: 0.75rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
  }
  .profil-nav-tajuk {
    margin: 0.25rem 0.5rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .profil-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .profil-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.65rem;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .profil-nav a:hover {
    background: var(--paper-2);
  }
  .profil-nav a:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }
  .ikon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    background: var(--paper-2);
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .ikon :global(.lucide) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .teks {
    display: grid;
    line-height: 1.25;
  }
  .teks strong {
    font-size: 0.95rem;
  }
  .teks small {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .profil-nav a[aria-current="page"] {
    background: var(--paper-2);
    box-shadow: inset 3px 0 0 var(--orange);
  }
  .profil-nav a[aria-current="page"] .ikon {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }
  .profil-nav a[aria-current="page"] strong {
    color: var(--navy);
  }

  /* Kandungan: panel dari page (Maklumat / Kata laluan). */
  .profil-isi {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  /* Skrin lebar: borang dua kolum supaya panel mengisi lebar kandungan (bukan 40rem di kiri).
     Fieldset (chip), alert, butang dan perenggan kekal satu baris penuh. `.form-sempit` = kekal
     satu kolum sempit (contoh kata laluan: medan bertindan, meter di bawah medannya). */
  @media (min-width: 64rem) {
    .profil-isi :global(.form:not(.form-sempit)) {
      max-width: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    .profil-isi :global(.form > :is(fieldset, .form-group, .alert, .btn, p)) {
      grid-column: 1 / -1;
    }
  }
  .profil-isi :global(.panel) {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
  }
  .profil-isi :global(.panel h2) {
    margin: 0;
    font-size: 1.5rem;
    color: var(--navy);
  }
  .profil-isi :global(.panel p) {
    margin: 0;
  }
  /* Butang tindakan panel (Telegram, padam akaun): satu lebar penuh, bukan ikut panjang label. */
  .profil-isi :global(.panel .actions .btn) {
    flex: 0 0 100%;
    width: 100%;
  }

  /* Telefon: card yang sama jadi tab segmen mendatar */
  @media (max-width: 48rem) {
    .profil {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .profil-nav {
      position: static;
      padding: 0.35rem;
    }
    .profil-nav-tajuk,
    .teks small,
    .ikon {
      display: none;
    }
    .profil-nav ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .profil-nav a {
      justify-content: center;
      gap: 0.5rem;
      padding: 0.55rem;
    }
    .profil-nav a[aria-current="page"] {
      box-shadow: none;
      background: var(--navy);
    }
    .profil-nav a[aria-current="page"] strong {
      color: #fff;
    }
  }
</style>
