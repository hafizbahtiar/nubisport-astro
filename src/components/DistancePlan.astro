---
// Pelan 10K / 21K - akaun sahaja (/account/distance-plan, pengawal sesi = AccountLayout).
// Bertangga: 10K dari masa 5K, 21K dari masa 10K. Sasaran lalai = habis; masa sasaran pilihan.
// Enjin: src/lib/distance-plan.ts. Render kad minggu dikongsi dengan Pelan 5K (lib/plan-render.ts).
import PageHero from "./ui/PageHero.astro";
import Section from "./ui/Section.astro";
import ChipGroup from "./ui/ChipGroup.astro";
import Field from "./ui/Field.astro";
import DatePicker from "./ui/DatePicker.astro";
import Checkbox from "./ui/Checkbox.astro";
import Timer from "./Timer.astro";
import RunCheck from "./RunCheck.astro";
import RaceDateField from "./RaceDateField.astro";
import { CONDITIONS, AGE_MAX, AGE_MIN } from "../lib/maf";
import { DISTANCES } from "../lib/distance-plan";
import "../styles/plan.css";

const tahun = new Date().getFullYear();
---

<PageHero
  eyebrow="Pelan latihan"
  title="10K dan"
  accent="21K."
  lead="Langkah seterusnya lepas 5K. Sasaran utama habis dengan selamat - masukkan masa sasaran kalau nak sesi laju dan pecahan 'Realistik tak?'."
>
  <form class="form" method="get" id="borang">
    <ChipGroup
      legend="Jarak"
      name="jarak"
      checked="10k"
      options={[
        { value: "10k", label: "10K" },
        { value: "21k", label: "21K (separuh maraton)" },
      ]}
    />
    <RaceDateField jarak={["10K", "21K"]} />
    {
      (Object.keys(DISTANCES) as (keyof typeof DISTANCES)[]).map((j) => (
        <fieldset class="form-group" data-untuk={j} hidden disabled>
          <ChipGroup
            legend="Tempoh"
            name="minggu"
            options={DISTANCES[j].minggu.map((m) => ({
              value: m,
              label: `${m} minggu`,
            }))}
          />
        </fieldset>
      ))
    }
    <Field label="Masa 5K sekarang (minit)" id="masa-medan">
      <input
        class="input"
        type="number"
        name="masa"
        step="1"
        inputmode="numeric"
        required
      />
    </Field>
    <Field
      label="Masa sasaran (minit, pilihan)"
      id="sasaran-medan"
      hint="Kosongkan untuk sasaran habis dengan selamat."
    >
      <input
        class="input"
        type="number"
        name="sasaran"
        step="1"
        inputmode="numeric"
      />
    </Field>
    <ChipGroup
      legend="Hari seminggu"
      name="hari"
      checked={3}
      options={[3, 4].map((h) => ({ value: h, label: `${h} hari` }))}
    />
    <Checkbox
      name="maf"
      id="maf"
      label="Ikut nadi (MAF)"
      hint="Sesi mudah dan larian panjang dikawal had kadar nadi anda. Perlu jam atau tali dada pengukur nadi."
    />
    <fieldset class="form-group" id="maf-medan" hidden disabled>
      <Field label="Umur (tahun)">
        <input
          class="input"
          type="number"
          name="umur"
          min={AGE_MIN}
          max={AGE_MAX}
          step="1"
          inputmode="numeric"
          required
          placeholder="cth. 32"
        />
      </Field>
      <ChipGroup
        legend="Keadaan anda sekarang"
        name="keadaan"
        checked="terganggu"
        stacked
        options={Object.entries(CONDITIONS).map(([value, k]) => ({
          value,
          label: k.label,
        }))}
      />
    </fieldset>
    <Field
      label="Tarikh mula (pilihan)"
      for="mula-text"
      hint="Pelan bermula pada hari Isnin pada atau lepas tarikh ini."
    >
      <DatePicker
        id="mula"
        name="mula"
        min={`${tahun - 1}-01-01`}
        max={`${tahun + 2}-12-31`}
      />
    </Field>
    <button class="btn btn-primary" type="submit">Buat pelan</button>
  </form>
</PageHero>

<section class="hasil" id="hasil" hidden aria-live="polite">
  <div class="container" id="pelan"></div>
</section>

<RunCheck />

<Section band narrow title="Sebelum mula" class="nota">
  <ul>
    <li>
      Pelan ini panduan umum, <strong>bukan nasihat perubatan</strong>. Rujuk
      doktor kalau ada masalah jantung, tekanan darah, sendi atau baru sembuh
      daripada kecederaan. Berhenti kalau sakit (bukan sekadar penat). Pelan
      dibina ikut prinsip latihan umum (contoh pelan pemula Hal Higdon) dan <strong
        >belum disemak jurulatih bertauliah</strong
      >.
    </li>
    <li>
      Pelan disimpan dalam pelayar ini. Tekan "Simpan ke awan" (akaun percuma 1
      pelan, ahli 5) supaya ia dan tanda siap ikut akaun anda ke peranti lain.
    </li>
    <li>
      Bertangga: 10K perlukan masa 5K (boleh lari 5 km tanpa henti), 21K
      perlukan masa 10K. Belum sampai? Mula dengan
      <a class="link" href="/account/plan-5k">Pelan 5K</a> atau pelan 10K dulu.
    </li>
    <li>
      Anggaran masa guna formula Riegel berdasarkan masa anda sekarang - <strong
        >anggaran kasar</strong
      >. Jarak jauh biasanya lebih perlahan daripada ramalan bagi pelari yang
      belum biasa.
    </li>
    <li>
      Larian panjang naik sedikit demi sedikit, setiap minggu ke-4 lebih ringan,
      dan minggu terakhir sebelum lumba diturunkan (tirus) supaya kaki segar.
      Cuaca Malaysia panas - lari awal pagi, bawa air.
    </li>
    <li>
      Baru bermula? Baca <a class="link" href="/guide">panduan pemula</a> - kasut,
      panas badan, cuaca panas, keselamatan dan senarai semak hari lumba.
    </li>
  </ul>
</Section>

<Timer />
<script>
  import { buildIcs, malaysiaTime } from "../lib/ics";
  import { prefillForm, fillEmptyProfile } from "../lib/profile";
  import { calcMaf, type Condition } from "../lib/maf";
  import {
    startMonday,
    racePlan,
    sessionDate,
    earliestRaceDate,
    isoDate,
    formatPace,
  } from "../lib/plan-5k";
  import {
    DISTANCES,
    analyzeDistancePlan,
    buildDistancePlan,
    planDistancePaces,
    distanceWeeksNeeded,
    formatTime,
    type Distance,
  } from "../lib/distance-plan";
  import {
    weekHtml,
    pacesHtml,
    mountPaceForm,
    raceDayHtml,
    loadBarHtml,
    ramadanNotice,
    analysisHtml,
    mountShare,
    mountResume,
    mountTestForm,
    shareLink,
  } from "../lib/plan-render";
  import {
    CREATED_KEY,
    readList,
    distancePlanKey,
    deletePlan,
    planParams,
    pickPlanKey,
    planParamsFromForm,
    writeList,
    writeParams,
  } from "../lib/saved-plans";
  import {
    removeFromCloud,
    mountCloudBox,
    listCloud,
    saveToCloud,
  } from "../lib/cloud-sync";
  import {
    mountActivePlanBox,
    mountActuals,
    planSessionDate,
  } from "../lib/plan-sync";
  import { confirmDialog } from "../lib/confirm";

  const borang = document.getElementById("borang") as HTMLFormElement;
  const el = (n: string) => borang.elements.namedItem(n);
  const masaMedan = document.getElementById("masa-medan")!;
  const masaInput = el("masa") as HTMLInputElement;
  const sasaranInput = el("sasaran") as HTMLInputElement;
  const mafBox = document.getElementById("maf") as HTMLInputElement;
  const mafMedan = document.getElementById("maf-medan") as HTMLFieldSetElement;
  const hasil = document.getElementById("hasil")!;
  const pelanEl = document.getElementById("pelan")!;
  mountTestForm(pelanEl);
  mountPaceForm(pelanEl, ["sasaran"]); // pace sendiri ganti masa sasaran
  const lumbaInput = el("lumba") as HTMLInputElement;
  const PROFIL_LABEL: Record<string, string> = {
    hari: "hari seminggu",
    masa5k: "masa 5K",
    masa10k: "masa 10K",
    keadaan: "keadaan MAF",
  };

  const q = new URLSearchParams(location.search);
  const ikutJarak = () => {
    const j = ((el("jarak") as RadioNodeList).value || "10k") as Distance;
    const c = DISTANCES[j];
    borang
      .querySelectorAll<HTMLFieldSetElement>("[data-untuk]")
      .forEach(
        (f) =>
          (f.hidden = f.disabled = f.dataset.untuk !== j || !!lumbaInput.value),
      ); // tarikh lumba = minggu dikira
    // Dua fieldset kongsi name="minggu", jadi checked server tak boleh dipakai. Set lalai
    // pada kumpulan aktif sahaja, dan jangan ganggu pilihan dari URL/pengguna.
    const tempoh = [
      ...borang.querySelectorAll<HTMLInputElement>(
        'fieldset:not([disabled]) input[name="minggu"]',
      ),
    ];
    if (tempoh.length && !tempoh.some((r) => r.checked))
      tempoh.find((r) => Number(r.value) === c.mingguLalai)!.checked = true;
    masaMedan.querySelector(".field-label")!.textContent =
      `Masa ${c.prasyarat.nama} sekarang (minit)`;
    masaInput.min = String(c.prasyarat.min);
    masaInput.max = String(c.prasyarat.max);
    masaInput.placeholder = j === "10k" ? "cth. 32" : "cth. 65";
    sasaranInput.min = String(c.sasaran.min);
    sasaranInput.max = String(c.sasaran.max);
    sasaranInput.placeholder = j === "10k" ? "cth. 60" : "cth. 140";
    mafMedan.hidden = mafMedan.disabled = !mafBox.checked;
  };
  // Pilih jarak dahulu (tempoh bergantung padanya), kemudian isi medan lain dari URL.
  if (q.get("jarak") === "21k") (el("jarak") as RadioNodeList).value = "21k";
  ikutJarak();
  void prefillForm(borang, q, (p) =>
    (el("jarak") as RadioNodeList).value === "21k" ? p.masa10k : p.masa5k,
  );
  for (const [k, v] of q) {
    const e = el(k);
    // "minggu": nilai 12 wujud dalam kedua-dua kumpulan - tanda dalam kumpulan jarak aktif.
    if (k === "minggu")
      borang
        .querySelectorAll<HTMLInputElement>(
          `fieldset:not([disabled]) input[name="minggu"]`,
        )
        .forEach((r) => (r.checked = r.value === v));
    else if (e instanceof RadioNodeList) e.value = v;
    else if (e instanceof HTMLInputElement && e.type === "checkbox")
      e.checked = v === e.value;
    else if (e instanceof HTMLInputElement) {
      e.value = v;
      e.dispatchEvent(new Event("change")); // DatePicker
    }
  }
  borang.addEventListener("change", ikutJarak);
  ikutJarak();
  // Tempoh lalai = `mingguLalai` setiap jarak (10K 10, 21K 16), ditanda oleh ikutJarak().
  if (q.has("jarak")) papar();

  function papar() {
    const jarak = (q.get("jarak") === "21k" ? "21k" : "10k") as Distance;
    const c = DISTANCES[jarak];
    let minggu = Number(q.get("minggu"));
    const hari = Number(q.get("hari"));
    const masa = Number(q.get("masa"));
    const pace = q.get("pace") ? Number(q.get("pace")) : undefined;
    const sasaran = pace
      ? undefined
      : q.get("sasaran")
        ? Number(q.get("sasaran"))
        : undefined;
    const ISO = /^\d{4}-\d{2}-\d{2}$/;
    const tarikhPanjang = (d: Date) =>
      d.toLocaleDateString("ms-MY", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      });
    // Ikut tarikh lumba: minggu dari mula (atau Isnin depan) ke minggu lumba, disimpan dalam URL.
    const lumbaIso = ISO.test(q.get("lumba") ?? "") ? q.get("lumba")! : null;
    const lumba = lumbaIso ? new Date(`${lumbaIso}T00:00:00`) : null;
    if (lumba) {
      const r = racePlan(
        new Date(
          `${ISO.test(q.get("mula") ?? "") ? q.get("mula") : isoDate(new Date())}T00:00:00`,
        ),
        lumba,
        [c.minggu[0], c.minggu.at(-1)!],
        hari,
      );
      minggu = r.minggu;
      q.set("mula", isoDate(r.mula));
      q.set("minggu", String(minggu));
      history.replaceState(null, "", `?${q}`);
    }
    // Tiada pilihan minggu (contoh pautan hanya ?jarak=10k): ambil lalai yang sudah ditanda.
    if (!Number.isInteger(minggu)) {
      const dipilih = borang.querySelector<HTMLInputElement>(
        'fieldset:not([disabled]) input[name="minggu"]:checked',
      );
      minggu = Number(dipilih?.value ?? c.mingguLalai);
      q.set("minggu", String(minggu));
      history.replaceState(null, "", `?${q}`);
    }
    const awal = (n: number) =>
      earliestRaceDate(new Date(`${q.get("mula")}T00:00:00`), n, hari);
    const cubaLumba = (n: number) =>
      `<p>Tarikh lumba paling awal yang munasabah: <strong>${tarikhPanjang(awal(n))}</strong>.</p>
       <a class="btn btn-primary btn-sm" href="?${new URLSearchParams({ ...Object.fromEntries(q), lumba: isoDate(awal(n)) })}">Cuba tarikh itu</a>`;
    const tempoh = lumba
      ? `Lumba ${lumba.toLocaleDateString("ms-MY", { day: "numeric", month: "short", year: "numeric" })} · ${minggu} minggu`
      : `${minggu} minggu`;
    hasil.hidden = false;
    const amaran = (t: string, lagi = "") => {
      pelanEl.innerHTML = `<div class="alert alert-warning"><p>${t}</p>${lagi}</div>`;
      hasil.scrollIntoView({ behavior: "smooth" });
    };
    let nadi: { maf: number; bawah: number } | undefined;
    if (q.get("maf") === "1") {
      const m = calcMaf(Number(q.get("umur")), q.get("keadaan") as Condition);
      if (!m.ok) return amaran(`Ikut nadi: ${m.sebab}`);
      nadi = { maf: m.maf, bawah: m.bawah };
    }
    if (lumba && minggu < c.minggu[0])
      return amaran(
        `Lumba ${minggu} minggu lagi terlalu dekat untuk pelan ${c.nama} - perlu sekurang-kurangnya ${c.minggu[0]} minggu.`,
        cubaLumba(c.minggu[0]),
      );
    const input = { jarak, minggu, hari, masa, sasaran, pace, nadi };
    const h = buildDistancePlan(input);
    if (!h.ok) return amaran(h.sebab);
    const a = analyzeDistancePlan(input);

    // Pelan yang dibuka dari dashboard bawa `kunci` - "Kemas kini pelan" menulis params di bawahnya.
    const dibuat = readList(CREATED_KEY);
    const kunci = pickPlanKey(
      q.get("kunci"),
      dibuat,
      distancePlanKey(jarak, minggu, masa, pace ? `p${pace}` : sasaran, hari),
    );
    const paces = planDistancePaces(input);
    const sasaranMinit = pace ? (pace * c.km) / 60 : sasaran;
    const perlu = distanceWeeksNeeded(input);
    if (!dibuat.includes(kunci)) writeList(CREATED_KEY, [...dibuat, kunci]);
    writeParams(kunci, planParams(q));
    // Buang tanda siap untuk sesi yang tak wujud lagi selepas pelan dikemas kini (minggu berubah).
    const sah = new Set(
      h.minggu.flatMap((w) => w.sesi.map((_, i) => `${w.no}.${i}`)),
    );
    const tersimpan = readList(kunci);
    const siap = new Set<string>(tersimpan.filter((id) => sah.has(id)));
    if (siap.size !== tersimpan.length) writeList(kunci, [...siap]);
    const isnin = /^\d{4}-\d{2}-\d{2}$/.test(q.get("mula") ?? "")
      ? startMonday(new Date(`${q.get("mula")}T00:00:00`))
      : null;
    const hariIni = new Date().toDateString();
    const jumlah = h.minggu.reduce((n, w) => n + w.sesi.length, 0);
    const tajuk = `${c.nama} · ${tempoh} · ${hari} hari seminggu`;

    pelanEl.innerHTML = `
      <div class="ringkas">
        <div>
          <p class="eyebrow">Pelan anda</p>
          <h2 class="display section-title">${tajuk}</h2>
          <p class="lead">${c.prasyarat.nama} ${masa} minit → ${c.nama} ${sasaranMinit ? `bawah ${formatTime(sasaranMinit)}${pace ? ` (pace ${formatPace(pace)}/km)` : ""}` : `habis (anggaran ~${formatTime(h.ramalan)})`}.
            ${nadi ? `Ikut nadi: had MAF <strong>${nadi.maf}</strong>, julat ${nadi.bawah}-${nadi.maf} denyut/min.` : ""}
            ${isnin ? `Bermula ${tarikhPanjang(sessionDate(isnin, 1, hari, 0, lumba))}.` : ""}
            <span id="kemajuan"></span></p>
        </div>
        <div class="actions no-print">
          <button class="btn btn-outline" type="button" data-kongsi>Kongsi</button>
          <button class="btn btn-outline" type="button" onclick="print()">Cetak</button>
          <button class="btn btn-outline" type="button" data-kemas>Kemas kini pelan</button>
          <button class="btn btn-outline" type="button" data-padam>Padam pelan</button>
        </div>
      </div>
      <p class="awan-baris no-print" data-awan></p>
      <p class="awan-baris no-print" data-aktif></p>
      <p class="muted no-print" data-profil hidden></p>
      ${h.amaran.map((t) => `<div class="alert alert-info"><p>${t}</p>${lumba && perlu <= c.minggu.at(-1)! ? cubaLumba(perlu) : ""}</div>`).join("")}
      ${a ? analysisHtml(a) : ""}
      ${pacesHtml(paces, !!pace, `Lumba ${c.nama}`)}
      ${lumba ? raceDayHtml(lumba, paces.lumba, c.nama) : ""}
      ${ramadanNotice(h.minggu, isnin, lumba)}
      <div class="kalendar no-print">
        <h3 class="display">Simpan ke kalendar</h3>
        ${
          isnin
            ? `<div class="actions">
                <label class="field"><span class="field-label">Masa lari</span>
                  <input class="input" type="time" id="masa-lari" value="06:30" /></label>
                <button class="btn btn-primary" type="button" data-ics>Muat turun fail kalendar (.ics)</button>
              </div>`
            : `<p class="muted">Isi "Tarikh mula" di atas dan tekan "Buat pelan" - kalendar perlukan tarikh sebenar.</p>`
        }
      </div>
      <div class="no-print" data-sambung-slot></div>
      <ol class="minggu">${h.minggu.map((w) => weekHtml(w, isnin, hariIni, jarak, lumba)).join("")}</ol>`;

    const kemajuan = document.getElementById("kemajuan")!;
    // Pelan 10K/21K = akaun: kawan perlu akaun percuma untuk membukanya.
    mountShare(
      pelanEl.querySelector<HTMLButtonElement>("[data-kongsi]")!,
      shareLink(
        "/account/distance-plan",
        (() => {
          const k = new URLSearchParams(q);
          k.delete("kunci"); // kunci simpanan peribadi - bukan untuk pautan kongsi
          return k;
        })(),
      ),
      `Mari berlari bersama: pelan ${tajuk} dari Nubi Sport (perlu akaun percuma).`,
    );
    // Ubah masa/pace/tarikh pada borang, kemudian tulis params di bawah kunci yang sama.
    pelanEl.querySelector("[data-kemas]")?.addEventListener("click", () => {
      const baru = planParamsFromForm(borang, q, kunci);
      for (const k of [...q.keys()]) q.delete(k);
      baru.forEach((v, k) => q.set(k, v));
      papar();
      history.replaceState(null, "", `?${q}`);
      // Pelan ini mungkin sudah di awan: hantar params/tanda siap baharu (update, bukan slot baharu).
      if (pelanEl.querySelector("[data-kemas]"))
        void listCloud().then((a) => {
          if (a?.items.some((p) => p.key === kunci)) void saveToCloud(kunci);
        });
    });
    // Pelan lumba tak dianjak - tarikh lumba tetap.
    const sambung =
      isnin && !lumba
        ? mountResume(
            pelanEl.querySelector("[data-sambung-slot]")!,
            h.minggu,
            isnin,
            siap,
          )
        : () => {};
    const kira = () => {
      kemajuan.textContent = `${siap.size} / ${jumlah} sesi siap.`;
      sambung();
    };
    const kotak =
      pelanEl.querySelectorAll<HTMLInputElement>("input[data-sesi]");
    const kemas = () => {
      kotak.forEach((cb) => (cb.checked = siap.has(cb.dataset.sesi!)));
      kira();
    };
    const keAwan = mountCloudBox(
      pelanEl.querySelector<HTMLElement>("[data-awan]")!,
      kunci,
      siap,
      kemas,
    );
    void mountActivePlanBox(
      pelanEl.querySelector("[data-aktif]")!,
      kunci,
      !!isnin,
      siap,
      kemas,
    );
    void mountActuals(pelanEl, kunci, (w) => loadBarHtml(w, "Beban minggu: "));
    // Profil kali pertama: isi medan kosong saja (lib/profile.ts).
    void fillEmptyProfile({
      hari: String(hari),
      [jarak === "10k" ? "masa5k" : "masa10k"]: String(masa),
      keadaan: nadi ? (q.get("keadaan") ?? undefined) : undefined,
    }).then((k) => {
      const p = pelanEl.querySelector<HTMLElement>("[data-profil]");
      if (!p || !k.length) return;
      p.innerHTML = `Disimpan ke profil: ${k.map((x) => PROFIL_LABEL[x] ?? x).join(", ")}. Ubah di <a class="link" href="/account/profile/training">Profil</a>.`;
      p.hidden = false;
    });
    kemas();
    kotak.forEach((cb) =>
      cb.addEventListener("change", () => {
        cb.checked ? siap.add(cb.dataset.sesi!) : siap.delete(cb.dataset.sesi!);
        writeList(kunci, [...siap]);
        kira();
        keAwan();
      }),
    );
    pelanEl
      .querySelector("[data-padam]")!
      .addEventListener("click", async () => {
        const ya = await confirmDialog({
          title: "Padam pelan ini?",
          message: `Pelan ${tajuk} dan ${siap.size} tanda siap akan dibuang dari pelayar ini dan dari awan. Tindakan ini tak boleh dibatalkan.`,
          confirmLabel: "Padam",
          danger: true,
        });
        if (!ya) return;
        deletePlan(kunci);
        await removeFromCloud(kunci);
        location.href = "/account";
      });
    pelanEl
      .querySelector<HTMLButtonElement>("[data-ics]")
      ?.addEventListener("click", () => {
        const pukul =
          (document.getElementById("masa-lari") as HTMLInputElement).value ||
          "06:30";
        const ics = buildIcs(
          h.minggu.flatMap((w) =>
            w.sesi.map((s, i) => ({
              uid: `${kunci.replace(":", "-")}-m${w.no}s${i}`,
              mula: malaysiaTime(
                planSessionDate(isnin!, w.no, hari, i, s.jenis, lumbaIso),
                pukul,
              ),
              minit: s.minit,
              tajuk: `Nubi ${c.nama} · Minggu ${w.no}: ${s.tajuk} (${s.minit} min)`,
              keterangan: `${s.arahan}\n${s.usaha}`,
            })),
          ),
          { nama: `Nubi ${c.nama} · ${tempoh}` },
        );
        const link = document.createElement("a");
        link.href = URL.createObjectURL(
          new Blob([ics], { type: "text/calendar" }),
        );
        link.download = `pelan-${jarak}-${minggu}mgg-${hari}hari.ics`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 60e3);
      });
    (pelanEl.querySelector(".kad.kini") ?? hasil).scrollIntoView({
      behavior: "smooth",
    });
  }
</script>
